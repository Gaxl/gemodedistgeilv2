	quest.212EF8601746C500.quest_desc: ["Güçlendirmeler:\\n\\n - Hasar Emilimi II (3:00)\\n - Hız II (3:00)\\n - Direnç II (3:00)\\n - Yenilenme II (3:00)"]
	quest.212EF8601746C500.title: "&9Imperium Apple"
	quest.21398F45428CD1D1.quest_desc: ["&6Bloom Berries&r, &bBlooming Caverns&r tavanındaki &bGlowing Vines&r üzerinde yetişir. \n\n&bGlowing Vines&r içinde &6Bloom Berries&r oluşabilir ve Sağ Tık ile onları &bSarmaşıktan&r toplamanızı beklerler! \n\nBu, &3&lOtherside&r boyutundaki tek Yiyecek Kaynağıdır."]
	quest.21398F45428CD1D1.title: "&6Bloom Berries"
	quest.2149833F65D523E5.quest_desc: [
		"Tıpkı Arı Topu gibi, Kristal Topu da üretilebilir, yapılarda bulunabilir veya &5Arı Kraliçesi&r ile takas edilebilir. \\n\\nTatar yayı gibi kullanılır: Envanterinizde &5Bal Kristali Parçaları&r varsa, kristal yüklemek için sağ tıklayıp basılı tutun ve fırlatmak için serbest bırakın!"
		"{image:atm:textures/questpics/bumblezone/bumble_cannon1.png width:75 height:150 align:center}"
	]
	quest.2156C00E30424844.quest_desc: ["&4Dökümhane Tankları&r, &c&lDökümhanemize&r sıvı eklemek için yapılmıştır. \\n\\nÇoğunlukla yakıt. \\n\\nÇoğunlukla &cLav&r! \\n\\nGörünüşe göre &c&lDökümhaneye&r gerçek anlamda yakıt sağlamanın tek yollarından biri bu."]
	quest.2156C00E30424844.title: "&l&cDökümhane&r &4Tankları"
	quest.2158A566C2F54AA9.title: "Draconic Kalkan Kontrol Modülü"
	quest.215AD616E6847E9A.quest_desc: ["Her &5Insanium Gemstone&r, 2 &5Insanium Essence&r'a eşittir. Yani her &5Gemstone Block&r, 18 &5Insanium Essence&r'dır. \\n\\nBu, &5Insanium Blocks&r için olan 9,216 &aInferium Essence&r'ı alıp sadece 4 &5Insanium Gemstone Blocks&r için 18,432 &aInferium Essence&r elde etmek üzere ikiye katlayabileceğimiz anlamına gelir."]
	quest.215AD616E6847E9A.title: "4 &5Insanium Gemstone Blocks"
	quest.215C9C2B2240FAA1.quest_desc: ["&e&lIron's Spells&r &5Electric Zırh&r!"]
