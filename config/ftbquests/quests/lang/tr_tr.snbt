	quest.713D3B3954E58C4A.quest_subtitle: "Depolama: 1,640,000,000 RF"
	quest.713D3B3954E58C4A.title: "Aşama 3"
	quest.713EF442D59501BA.quest_desc: ["&5Chain of &9Souls&r, &9&lLunar Monstrosity&r'nin düşürdüğü malzemelerle üretilebilir. \\n\\nBir çekme kancası işlevi görür: Sağ tık ile fırlatıldığında tutunduğu yüzeye veya hedefe doğru sizi hızla çeker; bağı koparmak için tekrar sağ tıklayın."]
	quest.713EF442D59501BA.title: "&5Chain of &9Souls"
	quest.7143CE930D08F160.quest_desc: ["AOE (Etki Alanı) çoğu Oyuncunun bileceği bir terimdir. Temel olarak üzerinde bulunduğu Aletin çalışma alanını yükseltir. 3x3 AOE'ye sahip Kazmalar 3x3'lük bir alanda kazar. 3x3 AOE'ye sahip Kılıçlar o alan içinde vurulan tüm yaratıkları öldürür. Yükseltme ne kadar iyi olursa alan o kadar büyük olur. Hayır, üst üste biriktirilemez!"]
	quest.7143CE930D08F160.title: "Basic Area-Of-Effect Module"
	quest.71441DFA05FD73E5.quest_desc: [
		"Geçerli Yükseltmeler:"
		"- Mind Fog"
		"- Stupefy"
		"- Night Vision"
	]
	quest.714960DF26EFFA53.quest_desc: ["Tüm &5Zanite aletler&r dayanıklılıkları düştükçe blokları daha hızlı kazar. \\n\\nAyrıca &5Zanite Kazma&r ile &dGravitit&r cevheri kazabilirsiniz."]
	quest.714960DF26EFFA53.title: "&5Zanite&r Aletleri"
	quest.7154D73516548149.quest_desc: ["&6&lAllthemodium&r, Netherit'tan sonra daha fazla içerik eklemek için &6AllTheMods Takımı&r tarafından özel olarak eklenmiş bir moddur! \\n\\n&6&lATM Star&r için gereken bazı Eşyaları elde etmek amacıyla içinde maceraya atılman gerekecek. \\n\\nArtık bunun için takip edebileceğin bir Görev sayfası var!"]
	quest.7154D73516548149.title: "&l&6Allthemodium"
	quest.715588642623A8A1.quest_subtitle: "Kristal Arısı + Demir Arısı"
	quest.715588642623A8A1.title: "Kuvarsla Zenginleştirilmiş Demir Arısı"
	quest.71581992E8E4C43E.quest_desc: ["Bir &8Wither &3Glyph&r'i yapmak için birkaç &8Wither İskeleti Kafatası&r ve bir &dAbjuration Essence&r fırlat! \\n\\nEğer işe yaramadıysa daha fazla &aEXP&r'ye ihtiyacın olabilir."]
	quest.71581992E8E4C43E.title: "&3Glyph of &8Wither"
	quest.715B86DC82EA636B.quest_desc: [
		"&3Liquid Kompresör&r belirli sıvıları kullanarak basınç yaratır. Kovayı makineye sağ tıklayarak, sıvıyı pompalayarak veya GUI'deki üst yuvaya bir kova koyarak yakıtı içine koyabilirsiniz."
