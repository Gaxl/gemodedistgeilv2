	quest.3512F47DADC07EAE.quest_desc: ["&5Unobtainium Zırh&r ama &d&lArs Nouveau&r Büyülerine güçlendirmeleri var!"]
	quest.3512F47DADC07EAE.quest_subtitle: "40"
	quest.3512F47DADC07EAE.title: "&5Unobtainium Arcanist Ekipmanı"
