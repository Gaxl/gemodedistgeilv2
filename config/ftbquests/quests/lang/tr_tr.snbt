	quest.21624A6500545C42.quest_subtitle: "Daha Hızlı Ekinler"
	quest.21693C4DE6531D73.quest_desc: [
		"Öğütücü tıpkı adının da belirttiği gibidir. Üretim malzemeleri elde etmek için blokları kırabilir; tuğla merdivenden tuğla veya külçelerden toz elde etmek gibi. \n\nÇalışmak için güce ihtiyacı vardır! \n\nBir tane inşa etmek için 3x2x2 boyutunda Öğütücü bloğu gerekir."
		"{image:atm:textures/questpics/railcraft/rail_crusher.png width:100 height:100 align:center}"
	]
	quest.21693C4DE6531D73.title: "Öğütücü"
	quest.216DA9782EBDFF34.quest_desc: ["Bence bu Mod gerçekçi değil. Hangi Kitaplara veya Eşyalara sahip olduğun umurumda değil, Şeytani varlıkların her emrine uyacağını ve senin için bir köle olarak çalışacağını sanmıyorum. \\n\\nNe olursa olsun, bunu yapmak için Görevleri takip edebilirsin."]
	quest.216DA9782EBDFF34.title: "&b&lOccultism"
	quest.2171DC0B13C4BD43.quest_desc: ["&a&lRoots Classic&r JEI'de küçük görünebilir ancak sana onda çok daha fazlası olduğuna söz verebilirim! \\n\\nRoots tamamen doğanın armağanlarını ritüeller (rituals) yapmak için kullanmakla ilgilidir.\\n\\nBana güven, bu eşyaları her yerde bulacaksın!"]
	quest.2171DC0B13C4BD43.title: "&a&lRoots Classic"
	quest.217DB12EA32E1724.quest_desc: ["&bİnfüzyon Kristali&r, özlerin seviyesini yükseltmek için kullanılır. Örneğin kristali 4 adet Inferium Özü ile birleştirdiğinizde 1 adet Prudentium Özü elde edersiniz.\\n\\nİlerleyen aşamalarda kırılmayan üst düzey bir İnfüzyon Kristali da üretebilirsiniz."]
	quest.217DB12EA32E1724.title: "&bİnfüzyon Kristali"
	quest.217DF3B66A07A8DE.quest_desc: [""]
	quest.217DF3B66A07A8DE.quest_subtitle: "&oTek bir Tohumda Cennet Bahçesi."
	quest.217DF3B66A07A8DE.title: "&3&lDimensional &2Seed"
	quest.2182492BCC1B33D8.quest_desc: ["Bir Kovana takıldığında, her bal teslim edildiğinde %5 şansla yeni bir yavru arı doğmasını sağlar.\\n\\nBir Yakalayıcıya yerleştirildiğinde, yakalayıcının yalnızca yavru arıları yakalamasına izin verir.\\n\\nDaha yüksek bir şans elde etmek için bunları üst üste istifleyebilirsiniz."]
	quest.2182492BCC1B33D8.quest_subtitle: "Bebek Yapmak"
	quest.2188C52C1F384DE4.quest_desc: [""]
	quest.2188C52C1F384DE4.quest_subtitle: "&oSonsuza dek yanan yakıt (aslında değil)."
	quest.2188C52C1F384DE4.title: "&c&lPhilosopher's Fuel"
	quest.219932CB19258C16.quest_desc: ["Depolama bileşeninin üçüncü kademesi, &e16384&f bayt depolama alanı sağlar."]
	quest.219932CB19258C16.quest_subtitle: "x4^2"
