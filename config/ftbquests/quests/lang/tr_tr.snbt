	quest.0000A88BB40B2149.quest_desc: ["Kaos Adası'na gitmeden önce hazırlık yapmanızı öneririm; Ender Ejderhası'na benziyor olabilir ama bu Ejderha çok daha zordur. İşinizi kolaylaştırmak için yüksek hasar veren Draconic silahlar ve aletler kullanmak isteyeceksiniz. Ejderha devasa miktarda hasar verdiği için Unobtainium veya Meka-Suit gibi güçlü bir zırh giymeniz tavsiye edilir. (Ayrıca Yenilenme, Emilim ve Direnç efektleri hayatta kalmanıza yardımcı olacaktır.) Merak etmeyin, hazır değilseniz savaşı erteleyip başka bir gün şansınızı deneyebilirsiniz."]
	quest.0000A88BB40B2149.title: "Zor Olacak, Hazırlanman Gerekecek"
	quest.00075A5F9AC120ED.quest_desc: ["Bu işlem, eşyaları girdi sandığınızdan alacaktır."]
	quest.00075A5F9AC120ED.quest_subtitle: "Her Zaman Gerekli"
	quest.000C1ECD781F3F81.quest_desc: ["&2&lNature&r, düşmanlarımızı &2Zehirleyerek&r ve &2Zayıflatarak&r Dünyayı kendi avantajımıza kullanmak için tasarlanmıştır! Tıpkı Büyük Şirketlerin Dünya'nın kendisine yaptığı gibi! \n&2&lNature's&r Odak Malzemesi &2Poisonous Potato&r'dur. \n\n&2Scrolls&r (Parşömenler), &2Dark Green&r (Koyu Yeşil) metinli &aLight Green&r (Açık Yeşil) renktedir."]
	quest.000C1ECD781F3F81.title: "&2&lNature"
	quest.001A348054127235.quest_desc: ["&5Tomurcuklanan Ametist&r, üretim tariflerinde ve hatta sadece &5Ametist&r yetiştirmek için oldukça faydalıdır! \\n\\nBir &5Ametist Bloğunu&r &a60 Eterna&r, &c%30-%50 Quanta&r ve &5%50 Arkana&r değerleriyle &d&lİnfüze ederek&r elde edebilirsin. \\n\\nBu değerleri yakalamak için 10 &9Derin Kitaplık&r (&9Uyuyan&r olanlar değil), 2 &2Karpuz Kitaplığı&r ve 7 &7Temel Kitaplık&r kullanabilirsin.\\n\\nEğer &bDeniz Kitaplıkları&r yolunu seçtiysen 11 &bKristal Deniz Kitaplığı&r ve 1 &bAşılama Yapılmış Deniz Kitaplığı&r da işini görecektir."]
	quest.001A348054127235.title: "&5Tomurcuklanan Ametist&r Üretimi"
	quest.001C1881E9289566.quest_desc: ["&9Nadir&r, nadirlik derecelerinin ortasında yer alır. \n\nTüm &lDünya Kademeleri&r'nde düşebilir ancak en çok &lDünya Kademesi: &eYükseliş&r'te yaygındır. \n\n&9Işıltılı Kristal Parçaları&r, &c&lKurtarma Masasında&r &9Nadir&r &eEşyaları&r sökerek elde edilir."]
	quest.001C1881E9289566.quest_subtitle: "&9Nadir"
	quest.001C1881E9289566.title: "&9Işıltılı Kristal Parçası"
	quest.001DE8028CAF0A08.quest_desc: ["&5&lMekanism&r &5Makineleri&r oldukça gürültülü olabilir! \n\nHadi bunu durduralım!"]
	quest.001DE8028CAF0A08.quest_subtitle: "şşşt... çok gürültülü...."
	quest.001DE8028CAF0A08.title: "Susturucu &8Yükseltmesi"
	quest.002163B909070CF8.quest_desc: [
		"Belirli bloklar/sıvılar hakkındaki ayrıntıları duvarların arkasından bile görmenizi sağlar.\\n"
		"{image:atm:textures/questpics/pneumaticcraft/block_tracker.png width:150 height:150 align:center}"
	]
	quest.002163B909070CF8.quest_subtitle: "Maks: 1"
	quest.002B8F2DE2CB4D2C.quest_desc: ["Diğer elinde bir Kalkan, ana elinde &7Güçleniş Parşomeni&r tut ve Sağ Tık'ı basılı tut."]
	quest.002B8F2DE2CB4D2C.title: "Güçlü Kalkan"
	quest.002D65E4D7E8F62B.title: "Kademe 2 Sınıflandırma Katalizörü"
	quest.00307A898A639191.quest_desc: ["Bu Görev, AllTheMods Modpaketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk katılımcısı&r tarafından hazırlanmıştır.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu Görevin &6AllTheMods Ekibi&r tarafından yayınlanmayan hiçbir açık pakette açık izin olmadan kullanılmasına izin verilmez.\\n\\nBu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız, düzenleme modundasınız demektir."]
	quest.003AA945CACCD641.quest_subtitle: "Offering Table ile yapılır"
	quest.003AA945CACCD641.title: "Bee Of the Depths"
	quest.003FF3813A864BA1.quest_subtitle: "Bir Lava Bee'ye Tuhaf Madde Kovası yedirin"
	quest.003FF3813A864BA1.title: "Strange Matter Bee"
	quest.00453FF528AA0B1C.quest_desc: ["&7Lonestar İskelet&r'lar her yerde doğabilen düşmancıl yaratıklardır. \\n\\n10 &4Kalbi&r vardır ve saldırmak için kılıçlarını fırlatırlar. \\n\\nÖldüklerinde kemik, &7Deepsilver Nugget&r ve &7Parçalanmış Kılıç&r düşürebilirler."]
	quest.00453FF528AA0B1C.title: "&7Lonestar İskelet"
	quest.004D61425172324F.quest_desc: ["&8Zincir Zırh&r Demirden biraz daha kötüdür. &l&2Minecraft&r'daki asıl kullanım alanı, yalnızca Ticaret ve Yaratık Düşürmeleri yoluyla elde edilebildiği için nadir olmasıydı. \\n\\nElbette bu modlanmış sürüm; artık üretebiliriz! Bu da kullanım amacını ortadan kaldırıyor..."]
	quest.004D61425172324F.quest_subtitle: "12"
	quest.004D61425172324F.title: "&8Zincir Zırh"
	quest.0052E5592A6BBEC1.quest_desc: [
		"Bu &2&lMinecraft&r, sana nasıl yapı yapacağını söyleyemem..."
		"{@pagebreak}"
		"Ama sana bunun için ipuçları verebilirim!"
	]
	quest.0052E5592A6BBEC1.title: "&lYapı İpuçları!&r"
	quest.005CC8A3325FE2BD.quest_desc: ["&bFroststeel&r, &7Cloggrum&r ve &eRegalium&r kazılarak elde edilebilir. \\n&cUtheric&r ve &aForgotten&r'ı ise öldürmen gerekir. \\n\\nBaşka soru var mı?"]
	quest.005CC8A3325FE2BD.title: "&2&lUndergarden&r Metalleri"
	quest.00611844AFD5C31E.quest_desc: ["Yazıcı ve Şarj Cihazı RF/FE'yi doğal olarak kabul ederken, ME ağının büyük çoğunluğu AE adı verilen kendi özel güç sistemini kullanır.\\n\\nRF/FE, 2:1 RF:AE oranında ya doğrudan bir ME Kontrolcü aracılığıyla ya da bunun yerine ağın herhangi bir bölümüne bağlanabilen &bEnerji Kabul Edici&f aracılığıyla yerel AE'ye dönüştürülebilir."]
	quest.00611844AFD5C31E.quest_subtitle: "Fişe tak"
	quest.0072C4F028C327CB.quest_subtitle: "Magmatik Arı + Göçebe Arı"
	quest.0072C4F028C327CB.title: "BlazBee"
	quest.00764A738DA6451C.quest_desc: ["4 &dEndermite&r öldürün. \\n\\nArtık önümüze çıkan her şeyi öldürüyoruz, değil mi?"]
	quest.007A11C49E06F15F.quest_desc: ["Bunlar üretilebilir. \\n\\n&9Üretim Bileşenleri Şeması&r, en önemli &9Şemalardan&r biridir. \\n\\n&6Mühendis'in Çalışma Tezgahı&r, standart Çalışma Masalarına kıyasla küçük Mekanik Bileşenleri daha ucuza üretmenizi sağlar. \\n\\nAyrıca Ampuller ve Devreler gibi benzersiz eşyalar üretmek için de kullanılabilir!"]
	quest.007A11C49E06F15F.title: "&9Üretim Bileşenleri Şemaları"
	quest.0089A394566B0F3B.quest_desc: ["&aSıra Dışı&r, ikinci nadirlik derecesidir. \n\n&lDünya Kademesi: &9Sığınak&r'ta görünmeye başlar, en çok &lDünya Kademesi: &2Sınır&r'da bulunur ve &lDünya Kademesi: &4Zirvede&r artık düşmez. \n\n&aZamanla Aşınmış Kumaş&r, &c&lKurtarma Masasında&r &aSıra Dışı&r &eEşyaları&r sökerek elde edilir."]
	quest.0089A394566B0F3B.quest_subtitle: "&aSıra Dışı"
	quest.0089A394566B0F3B.title: "&aZamanla Aşınmış Kumaş"
	quest.008D186B4E0ED14F.quest_desc: [
		"Buharlı Fırın, buhar gücünden yararlanan özel bir fırın yapısıdır. \\n\\nİçine buhar sağlandığında yerleştirilen tüm eşyaları pişiren bir fırın görevi görür. Cevherleri külçelere dönüştürebilir ve yiyecekleri pişirebilir. \\n\\nBuharlı Fırın bloklarından oluşan 2x2x2 boyutunda bir çoklu yapıdır."
		"{image:atm:textures/questpics/railcraft/rail_oven.png width:100 height:100 align:center}"
	]
	quest.008D186B4E0ED14F.title: "Buharlı Fırın"
	quest.008E65AF545A706E.quest_desc: [
		"&5&lMekanism&r modunun en pahalı &5Makinelerinden&r biri olmasına rağmen kullanımı aslında o kadar da zor değildir! \n\nÖncelikle yapıyı inşa ettikten sonra yakıt olarak &aPolonyum&r vermemiz gerekecek. &dSPS Bağlantı Noktalarından&r birine &cTüp&r ile &aPolonyum&r pompalayın, çünkü &aPolonyumu&r &dAntimaddeye&r dönüştürmemiz gerekecek! \n\nŞarj etmek için &dSüperşarj Bobinlerimize&r güç sağlamamız gerekiyor! &dSPS Bağlantı Noktalarına&r &aKablo&r ile devasa miktarda &aEnerji&r verin, böylece bunu &dSüperşarj Bobinlerine&r aktarabilirler. \nHer bir &dSüperşarj Bobini&r sadece belli miktarda &aEnerji&r alabilir, bu yüzden optimum verimlilik için 2 adet kullanın! Evet, 1 adet de kullanabilirsiniz ama gelin görün ki bize &dAntimadde&r gelecek yıl değil bu yıl lazım! \n\n&aPolonyumu&r &myeterli miktarda&r milyonlarca FE ile bombaladıktan sonra &dAntimaddemizi&r elde edeceğiz. Bir dakika, bu &cKimyasal&r &dAntimadde&r mi?!?! İhtiyacımız olan..."
		"{@pagebreak}"
		"{image:atm:textures/questpics/mek/mek_sps1.png width:100 height:75 align:center}"
		"{image:atm:textures/questpics/mek/mek_sps2.png width:100 height:90 align:center}"
		"{image:atm:textures/questpics/mek/mek_sps3.png width:120 height:100 align:center}"
		"{image:atm:textures/questpics/mek/mek_sps4.png width:120 height:100 align:center}"
		"{image:atm:textures/questpics/mek/mek_sps5.png width:120 height:100 align:center}"
		"{image:atm:textures/questpics/mek/mek_sps6.png width:110 height:100 align:center}"
		"{image:atm:textures/questpics/mek/mek_sps7.png width:100 height:100 align:center}"
		"{@pagebreak}"
	]
	quest.008E65AF545A706E.quest_subtitle: "&d&lSPS"
	quest.008E65AF545A706E.title: "&d&lSüperkritik Faz Kaydırıcı"
	quest.0095422BC87AA135.quest_desc: [
		"Tekrar mı? Dostum, biz &7Külçe&f istiyoruz &7Yığın&f veya &7Parça&r değil! &7KÜLÇE&r! \n\n&7Cevher Parçalarını&r &bOksijen&r (muhtemelen önceki &9&lElektrolitik Ayırıcımızdan&r) ile bir &b&lArındırıcıya&r atarak &7Cevher Yığınları&r yapın. \n\nŞimdi sadece önceki Aşamanın adımlarını tekrarlıyoruz. &7Yığınları&f &4Kırarak&f &7Kirli Toz&r elde edin. \n\n&dZenginleştir&f &7Kirli Tozu&r temizlemek için. \n\nArdından, &7Tozu&f &6Eriterek&f &7Külçelerimizi&r elde edin!"
		"{image:atm:textures/questpics/mek/mek_tier3_3.png width:250 height:100 align:center}"
	]
	quest.0095422BC87AA135.quest_subtitle: "Aşama 3 Cevher İşleme"
	quest.0095422BC87AA135.title: "&7Parçadan&f, &7Yığına&f, &7Toza&f, &7Külçeye"
	quest.00A17728A387B426.quest_desc: ["Ahşap Yuvalar, Marangoz Arılarını ve Mavi Şeritli Arıyı çekmek için kullanılır.\n\nKoyu Meşe Yuvaları 3 farklı arıyı çeker.\n\nBunlar herhangi bir Overworld biyomuna yerleştirilebilir."]
	quest.00A17728A387B426.quest_subtitle: "Herhangi bir Overworld biyomuna yerleştirilebilir"
	quest.00A17728A387B426.title: "Ahşap Yuvalar"
	quest.00A6020BC979947F.quest_desc: ["Yeni çağırdığınız &9Marid Crusher&r ile bir Yankı Parçacığı ve bir Iesnium Ingot'u parçalayabilirsiniz, bunlar bir Parlayan Mürekkep Kesesi ile birleştirildiğinde Cyan Chalk oluşturur."]
	quest.00A6020BC979947F.title: "&3Cyan Chalk"
	quest.00A91BD731486644.quest_subtitle: "Ceylon Ebony + Sour Cherry"
	quest.00AC7CC291A3E590.quest_desc: ["Muhtemelen (kesinlikle) dünyanın dört bir yanında içlerinden Beacon'lar çıkıyormuş gibi görünen yapılar görmüşsündür. Kaldırım taşından yapılırlar; onları destekleyen 4 bacakları vardır ve havada epey yüksekte dururlar! \\n\\nUmarım biliyorsundur: Bunlara &8Karanlık Tapınaklar&r denir ve ihtiyacımız olan bir &aEnvironmental Accumulator&r içerirler. \\n\\nHava Durumu Container'ını doldurmak için Thunderstorm olmasını beklemen gerekecek. Ardından &3Lightning Bomb&r yapabilirsin!"]
	quest.00AC7CC291A3E590.title: "&3Lightning Bomb"
	quest.00B7DD3AFC94B037.quest_subtitle: "Beech + Alder"
	quest.00C26068B55F4FD9.quest_desc: ["Runes of Silence, spawner'a tek bir şey yapar, o da onu susturmaktır. Aptal spawner seslerini duymaktan hoşlanmıyor musunuz? O zaman bir Rune of Silence kullanın!"]
	quest.00C26068B55F4FD9.title: "Sessiz olun, mobları uyandıracaksınız!"
	quest.00C95A190BE2CBF9.quest_desc: ["&#994ABAStiren&r elde etmek için &#C2C969Demir Tozu&r, &#69C9B6Etilbenzen&r ve buhar tepkimeye sokulmalıdır. &#69C9B6Etilbenzen&r ise &#CDCF95Buharla Parçalanmış Nafta&r'nın damıtılmasıyla elde edilir."]
	quest.00C95A190BE2CBF9.title: "Gelişmiş Damıtma"
	quest.00CB8D60E7831A57.quest_desc: ["Catacombs, Depthrock Bricks'ten yapılmış devasa yeraltı yapılarıdır. Yeryüzüne fırlamış parçalarını bulabilirsiniz. \\n\\nDevasa labirentin içinde &7Forgotten'lar&r, gizli sandıklar ve zindan patronu bulunur: &aForgotten Guardian&r. \\n\\nUmarız buna hazırsınızdır!"]
	quest.00CB8D60E7831A57.title: "Catacombs"
	quest.00D7BCC68D971A53.quest_desc: ["Yakındaki canlı yaratıklar, duvarların arkasında olsalar bile otomatik olarak izlenecektir. Eğer saldırgan bir canlıysa, sizi hedef aldığında bir uyarı alırsınız."]
	quest.00D7BCC68D971A53.quest_subtitle: "Maks: 1"
	quest.00D80AA4CDD8335C.quest_desc: ["&6&lPriest&r sizin için yeterince &6Holy&r değil mi? O zaman &6Lightbringer Chestplate&r üretebilirsiniz! \n\nİlk olarak, üretebileceğiniz &6Priest Robes&r'a ihtiyacınız olacak. \n\n&bMithril&r ve Zincirlerden yapılan 3 adet &bMithril Weave&r'e ihtiyacınız olacak. \n\nArdından bir &dDivine Soulshard&r elde etmeniz gerekecek, sonrasında &6Chestplate&r'i üretebilirsiniz. \n\nBu &6Chestplate&r, &6Priest Robes&r ile aynı zırh puanına sahiptir, ancak diğer her şey çok daha iyi hale gelir! \n\nZırh Sertliği, Savurma Direnci ve tabii ki daha fazla &3Spell Power&r (Büyü Gücü) ve Mana kazanırsınız."]
	quest.00D80AA4CDD8335C.title: "&6Lightbringer Chestplate"
	quest.00DB5495C3A44999.quest_desc: ["Boşaltmak için bir envantere Shift-Sağ Tıkla."]
	quest.00DEFA26F2B896D6.quest_subtitle: "Silver Lime + Oak/Birch"
	quest.00E19377BAE5DD6A.quest_desc: ["Bu modül &dMeka-Aletimize&r &7Makas&r işlevi ekler! \n\nBu modülü &2Çiftçilik &7Modülü&r veya &5Işınlanma &7Modülü&r ile birlikte kullanamayız."]
	quest.00E19377BAE5DD6A.quest_subtitle: "Meka-Aleti"
	quest.00E19377BAE5DD6A.title: "&7Makas Modülü"
	quest.00E1F1279F97557B.quest_desc: ["Extruder MK1'e benzer ancak çok daha gelişmiştir! Desenler ile kullanıldığında blokların yerleştirilme sırasını ve düzenini kontrol etmenizi sağlar."]
	quest.00F00B0B66059996.quest_desc: [
		"Tamam, bir &lMultiblock&r daha! Bu, herhangi bir Deniz Üssünde görülenden daha fazla port gerektiriyor!\\n\\n&3Fluid Input &fve &3Output&r Hatch'lerine, ayrıca &6Item Input &fve &6Output&r Hatch'lerine ihtiyacımız olacak.\\n\\nBu işlem biraz uzun sürecek; bu yüzden dikkatlice takip et!\\n\\nÖncelikle, bir Soul Tree üzerinde &lIF&r'ye ait Sıvı Çıkarıcı kullanılarak elde edilen &7Unrefined Liquid Souls&r gerekiyor.\\n\\nArdından, yakındaki Source Jar'lardan Source çekip onu &dLiquefied Source&r'a dönüştüren bir &9Source Condenser&r kullanarak &dLiquefied Source&r elde etmeliyiz!\\n\\nSonra, Souls, &7Unrefined Liquid Souls&r ve &dLiquefied Source&r'u birleştirerek Liquid Souls elde etmek için &b&lRunic Crucible&r'ı kullanabiliriz!\\n\\nSon olarak Liquid Souls, &dLiquefied Source&r ve &l&5Mekanism&r'den bazı eşyaları kullanarak &5Obsidiansteel&r üreteceğiz."
		"{@pagebreak}"
		"{image:atm:textures/questpics/chap3/creative_crucible1.png width:125 height:100 align:center}"
		"&l&bRunic Crucible&r'ın ilk katmanında ortada bir &6Gilded Chiseled Polished Darkstone&r bulunur; çevresi &9Polished Darkstone&r ile çevrilidir. Yanlarda ters çevrilmiş &9Polished Darkstone Stairs&r, köşelerde ise &7Rune Blocks&r bulunur."
		"{image:atm:textures/questpics/chap3/creative_crucible2.png width:125 height:100 align:center}"
		"Tam ortaya bir &bArcane Crystal&r, çevresine de &9Polished Darkstone Stairs&r yerleştireceğiz. Yanlarda &6Arcane Polished Darkstone Pillars&r, Hatch'lerle değiştirilecek &9Polished Darkstone&r ve &6Arcane Polished Darkstone&r bulunacak."
		"{image:atm:textures/questpics/chap3/creative_crucible3.png width:125 height:100 align:center}"
		"Her köşeye &bArcane Crystal Blocks&r yerleştirip işi bitirin!"
		"{image:atm:textures/questpics/chap3/creative_crucible4.png width:125 height:100 align:center}"
		"Son olarak, bir blok boşluk bırakarak orta &bArcane Crystal Block&r'ın üstüne &7Quantum Injector&r yerleştirin."
		"{image:atm:textures/questpics/chap3/creative_crucible5.png width:150 height:100 align:center}"
		"{image:atm:textures/questpics/chap3/creative_crucible6.png width:150 height:100 align:center}"
		"Orta katmandaki &9Polished Darkstone blocks&r, Hatch'lerimizi yerleştireceğimiz yerdir!"
	]
	quest.00F00B0B66059996.title: "&b&lRunic Crucible"
	quest.00F2C4A528873A6B.quest_desc: ["&l&bRunic Crucible&r, çalışmak için &dSource&r'a ihtiyaç duyar. Ne yazık ki onu destekleyecek &dSource Hatch&r'larımız yok. Ancak başka bir çözümümüz var: &dSource&r'u &dSource Condenser&r kullanarak sıvıya dönüştürmek. &dSource Condenser&r'ın yanına içinde &dSource&r bulunan bir &dSource Jar&r koyduğunuzda, onu &dLiquefied Source&r'a dönüştürür. Artık &9Fluid Hatch&r'ler ile işlenebilir."]
	quest.00F2C4A528873A6B.title: "&l&dSource Yoğunlaştırma"
	quest.00FD36C207845895.quest_desc: ["Bu arıyı çekmek için End'e bir Obsidiyen Yuva yerleştirin."]
	quest.00FD36C207845895.quest_subtitle: "&9Obsidiyen Yuva Gerektirir"
	quest.00FD36C207845895.title: "Draconic Arısı"
	quest.00FDBA93722ACECE.title: "&4Amaramber Hoe"
	quest.00FF2CA7BA326007.quest_subtitle: "Mandarin + Wild Cherry"
	quest.01046CFBD7411AA6.quest_subtitle: "Kademe: &54"
	quest.0104C2E2E30B966B.quest_desc: [
		"&cBlood Chest&r yeterince hızlı çalışmıyor mu? Tamir edilmesi gereken çok fazla eşyanız mı var? Bu sorunları çözmek için bir &cColossal Blood Chest&r yapabilirsiniz.\n\nBir tane inşa etmek için 25 adet &9Reinforced Undead Planks&r üretmelisiniz. Bunlarla 3x3x3 boyutlarında içi boş bir küp oluşturup, çoklu blok yapısını tamamlamak için bir &cColossal Blood Chest&r bloğu yerleştirmelisiniz. Doğru yaptıysanız artık kullanabileceğiniz devasa bir &cBlood Chest&r yapısına sahip olacaksınız. Kimileri buna devasa diyebilir.\n\nBu yapı ayrıca &6Promises&r kullanarak onu geliştirmenize de olanak tanır.\n"
		"{image:atm:textures/questpics/evilcraft/bloodchest.png width:250 height:200 align:1}"
	]
	quest.0104C2E2E30B966B.quest_subtitle: "Dev Blood Chest"
	quest.0104C2E2E30B966B.title: "&aDevasa Tamirler"
	quest.010607466D565B53.quest_desc: ["Doğa Ana ile temasa geçmek dostum. \\n\\n&aKöklenmiş Çizmeler&r ile doğa senin en iyi dostun! Çimenlerin üzerinde durduğunda Kalplerin Yenilenir. Ayrıca Çimen üzerinde dururken Yemek yediğinde sanki Kemik Tozuyla sağ tıklanmış gibi davranacaktır."]
	quest.010607466D565B53.quest_subtitle: "Ayaklar"
	quest.010607466D565B53.title: "&aKöklenmiş Çizmeler"
	quest.0107D516E038E0DB.quest_desc: ["&eLich Kulesi&r, &eLich&r'e ev sahipliği yapar! Dövüş 3 aşamadan oluşur:\n\nAşama 1: &eLich&r etrafını kalkanlarla çevreler ve üzerinize Ghast ateş topları gibi fırlayan &5Ender İncileri&r ile saldırır. Kalkanlarını kırmak için bunları &eLich&r'e geri sektirin! Kalkanları kırıldıkça dikkatinizi dağıtmak için kopyalarını çıkaracaktır.\n\nAşama 2: &eLich&r, savaşta kendisine yardım edecek Zombiler çağırmak için asa değiştirir. Savunması düştüğünde ona yakın dövüşle saldırma fırsatı bulacaksınız!\n\nAşama 3: Asasındaki tüm yükler bittiğinde bir &eAltın Kılıç&r'a geçer ve gözü döner. Onu hızlıca öldürün!"]
	quest.0107D516E038E0DB.title: "&eÖlüleri Çıkarın"
	quest.0108F3EFDFD6DFD0.quest_desc: ["Depo Bağlantısı, bir Depo Denetleyicisine veya ona bağlı herhangi bir bloğa bağlı olmayan birden fazla depoyu bağlamana olanak tanır.\\n\\nYani her birine sağ tıklamaya gerek kalmadan “çok bloklu” bir depoyu kablosuz olarak bağlamanın bir yolu.\\n\\n14 blok menzil hâlâ geçerlidir."]
	quest.010A970FC91BD617.quest_subtitle: "Alloy Smelter'da üretilir"
	quest.010A970FC91BD617.title: "Soularium Arısı"
	quest.01119871B1D5C576.quest_desc: [
		"Neredeyse her &6Village&r (Köy) içinde &6&lPriest&r (Rahip) barındırabilir. Buna modlu &6Villages&r da dahildir. \n\nGenellikle Pazarların yanında, &6Village&r'ın ortasında takılırlar. Her &6Village&r'da bir tane bulunmaz."
		"{image:atm:textures/questpics/iron_spells/spells_village.png width:200 height:100 align:center}"
	]
	quest.01119871B1D5C576.title: "&6Village"
	quest.011B8BD02D80DDD4.quest_desc: ["Dünyada kolayca &#6E2D6ETungsten Cevheri&r bulabilirsiniz. Cevheri kırdığınızda &#A140A1Ham Tungsten&r elde edersiniz."]
	quest.011D8CADA29C9C70.quest_desc: ["&eQIO Sürücüleri&r, &e&lQIO Sürücü Dizilerinin&r depolama kapasitesini belirler. \n\nKullanılabilmeleri için &5Makinelerin&r envanterine yerleştirilirler. En fazla 12 adet yerleştirebilirsiniz. \n\n&eQIO Sürücüleri&r &eEşyaları&r tutar ve otomatik olarak sırayla ilk &eQIO Sürücüsünü&r doldururlar. \n\nHer birinin bir &eEşya Depolama&r sınırı ve &eEşya Türü&r sınırı vardır. &eQIO Sürücüsü&r ne kadar iyiyse, o kadar çok &eEşya&f ve &eEşya Türü&r elde edersiniz! \n\n&aQIO Sürücüsü&r: En temel sürücüdür, 16k Eşya ve 128 Tür kapasitesine sahiptir. Üretmek için &2&lFisyon Reaktörü&r gerektirmeyen tek sürücüdür. \n\n&cAşırı Yoğun QIO Sürücüsü&r: Ve bundan sonraki tüm sürücüler &2&lFisyon Reaktörü&r gerektirecektir. Bu sürücü 128k Eşya ve 256 Eşya Türü tutar. \n\n&bZaman Genişleten QIO Sürücüsü&r: 1.048k Eşya ve 1.024 Eşya Türü depolayabilir. \n\n&dSüper Kütleli QIO Sürücüsü&r: Üretmek için &dAntimadde&r gerektirir ama elbette en fazla depolamayı sağlar. 16 milyar Eşya ve 8.192 Eşya Türüne izin verir."]
	quest.011D8CADA29C9C70.title: "&eQIO Sürücüleri"
	quest.011F787E620DE9E8.quest_desc: ["Canavar Filtresini ayarlamak için, Canavar Filtresi ile bir daha asla görmek istemediğin veya yanlışlıkla öldürülmesini önlemek istediğin Yaratığa tıklaman yeterlidir. \\n\\nHer Filtre yalnızca 1 Yaratık tutabilir, bu nedenle Zombilerin, İskeletlerin, Örümceklerin, Creeperların ve Endermanlerin artık ortaya çıkmamasını istiyorsan 5 Canavar Filtresine ihtiyacın olacak. \\n\\nSadece, farklı bir Yaratığa tıklayarak içindeki Yaratığı değiştirebilirsin."]
	quest.011F787E620DE9E8.quest_subtitle: "O davet edilmedi!"
	quest.011FCC180FF3BD83.title: "&9Malarite Kılıcı"
	quest.012912FDAFCD1C66.quest_desc: ["&e&lCaliburn&r başlangıçta bir &bElmas Kılıç&r'dan çok daha iyi olmayacak ama bir kez yükseltildiğinde; &bElmas Kılıç&r, &e&lCaliburn&r'ün yanında normal bir Çubuk gibi kalacaktır! \\nHem &4&lMorgan&r hem de &e&lCaliburn&r'ün gerçek Hasarları ve Doğuştan Gelen Sınırları vardır. \\n\\nDoğuştan Gelen Sınır, artırılabileceği maksimum Hasardır. &e&lCaliburn&r'ün Doğuştan Gelen Sınırını artırmak için, onu &5Darbe&r ile büyüle ve ardından Nether Yıldızları ile birlikte &3Göle&r at. \\n\\nMaksimum Sınıra ulaşmak için 6 Nether Yıldızına ihtiyacın var. Bir kez yükseltildiğinde daha fazla yükseltilemez, bu yüzden 6'sını da aynı anda attığından emin ol! \\n\\nNormal Hasarı artırmak için onu &5Darbe&r ile büyülemen gerekecek, sonra tekrar &3Göle&r gidecek! Şunları yapabilmek için daha fazla hasara ihtiyacın olacak..."]
	quest.012912FDAFCD1C66.title: "&l&eCaliburn&r'ü Yükseltme"
	quest.0133DA323E24A455.quest_desc: ["Eşyaları değiştirmekten bahsetmişken (&6Radyasyon Elbisesini&r &aRadyasyon Kalkanı &7Modülü&r ile değiştirmek gibi), şimdi de &eDalgıç Takımını&r değiştirelim! \n\n&a&lMekaSuit Miğferimize&r eklenen bu &7Modül Parçası&r sayesinde &9Su Altında&r yüzebilecek ve nefes alabileceğiz! \n\nEğer &a&lMekaSuit Göğüslüğümüzde&r bir &cJetpack &7Modülü&r varsa, &9Suyun&r içindeyken ona &7Hidrojen&r besleyecektir."]
	quest.0133DA323E24A455.quest_subtitle: "Kask"
	quest.0133DA323E24A455.title: "&9Elektrolitik Solunum &7Modülü"
	quest.0145727E40D7F674.quest_subtitle: "Cempedack + Breadfruit"
	quest.01516BC726013B7C.quest_desc: ["Bu görev, AllTheMods Modpack'lerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk katılımcısı&r tarafından oluşturulmuştur.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu görevin &6AllTheMods Ekibi&r tarafından yayınlanmayan veya açık bir izin verilmeyen hiçbir halka açık pakette kullanılmasına izin verilmez.\\n\\nBu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.0152938EE5651409.quest_desc: ["Bu Görev, AllTheMods Mod Paketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk katılımcısı&r tarafından hazırlanmıştır.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisanslı olduğundan, bu Görevin açık izin alınmadan &6AllTheMods Ekibi&r tarafından yayınlanmayan hiçbir halka açık pakette kullanılmasına izin verilmez.\\n\\nBu görev bilerek gizlenmiştir, eğer bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.01612963DBBAC9A1.quest_desc: ["Umarım bu seni korumaya yeter."]
	quest.01612963DBBAC9A1.title: "Chaotic Göğüslük"
	quest.01748C2CD9C97523.quest_desc: ["&cYeniden Beliren Bloklar&r harika geçici kapı alternatifleridir. Sağ tıkladığınızda kısa bir süreliğine kaybolurlar.\\n\\n&cKaybolan Bloklar&r ise sağ tıklandığında yok olur ve geri gelmezler."]
	quest.01748C2CD9C97523.title: "&cYeniden Beliren \\& Kaybolan Bloklar"
	quest.019CA0E35F888222.quest_subtitle: "Daha Fazla Filtreleme Seçeneği"
	quest.019CA0E35F888222.title: "&eGelişmiş Stok Yenileme Yükseltmesi"
	quest.019CC48531E7759B.quest_subtitle: "Dragonsteel Forge'da üretilir"
	quest.019CC48531E7759B.title: "Ice Dragonsteel Arısı"
	quest.01A90E2541C91DB2.quest_desc: ["Çoğu &5Makine&r, en azından basit olanlar, &8Yükseltme&r kullanabilir! \n\n&8Yükseltmeler&r Arayüzün Sağ Üst köşesindedir. Bu ekran biraz kafa karıştırıcı olabilir ama endişelenmeyin açıklayacağım! \n\nİlk olarak, alt kısımda &8Desteklenen Yükseltmeler&r gösterilir. Net olan &8Yükseltmeler&r &aDesteklenenlerdir&r, şeffaf olanlar ise &4desteklenmez&r! İsimlerini ve &aDesteklenip&r desteklenmediklerini görmek için farenizle üzerlerine de gelebilirsiniz. \n\n&8Yükseltmeler&r Üst Yuvadan eklenir, ardından Sağda görünürler. Burada üzerlerine Tıklayarak Makinede kaç tane olduğunu ve Etkisini görebilirsiniz! \n\n&8Yükseltmelerimizi&r çıkarmak isterseniz, çıkarmak istediğinize Tıklayın, ardından Kaldır Düğmesine basın. Bu, &8Yükseltmeyi&r Alt Yuvaya taşıyacaktır."]
	quest.01A90E2541C91DB2.title: "&8Makine Yükseltmeleri"
	quest.01AFC11EAAB6CB3B.quest_desc: ["&eKemikli Sürüngen Zırhı&r; &eKoboleton Kemiği&r, &eAntik Metal&r ve Kask için bir &eKobolediator Kafatası&r'ndan yapılır. \\n\\nBunlar özel bir şey yapmıyor gibi görünüyor, sadece ucuz bir Zırh için çok iyi özellikler veriyorlar!"]
	quest.01AFC11EAAB6CB3B.title: "&eKemikli Sürüngen Zırhı"
	quest.01B13BBB41BBB460.quest_desc: ["&cUtherium Zırhı&r, Netherite zırhı ile aynı değerlere sahiptir! \\n\\nÜstelik bir Demirci Şablonuna ihtiyaç duymadan!"]
	quest.01B13BBB41BBB460.title: "&cUtherium&r Zırhı"
	quest.01B2DDD81065B4EF.quest_subtitle: "Jungle + Cherry"
	quest.01C0DC225CB25A0C.quest_subtitle: "Avcı eklentisi, lazerin yaratıkları hedeflemesini sağlar"
	quest.01C0DC225CB25A0C.title: "Yaratıklara Hasar Verme"
	quest.01C169A7FA424F6E.quest_subtitle: "Aşama: &a2"
	quest.01C5D8357D8B0D62.quest_desc: ["Dedektör Rayının çalışma mantığına aşinaysanız bu modül size hiç yabancı gelmeyecektir.\\n\\nÖzetle, Router'ın içinde belirli bir eşya bulunduğunda dışarıya Redstone sinyali verir.\\n\\nModül menüsünden algılanacak eşyayı, sinyalin çıkış yönünü ve sinyal gücünü ayarlayabilirsiniz."]
	quest.01CF1A9D9F29AFF7.quest_subtitle: "Pomelo + Orange"
	quest.01EC5DB1A4A25B0B.quest_desc: ["&aGeçitler&r, &aPasif Yaratıklar&r ve Ganimet Ödülleri elde etmenin kolay bir yoludur! \\n\\nTamam, belki de o kadar kolay değil. &cCanavar&r Dalgalarıyla savaşmanız gerekecek. Ayrıca yapmak için bir &aEnder Gözü&r veya &5Ender İncisi&r gerekecek. \\n\\nAma buna değer! \\n\\nFarklı &aGeçitler&r farklı Ödüller ve &cCanavarlar&r verir."]
	quest.01ECFBB5F0574C24.quest_desc: [
		"Bu Görev, AllTheMods Modpaketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk katılımcısı&r tarafından hazırlanmıştır. "
		""
		"Tüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu Görevin &6AllTheMods Ekibi&r tarafından yayınlanmayan hiçbir açık pakette açık izin olmadan kullanılmasına izin verilmez. "
		""
		"Bu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız, düzenleme modundasınız demektir."
	]
	quest.01EE2526B43B6502.quest_subtitle: "Kademe: &b3"
	quest.01F18150EC923482.quest_desc: ["&3Refined Storage&r (RS veya RS2), ağ tabanlı bir depolama sistemi sunan kapsamlı bir depolama modudur.\n\nModa başlamak için bir &3Kontrolcü&r yapmanız gerekir.\n\nKontrolcü, depolama ağınızın 'Çekirdeği'dir. Güç sağlandığında, bağlı tüm RS bileşenlerini hayata geçirir."]
	quest.01F18150EC923482.quest_subtitle: "Sürüm 2"
	quest.01F18150EC923482.title: "&3Refined Storage"
	quest.01F322AEFCC6109E.quest_desc: ["Tangled Skull'lar... şey, Tangled Skull'lardan düşer. \n\nTıpkı bir Wither'ın fırlattığı Wither Kafası gibi bir mermi olarak kullanılabilirler. \n\nAncak bunu yaptığınızda tüketilirler."]
	quest.01F3F0C25BA72BDA.quest_desc: [
		"Eşyaların ve sıvıların depolanmasının yanı sıra AE2, Compact Machines moduna benzer biçimde tüm &eyapıları&f Storage Cells içinde depolamanın yerleşik bir yolunu da sunar. "
		""
		"&bMekansal GÇ Bağlantı Noktası&f, bir &bSpatial Containment Structure&f içindeki yapıların özel tasarlanmış bir Storage Cell'e alınmasını sağlar; işlem bir Redstone signal ile etkinleştirilir. "
		""
		"Alan kaydedilirken bir yaratık veya oyuncu SCS'nin içinde durursa, onlar da alanın geri kalanının gittiği yere, yani özel bir boyuta taşınacaktır. Yakalanan kişi sen isen, geri dönmek ve içeri girmek için bir yolun olduğundan emin ol."
	]
	quest.01F3F0C25BA72BDA.title: "Mekansal GÇ"
	quest.01F51EBFEC660549.quest_subtitle: "Silver Lime + European Larch"
	quest.01F7F3589EBD8872.quest_subtitle: "Bir Shroombee'ye Kahverengi Mantar yedirin"
	quest.01F7F3589EBD8872.title: "Kahverengi Shroombee"
	quest.020E6AF37A0421C8.quest_desc: [
		"Su Tankı, dışarıda bir varil bulundurmak gibidir. Sadece bu varil çok daha büyüktür. Su toplar ve Buharlı Lokomotifler için su depolayabilir. \n\nÜrettiği su miktarı biyoma ve gökyüzünü görüp görmediğine bağlıdır. \n\nOrtası boş olacak şekilde 3x3x3 boyutunda Su Tankı bloklarından yapılır."
		"{image:atm:textures/questpics/railcraft/rail_tank.png width:100 height:100 align:center}"
	]
	quest.020E6AF37A0421C8.title: "Su Tankı"
	quest.022C38096F79EF07.quest_desc: ["&6&lForbidden \\& Arcanus&r, daha da güçlenmek için Ocak'ta ritüeller yapmak amacıyla Kadim Büyüyü kullanmakla ilgilidir! \\n\\nVeya çoğunun bildiği adıyla, Ebedi Stella. Modda bundan daha fazlası var, biliyorsun değil mi! "]
	quest.022C38096F79EF07.title: "&6&lForbidden \\& Arcanus"
	quest.02315D55EB638E3C.quest_subtitle: "Çalıştırmak için biyokütle hazırlayın"
	quest.02414CBEF2CD5A9D.title: "&7Deepsilver Kılıcı"
	quest.024BD22824C7F53A.quest_desc: ["&#F0C87DBuharla Parçalanmış Nafta&r damıtılarak &#8FD5E3Toluen&r elde edilebilir."]
	quest.0252B8F77A038D17.title: "Wyvern Otomatik Besleme Modülü"
	quest.02593CD4B4AE814C.quest_desc: [
		"&eAlchemical Sulfurs&r'ün kuluçkalanması için &bSalt&r çok önemlidir! \\n\\n&bSalt&r elde etmek için çeşitli eşyaları kireçleme fırınında pişirmemiz gerekir. Farklı eşyalar farklı &bSalt&r türleri üretir ve bu tuzlar nadirliklerine göre seviyelere ayrılır. \\n\\n&bSalt&r üretmek için eşyaları fırına koyup altına bir ısı kaynağı yerleştirin. Ardından elde ettiğiniz &bSalt&r'ı fırından alın!"
		"{image:atm:textures/questpics/theurgy/theurgy_oven.png width:100 height:100 align:center}"
	]
	quest.02593CD4B4AE814C.title: "Tuzdan Arındırma Tesisi"
	quest.02643BAD1AE747C6.quest_desc: ["&3Advanced Liquid Kompresör&r, Liquid Kompresör ile aynı şekilde çalışır, ancak çok daha iyidir!"]
	quest.026A71F98A52E3A5.quest_desc: ["Köylerde &dKurtadam&r olan &oilginç&r köylüler bulunur.\\n\\nBu yaratıkları katletmek size &dWerewolf Flesh&r kazandırır."]
	quest.026C63594F813BCC.quest_desc: [
		"&lYetenek Türü:&r Aktif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Etkinleştirildiğinde oyuncunun üzerindeki tüm olumsuz etkileri temizler. Bekleme süresi vardır."
	]
	quest.0272E58516A0C284.quest_desc: [
		"Geçerli Yükseltmeler:"
		"- Ore Miner"
		"- Ore Scanner &4&lDEVRE DIŞI&r&f"
		"- Lawnmower"
		"- Sky Sweeper"
		"- Tree Feller"
		"- Leaf Breaker"
		"- Auto Smelter"
		"- Hammer"
		"- Drops Teleporter"
	]
	quest.027E6E294D9E1375.quest_desc: ["Not al &lCorail&r! Holiday'leri işte böyle yapmalısın! (Bunu %100 sevgiyle söylüyorum, seni seviyoruz &lCorail&r!) \\n\\nBu eklenti Noel ve Cadılar Bayramı için bol miktarda süsleme ekliyor. \\n\\nNoel için Noel Ağaçları, Hediyeler ve Işıklardan Cadılar Bayramı için Kabaklar, Örümcekler ve Cadı Şapkalarına kadar."]
	quest.027E6E294D9E1375.title: "&b&lMacaw's Holidays&r"
	quest.027EF5C8A74B1596.quest_desc: [
		"&6Arıların&r ana silahı iğneleridir. \\n\\nÖyleyse neden bunu kendi silahımız olarak kullanmayalım? Bir İğneli Mızrak üretebilir, yapılarda bulabilir veya takasla elde edebilirsiniz; Üçlü Mızrak gibidir. \\n\\nSadece çok daha zayıftır ama vurduğu yaratıklara zehir verir!"
		"{image:atm:textures/questpics/bumblezone/bumble_spear.png width:100 height:150 align:center}"
	]
	quest.027FD9135DEC4949.quest_subtitle: "Nether'a yerleştirilip Ghast Gözyaşı verildiğinde Hayaletimsi Arıları çeker"
	quest.028472D7F51D439A.title: "&aFlowglaze Tırpanı"
	quest.0298A17C2AAC5765.quest_desc: ["Sırt Çantasındaki istif boyutunu 8 artırır."]
	quest.0298A17C2AAC5765.title: "&bİstif Yükseltmesi Kademe 3"
	quest.029AA03790F055E8.quest_subtitle: "Kristal Arısı + Duvarcı Arı"
	quest.029AA03790F055E8.title: "Altın Arısı"
	quest.02B0CCD5607FF3B5.quest_desc: ["Player Accessor, oyuncunun envanterine erişim sağlayan bir sandık görevi görür. Arayüzü üzerinden Player Accessor'ın farklı yüzleri, oyuncunun envanteri, sol eli veya zırh yuvalarıyla etkileşime girecek şekilde yapılandırılabilir."]
	quest.02B574B09AB45D09.quest_desc: [
		"&bFreeze&r'ler &cBlaze&r'lere benzer; uçar ve atış yaparlar. \\n\\nAncak &bFreeze&r'ler tek bir mermi fırlatır ve bu sizi yakmak yerine dondurur. \\n\\n16 &4Kalbi&r vardır ve öldüklerinde &bFrozen Tube&r düşürürler."
		"{image:atm:textures/questpics/eternal/starlight_freeze.png width:150 height:100 align:center}"
	]
	quest.02B574B09AB45D09.title: "&bFreeze"
	quest.02B5E57E9E803F78.quest_desc: [
		"Bir demir plakayı şarjlı bir mücevherle birlikte bir Binding Array üzerinde bağlarız ve metal uyanır. &cSentient Armour&r küçük başlar — büyümesi için yüz puanlık alanı vardır — ama uzun bir hafızası vardır."
		""
		"Yaptığımız her şeyi kaydeder: aldığımız darbeleri, yürüdüğümüz mesafeyi, kırdığımız blokları. Parça yavaş yavaş sıradan olmaktan çıkar ve bize ait olmaya başlar."
	]
	quest.02B5E57E9E803F78.title: "Duyarlı Kabuk"
	quest.02B8F50721F12CFF.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:"
		""
		"Oyuncunun düşme hasarı almasını engeller."
	]
	quest.02C6132919DEAF2A.quest_desc: ["&aEnerji&r üretmeye başlamadan önce Buharımızı her yere yayalım. Bunu &9Rotasyonel Kompleksi&r &9Basınç Dağıtıcılar&r ile çevreleyerek yapabiliriz! \n\nBu katmanın üzerine yeni bir katman gerekecek, bu katman tamamen &aElektromanyetik Bobinlerle&r dolu olacak. Bunlar &9Rotasyonel Kompleks&r sayesinde hareket edecek, birbirleriyle hareket etmeleri Manyetik Kuvvetleri aracılığıyla &aEnerji&r geliştiren şeydir. Aynı şey Hidroelektrik Santrallerinde de olur! \n\n&aElektromanyetik Bobinlerin&r üzerinde Buharımızı tekrar &9Suya&r dönüştürecek &9Doygunlaştırıcı Kondansatörler&r kullanabiliriz! &9Su&r, &9Türbin Havalandırmaları&r aracılığıyla dışarı çekilecektir."]
	quest.02C6132919DEAF2A.title: "Bir &9&lTürbin&r ile &aEnerji&r Üretmek"
	quest.02D45E3FB37ED0AD.quest_subtitle: "Aşama: &63"
	quest.02DEAB3F1198BFBE.quest_desc: ["&bAncient Warped Forest&r, &b&lThe Other&r içindeki başka bir Ormandır. \\n\\nAltında &cNetherrack&r bulunan &bWarped Nylium&r bir zemine sahiptir. \\n\\n&bWarped Tree&r/Mantar/her neyse yerine, &bSoul Tree&r'lere sahiptir!"]
	quest.02DEAB3F1198BFBE.title: "&bAncient Warped Forest"
	quest.02F2DF9D9DA7833A.quest_desc: ["&9Corrupt Soul&r'larımızı elde etmek için biraz &5Büyü&r yapmamız gerekecek! \n\n&5Soul Looting Büyüsü&r'nü arıyoruz. Silahlara uygulanır ve bir yaratık öldürdüğünüzde her seferinde &9Corrupt Soul&r doğurma şansı vardır. \n\nDoğan bu ruhlar daha sonra eşya olarak elde edilmek üzere öldürülebilir. Uçup gitmeyi sevdikleri için hızlıca öldürmeye çalışın! \n\nBelki de onları öldürmek istediğinizi biliyorlardır?"]
	quest.02F2DF9D9DA7833A.title: "&5Soul Looting Büyüsü"
	quest.02F3133A9006BC1E.quest_subtitle: "Demir Arısı/Kömür Arısı Çağırma Yumurtası üzerine Eriyik Çelik"
	quest.02F3133A9006BC1E.title: "Çelik Arısı"
	quest.02F4C3BEBD8427AD.quest_desc: [
		"Bana inanın, gördüğünüzde hemen tanıyacaksınız. \\n\\nKovanın tavanından sarkan onlarca bahçe... Yüzlerce farklı çiçek ve ağaç barındırıyor; hatta Eternal Starlight veya Regions Unexplored gibi diğer modların bitkileri bile var!\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_garden.png width:200 height:100 align:center}"
	]
	quest.02F4C3BEBD8427AD.title: "Asma Bahçe"
	quest.0306D25C7407FE88.quest_desc: ["&c&lFüzyon Reaktörünü&r gerçekten başlatmak için ihtiyacımız olan bir diğer parça da &6Isıdır&r! Ya &4Lazerler&r kullanabiliriz ya da içine &6Isı&r &cAktarabiliriz&r. \n\nBiz burada sadece &4Lazerleri&r kullanacağız. Daha spesifik olarak, &cLazer Odak Matriksine&r belirli miktarda ateşleme yapan &4Lazer Amplifikatörü&r. \n\n&cLazer Odak Matriksine&r ateşlenmek üzere 1 GFE değerinde &aEnerjiye&r sahip bir &4Lazer Amplifikatörüne&r ihtiyacımız olacak. Kulağa çok fazla &aEnerji&r gibi geliyor ama endişelenmeyin, onu geri alacağız! \n\n&4Lazer Amplifikatörü&r Görevini takip ederek, &4Lazer Amplifikatörüne&r &4Lazerler&r ateşlememiz gerekecek. Ancak her biri birkaç saniyede sadece yaklaşık 1 MFE verir... \n\nBir yıl beklemek yerine, &cLazer Odak Matriksini&r hedefleyen ana amplifikatöre ateş eden birden fazla &4Lazer Amplifikatörüne&r ateş eden birden fazla &4Lazer&r kullanabiliriz. \n\n&4Lazer Amplifikatörlerini&r arkalarında başka bir amplifikatör kalacak şekilde yerleştirin, bu sırada hepsinin diğer yönlerden ateş eden 4 &4Lazer&r cihazı olsun!"]
	quest.0306D25C7407FE88.title: "&cLazer Odak Matriksi"
	quest.030AC1AF8F735550.quest_desc: ["Tanka sıvı aktarmak için bir boru sistemine ihtiyacınız olacak.\\n\\nHydro Pump, suyu borulara yavaş bir hızda ama tamamen ücretsiz ve otomatik olarak aktarır!"]
	quest.030AC1AF8F735550.title: "Borular"
	quest.030DCC13171C3E16.quest_desc: [
		"Bu bölümdeki diğer görevlerin aksine, bu görev belirli bir eşyaya odaklanmıyor. Çok fazla tuş atamanız var ama klavyenizde hepsi için yeterli fiziksel tuş yok mu? Nadiren kullanılan tuşları sürekli olarak başka atamalara değiştirmekten bıktınız mı? Hangi tuşun ne yaptığını hatırlamak çok mu zor? Size Tuş Atama Paketlerini tanıtmama izin verin!\\n\\n&lPaket Oluşturma&r\\n\\nYeni bir paket oluşturmak için Ayarlar'a, ardından Kontroller'e gidin, sonra Tuş Atamaları ekranını açın ve KeyBind Bundles kategorisi altında (ilk sırada olmalı) &lAdd key bundle&r düğmesine tıklayın, ardından paketiniz için bir isim girin.\\nBunun ardından paketteki Edit (Düzenle) düğmesine tıklayın. Yeni ekranda ortadaki dairesel menünün üzerine gelin ve Add entry seçeneğine tıklayın. Bu, tuş atamaları ekranını tekrar açacaktır, ancak şimdi her tuş atamasının bir seçme düğmesi var. Buradan pakete eklemek istediğiniz atamaları seçebilirsiniz. Atamaları seçtikten sonra dairesel menüdeki her girdiyi düzenleyebilir ve ona özel bir ad ve eşya simgesi verebilirsiniz. Escape'e basarak düzenleme menüsünden çıkın ve paketi bir tuşa atayın."
		"{@pagebreak}"
		"&lPaketleri Kullanma&r\\n\\nOyundayken dairesel menüyü açmak için atadığınız tuşa basılı tutabilirsiniz. Bir girdinin üzerine gelip sol tıklayarak o tuş atamasını tetikleyebilirsiniz. Bu kadar basit!\\nAyrıca sağ tıklayarak bir tuş atamasını yer imlerine ekleyebilirsiniz. Yer imlerine eklendiğinde, pakete atanan tuşa basmak dairesel menüyü açmadan hemen o atamayı tetikleyecektir. Bir tuş yer imlerine eklendiğinde, dairesel menü, varsayılan olarak &lSol alt&r olan &lRadial menu modifier&r tuşuna basılı tutularak tekrar açılabilir. Mevcut yer imlerine eklenmiş tuş, dairesel menüde kırmızı olarak vurgulanacaktır."
	]
	quest.030DCC13171C3E16.quest_subtitle: "Tuş Atamaları İçin Dairesel Menüler"
	quest.03164C4C7813CE2B.quest_desc: [
		"Kuantum Bilgisayarı, oldukça güçlü bir üretim işlemcisidir. Kendisine tahsis edilmiş depolama alanı bulunduğu sürece sınırsız sayıda üretim işi çalıştırabilir ve bunlar arasında eş işlemci iş parçacıklarını ortaklaşa kullanabilir."
		""
		"En az 3x3x3, en fazla 7x7x7 boyutlarında bir küp yapıda olmalıdır. Alternatif olarak: Tek bir Kuantum Bilgisayar Çekirdeği, kendi başına bir Kuantum Bilgisayarı olarak çalışabilir."
		""
		"Bir Kuantum Bilgisayarı yapısı için şunlar gereklidir:"
		"- Yapının içinde boş alan bırakılamaz. Boşluklar ek bir fayda sağlamasa da Kuantum Üretim Birimi ile doldurulabilir."
		"- Tam olarak 1 adet Kuantum Bilgisayar Çekirdeği"
		"- En fazla 1 adet Kuantum Veri Dolaştırıcısı"
		"- En fazla 1 adet Kuantum Bilgisayar Çoklu İşleyicisi"
		"- Dış katmandaki tüm bloklar Kuantum Bilgisayar Yapısal Camı olmalıdır."
		"- İç kısımdaki blokların hiçbiri Kuantum Bilgisayar Yapısal Camı olamaz."
		""
		"Umarız bol miktarda Tekillik üretmeye hazırsınızdır."
	]
	quest.03164C4C7813CE2B.title: "Sonsuz Üretim İşleri: Kuantum Bilgisayarı"
	quest.03250A0202C25E80.quest_desc: ["&4Tibira's Attraction&r ile çağırdığınız &9Unbound Marid&r Demon'u başarıyla öldürdükten sonra, düşürdüğü &9Marid Essence&r'ı kullanarak \"en yüksek\" renkli Tebeşir olan Blue Chalk üretebilirsiniz."]
	quest.03250A0202C25E80.title: "&9Blue Chalk"
	quest.032B654201E71618.quest_desc: ["Bu &cRay Kitleri&r, &7Vagonlarınızda&r varlıkları (yani Mob'ları) kullanmak içindir. \n\n&cBindirme Kiti&r yakındaki Mob'ları toplayıp bir &7Vagona&r bindirir. \n&cİndirme Kiti&r Mob'ları &7Vagonlardan&r indirir. \n&cBoşaltma Kiti&r ise &7Vagonlardaki&r mob'ları üzerinde bulunduğu &6rayların&r altına düşürür."]
	quest.032B654201E71618.title: "Varlıkları Taşımak İçin &cRay Kitleri&r"
	quest.03326C2FF16F64C3.quest_desc: ["&8Troll Leather Armor&r, belirli Biyomların &8Troll&r'lerinden yapılır. Farklı Biyomlar görünüm dışında hiçbir şeyi değiştirmez. \\n\\nHer tam set, Demir ile &bElmas&r arasında, toplam 17 &7zırh puanı&r verir. \\n\\nAncak her bir &8Zırh&r daha az Mermi Hasarı alacaktır! Sanki tüm Zırhınızda Mermi Koruması varken aynı zamanda Koruma da alabiliyormuşsunuz gibi! \\n\\nArtı, bir &8Troll&r gibi görüneceksiniz!"]
	quest.03326C2FF16F64C3.title: "&8Troll Leather Armor"
	quest.0342248394E40B6A.quest_desc: ["Bu görev, AllTheMods mod paketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2topluluk katılımcısı&r tarafından hazırlanmıştır.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu görevin &6AllTheMods Ekibi&r tarafından yayınlanmayan başka hiçbir pakette izinsiz kullanılmasına izin verilmez.\\n\\nBu görev kasıtlı olarak gizlenmiştir; eğer görüyorsanız düzenleme modundasınız demektir."]
	quest.034A9FBCA6D79BB6.quest_desc: ["Hasatçı Sütununun çalışması için bir Çapaya ihtiyacı vardır. \\n\\n(Kırılamayan çapalar sonsuza kadar çalışacak, kırılabilen çapaların değiştirilmesi gerekecektir)."]
	quest.034AB493E1EC2E63.quest_desc: [
		"Birleştirici Matris Çekirdekleri; yapının kalıp kapasitesini, üretim işlerini ve hızını belirleyen ana bileşenlerdir."
		""
		"Üretim Çekirdekleri, yapının azami paralel üretim işi kapasitesini 8 artırır."
		"Kalıp Çekirdekleri, yapıya 36 kalıp yuvası ekler."
		"Hız Çekirdekleri, tıpkı Hızlandırma Kartı gibi üretim işlerinin hızını artırır. 5'ten fazla Hız Çekirdeği eklemenin üretim hızına ekstra bir katkısı yoktur."
	]
	quest.034AB493E1EC2E63.title: "Birleştirici Matris Çekirdekleri"
	quest.034DB3C64F24C7B7.quest_desc: ["&6&lAllTheOres&r cevherleri birleştirmeye yardımcı olmak için tarafımızca yapılmış bir moddur.\\n\\nBununla birlikte tonlarca çok kullanışlı dekoratif blok geliyor!\\n\\n&dFlorit&r ve &9Safir&r'in her ikisi de çok havalı görünüyor!"]
	quest.034DB3C64F24C7B7.title: "&l&6AllTheOres&r Blokları"
	quest.034F2CDF0830254B.quest_desc: [
		"Tıpkı Item Importer gibi; &eFluid Importer&r'ı sıvı içeren bir depoya yerleştirin. Ardından sıvının aktarılmasını istediğiniz yere &eFluid Interface&r koyun ve bunlara Logic Cable çekin. Son olarak da önceki gibi bir Variable Card ekleyin! \\n\\nAyrıca sıvıları tam sayı sınırına (Integer limit) kadar çekebilir. \\n\\nDünyadaki sıvı kaynak bloklarını yerleştirmez veya toplamaz, yalnızca bir depodan diğerine sıvı aktarır."
		"{image:atm:textures/questpics/logistics/id_fluid.png width:200 height:50 align:center}"
	]
	quest.034F2CDF0830254B.title: "&eSıvı İçe Aktarımı"
	quest.035495984F84FB44.quest_subtitle: "Alloy Smelter'da üretilir"
	quest.035495984F84FB44.title: "Pals Alaşımı Arısı"
	quest.03564837ECB5CC79.quest_desc: ["Elbette başka bir Ritüel, bu da &2Ihagan's Enthrallment&r. (Bu arada bir Atı feda etmek için ritüeli yaparken yakınlarda olması gerekir) \\n\\nTamamlandığında sana bir &2Dragon Familiar&r verilecek. Onu &6&lATM Star&r için kullanmak amacıyla üzerine bir Yaratık Yakalayıcı fırlatman gerekecek.\\n\\nBu seni etrafta takip edecek ve üzerinde Shift Sağ Tık kullanılarak sevilebilir."]
	quest.03564837ECB5CC79.title: "Bir Yaratık Yakalayıcı içinde &2Dragon Familiar&r"
	quest.035C52EF63AD23A7.quest_desc: ["Modun adından (&lRailcraft&r) ve etrafında döndüğü şeyden (&5Trenler&r) anlaşılabileceği gibi, &6Raylar&r oldukça önemlidir. \n\n&2Vanilla&r olanlar bunların çoğu için iş görür ama hadi ama, berbat olduklarını hepimiz biliyoruz. Gelişmiş olanların tarifleri için daha özel eşyalara ihtiyacı olacak! Onları üretin! (Bu eşyaları yapmak makineleri kullanmayı gerektirebilir, bu yüzden görevin o kısmına göz atın!)"]
	quest.035C52EF63AD23A7.title: "&6&lRaylar&r!"
	quest.036D5767E07005BC.quest_desc: ["&bDökümhane Drenajlarını&r, &7Eriyik Metalleri&r dışarı çıkarmak için kullanacağız. Evet, ne yazık ki ellerimizle veya kovalarla almak için çok sıcak. \\n\\n&c&lDökümhane Musluğunu&r &bDökümhane Drenajına&r bağlayın ve musluğa sağ tıklayarak &7Eriyik Metalleri&r dışarı akıtın. \\n\\nAyrıca, &bDökümhane Drenajına&r bakarak &c&lDökümhane&r içindeki sıvı miktarlarını da görebilirsiniz!"]
	quest.036D5767E07005BC.title: "&c&lDökümhane&r &bDrenajları"
	quest.037415D5B965E214.quest_desc: ["Bu yükseltme, Sırt Çantasının yok olmamasını sağlar."]
	quest.037488EF1F3581CE.quest_desc: ["Varsayılan olarak, bir ME ağı ME Kontrolcüsü olmadan kendi başına yalnızca 800AE'lik bir dahili arabelleğe sahiptir ve kontrolcü blok başına ekstra 8kAE ekler. Yeterince büyük ağlar için bu yetersiz olabilir ve bağlı herhangi bir cihaz için gücü telafi etmeye çalışırken bir ağın aralıklı olarak kapanmasına sebep olabilir.\\n\\n&bEnerji Hücresi&f, normal Enerji Hücresi başına 200kAE ve &bYoğun&f Enerji Hücresi başına 1.6MAE daha ekleyerek bir ME ağının önemli ölçüde daha fazla enerji tutmasına olanak tanır. Bunlar ayrıca daha fazla enerji arabelleği sağlamak için ağda herhangi bir yere yerleştirilebilir."]
	quest.037E0DAA5ECC5AB8.quest_desc: ["24 farklı yaratığa &ePolen Püskürmesi&r fırlatın. \\n\\n&6Arıları&r vurmak en eğlencelisidir!"]
	quest.037FBF06E59E1027.quest_subtitle: "Clibano'da yapılır"
	quest.037FBF06E59E1027.title: "Deorum Arısı"
	quest.03840E4C74731E0C.quest_desc: ["Dinleyin, çoğu &5&lMekanism&r Görevi için size &9Elektrikli Pompalar&r kullanmanızı söyleyip durdum. \n\nAma dürüst olmak gerekirse artık mezun olmanıza izin vermeliyim. &2&lReaktörler&r daha fazla &9Suya&r ihtiyaç duyacak, bu yüzden size &9Evyeyi&r (Sink) sunuyorum! \n\n&9Evyenin&r Sonsuz &9Suyu&r vardır ve neredeyse tüm modların &bBorularıyla&r dışarı aktarılabilir. Varsa &9&lID&r (Integrated Dynamics) kullanmanızı öneririm çünkü her Tick 2 Milyardan fazla mB &9Su&r çekebilir! \n\n&9Elektrikli Pompaları&r kullanmamın sebebi size &9Evyeler&r konusunda güvenmemem değil, şu nedenlerden dolayıdır: 1. &9Evye&r bulunmayan Mod paketleri için geçerli kalması ve 2. &5&lMekanism&r moduna ait olması. "]
	quest.03840E4C74731E0C.title: "&9Su &bSoğutucusu"
	quest.038812A14456236C.quest_desc: ["Bazı İşlemcileri, bir Enerji Hücresini ve herhangi bir Yoğun Kabloyu birleştirerek ME Kuantum Halkasını elde ederiz. \\n\\nGenellikle onu Boyutlar arası ME sistemimizi bağlamak için kullanırız ama biz sadece &6&lATM Star&r ile ilgileniyoruz!"]
	quest.03B40AB768FC0161.quest_desc: [
		"&3Shimmer River&r'lar zararsız nehirlerdir; sizi avlamaya çalışmazlar. \\n\\nBazen &bdenizleri&r birbirine bağlar ve ormanların içinden geçerler. \\n\\nİçleri &9suyla&r doludur ve dip kısımlarında bolca ganimet saklıdır!"
		"{image:atm:textures/questpics/eternal/starlight_river.png width:200 height:100 align:center}"
	]
	quest.03B40AB768FC0161.title: "&3Shimmer River"
	quest.03C40D6A5D722543.quest_desc: ["Variable Card'lar, eşya aktarımı gibi etkileşimleri başlatmak için gereklidir. Kartı aktif etmek için Importer'ın yuvalarından birine yerleştirin. \\n\\nArdından + düğmesine basarak tüm ayarları düzenleyebilirsiniz. O kart ile ne kadar eşya aktarılacağını, hangi envanter yuvasını, hangi kanalı kullanacağını —yani neredeyse her şeyi— değiştirebilirsiniz. \\n\\nEğer sizin de amacınız sadece eşya taşımaksa ve karmaşık ayarlara gerek duymuyorsanız, kartı doğrudan takıp gerekirse yalnızca aktarım sınırını belirleyebilirsiniz."]
	quest.03C54B07106091DD.quest_desc: ["&cSmelter Prism&r, &6&lATM Star&r üretiminde de gerektiği gibi bu ritüellerle yapılan en kullanışlı eşyalardan biridir! \n\nÜretmek için 4 &cBlaze Powder&r, 2 &8Kömür&r ve 1 &bBlock of Arcane Crystals&r gereklidir. Ayrıca &3Elementarium&r kalıntısını da unutmayın! \n\n&cSmelter Prism&r'ı istemenizin asıl sebebi muhtemelen &6&lATM Star&r'dır. Ancak aletlere takıldığında kırılan blokları doğrudan eritmek için de kullanılabilir: ham cevherleri külçeye, kütükleri kömüre, kumu cama çevirir. \n\nOcak yakıtı olarak da kullanabilirsiniz ama pek bir işe yaramaz. Adının daha iyi olacağını ima etmesi yüzünden bu oldukça saçma!"]
	quest.03C54B07106091DD.title: "&cSmelter Prism"
	quest.03C78165C5CBD9E1.title: "&a16k Depolama Parçası"
	quest.03DCDFB32CD4BD85.quest_desc: ["&e&lCaliburn&r birkaç şey gerektirir; bazıları görevlerde belirtildi, bazıları ise henüz belirtilmedi. \\nÖncelikle &3Mahou Gölü&r'ne ve 5000 &4Mahou&r'ya ihtiyacın var. \\n\\nDaha sonra &5Darbe&r büyüsüne sahip bir &bElmas Kılıç&r'a ihtiyacın olacak (seviye ne kadar yüksekse o kadar iyi). \\n\\nSon olarak, &bKılıç&r'ı &3Göl&r'e at, en dibinde &e&lCaliburn&r'ü bulacaksın!"]
	quest.03DCDFB32CD4BD85.title: "&e&lCaliburn"
	quest.03E05018D64DDEE1.quest_desc: ["&eKademe 5&r, esasen sadece Allthemodium Cevheri içindir. Başka bir şey için değil."]
	quest.03E05018D64DDEE1.title: "&eKırma Kademesi 5"
	quest.03E6FA4DCB71162E.quest_desc: ["&bRenk Uygulayıcı&f, kabloların dünya içinde boyanmasını sağlayan şarj edilebilir bir araçtır. Aşağı yukarı özel bir &edepolama hücresi&f olarak işlev görür ve vanilla boyaları ya da belirli renkler için &bboya topları&f ile doldurulabilir. Renkleri yıkamak ve kabloları Fluix varyantlarına geri döndürmek için &ekar topları&f ile birlikte kullanılır.\\n\\nBir kabloya renk uygulamak, tek bir şarjda toplam 3400 kablo segmenti için dahili bataryasından 100AE enerji kullanır."]
	quest.03E6FA4DCB71162E.title: "Renk Uygulayıcı"
	quest.03ED9B0DFE8B4574.quest_desc: [
		"Geçerli Yükseltmeler:"
		"- Mind Fog"
		"- Stupefy"
		""
		"Doğuştan Yetenek:"
		"- Lava Repair"
	]
	quest.041365A540BF5A03.quest_desc: ["&7Sözlük&r ortalama bir Oyuncu için pek yardımcı değildir: Maden kazmaz, blok koymaz, Üretim yapmaz, Eritmez, gerçekten hiçbir şeyle etkileşime girmez. \n\nBunun yerine Etiketleri bulmak için kullanılır! \n\nElimizde &7Sözlük&r varken bir Bloğa Sağ Tıklayabiliriz ve Bloğun Etiketleri Sohbette görünecektir. Aynı şeyi Varlıklarla da yapabiliriz. \n\nBu yeterli değil mi? Eh, &7Sözlüğümüzü&r açmak için Shift Sağ Tıklayabiliriz de! \n\nBurada Envanterimizdeki Eşyaları görebilir ve onlar için tüm farklı Etiketleri kontrol edebiliriz. Eşya, İksir, Büyü Etiketlerine kadar hiçbir şey &7Sözlükten&r saklanamaz!"]
	quest.041365A540BF5A03.title: "&7Sözlük"
	quest.041CDB45450A67E0.quest_subtitle: "Platin Arısı Çağırma Yumurtası ile Antik Arı Çağırma Yumurtası alaşımı"
	quest.041CDB45450A67E0.title: "Duratium Bee"
	quest.041D16DA96BC4253.quest_desc: [
		"&e&lTozlaşmış Sütunlar&r, &e&lTozlaşmış Alanları&r &6&lKovan Duvarları'na&r bağlayan yapılardır. \\n\\nİkisinin harika bir bileşimidir; üzeri &ePolen&r katmanlarıyla kaplı devasa dik &6Bal&r duvarları!\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_pollenpillar.png width:200 height:100 align:center}"
	]
	quest.041D16DA96BC4253.title: "&e&lTozlaşmış Sütun"
	quest.041ED280691BB05D.quest_desc: ["&9Froststeel&r, &2&lUndergarden&r'ın Soğuk Biyomlarında yaygın bir Cevherdir. "]
	quest.041ED280691BB05D.quest_subtitle: "18"
	quest.041ED280691BB05D.title: "&9Froststeel Zırhı"
	quest.0436DF3308681913.quest_desc: [
		"Tahtta geçmişte yaşamış bir &4&lKing&r'in kalıntıları yatmaktadır. Ancak yaklaşıp onlara dokunduğunuzda yeniden canlandıklarını görürsünüz; &4&lKing&r artık ölü değildir! Fakat onu hayatta tutan tek şey cinayettir... ve etraftaki en yakın canlı sizsiniz. \n\n&4&lThe Dead King&r, &lIron's Spells 'N Spellbooks&r modunun ilk Bossudur. 500 &cKalbi&r vardır ve gerçek bir Boss Çubuğuna (ve müziğe) sahiptir. Herhangi bir sınıftan çeşitli &3Spells&r (Büyüler) kullanabilir: &2Nature&r sınıfından &2Poison Arrow&r, &6Holy&r sınıfından &6Blight&r ve hatta &aEvokation&r sınıfından &aFangs&r! Ayrıca ışınlanabilir, ölüleri çağırabilir ve size &4Blood Staff&r ile vurabilir. \n\nOnu öldürebilirseniz her türden &3Scrolls&r (Parşömenler), Bone Keys ve muhtemelen &4Blood Staff&r ile Necronomicon düşürür. \n\n&9Phylactery&r kullanılarak yeniden diriltilebilir; bunun parçaları &4Catacombs&r içindeki Trial Spawner'lardan elde edilebilir."
		"{image:atm:textures/questpics/iron_spells/spells_king.png width:100 height:200 align:center}"
	]
	quest.0436DF3308681913.title: "&4&lThe Dead King"
	quest.04440BB2EFFD6DD9.quest_desc: ["Labirent Bataklığı'nın derinliklerinde devasa bir &cMinoshroom&r yaşar.\\n\\nYenildiğinde &eMeef Stroganoff&r düşürür. Bir sonraki bölgenin kilidini açmak için bunu yemeniz gerekir."]
	quest.04440BB2EFFD6DD9.title: "&cGüçlü Meef Stroganoff"
	quest.0447551EF7FB171B.quest_desc: ["Daha fazla işlemeye gerek yok, bu bir kan testi değil, sadece yakıt! \n\nSadece &4Pedestal&r'ı &c&lForge&r'a borularla bağlayın ve &4Kan&r'ın akışını izleyin!"]
	quest.0447551EF7FB171B.title: "&4Kan"
	quest.0450060852F290CA.quest_desc: [
		"&9Derin Yer Altı Toprakları&r, en çok &3Karanlık Derinlikler&r biyomuna benzer. \n\nBuralar &3Sculk&r'ın yanı sıra &3Çığırtkanlar&r ve &3Sensörler&r ile doludur; evet, bunlar hâlâ &9&lMuhafız&r çağırabilir. \n\nBurada ayrıca daha fazla &3Sculk Yaratığı&r ve Bitki, hatta &3&lOtherside'ın&r sahip olduğu tek Yapıyı bile bulacaksınız!"
		"{image:atm:textures/questpics/deepndark/dnd_land.png width:200 height:100 align:center}"
	]
	quest.0450060852F290CA.title: "&9Derin Yer Altı Toprakları"
	quest.0460DDEEFDEB0AAF.quest_desc: ["Kehanet Asaları, belirli eşyaları bulmak için ruhlarla iletişim kurmamızı sağlayan araçlardır. \n\nİlk olarak, asayla bloğa veya eşyaya Shift + Sağ Tıklayarak ya da asayı onun &eAlchemical Sulfur&r'ü ile üreterek hedefinizi seçmeniz gerekir!\n\nAsayı elinizde tutup Sağ Tıka basılı tuttuğunuzda seçilen eşyayı aramaya başlar. Bloğun veya eşyanın ne kadar yakın olduğuna bağlı olarak ses çıkarır ve asa parlar. \n\nYeterince yakınsanız size eşyaya giden yolu gösteren bir küre belirebilir."]
	quest.0460DDEEFDEB0AAF.title: "Kehanet Asaları"
	quest.0465094C2D31B898.quest_subtitle: "Demir Arısı + CreeBee"
	quest.0465094C2D31B898.title: "Uraninite Arısı"
	quest.04665EFC3A37250E.quest_desc: ["8 &7Gümüşçün&r öldürün."]
	quest.04695DA1BD3BF1B2.title: "Chaotic Hasar Modülü"
	quest.046C417B2ADF3AA7.quest_desc: ["Kartların belirli sınırları vardır. Eşya çıkarma işlemi sefer başına yalnızca 8 eşya, sıvı çıkarma ise 5 kova aktarabilir. Kimyasal ve enerjiyi siz düşünün... \\n\\nBurası modlu &2&lMinecraft&r; bu sınırlar elbette yetersiz kalacaktır. Bu yüzden kartlara hız aşırtma yapmamız gerekiyor! \\n\\nKartın sağ üst köşesine biraz Overclocker yerleştirerek aktarım limitini yükseltebilirsiniz!"]
	quest.046C417B2ADF3AA7.quest_subtitle: "Maks: 4"
	quest.0474C15D3AE3C2C9.quest_desc: ["&cDecrepit Scythe&r, &c&lEcho of Tyros&r'un sizi Öldürmek için kullandığı şeydir. Sadece bizim versiyonumuz çok daha küçüktür. \\n\\n&5Decrepit Flamberge&r'a çok benzer özelliklere sahiptir, sadece biraz, ve birazcık demek istiyorum, daha hızlı Saldırı Hızına sahiptir. \\n\\nAyrıca &6Pyrium&r ile yükseltilebilir, bu ona daha fazla hasar artı bir &3Spell&r (Büyü) verecektir! \\n\\n&cHellrazer&r'ın aldığı &3Spell &cRaise Hell&r'dir. Bu, etrafınızdaki her yöne bir &cFire&r (Ateş) Dalgası gönderecektir. Bu &cFire&r'ı yaymaz ancak yakındaki tüm yaratıklara bir ton hasar verir!"]
	quest.0474C15D3AE3C2C9.title: "&cDecrepit Scythe"
	quest.047F3F99035CE623.quest_subtitle: "Madenleri özlüyorum"
	quest.0480DF316ACF12DA.quest_subtitle: "Western Hemlock + Jungle"
	quest.0481E975F317F64D.quest_desc: ["&bIce Dragon&r'lar &bBuza&r, &cFire Dragon&r'lar &cAteşe&r ihtiyaç duyar, peki &5Lightning Dragon Egg&r neye ihtiyaç duyar? Yağmurda dışarıda bırakılmaya! \n\nBir dakika, gerçekten mi? \n\nSadece &5Lightning Dragon Egg&r'i &bGökyüzüne&r açık olacak şekilde Yere bırakın, Yağmur yağdığında yumurtadan çıkmaya başlayacaktır. \n\n6 dakikalık kesintisiz yağmurdan sonra, &5Yıldırım&r &5Yumurtaya&r çarpacak ve &5&lLightning Dragon&r yumurtadan çıkacaktır. \n\n&5Yıldırım&r bir &cAteş&r başlatabilir ve bu da &5&lYavruya&r zarar verebilir, bu yüzden buna dikkat edin!"]
	quest.0481E975F317F64D.title: "&5Yumurtanızı&r Yağmura Bırakın"
	quest.04833C4BB0CCCBB7.quest_desc: ["Taş silahlarla aynı özelliklere sahiptir; tek farkı &7Kılıç&r yaratıklara vurduğunda, &7Balta&r ise &2Ağaçları&r kestiğinde &eAmbrosium Parçaları&r düşürür."]
	quest.04833C4BB0CCCBB7.title: "&7Kutsaltaş&r Silahları"
	quest.0483D3B051665F07.quest_desc: ["&5Zanite&r kendinden önceki materyallere göre çok daha fazla kullanım alanına sahiptir. \\n\\nZanite ile aletler ve zırhlar üretebilirsiniz. \\n\\nHatta &5Doğa Asası&r ve &5&lSunak&r gibi özel eşyalar bile yapabilirsiniz."]
	quest.0483D3B051665F07.title: "&5Zanite"
	quest.0484051446480B54.quest_desc: ["Tonlarca hasar verir ve ağaçları keser! Daha ne istiyorsun?"]
	quest.0484051446480B54.title: "&6Allthemodium &5Alaşımı &3Balta"
	quest.0496E8E786262464.quest_desc: ["&2Overworld&r'ü sana gerçekten açıklamam gerekiyor mu?"]
	quest.0496E8E786262464.title: "&2Overworld&r: &m3 4&r 5 bossun diyarı"
	quest.0498A578D0EC3254.quest_desc: ["İnfüze edilmiş Eşyaların en önemlilerinden sonuncusu &aTemel Kontrol Devresidir&r. \n\nBunlar, 20mB &4Redstone&r ile bir &7Osmiyum Külçesinin&r birleştirilmesiyle yapılır. \n\n&9&lMetalurjik İnfüzere&r &4Redstone'u&r nasıl ekleyeceğinizi öğrenmek için &cİnfüze Alaşım Görevine&r göz atın!"]
	quest.0498A578D0EC3254.quest_subtitle: "Temel Kontrol Devresi"
	quest.0499A372F55D04C8.title: "Draconic Mermi Sürati Modülü"
	quest.04A1D582003A0D9A.quest_desc: [
		"Geçerli Yükseltmeler:"
		"- Run Speed"
		"- Walk Speed"
	]
	quest.04A7AA70C23830FF.quest_desc: ["Oraklar, geniş alanlardaki organik materyalleri temizlemek için kullanılan aletlerdir. Kırdığınız bloğun etrafındaki alanda yer alan blokları da topluca kırarlar."]
	quest.04B31A600004F7CB.quest_desc: ["Bu Görev, AllTheMods Modpaketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk katılımcısı&r tarafından oluşturulmuştur. \\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu Görevin &6AllTheMods Team&r tarafından yayınlanmayan hiçbir açık pakette açık izin olmadan kullanılmasına izin verilmez. \\n\\nBu görev kasıtlı olarak gizlenmiştir, bunu görüyorsan düzenleme modundasın."]
	quest.04B40BB107F14330.quest_desc: ["&4Et Öğütücü&r, &4Witherite&r'tan yapabileceğiniz bir yakın dövüş silahıdır. \n\nSol Tık veya Sağ Tık kullanılarak yapılan iki saldırısı vardır. \n\nSol tıkladığınızda &4Et Öğütücü&r'ı bir Balta gibi kullanır ve onlara iyi bir menzilden bir kez vurur. \n\nSağ tıkladığınızda Testeresiyle onları defalarca parçalayacak ve daha yakından çok daha hızlı hasar verecektir."]
	quest.04B40BB107F14330.quest_subtitle: "Doğrudan Fallout 3 DLC The Pitt'ten"
	quest.04B40BB107F14330.title: "&4Et Öğütücü"
	quest.04B6E31120663EB2.quest_subtitle: "Aşama: &a2"
	quest.04B92FAB179A74C9.quest_desc: ["&dGravitit Kılıcı&r vurduğu hedefleri havaya fırlatır. Geri tepme gibi... ama yukarı doğru! \\n\\n&dGravitit Baltası&r ise &eAltın Meşe Ağaçlarını&r kesmenin tek yoludur."]
	quest.04B92FAB179A74C9.title: "&dGravitit&r Silahları"
	quest.04BE9F63E6003475.quest_desc: ["&3LPG&r, Molten Plastik yapmak için kullanılabilir."]
	quest.04BE9F63E6003475.quest_subtitle: "İhtiyacımız olan şey"
	quest.04BE9F63E6003475.title: "LPG"
	quest.04BF68E4554D69AA.quest_desc: [
		"Sonuncu ve en güçlüsü Aşama 8! 378 Uyandırılmış Draconium Blok ve 786 Draconium Blok gerektirir! Buna değer mi?"
		"{image:atm:textures/questpics/draconic/draconic_core_8off.png width:100 height:100 align:1}"
		"{image:atm:textures/questpics/draconic/draconic_core_8on.png width:100 height:100 align:1}"
	]
	quest.04BF68E4554D69AA.quest_subtitle: "Depolama: Neredeyse Sonsuz"
	quest.04BF68E4554D69AA.title: "Aşama 8"
	quest.04D0543FE2820F64.quest_desc: ["Flax String normal İp yerine kullanılabilir."]
	quest.04D0543FE2820F64.quest_subtitle: "Örümceklere kimin ihtiyacı var ki?"
	quest.04D0543FE2820F64.title: "Flax String"
	quest.04D9F6587EF8D9B7.quest_desc: ["&9Potion Jar&r, 100 şişeye kadar iksir depolar. Boş bir iksir şişesi kullanarak iksiri kavanozdan alabilir veya doldurabilirsiniz. \\n\\nWixie'ler bu kavanozları otomatik iksir üretiminde kullanır."]
	quest.04D9F6587EF8D9B7.quest_subtitle: "İksir Depolama"
	quest.04DD3F761C210822.quest_desc: [
		"&c&lİlkel Yüksek Fırın&r, &8Çelik&r üretmenin çok basit (ve ilkel) bir yoludur. \n\nİçine bir &7Demir Külçesi&r ve &0Odun Kömürü&r veya &0Kok Kömürü&r koymanız gerekir. \n\nHer &8Çelik Külçesi&r için pişme süresi 60 saniyedir. &0Odun Kömürü&r 15 saniye sağlarken &0Kok Kömürü&r tam 60 saniye sağlar. Bunlar blok formlarıyla da katlanabilir. \n\nAyrıca Cüruf da elde ederiz... ki bu oldukça işe yaramazdır."
		"{@pagebreak}"
		"Bu da başka bir 3x3x3 yapıdır, sadece bu sefer &cYüksek Fırın Tuğlaları&r kullanılır."
		"{image:atm:textures/questpics/immersive/immersive_crude1.png width:100 height:100 align:center}"
		"{image:atm:textures/questpics/immersive/immersive_crude2.png width:100 height:100 align:center}"
		"{image:atm:textures/questpics/immersive/immersive_crude3.png width:100 height:100 align:center}"
		"Yine güvenilir &6Çekicimizle&r ön orta bloğa sağ tıklıyoruz!"
		"{image:atm:textures/questpics/immersive/immersive_crude.png width:100 height:100 align:center}"
	]
	quest.04DD3F761C210822.title: "&l&cİlkel Yüksek Fırın"
	quest.04DEC6E210F06D65.quest_subtitle: "Balsa + Cocobolo"
	quest.04F5846E2468E807.quest_desc: ["&b&lMacaw's Doors&r her türlü farklı Kapı ve Kapı çeşidini ekler. \\nHuş ağacı tasarımını Ladin ağacıyla mı istiyorsun? Buna sahip olabilirsin! \\n\\nHatta Hastane Kapıları bile var!"]
	quest.04F5846E2468E807.title: "&b&lMacaw's Doors"
	quest.05056CAA64E3971B.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Yay ile atılan okların, Potion Canister'ınızdaki iksir etkisini uygulamasını sağlar."
	]
	quest.050CCE5D1DD6B21E.quest_desc: [
		"En önemli Multiblock'lardan biri; çünkü diğer Multiblock'lar için çoğunlukla buna ihtiyacımız var. \\n\\nBurada &bFluid Input&r (her Input yalnızca bir Fluid türü tutabildiği için birden fazlası gerekir), &cEnergy Input&r ve &eItem Input&r ile Output Hatch'lerine ihtiyacın olacak. \\n\\nBu Hatch'lerle tüm &eItems&r, &bFluids&r ve &cEnergy&r girdilerini sağlayabilir; diğer &5Multiblock Controllers&r gibi eşyalarımızı üretebiliriz. \\n\\nBöylece &6Star Parts&r için gereken eşyaları da üretebiliriz! Bunlar için çok miktarda &4Blood&f, &bAureal&f, Souls ve &cEnergy&r gerekecek!"
		"{@pagebreak}"
		"{image:atm:textures/questpics/chap3/creative_forge1.png width:150 height:100 align:center}"
		"İlk katman oldukça basit: birkaç &9Polished Darkstone Blocks &fve &9Stairs&r; ayrıca &7Rune Blocks&r ve &6Arcane Polished Darkstone&r. Ah, neredeyse en önemli bloğu unutuyordum: &5Forge Block&r."
		"{image:atm:textures/questpics/chap3/creative_forge2.png width:150 height:100 align:center}"
		"Sonraki katmanda &9Blocks&f, &9Stairs&f ve &9Slabs&r biçiminde daha fazla &9Darkstone&r; ayrıca &6Gilded Arcane Polished Darkstone&r ve &6Chiseled Polished Arcane Darkstone&r olacak. Dört &bArcane Crystal Obelisks&r'i de unutma!"
		"{image:atm:textures/questpics/chap3/creative_forge3.png width:150 height:100 align:center}"
		"Bu katman çok kolay! Ortada kare biçiminde bir &9&lTier 5 &6Forge&r ve ondan iki blok uzakta sekiz &6Darkstone Pedestals&r bulunacak."
		"{image:atm:textures/questpics/chap3/creative_forge4.png width:150 height:100 align:center}"
		"Bu katmanda hiçbir şey eklenmediği için bir katmanı atlıyoruz. Aralarında bir blok boşluk bırakarak &7Quantum Injector&r'ı &9&lTier 5 &6Forge&r'un üstüne yerleştir."
		"{image:atm:textures/questpics/chap3/creative_forge5.png width:200 height:100 align:center}"
		"{image:atm:textures/questpics/chap3/creative_forge6.png width:200 height:100 align:center}"
		"Son olarak birkaç Hatch daha yerleştir! Onlara ihtiyacımız olacak!"
	]
	quest.050CCE5D1DD6B21E.title: "&c&lAutomatic Hepheastus Forge"
	quest.050CD33E92601651.quest_desc: [
		"&c&lTier 1&r sizin için yeterli değil mi? O zaman yükseltme zamanı! \\n\\n&6&lForge&r'un orta yuvasına bir Edelwood Plank koyun ve kürsülere 4 &bArcane Crystal&r ile 4 Spawner Scrap yerleştirin. \\n\\nBir Gavel ile vurduğunuzda &c&lTier 1&r ocağınız &3&lTier 2 &6Forge&r seviyesine yükselir! \\n\\nArtık yeni ritüeller açılacak, &6&lForge&r daha fazla Öz depolayabilecek ve ikinci bir Relic kullanabileceksiniz!"
		"{image:atm:textures/questpics/forbidden/forbidden_tier1.png width:100 height:100 align:center}"
	]
	quest.050CD33E92601651.title: "&l&3Tier 2 &6Forge"
	quest.050D8480EE9D8E62.quest_desc: [
		"Wigglewood Forests diğer ormanlar gibidir. \n\nSadece buradaki ağaçlar diledikleri yöne doğru büyümeyi severler."
		"{image:atm:textures/questpics/undergarden/undergarden_wiggle.png width:200 height:100 align:center}"
	]
	quest.050D8480EE9D8E62.title: "Wigglewood Forest"
	quest.05113AC92BC1B192.quest_desc: [
		"&a&lHydra&r'lar, &b&lIce &fand &cFire&r'ın sunduğu en zorlulardan bazılarıdır. \\n\\nYeşil, Turkuaz veya Kırmızı olabilirler. Hepsi kolu veya bacağı olmayan 3 Başlı Kertenkelelerdir. \\n\\n&a&lHydra&r'ların 450'den fazla &4Kalbi&r ancak yalnızca 2 &7zırh puanı&r vardır. \\n\\nEn basiti Isırma olmak üzere pek çok Saldırıları vardır. Ayrıca önlerine, &dEjderha Nefesi'ne&r benzer şekilde &aPoison Breath&r kullanabilirler. En tehlikelisi ise, diğer Saldırılarının artık &aZehir&r bulaştırmasını sağlayacak olan &aVenom&r'larını kullanmalarıdır! \\n\\nYeterince hasar verildiğinde, &a&lHydra&r'lar bir Baş kaybeder. Eğer &cAteş&r üzerinde değillerse, Baş onun yerine 2 tane daha doğuracaktır. Ne kadar çok Baş, o kadar çok hasar verebilirler... hadi bunu engelleyelim! Bu Yenilenme nedeniyle de aldıkları hemen hemen tüm Hasarı geri kazanırlar, bu yüzden kesinlikle biraz &cAteşe&r ihtiyacınız olacak! \\n\\nBu arada, 9 Başa kadar sahip olabilirler. Size &cAteş&r getirmenizi söylemiş miydim?"
		"{image:atm:textures/questpics/iceandfire/iaf_hydra.png width:200 height:100 align:center}"
	]
	quest.05113AC92BC1B192.title: "&a&lHydra"
	quest.0518551637F76C50.quest_desc: ["&9Yankılanan&r geliştirmesi için birkaç farklı eşyaya ihtiyacın olacak. \\n\\nToplaması oldukça kolay olan Mumlar ve elde etmesi kesinlikle kolay olmayan &9Yankı Parçaları&r... \\n\\nParçaları bulmanın en iyi yolu bir &6Antik Şehri&r yağmalamaktır; ancak onları çeşitli ritüellerle de üretebilirsin. \\n\\n(Hatta ileride &5Efsunlama&r ile de!) \\n\\n&9Yankılanan Derin Kitaplıklar&r, &5%15&r ekstra &5Arkana&r sağlamanın yanı sıra maksimum &aEterna&r sınırını da &a75&r'e çıkarır!"]
	quest.0518551637F76C50.title: "&9Yankılanan Derin Kitaplık"
	quest.051E0C85E7B71CE0.quest_desc: ["Madencilik yaptığını varsayıyorum, öyle değil mi? Sonuçta bu MINEcraft.\\n\\nKafanı karıştırabilecek bir sürü yeni cevher bulacaksın, ancak başlamak için vanilla malzemelere bağlı kalabilirsin!\\n\\nBakır bol miktarda bulunur ve &aCevher Çekiçleri&r veya &eÇekmece Yükseltmeleri&r gibi şeyler için bol miktarda kullanıma sahiptir, bu yüzden bol miktarda topladığından emin ol!\\n\\nDemir muhtemelen her karşılaştığında elde etmek isteyeceğin en önemli cevherlerden biridir. Modlu MC dünyası çoğunlukla Demir ile çalışır."]
	quest.051E0C85E7B71CE0.title: "&9Metal&r Çağı"
	quest.052BE1D845794702.quest_subtitle: "Teak + Acacia"
	quest.052E261F934AB439.quest_desc: ["Ayrıca patikalar da oluşturabilir!"]
	quest.052E261F934AB439.title: "Chaotic Kürek"
	quest.053483E3349B2F8A.quest_desc: [
		"Bu yapı Asma Bahçe'ye benzer, ancak burada devasa boyutta tek bir bahçe bulunur. &bMavi Işıldayan Balmumu Kanalı'ndaki&r renkten buranın &bMavi Sonsuz Mabet&r olduğunu hemen fark edeceksiniz. \\n\\nYapının içine girin ve en alt odaya giden yolu takip edin (Nöbetçi Gözcülere dikkat edin), orada &bMavi Öz&r bulacaksınız. \\n\\nİçeri girin ve nefesinizi tutmaya hazırlanın. Su altında Boğulmuşlar, Muhafızlar ve Yaşlı Muhafız ordularıyla savaşmanız gerekecek. Hepsi öldüğünde ödülünüzü alacaksınız..."
		"{image:atm:textures/questpics/bumblezone/bumble_blue1.png width:200 height:100 align:center}"
		"{image:atm:textures/questpics/bumblezone/bumble_blue2.png width:200 height:100 align:center}"
	]
	quest.053483E3349B2F8A.title: "&bMavi Sonsuz Mabet"
	quest.0539AF15A10B2859.quest_desc: ["&lCompact Makineler&r, sıkıştırılmış bir boyuta girmene olanak tanır. Bir &lCompact Machine&r yerleştirdikten sonra, Personal Shrinking Device kullanarak içine girebilirsin.\\n\\n&lCompact Machine&r boyutu tarife bağlı olarak 5x5x5'ten 45x45x45'e kadar değişir!\\n\\n&lCompact Machine&r duvarlarını kıramazsın ve Personal Shrinking Device ile Sağ Tık yaparak çıkabilirsin."]
	quest.0539AF15A10B2859.title: "&lCompact Makineler"
	quest.05422E444126FDA6.quest_subtitle: "Demir Arısı + Blaze"
	quest.05422E444126FDA6.title: "Crimson Iron Bee"
	quest.05428EA120583BD0.quest_subtitle: "Enerjilendiren Küre ile yapılır"
	quest.05428EA120583BD0.title: "Nitro Kristal Arısı"
	quest.0542FE108089A0A2.quest_desc: ["&l&6Theurgy&r, simya için Büyü kullanma sanatıdır! Ya da bizim anlamımızla, daha fazla veya farklı eşyalar üretmek için Makineleri ve Eşyaları kullanmaktır! \n\n&l&6Theurgy&r için ihtiyacımız olan makinelerin çoğu Bakır gerektirir, bu yüzden oradan başlayın!"]
	quest.0542FE108089A0A2.title: "&l&6Theurgy"
	quest.054F3A0499F8A0D8.quest_subtitle: "Sweet Chestnut + Capoazu"
	quest.055CCAE237DF3EEF.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_ironwood.png width:100 height:150 align:center}"]
	quest.055CCAE237DF3EEF.title: "&8Ironwood"
	quest.056E1E3B1ED14917.quest_subtitle: "Teak + Dark Oak"
	quest.0573B6F1BE5110FD.quest_desc: ["&2&lMinecraft&r Arıları sevimlidir ancak Balın bize sağladığı sınırlı şeyler, onu elde etmek için yapılan işi haklı çıkarmak için yeterli değildir. \\n\\nEğer Arılardan hemen hemen her şeyi elde edebiliyorsan, o zaman durum farklı olur!"]
	quest.0573B6F1BE5110FD.title: "&e&lProductive Bees&r"
	quest.0576C32B0FB360B0.quest_desc: [
		"&l&9Lunar Monstrosity&r'nin 200 &4Kalbi&r vardır ve ateş kullanmadığınız sürece darbe başına yalnızca 1 hasar alır. \n\nZemin dikenleri, fırlattığı mermiler ve patlayan Tangled kafaları gibi çeşitli saldırılara sahiptir! \n\nKatledildiğinde oklar, külçeler, Tangled Skull, &9Tenacious Petals&r, &5Tenacious Vines&r, &9Soul Dew&r ve nadir bir silah düşürme şansı vardır!"
		"{image:atm:textures/questpics/eternal/starlight_lunar.png width:100 height:125 align:center}"
	]
	quest.0576C32B0FB360B0.title: "&9&lLunar Monstrosity"
	quest.0583862ED0114442.quest_subtitle: "&f4 &cSaldırı Hasarı"
	quest.0584073A7383E0EA.quest_desc: [
		"&5Arı Kraliçesi&r görevlerinin bazıları sinir bozucu gelebilir çünkü &dEndermite&r ve &7Gümüşçün&r bulabileceğiniz pek fazla yer yoktur. \\n\\nNeyse ki son güncellemelerle bu durum değişti! Akar Kalesi'ne hoş geldiniz! \\n\\nDevasa dikenli &7taş&r yapılarda bolca &7Gümüşçün&r (özellikle &5Obsidyen&r içinde ganimetler) bulacaksınız. \\n\\nYapının ortasında, her şeyin &5mor&r renkli olduğu yerde &dEndermite'lar&r bulunur. \\n\\nBu arada &6arıların&r &dEndermite&r ve &7Gümüşçünlere&r saldırdığını biliyor muydunuz? &5Kraliçelerinin&r takdirini kazanmak için onlarla birlikte savaşa atılın!"
		"{image:atm:textures/questpics/bumblezone/bumble_mite.png width:200 height:100 align:center}"
	]
	quest.0584073A7383E0EA.title: "Akar Kalesi"
	quest.05850541675B2493.quest_desc: ["Evet, öyle. \\n\\n&6&lATM Star&r oluşturdun, bu modpaketini yendiğin anlamına gelir!\\n\\nPeki sırada ne var?"]
	quest.05850541675B2493.quest_subtitle: "Bu kazandığın anlamına mı geliyor?"
	quest.05850541675B2493.title: "&6&lATM Star"
	quest.0589911EB4D30FAD.quest_desc: ["&l&cRegions Unexplored&r ayrıca Tahtaları, Yün veya Cam gibi boyayabilmeni sağlıyor!"]
	quest.0589911EB4D30FAD.title: "Boyalı Tahtalar"
	quest.0591CAFD665CE151.quest_subtitle: "Aşama: &b4"
	quest.0596F6C70758EEC0.quest_desc: ["En pahalısı olmalarının yanı sıra en güzelleri de onlar! \\n\\nVe Yapılar için önemli olan da budur!"]
	quest.05A4496705B6C6AF.quest_desc: [
		"Beehemoth'lar, vahşi uçan atlara benzeyen özel &6arı türleridir&r. \\n\\n&6Bal Şişesi&r veya &6Bal Kovası&r verilerek evcilleştirilebilirler. \\n\\nEvcilleşme durumlarını, ne kadar hızlı gittiklerini ve ne kadar canları olduğunu belirleyen bir arkadaşlık seviyesi vardır! Onları beslemek seviyeyi yükseltirken, hasar aldıklarında seviye düşer. \\n\\nArkadaşlık seviyesi en üst düzeye ulaştığında &5Kraliçe Beehemoth&r olurlar! \\n\\nTıpkı ineklerin buğdayı takip etmesi gibi &6Bal Kovalarını&r takip ederler (üzerlerinde Arı Sütü kullanmayı da deneyin)."
		"{image:atm:textures/questpics/bumblezone/bumble_beehemoth.png width:100 height:100 align:center}"
	]
	quest.05A4496705B6C6AF.title: "Beehemoth"
	quest.05B0A7D0B991050F.title: "Reaktör (Sertleştirilmiş)"
	quest.05B5E640F1B68A28.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_golem.png width:100 height:150 align:center}"]
	quest.05B5E640F1B68A28.title: "&3Golem Steel&r"
	quest.05B6DB75AEC01187.quest_desc: ["RFTools Power modunda enerjiyi depolamak için özelleştirilebilen ve yükseltilebilen çok bloklu &9Powercell&r birimleri bulunur.\\n\\nGiriş ve çıkış modlarını ayarlamak için bir Anahtar kullanmanız gerekir."]
	quest.05B6DB75AEC01187.title: "&9RFTools Power: &cPowercell'ler"
	quest.05D8C6EF8FCD6250.quest_desc: [
		"Primogel Goo, Just Dire Things modunun ilk aşama goo maddesidir ve üretimi için temel Overworld malzemeleri gerektirir."
		""
		"Açılan Üretimler:"
		"- Ferricore"
		"- Primal Coal"
		""
		"Goo Spread Örneği:"
		""
		"{image:atm:textures/questpics/justdirethings/goo_spread_ferricore.png width:200 height:200 align:center}"
	]
	quest.05DA7F48E2A1B77F.quest_desc: ["&a&lRobit&r ile tanışın! O sizin yeni Robotik Yoldaşınız! \n\nOnu Ev olarak belirlemek için bir &aŞarj Pedinin&r üzerine koyun! &a&lRobit'in&r hareket etmek ve çalışmak için &aEnerjiye&r ihtiyacı olduğu için bu önemlidir. 40 kFE depolayabilir. \n\nArayüzünü açmak için ona Sağ Tıklayabiliriz (tabii ki izin alarak!). Ortada onun hakkında bilgiler öğreten bir Ekran göreceğiz: İsmi, &aEnerjisi&r, İşi ve Sahibi! \n\nSolda bazı Düğmelerimiz var. Yukarıdan Aşağıya sırasıyla: Eve Işınlan onu &aŞarj Pedine&r getirir, Yeniden Adlandır Mob İsmini değiştirir ve Görünüm ise kozmetik &a&lRobit&r özelleştirmeleridir! \n\n&aEnerji Yuvasının&r altında İşini ayarlamak için Düğmeler bulunur. Toplama: &a&lRobit'in&r yerdeki &eEşyaları&r toplayıp envanterine koymasını sağlar. Takip Et: &a&lRobit'in&r sizi takip etmesini veya olduğu yerde durmasını sağlar. \n\nEn sağda daha da fazla Düğme var! İlki ana &a&lRobit&r menüsünü açar. Üretim, &a&lRobit&r içinde bir Çalışma Masası açar! Envanter, &a&lRobit'in&r Envanterini açar. Burada &eEşyaları&r saklayabilir veya toplanan &eEşyaların&r nereye gideceğini görebilirsiniz. Eritme, &eEşyaları&r bir Ocak gibi eritmek için &aEnerji&r kullanır. Tamir Etme, Dayanıklılıklarını Tamir etmek için iki &eEşyayı&r birleştirmenize olanak tanır."]
	quest.05DA7F48E2A1B77F.title: "&a&lRobit"
	quest.05DBDD86FCFF3BA8.title: "&5Lightning&r Upgrade Orb"
	quest.05DE9E1CDFBC22DE.quest_desc: ["&dDağılan Boşluk Okları&r, bir Spektral Ok ve bir &dBoşluk Çenesi&r ile Üretilir. \\n\\nHerhangi bir Yay veya Arbalet ile atılabilirler. Herhangi bir Yaratığa veya Bloğa çarptıklarında parçalanırlar. \\n\\nParçalandıklarında, birçok parça etrafa saçılarak çarptıkları her şeye hasar verir!"]
	quest.05DE9E1CDFBC22DE.title: "&dDağılan Boşluk Okları"
	quest.05E668CE6687AC64.quest_desc: ["&bToken of Joy&r, üretmeniz gereken ilk Token'dır. Token'lar, &aNature's Aura&r'daki pek çok eşya için temel üretim malzemesidir."]
	quest.05E668CE6687AC64.title: "&bToken of Joy"
	quest.05F428C34DD00B61.quest_subtitle: "Blue Yonder + Rippling Willow"
	quest.05F8458AB4A6950B.quest_subtitle: "Elmas Arısına Voidshimmer Goo yedirin"
	quest.05F8458AB4A6950B.title: "Celestigem Arısı"
	quest.06044B4452A6B720.quest_desc: ["Çöl biyomuna yerleştirildiğinde Kum Yuvası, Çikolata Kıran Arıyı veya Küllü Madenci Arıyı çeker."]
	quest.06044B4452A6B720.quest_subtitle: "Çöl biyomlarında arıları çeker"
	quest.06094615950AC062.title: "Diğer Konveyör Yükseltmeleri"
	quest.060CAF1582B83918.quest_desc: [
		"&eOccupied Village&r bir zamanlar bir Çöl Köyüydü. Şimdi canavarlar tarafından ele geçirilmiş durumda. \\n\\nBurada bir &eWadjet&r, birçok &eKoboleton&r ve tuzağa düşmüş Köylüler ve Demir Golemler bulacaksınız. \\n\\nTüm Köylerde olduğu gibi evlerde Sandıklar vardır. Sadece artık daha iyi ganimeti var!"
		"{image:atm:textures/questpics/cataclysm/cataclysm_occupied_village.png width:200 height:100 align:center}"
	]
	quest.060CAF1582B83918.title: "&eİşgal Edilmiş Köy"
	quest.061A51A0EC13CA0F.quest_desc: ["Artık bir &aDökümhane Kontrolcümüz&r, &bDökümhane Drenajlarımız&r ve &4Dökümhane Tanklarımız&r olduğuna göre birkaç bloğa daha ihtiyacımız var. \\n\\nBirincisi &6Sıvı Isıtma Bobinleri&r. Bunlar &c&lDökümhanenin&r zeminini oluşturacak ve &c&lDökümhaneyi&r ısıtmak için gereklidir. \\n\\nSonuncusu ise &c&lDökümhane Camları&r veya &cAteş Tuğlaları&r. Bunları yapının geri kalanı için kullanacağız! Kelimenin tam anlamıyla yapı taşları. \\n\\n&c&lDökümhanenin&r çerçevesinin inşa edilmesine gerek yoktur, bu nedenle her köşe boş kalabilir; ancak tamamlanması için 4 duvarı ve bir zemini olmalıdır. Eğer eksik bir blok varsa &aDökümhane Kontrolcüsü&r size yerini söyleyecektir. \\n\\n&c&lDökümhane&r; içinde bir &aDökümhane Kontrolcüsü&r ve &6Sıvı Isıtma Bobinleri&r bulunduğu, diğer duvarları da dolu olduğu sürece içten 1x1 kadar küçük olabilir! \\n\\nYine de bu kadar küçük yapmanızı önermem, çünkü &c&lDökümhane&r ne kadar büyük olursa içinde o kadar fazla alan olur! \\n\\n&aDökümhane Kontrolcüsü&r bir ocak gibi aydınlandığında ve &6Sıvı Isıtma Bobinlerinin&r rengi &6turuncuya&r döndüğünde, &c&lDökümhanenin&r inşa edildiğini anlayacaksınız."]
	quest.061A51A0EC13CA0F.title: "&c&lDökümhane&r İnşası"
	quest.061C4A9E439CE09B.title: "&9Malarite Kürek"
	quest.06210B6FD0F9989B.quest_desc: ["&d&lNihai Aşama&r, &5&lMekanism&r'den elde edebileceğimiz en iyi şeydir! En azından Hayatta Kalma modunda. \n\nBunlar en fazla Yuvayı verecek, en fazla &eEşyayı&r tutacak ve en fazla &eEşyayı&r hareket ettirecek! \n\nHer &d&lNihai Aşama&r &dAtomik Alaşımlar&f, &dNihai Kontrol Devreleri&f ve &bElmaslar&r gerektirecektir. \n\n&dAtomik Alaşımların&r yapımı için &5Arıtılmış Obsidyen&r gerekir, bunları elde etmek için &7Osmiyum Sıkıştırıcı Görevini&r takip edin. Ama temelde bir &bGüçlendirilmiş Alaşımı&r 20mb &5Arıtılmış Obsidyen&r ile İnfüze etmemiz gerekecek. \n\nArdından, &dNihai Kontrol Devresini&r yapmak için 2 &dAtomik Alaşımı&r 1 &bElit Kontrol Devresi&r ile birleştirin!"]
	quest.06210B6FD0F9989B.title: "&d&lNihai Aşama"
	quest.062AA943A1629A86.quest_desc: ["&zRainbow Furnace&r'ı patlattın mı?!?! Hemen yanına TNT mi koydun? Çıldırdın mı sen? O kadar fırına ve kaynağa mal oldu, sen de öylece patlattın ha?! En azından içinden işe yarar bir şey çıktı mı? &zRainbow Coal&r mu? Çok uzun süre yanan bir kömür mü? Aslında buna değer."]
	quest.062AA943A1629A86.title: "&zRainbow Coal"
	quest.063241B72BB3403E.quest_desc: ["&0&lAğır Kaplamalı Kalkan&r tıpkı normal bir Kalkan gibi kullanılır; diğer elinizde tutun ve kendinizi savunmak için kullanın. \\n&0&lAğır Kaplamalı Kalkan&r çok daha fazla dayanıklılığa sahiptir ve daha fazla hasardan korur. \\n\\nEvet, ayrıca yükseltmeleri de var! Bu yükseltmeler &6Mühendis'in Çalışma Tezgahı&r ile eklenebilir. \\n\\nKalkan 2 yükseltme alabilir."]
	quest.063241B72BB3403E.title: "&8&lAğır Kaplamalı Kalkan"
	quest.0650996C7818ADB5.quest_desc: ["&6&lIsı Jeneratörünün&r &aEnerji&r üretmek için 2 modu vardır. \n\nPasif: &6&lJeneratörü&r &cLav Kaynağı&r veya akan bloklarla çevrelemek, &6Isı&r yaratarak pasif &aEnerji&r üretir. \n\nÜste bir &cLav Kaynak Bloğu&r yerleştirin ve yanlardan akmasına izin verin. \n\nÖnce &bBoruları&r bağladığınızdan emin olun!\n\nAktif: &0Kömür&r veya &6Odun&r gibi yanıcı malzemeleri &6&lJeneratöre&r yerleştirmek, yakıtı yakarak &cEnerji&r üretecektir. \n\nArtık 320FE/t üretiyor."]
	quest.0650996C7818ADB5.quest_subtitle: "Temel Güç Üretimi"
	quest.0650996C7818ADB5.title: "&6&lIsı Jeneratörü"
	quest.065196033249A0AA.quest_subtitle: "Demir Arısı Çağırma Yumurtası ile Ham Biyopolimer alaşımı"
	quest.065196033249A0AA.title: "Biosteel Bee"
	quest.0661E9669E639621.quest_desc: ["Bazı fidanlar tozlaştırılamaz. Bu fidanların rastgele başka bir ağaca dönüşme şansı vardır.\\n\\nÖrneğin bir &4Red Crepe Myrtle Fidanı&r elde etmek istiyorsanız, önce bir Purple Crepe Myrtle Fidanı büyütün. Bundan bir &4Red Crepe Myrtle Ağacı&r elde etme şansınız olacaktır.\\n\\nMutasyon şansı düşüktür, bu yüzden ağacı tekrar tekrar büyütmeniz gerekebilir."]
	quest.0661E9669E639621.quest_subtitle: "Kendi Kendine Mutasyon?"
	quest.066438B01655D866.quest_desc: ["&dEssence&r faydalı olsa da, bu Ruhları daha sonra kullanmak üzere yakalayabiliriz. Kulağa oldukça kötücül geliyor, değil mi?\n\nBir Ruh Avcısı olmak için önce &dVengeance Focus&r üretmeniz gerekir. Bu eşya Ruhları yerinde &aDondurmak&r için kullanılır. Ardından Ruhun yanına bir &9Box of Eternal Closure&r yerleştirdiğinizde, kutu Ruhu içine çekecektir."]
	quest.066438B01655D866.title: "&dRuhları&r Yakalamak"
	quest.066B8A75B299AED8.quest_desc: [
		"&9&lEndüstriyel Sıkıştırıcı&r, diğer &eEşyaları&r veya &bSıvıları&r elde etmek için &eEşyaları&r sıkan basit bir makinedir. \n\n&eEşyaları&r &9Girmek&r için arkadaki 2 portu kullanabiliriz. Daha sonra &eEşyaları&r dışarı &6çıkarmak&r için fıçıların sağ tarafındaki portu kullanmamız gerekecek. Onun altındaki port ise &bSıvı&r &6Çıkışı&r yapacaktır. \n\nBu makine çoğunlukla Buğday Tohumları veya Kenevir Tohumları gibi ekin tohumlarından Bitki Yağı sıkmak için kullanılır! \n\nBazı tohumlar daha fazla yağ verir, hangisinin ne verdiğini görmek için &6Rehberi&r kontrol edin. \n\nAyrıca 8 &0Kok Kömürü Tozundan&r &0HOP Grafit Tozu&r elde etmek için de &9&lEndüstriyel Sıkıştırıcıyı&r kullanmamız gerekecek."
		"{@pagebreak}"
		"&2&lEndüstriyel Fermentör&r ile kelimenin tam anlamıyla aynı başlangıç."
		"{image:atm:textures/questpics/immersive/immersive_squeezer1.png width:100 height:100 align:center}"
		"Tıpkı &2&lEndüstriyel Fermentör&r gibi, sadece Kazanlar yerine Fıçıları kullanın!"
		"{image:atm:textures/questpics/immersive/immersive_squeezer2.png width:100 height:100 align:center}"
		"&eHafif Mühendislik Bloğu&r ile &4Redstone Mühendislik Bloğu&r arasındaki fıçının üzerine bir Piston yerleştirin. Diğer 3 fıçının üzerine &8Çelik Çit&r yerleştirin!"
		"{image:atm:textures/questpics/immersive/immersive_squeezer3.png width:100 height:100 align:center}"
		"Pistonun altındaki fıçıya çok kolay bir &6Çekiçle&r Sağ Tıklama."
		"{image:atm:textures/questpics/immersive/immersive_squeezer.png width:100 height:100 align:center}"
	]
	quest.066B8A75B299AED8.title: "&9&lEndüstriyel Sıkıştırıcı"
	quest.066F78936C8F943B.quest_desc: ["Bu Görev, AllTheMods Mod Paketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk Katkıda Bulunanı&r tarafından hazırlanmıştır. \n\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r kapsamında lisanslandığından, açık izin alınmadan &6AllTheMods Ekibi&r tarafından yayınlanmamış hiçbir halka açık pakette bu Görevin kullanılmasına izin verilmez. \n\nBu görev kasıtlı olarak gizlenmiştir; bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.0672462DA3599484.quest_subtitle: "512,000mb"
	quest.06767BA0AFE8C1EE.quest_desc: ["1... 2... Bir yerlerde 4 de olacaktı. \\n\\nBir sayı değeri belirlemek için eşyayı içine koyun, ardından miktarı ayarlamak için sol veya sağ tıklayın. Miktarı 10'ar 10'ar artırıp azaltmak için Shift tuşuna basarak tıklayın. Sayıyı belirledikten sonra bu değeri bir karta atayın! \\n\\nSistem, belirlenen miktarda eşya toplanana kadar bekleyecek ve aktarıma öyle başlayacaktır. Ayrıca kaynak envanterde de daima belirlediğiniz miktarda eşya bırakacaktır."]
	quest.067AB3E4C4492F0D.quest_desc: [
		"Topladığınız cevher bloklarını tek tek elde kırmak istemiyor musunuz? Neden bu işi Router'lara devretmiyorsunuz?\\n\\nCevherleri koymak için bir Placer modülü, ardından bunları kırmak için büyülü bir Breaker modülü kullanabilirsiniz. Breaker'ın büyülü olabilmesi için üretiminde kullanılan kazmanın büyülü olması gerekir; modülün kendisi doğrudan büyülenemez.\\n\\nKırılan cevherleri toplamak içinse ikinci bir Router kullanabilirsiniz."
		"{image:atm:textures/questpics/router/router_break.png width:150 height:80 align:center}"
	]
	quest.067AB3E4C4492F0D.title: "Router ile Madencilik"
	quest.068128395837AF4F.quest_subtitle: "Buharlı olanla aynı"
	quest.068294A7C21DE550.quest_desc: ["&cRay Kitleri&r, özel &6raylar&r yapmak için &6raylarla&r birlikte tariflerde kullanılır. \n\nBu &6raylar&r, &5Trenleri&r durdurmak, &5Trenleri&r hareket ettirmek ve Redstone sinyali yaymak gibi &5Trenlerle&r ilgili her konuda faydalı olacaktır."]
	quest.068294A7C21DE550.title: "&c&lRaylar&r!"
	quest.0682DC1F2417DAEB.quest_desc: ["Functional Storage, depolamaya yardımcı olmak için çeşitli yararlı eşyalar ve aynı eşyaların istiflerini saklama yolları ekleyen bir depolama modudur.\\n\\nBu Kırık Taş, Toprak ve daha fazlası gibi eşyalar için yararlı olabilir."]
	quest.0682DC1F2417DAEB.quest_subtitle: "Storage Drawers'ın Uzak Akrabası"
	quest.0682DC1F2417DAEB.title: "Functional Storage"
	quest.0688CE330DAF8714.title: "&cStarfire Hoe"
	quest.0691BDE968724213.quest_subtitle: "Alloy Smelter'da üretilir"
	quest.0691BDE968724213.title: "Titreşen Alaşım Arısı"
	quest.06A7A3FC8634D2DA.quest_subtitle: "Aşama: &c5"
	quest.06AD25DB96F3A1CC.quest_desc: [
		"Bir termometre gibi bunlar da &cMercury&r depolar! \n\nİster &cMercury Crystals&r ister &cShards&r olsun, &cMercury&r depolar."
		"{image:atm:textures/questpics/theurgy/theurgy_vessel_1.png width:100 height:125 align:center}"
	]
	quest.06AD25DB96F3A1CC.title: "&cMercury&r Kabı"
	quest.06B352AE90DD0D3E.quest_desc: ["Bir &4Obsidiyen Arısı Çağırma Yumurtasını&r tozlaştıran bir &8BlazBee&r, onu &2Sonsuzluğun Arısı Çağırma Yumurtasına&r dönüştürür."]
	quest.06B352AE90DD0D3E.title: "Sonsuzluğun Arısı"
	quest.06B6786122F3DAF9.quest_desc: ["Arının günün hangi saatinde çalışabileceğini etkiler. Bunun 3 seviyesi vardır: &aGündüzcü&r, &dGececi&r ve &cYarı Gündüzcü Yarı Gececi&r. &aGündüzcü&r arılar yalnızca gündüzleri, &dGececi&r arılar yalnızca geceleri, &cYarı Gündüzcü Yarı Gececi&r arılar ise günün her saati çalışabilir. Bizim hedefimiz &cYarı Gündüzcü Yarı Gececi&r özelliğidir. Arı (BeeBee) doğal olarak &cYarı Gündüzcü Yarı Gececi&r özelliğine sahiptir. &a&lÜretkenlik&r görevinde belirtildiği gibi, bu arı The Other boyutunda bulunur ve oldukça ölümcüldür.\n\nBu ölümcül arıyla uğraşmak istemiyorsanız başka bir seçenek daha var. Öncelikle bazı arıları gece vakti bir çite bağlayarak &dGececi&r yapmamız, ardından bu arıları gündüz vakti de çitte bağlı tutarak &cYarı Gündüzcü Yarı Gececi&r yapmamız gerekir. Doğal olarak &dGececi&r olan Hayaletimsi Arı veya Shroombee'ler ile bu adımlardan birini atlayabiliriz."]
	quest.06B6786122F3DAF9.quest_subtitle: "Uyku zayıflara göredir"
	quest.06B6786122F3DAF9.title: "&e&lDavranış"
	quest.06B85804163DD18B.quest_desc: ["Soaryn Box (Soaryn, XyCraft'ın geliştiricisidir), modun özel depolama sandığıdır.\\n\\nBlok kırıldığında içindeki eşyaları muhafaza etmez! Acaba üzerindeki o kareler ne işe yarıyor?"]
	quest.06B9D8973E9C6A2C.quest_desc: ["Şunu merak ediyor olabilirsiniz: Neden Occultism bölümünde bir Ars Nouveau eşyası var? Çünkü iki modu birbirine bağlayan Ars Ocultas'ımız var. Özellikle Foliot Crusher'ımız gibi Spirit'ler bu kavanozların içinde çalışabilirler. Hatta Spirit'lerin etkileşime girmesi için kavanozlara eşyaları borularla gönderebilirsiniz, onlar da bunları bitişik envanterlere çıkaracaktır (kavanozun alt tarafının eşya çıkarmak için en güvenilir yer olduğunu buldum). Eğer bir envantere çıkaramazlarsa eşyaları dünyaya fırlatırlar."]
	quest.06B9D8973E9C6A2C.quest_subtitle: "Spirit'ler Containment Jar'ların içinde çalışabilir"
	quest.06B9D8973E9C6A2C.title: "Ars Ocultas: Spirit Jars"
	quest.06D13E319C26C949.quest_desc: [
		"Blood Mushroom Bog, devasa kan mantarlarına (Blood Mushrooms) ev sahipliği yapar. \n\nKan görmek içimi bulandırıyor, o yüzden bu açıklamayı kısa tutacağım sanırım."
		"{image:atm:textures/questpics/undergarden/undergarden_blood.png width:200 height:100 align:center}"
	]
	quest.06D13E319C26C949.title: "Blood Mushroom Bog"
	quest.06D3EC025557855F.title: "&7Deepsilver Axe"
	quest.06EA86F9F6C9DECF.quest_subtitle: "Plum + Peach"
	quest.06EAA74E0A10CBB6.quest_subtitle: "Menzil: &b36&r blok"
	quest.06EAA74E0A10CBB6.title: "&9Imperium Büyüme Hızlandırıcısı"
	quest.06ECF443FBCC12FC.quest_desc: ["&eDeath Worm&r'ları öldürerek bir &eDeath Worm Egg&r elde edip onları evcilleştirebiliriz. &eYumurtayı&r bir Tavuk Yumurtası gibi fırlatmanız yeterlidir, bir &eTamed Death Worm&r (Evcilleştirilmiş Ölüm Solucanı) doğuracaktır. \n&eTamed Death Worm&r'lar normal evcil hayvanlar gibi davranmazlar, sizi takip etmez veya korumazlar... peki ne yaparlar? \n\nBirincisi, zamanla büyüyerek daha fazla &4Kalp&r ve boyut kazanırlar! \n\nAyrıca doğdukları yerden itibaren belirli bir alanda dolaşırlar. Bu alan içinde size veya Pasif Yaratıklara saldırmazlar, ancak Düşman olanlara saldırırlar! \n\nEvcilleştirilmemiş olsalar bile, her iki elimize bir Olta alarak &eDeath Worm&r'lara binebiliriz! \n\nOnlara Atlar gibi binebiliriz ama aynı zamanda (G) tuşuna basarak onlarla kullanabileceğimiz bir Saldırı elde ederiz. Bu Saldırı, &eGiant Death Worm&r'ların kullandığı saldırıyla aynıdır!"]
	quest.06ECF443FBCC12FC.title: "&eDeath Worm&r Sörfü!"
	quest.06F2C42E6408149E.quest_desc: [
		"Umarım bunu &c&lPyromancer&r'dan çalmamışsındır, o iyi olan!"
		"{image:atm:textures/questpics/iron_spells/spells_outfit_pyromancer.png width:50 height:100 align:center}"
	]
	quest.06F2C42E6408149E.title: "&cPyromancer Outfit"
	quest.06F70F6CA37168CC.quest_desc: ["&6&oHouse Fabergé Cevher Kutusu&r, gelişmiş bir &5Cevher Kutusu&r sürümüdür. \\n\\nÇok daha yüksek miktarda &aCevher&r depolayabilir.\\n\\nStandart &5Cevher Kutusu&r toplam 32.768 adet tutabilirken, &6&oHouse Fabergé Cevher Kutusu&r her bir farklı &aCevher&r türünden 2,1 milyara kadar saklayabilir! \\n\\nBunu elde etmek için standart &5Cevher Kutusu&r'nu &d&lİnfüze&r etmen gerekecek. \\n\\nGerekli dizilim: 4 &9Ruh Dokunuşlu Sculk Kitaplığı&f, 4 &9Yankılanan Sculk Kitaplığı&f, 2 &dEjderhamsı End Kitaplığı&f, 7 &7Taş Kitaplığı&r ve 1 &7Temel Kitaplık&r."]
	quest.06F70F6CA37168CC.quest_subtitle: "Gustav Fabergé gurur duyardı"
	quest.06F70F6CA37168CC.title: "&6&oHouse Fabergé Cevher Kutusu"
	quest.06F84E2C484FAC5B.quest_desc: ["Hiç kırıktaş jeneratörü duydunuz mu? Materyal Taş İşleme Fabrikası da buna benzer çalışır ama işi bir üst seviyeye taşır. Taşı kırarak çakıl, kum veya silikona dönüştürmesini, eritip tekrar taşa çevirmesini, obsidyen yapmasını ve JEI'de gösterilen diğer tüm işlemleri gerçekleştirmesini sağlayabilirsiniz."]
	quest.06F8EDF7513F8611.title: "&dEpic&r Ink"
	quest.06FFBB12CFA87815.quest_desc: ["Farklı &2Vanilla&r Biyomlarında bulunan &2Vanilla &lMinecraft&r Kütükleri! \\n\\nBundan daha fazlasını açıklamama gerek yok!"]
	quest.06FFBB12CFA87815.title: "&2Vanilla&r Kütükleri"
	quest.07084582F9562740.quest_desc: ["&5&lMekanism&r, sadece Renklendirme için yapılmış birkaç &5Makineye&r sahip! \n\nKullanmamız gereken 3 &5Makine&r var ve evet, sırasıyla! \n\n&c&lPigment Çıkarıcı&r, &cB&eo&ay&banmış&r Blokların Rengini çıkaracak ve bir Pigment yapacaktır! Pigmentler &cKimyasallardır&r ve tıpkı diğer &cKimyasallar&r gibi kullanılır: &cTüplerden&f geçirilir ve &cKimyasal Tanklarında&r tutulur. \n\n&e&lPigment Karıştırıcı&r 2 Pigmenti alıp yeni bir Renk Pigmentinde birleştirecektir. Bu, &5&lMekanism&r &eEşyaları&r için yapılmış bazı yeni Renkleri bile yapabilir! \n\n&b&lBoyama Makinesi&r bu Pigmentleri alıp &cB&eo&ay&banabilen&r Bloklara ve Eşyalara uygulayarak onları &cB&eo&ay&bayacaktır&r. Bu zaten &cB&eo&ay&banmış&r olan Eşyalarda bile işe yarar, bunu &2&lVanilla&r'da yapamazsınız!"]
	quest.07084582F9562740.title: "&cB&eo&ay&balar&r ve Pigmentler"
	quest.070CAEAD49B8DBA3.quest_desc: ["8 İstif &7Compressed Iron Block&r ve bir &6&lATM Yıldızı&r karşılığında &5Yaratıcı &7Compressed Iron Block&r elde edebilirsin! \\n\\nBu, ayarlanmasını istediğin herhangi bir sıcaklığa ayarlanabilir ve Makinelerinde kullanılabilir. \\n\\n8 İstif &7Compressed Iron Block&r, 4,608 &7Compressed Iron Ingot&r'a eşittir... iyi şanslar!"]
	quest.070CAEAD49B8DBA3.title: "&5&lYaratıcı &7Compressed Iron Bloklar"
	quest.070F8045CC14B50D.title: "Draconic Mermi Delme Modülü"
	quest.0720474D384F4774.quest_desc: ["&eMarimold&r su altında yetişen mantarlardır. \\n\\nBüyük ve küçük türleri bulunur. \\n\\nBlokları &6Bal&r ve &eMantar Işığı (Shroomlight)&r karışımı bir görünüme sahiptir."]
	quest.0720474D384F4774.title: "&eMarimold"
	quest.072FBEB0F6F1BC48.quest_desc: ["Çekmeceleri, Denetleyiciye bağlamak ve Ender Çekmeceleri bağlamak için kullanılır.\\n\\nÇekmeceleri, Denetleyiciye bağlamak için, yapılandırmayı başlatmak üzere Denetleyici bloğuna sağ tıkla. Çekmecelere sağ tıklamak onları ağa ekleyecektir.\\n\\nAleti tutmak, Denetleyiciye hangi Çekmecelerin bağlı olduğunu gösterecektir."]
	quest.073BA8470EA37A00.quest_desc: [
		"Sıradan bir deniz daha, tek farkı çok daha soğuk olması."
		"{image:atm:textures/questpics/undergarden/undergarden_icy.png width:200 height:100 align:center}"
	]
	quest.073BA8470EA37A00.title: "Icy Sea"
	quest.073D0D41BA5F219B.quest_desc: ["&cNether&r'ın cehennem gibi, kafir topraklarının derinliklerinde zamanlama gerektiren bir &6relic&r yatıyor... &cMisilleme Kalkanı&r. \\n\\nSaldırılara karşı koruma sağlamak için bir makine tarafından dövüldü, ancak bir bedeli var. Fırsat penceresi geçerse bu bedel savunmasız kalmaktır. \\n\\n- &l1 yeteneği var:&r \\n\\n &4Misilleme&r: \\n Kullanıldığında, &6relic&r'e gelen bir sonraki hasar örneğini kısa bir süreliğine engellersin. Pencere sırasında hasarı engelleyememek seni bir süreliğine daha savunmasız bırakır.\\n\\n- Kullanıcıyı tam doğru zamanda koruyan, hassas zamanlamaya sahip bir &6relic&r."]
	quest.073D0D41BA5F219B.quest_subtitle: "+ SAVUŞTURMA"
	quest.073D0D41BA5F219B.title: "&cMisilleme Kalkanı"
	quest.0741FABE57CA1A7D.quest_desc: ["&9Hippocamtus&r'lar, &9Acropolis&r'i koruyan güçlü Denizatı savaşçılarıdır. \n\nÇok fazla Zırh giyerler ve bir Mızrak ve Kalkan tutarlar. \n\n85 &4Kalbi&r ve 18 zırh puanı vardır. \n\nKalkanları Hasardan koruyacak ve Mızrakları sizi Öldürmek için kullanılacaktır. Size savurabilir, saplayabilir ve hatta üzerinizde özel bir hareket yapabilirler. Bu hareket sizi &9Hippocamtus&r'un defalarca saplayacağı bir yere kilitleyecektir. \n\n&9Cindaria&r gibi, me de &9Lacrima&r düşürecektir."]
	quest.0741FABE57CA1A7D.title: "&9Hippocamtus"
	quest.074EC1E636CD6605.quest_desc: ["&cNetherit Zırhı&r, &l&2Vanilla&r'da elde edebileceğin en iyisidir. &bElmas&r ile aynı Zırh Puanlarına sahiptir ancak daha fazla Zırh Sertliğine sahiptir. \\n\\nMuhtemelen onu yapmak için &bElmas&r'a ihtiyacın olduğu içindir!"]
	quest.074EC1E636CD6605.quest_subtitle: "20"
	quest.074EC1E636CD6605.title: "&cNetherit Zırhı"
	quest.07564DBB023EE2A6.quest_subtitle: "Aşama: &b4"
	quest.0759CA52EECF3B49.quest_desc: ["&6Mekanik Saban&r önünde ne varsa sürer geçer! En azından hareket ettirebildiği tüm blokları. \\n\\nMeşale, Düğme ve Sarmaşık gibi zayıf bağlı bloklar &6Saban&r üzerlerine geldiğinde anında kırılır. \\n\\nToprak veya Çimen üzerinde kullanıldığında tarla toprağı oluşturur! Dev çiftlikler kurmak için birebirdir! \\n\\nAyrıca &6Sabanı&r yaratıkları zarar vermeden itmek için de kullanabilirsiniz. Saban onları doğrudan öldürmez ancak itildikleri engeller veya tehlikeler öldürebilir."]
	quest.0759CA52EECF3B49.title: "&6Mekanik Saban"
	quest.07655CA904354E9E.quest_desc: [
		"&lYetenek Türü:&r Aktif"
		""
		"&lYetenek İşlevi:"
		""
		"Etkinleştirildiğinde yakındaki çim kütlelerini ve çiçekleri biçer."
	]
	quest.076A648E3E3245C9.quest_desc: ["Yakıttan enerji üretme hızı çok yüksektir ve bu da onu oldukça verimli kılar. Tek sorunu artık yükseltilemiyor oluşudur. Yine de normal Ocak Yakıtı kullanır."]
	quest.076A648E3E3245C9.title: "&aEmerald Generator"
	quest.07751E1BE48C6024.quest_subtitle: "Aşama: &b4"
	quest.07753C5D94312A50.quest_desc: [
		"&3Augment&r: Generator, &3Augment&r: Factory'nin tam tersidir. Eritmek için enerji kullanmak yerine, enerji üretmek için eritir. Artık eşya eritmeyecek, kullanılan her yakıtı enerjiye dönüştürecektir!"
		""
		"(Sadece birinde yakıt kullanmak yerine bir Generator ve Factory Furnace'ı birbirine bağlamanın daha iyi olup olmadığını merak ediyorum.)"
	]
	quest.07753C5D94312A50.title: "&3Augment&r: Generator"
	quest.077A214422FEFF02.quest_subtitle: "&f6.5 &cSaldırı Hasarı"
	quest.077B2D62FA7650FB.quest_subtitle: "Menzil: &627&r blok"
	quest.077B2D62FA7650FB.title: "&cTertium Büyüme Hızlandırıcısı"
	quest.078B69E9362A5496.quest_desc: ["Evet, &5&lMekanism&r işte bu kadar büyük! \n\n&2&lReaktörlerinizi&r ve Yenilmez Zırhınızı istiyorsanız doğru yerdesiniz! \n\nÖncelikle bir &2&lFisyon Reaktörüne&r ihtiyacımız olacak ve bunun için &2Bölünebilir Yakıt&r gerekiyor. &2Bölünebilir Yakıt&r yapmak için biraz &cKükürt Trioksit&r gerekecek. \n\n&eKükürt Dioksit&r yapmak için &eKükürdü&r bir &c&lKimyasal &eOksitleyiciye&r koyarak başlayın. \n\nArdından &9Suyu&r bir &9&lElektrolitik Ayırıcıdan&r geçirerek &bOksijen&r üretin. \n\nŞimdi &cKükürt Trioksitimizi&r yapmak için bu &bOksijeni&r ve &eKükürt Dioksiti&r bir &c&lKimyasal Karıştırıcıya&r &cTüple&r aktarabiliriz."]
	quest.078B69E9362A5496.title: "&5&lMekanism: Reaktörler"
	quest.078C5B50CDC174CB.quest_desc: ["&aMekanik Rulmanlar&r, hareketli düzeneklerin en temel parçasıdır. \\n\\nAlt kısımlarından &dDönme Gücü&r uygulandığında, üstlerindeki tüm blokları aynı hız ve yönde döndürürler. \\n\\nDoğrudan üzerindeki blok &aMekanik Rulmana&r kendiliğinden bağlanır; ancak diğer blokların da birlikte hareket edebilmesi için o bloğa &aYapıştırılması&r gerekir! \\n\\nBir &aMekanik Rulmanı&r başka bir hareketli mekanizmanın üzerinde kullanırsanız, bloğu döndürmek yerine sabit bir açıda tutmaya çalışır."]
	quest.078C5B50CDC174CB.title: "&aMekanik Rulman"
	quest.0790D3BB481162A6.quest_desc: [
		"Taşınabilir bir Çalışma Masasına mı ihtiyacın var? Taşınabilir bir Demirci Masasına ne dersin? "
		""
		"&l&8Çubukta Üretim&r en sevdiğin üretim istasyonlarından bazılarının taşınabilir versiyonlarını ekliyor! Bu, oyunun başlarında sahip olunması gereken bir şey."
	]
	quest.0790D3BB481162A6.quest_subtitle: "Daha Az Yerleştirme, Daha Fazla Üretim"
	quest.0790D3BB481162A6.title: "Üretim... Çubukta!"
	quest.079A415488A32076.quest_desc: ["Blaze Ember, Just Dire Things ile eklenen yeni bir malzemedir. Primal Coal bloklarının üzerinde ikinci aşama veya daha yüksek goo maddesiyle Goo Spread gerçekleştirilerek elde edilir. Blaze Ember cevheri Servet büyüsünden etkilenir."]
	quest.07AF1D5C24B069DD.quest_desc: ["&0Cockatrice Specter&r, &0Cockatrice Eyes&r ve &0Wither&r parçalarından yapılır. Bekle başka bir Göz mü? Neden Göz topluyoruz? \\n\\n&0Specter&r ile (bazı) Yaratıklara 2 Saniyeliğine &0Solma&r III verebiliriz. \\n\\nYaklaşık 20 Blokluk bir menzile sahiptir ve bir Bekleme Süresi vardır."]
	quest.07AF1D5C24B069DD.title: "&8Cockatrice Specter"
	quest.07BEB974DF1E5AD3.quest_desc: ["&aEmerald Generator&r ile aynı oranda enerji üretir ancak aktarım hızı çok daha yüksektir. Ayrıca daha az eşya gerektirdiği için tartışmasız daha ucuzdur; ama o eşya da &5Netherite&r, yani..."]
	quest.07BEB974DF1E5AD3.title: "&5Netherite Generator"
	quest.07BEE6FEC14765DC.quest_desc: ["Kil, Demir, Balçık Topu ve daha fazlasını gerektiren oldukça basit bir tarif... \\n\\nLodestone'ları ganimet sandıklarında aramak en iyisidir. &c&lNether&r'daki sandıklarda bolca bulunur, bu yüzden üretmek yerine bulmaya çalışın! \\n\\nBalmumu, Bal Şişesi ve Balçık Topu karışımıyla yapılan, &6&lForbidden \\& Arcanus&r'a özgü yeni bir eşyadır. \\n\\nHuniler ve borularla uyumlu çalışan &7Magnetized Pedestal&r'lar elde etmek için bunu bir &6Darkstone Pedestal&r üzerinde kullanabilirsiniz. \\n\\nEşyaların envanterinize çekilme menzilini artırmak için çizmelerinizle de birleştirebilirsiniz!"]
	quest.07CC809B6482AB09.quest_subtitle: "Aşama: &a2"
	quest.07E5B0BF7D8E055A.quest_subtitle: "+%30 Kaçınma Şansı"
	quest.07FDA46D83F8360D.quest_desc: ["4 &6Allthemodium Parçası&r ve bir Ender İncisi karşılığında Işınlanma Pedi elde edersin. \\n\\nFarklı bir boyuta ışınlanmak için Minecraft boyutlarından birine yerleştir. \\n\\nIşınlanmak için ana ve diğer elin boşken Shift+Sağ tıklaman gerekir! Bu önemli, lütfen oku! \\n\\nHER İKİ ELİN DE BOŞ OLMASI GEREKİYOR!"]
	quest.07FDA46D83F8360D.title: "Işınlanma Pedi"
	quest.0813CEDCC201216A.quest_subtitle: "Kapok + Old Fustic"
	quest.0817FD6E45C127E8.quest_desc: ["Teknik olarak bu adım isteğe bağlıdır ancak şiddetle önerilir! Enerji Çekirdeği'ne daha fazla OP aktarmak ve dışarı çekmek için birden fazla Sütun kullanabilirsiniz."]
	quest.0817FD6E45C127E8.title: "Daha Fazla Sütun (İsteğe Bağlı)"
	quest.081DC030A0546549.quest_desc: ["&2Biyoyakıt&r, bazı &2Bitkileri&r &4Kırarak&r yapılır! Hepsi farklı miktarlarda veren her türlü farklı &2Bitki&r! \n\n&6Balkabağı Turtası&r en çok &2Biyoyakıtı&r verir ancak &aKarpuz Dilimleri&r en verimli olanıdır. \n\n&2Biyoyakıt&r birçok farklı şekilde kullanılabilir! Bir &2&lBiyo-Jeneratöre&r &aGüç&r verebiliriz, Eşyaları &2Kimyasal Biyoyakıt&r ile &9&lİnfüze&r edebiliriz veya..."]
	quest.081DC030A0546549.title: "&2Biyoyakıt&f elde etmek için &2Bitkileri&f &4Kırmak"
	quest.08245411AFDB63DB.quest_desc: ["Bu Görev, &6AllTheMods&r ekibi veya AllTheMods mod paketlerinde kullanılmak üzere bir &2topluluk katılımcısı&r tarafından hazırlanmıştır.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu Görevin açık izin olmaksızın &6AllTheMods Ekibi&r tarafından yayınlanmayan herhangi bir herkese açık pakette kullanılmasına izin verilmez.\\n\\nBu görev bilerek gizlenmiştir, eğer bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.0830195863384CF0.quest_desc: ["&bStrata Salt&r; taş, kum veya obsidyen gibi temel bloklardan pişirilen en başlangıç seviye tuzdur. \\n\\n5 adet &bStrata Salt&r birleştirerek &bMineral Salt&r elde edebilirsiniz."]
	quest.0830195863384CF0.title: "&bStrata Salt"
	quest.083ABBA1C45FF960.quest_subtitle: "Sadece bir Çim Biçme Makinesi"
	quest.083D458032F0325C.quest_desc: ["&bME Dışa Aktarma Veriyolu&f, beyaz liste filtresindeki eşyaları periyodik olarak veriyolunun baktığı harici depolama alanına gönderir. İçe Aktarma Veriyolu aksine, Dışa Aktarma Veriyolu filtrelenmeden çalışamaz."]
	quest.083D458032F0325C.quest_subtitle: "Ç (Çıkış)"
	quest.08457BEED799E600.quest_desc: ["Bu yeni &7Vagonlar&r çoğunlukla &6Ray&r döşemek içindir.\n\n&7Ray Yerleştirici&r &6Rayları&r yerleştirirken &7Ray Sökücü&r &6Rayları&r söker.\n\n&7Ray Değiştirici&r &6Rayları&r farklı olanlarla değiştirir ve &7Ray Altı Kazıcı&r ise &6Rayların&r altındaki blokları değiştirir."]
	quest.08457BEED799E600.title: "&7Vagonlar&r ve &6Raylar&r"
	quest.0848056FDD3F9BDA.quest_desc: ["Bir &9Tekillik&r, teorik olarak en yüksek yoğunluk noktasıdır. Bilim insanları yaşadığımız Evrenin bir zamanlar bir &9Tekillik&r olduğuna inanıyor. Evrenimizdeki her molekül, bir kum tanesinden daha küçük tek bir noktadaydı. \\n\\nElbette &l&bAE2&r'nin teorik bilimler çizgisinde ilerlemesiyle kendi &9Tekillik&r'leri de var. \\n\\nBunu Üretmenin 2 yolu var ancak her ikisi de çok sayıda Eşyayı tek bir noktada yoğunlaştırmayı gerektiriyor!"]
	quest.0848056FDD3F9BDA.title: "&9Tekillik"
	quest.0850F88E2205623F.quest_desc: ["&3Sculk Dalları&r, &bBükük Sarmaşıklar&r gibidir... sadece &3Sculk'ımsı&r. \n\n&9Derin Yer Altı Toprakları&r biyomunda nadiren oluşurlar."]
	quest.0850F88E2205623F.title: "&3Sculk Dalları"
	quest.0853917693A259C2.quest_desc: ["&3Yok Edici&r, &3Cursium&r ve Kara Çelik'ten yapılmış çok eğlenceli bir silahtır. \n\nBununla bütün gün düşmanları tokatlayabilirsiniz! Ama bir &3Yok Edici&r'dan daha eğlenceli ne var biliyor musun? \n\nİki &3Yok Edici&r! \n\nEğer her iki elinizde de bir &3Yok Edici&r varsa, etrafınızdaki herkese hasar veren güçlü bir yere çarpma hareketi yapmak için Sağ Tıklaması basılı tutabilirsiniz!"]
	quest.0853917693A259C2.title: "&3Yok Edici"
	quest.0854589F28AAA8D0.title: "&dStarlit Elmas Hoe"
	quest.0854AD352218E1C3.quest_desc: ["O kadar güce sahip olup da makineleri sürekli manuel ısıtmaktan bıktınız mı? \\n\\nCaloric Flux Emitter ile bu sorunu çözebilirsiniz! Cihazı makineye bağlamak için önce makineye Shift + sağ tıklayın. Ardından yere yerleştirip enerji vererek ısı aktarımını başlatın. \\n\\nAynı anda yalnızca tek bir makineye bağlanabilir!"]
	quest.0854AD352218E1C3.quest_subtitle: "Nasıl?"
	quest.0854AD352218E1C3.title: "Kablosuz Isı"
	quest.08697EB269B011FD.quest_desc: [
		"&dRonaza's Contact&r ile, &bIesnium Ritual Bowl&r'unuzu Eldritch Chalice'a yükseltebilirsiniz. Bir ritüelde kullanıldığında, tamamlanması için geçen süreyi... tamamen sıfırlar. "
		""
		"Evet, Eldritch Chalice tüm ritüellerin anında tamamlanmasını sağlar!"
	]
	quest.08697EB269B011FD.title: "Eldritch Chalice"
	quest.08767A1E6D48A5EA.quest_desc: ["&7Graybeard Staff&r çok ucuz bir Asadır. Fiyat ve kalite bakımından ucuzdur. \\n\\nSadece 3 &4Damage&r verir ancak %25 Mana Yenilenmesi ve %10 &3Spell Power&r (Büyü Gücü) verir. \\n\\nÖldürmek için sadece &3Spells&r kullanıyorsanız oldukça yardımcı olur!"]
	quest.08767A1E6D48A5EA.quest_subtitle: "Ne zaman Whitebeard (Ak Sakal) olacak?"
	quest.08767A1E6D48A5EA.title: "&7Graybeard Staff"
	quest.08788F976B5C3281.quest_desc: ["&6Kutsal Kılıç&r, üzerinde Darbe büyüsü bulunan bir &bElmas Kılıca&r benzer. \\n\\nDarbe büyüsü ölümsüz yaratıklara ekstra hasar verir; &6Kutsal Kılıç&r da aynı şekilde işler. \\n\\nEn güzel yanı ise hasarını daha da artırmak için üzerine tekrar Darbe büyüsü ekleyebilmenizdir!"]
	quest.08788F976B5C3281.title: "&6Kutsal Kılıç"
	quest.087F6C09CB5B2D1A.quest_desc: ["&bAkıllı Akışkan Boruları&r, boru hatlarınızda detaylı filtreleme yapmanızı sağlar. \\n\\nSıvının çekildiği noktaya yerleştirildiğinde yalnızca belirlenen tek bir &bSıvıyı&r çekecek şekilde ayarlanabilir. Bu filtreleme, filtre yuvasına o sıvı ile dolu bir kova koyarak yapılır. \\n\\n&bAkıllı Akışkan Borusunu&r sistemin devamına yerleştirerek sonrasındaki borulardan sadece seçtiğiniz sıvının geçmesine izin verebilirsiniz. \\n\\nBu sayede karışık Akışkan Tanklarını ve hatlarını kolayca ayrıştırabilirsiniz!"]
	quest.087F6C09CB5B2D1A.title: "&bAkıllı Akışkan Borusu"
	quest.088CA7B6D4899846.quest_desc: ["&#65C2A6Paketleyici&r; &#53E67BÇift Külçe&r, &#53E67BBıçak&r ve &#53E67BKablo&r üretmek için kullanılır. Makinenin farklı işlevleri de bulunsa da temel olarak bu parçaların üretiminde kullanacaksınız."]
	quest.088FCB5267CB7A89.quest_desc: ["Bu kemer, kısa süreliğine rastgele olumlu iksir etkileri sağlar. Etkilerin gücü değişkenlik gösterebilir."]
	quest.0893EFCAC7031FEA.quest_desc: ["Süt ve yumurtaların hazırsa, pasta yapma zamanı."]
	quest.0893EFCAC7031FEA.quest_subtitle: "Hem Pastan Dursun Hem Karnın Doysun"
	quest.0894EB1F3FCFCECA.quest_desc: ["&3Draugr&r'lar &5Deepling&r'lere benzer çünkü onların da rütbeleri vardır. &3Draugr&r rütbeleri şunlardır: &3Draugr&r, &3Asil Draugr&r ve &3Elit Draugr&r. \n\nNormal &3Draugr&r'lar 14 &4Kalbe&r sahiptir ve Kara Çelik Kılıçlar ve Baltalar taşırlar. Bunlar Çürük Et, Kemikler ve nadiren Kara Çelik Parçaları düşürür. \n\nSırada &3Asil Draugr&r var. Bunların 15 &4Kalbi&r vardır ve Kılıç ile Baltaların yanı sıra Kara Çelik Kalkanlar taşırlar. Normal &3Draugr&r'larla aynı Eşyaları düşürürler. \n\nSonuncusu &3Elit Draugr&r. Bunlar, onlardan ne kadar uzakta olduğunuza bağlı olarak Kara Çelik Kılıçlar ve Arbaletler arasında geçiş yaparlar. 16 &4Kalbi&r vardır ve elbette aynı ganimeti düşürürler!"]
	quest.0894EB1F3FCFCECA.title: "&3Draugr'lar"
	quest.089B1B9837AF4938.title: "&5Unobtainium Aletleri"
	quest.08A3292277D2FDE2.quest_subtitle: "Enchanting Apparatus ile yapılır"
	quest.08A3292277D2FDE2.title: "Water Essence Bee"
	quest.08AC2D81A1004984.title: "&6Allthemodium &5Alaşımı &3Üçlü Mızrak"
	quest.08B60D8A25008CCC.quest_desc: ["Bu Görev, &6AllTheMods&r ekibi veya AllTheMods mod paketlerinde kullanılmak üzere bir &2topluluk katılımcısı&r tarafından hazırlanmıştır. \\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu Görevin açık izin olmaksızın &6AllTheMods Ekibi&r tarafından yayınlanmayan herhangi bir herkese açık pakette kullanılmasına izin verilmez. \\n\\nBu görev bilerek gizlenmiştir, eğer bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.08C66BCA3AAE765B.quest_desc: ["Bu &2&lMinecraft&r'ta Olmayan Bloklar ekler, bu yüzden tartışmamayı tercih ederim."]
	quest.08C66BCA3AAE765B.title: "&b&lMacaw's Roofs"
	quest.08C6B7D2DAE87222.quest_subtitle: "Oak + Birch"
	quest.08C870DC50CA49FC.quest_desc: [
		"&#5C5C5CHam Petrol&r tek başına pek kullanışlı değildir; fakat bir damıtma tesisinden geçirildiğinde, pek çok farklı alanda kullanılabilecek ürünler elde edilir."
		""
		"Böylece &#C4C241Sülfürik Ağır Yakıt&r, &#CECC5FSülfürik Hafif Yakıt&r ve &#D9D782Sülfürik Nafta&r üretebilirsiniz."
	]
	quest.08C870DC50CA49FC.title: "&#5C5C5CHam Petrol İşleme"
	quest.08CE14FFED813992.quest_subtitle: "13 Islak Koyu Pembe blok"
	quest.08D1CC753F6B4283.quest_desc: ["Yaşlı Gardiyan, Muhafız'dan önce Minecraft için üçüncü Patron olarak kabul edildi, ancak ben onu bir Mini Patron olarak görüyorum. \\n\\nYaşlı Gardiyanlar, Okyanus Anıtlarında ortaya çıkar. Üç tanesi orada ortaya çıkar ve yakındaki herkese Madenci Yorgunluğu verir. \\n\\nOkyanus Anıtı'nın hazinelerini istiyorsan, Gardiyan'ları bulup öldürmen gerekecek! (İpucu: Ben her zaman en üstteki Odada 1 tane, en soldaki Odada 1 tane ve en sağdaki Odada 1 tane buldum!) \\n\\n80 kalpleri var ve normal Gardiyanlar gibi saldırıyorlar, Lazerler ve Dikenler! \\n\\nÖldüklerinde şunları düşürecekler: Süngerler, Prizmarin ve yemeklerini..."]
	quest.08D1CC753F6B4283.title: "Bir Yaşlı Gardiyan Öldür"
	quest.08D9C809CF4062E8.quest_desc: ["Onları çiğ yiyin, kızartın, şişe geçirin. \\n\\nUnderbean'lerle yapamayacağınız şey yok!"]
	quest.08DB91D079C5B715.quest_subtitle: "Red Maple + Mahogany"
	quest.08DDE018A804BFE7.quest_desc: ["&d&lZenginleştirme Odası&r, içinden geçen &eEşyaları&r &dZenginleştirecektir&r. Sadece &eEşyaları&r &4Kırmızı Yuvalara&r yerleştirin ve &dZenginleştirilmiş Eşyalar&r &9Mavi Yuvalardan&r çıkacaktır. \n\n&dZenginleştirilmiş eşya&r nedir? Veya bir &eeşya&r &dZenginleştirildiğinde&r ne olur? Ya ondan yapılabilecek &eEşyalardan&r daha fazlasını elde ederiz ya da &eEşyanın&r kendisini değiştiririz! \n\n1 Cevherden 2 Toz elde edebiliriz. 1 Çiçekten daha fazla Boya elde edebiliriz. Hatta &6Bakır&r Aşamalarını değiştirebilir veya &7Kırık Taşın&r üzerinden &2Yosunu&r alabiliriz! \n\nDaha sonraki &d&lZenginleştirme Odası&r Aşamalarında, aynı anda daha fazla &eEşyayı&r &dZenginleştirmek&f için daha fazla Yuvaya sahip oluyoruz. \n\nAyrıca Otomatik Sıralama (Auto-Sort) yeteneği de kazanıyoruz. Bu Düğmeye basarak! Bunu, &eeşya&r Yığınlarının her yuvaya eşit olarak dağıtılacağı şekilde ayarlayabiliriz, böylece &d&lMakine&r daha Verimli olur."]
	quest.08DDE018A804BFE7.quest_subtitle: "Ham Cevherleri Tozlara Ayırır"
	quest.08DDE018A804BFE7.title: "&d&lZenginleştirme Odası"
	quest.08E47A27EFFB7C6B.quest_subtitle: "5 Kuru Pembe blok"
	quest.08E484DD3E751697.quest_subtitle: "Gökkuşağının Mavisi"
	quest.08E484DD3E751697.title: "&bMavi Xychorium Taşları"
	quest.08E4892F96828EC4.quest_desc: [
		"&c&lGüneş Ruhu&r'na doğrudan vuramazsınız. Savaşı başlatmak için önce onunla konuşmak adına sağ tıklamanız gerekir. \\n\\nBunu birkaç kez daha yapın... sonra biraz daha... sonra bir düzine daha yapın; yeterince sinirlendiğinde savaşı başlatacaktır! \\n\\n&c&lGüneş Ruhu&r odanın etrafında dolanarak geçtiği her yere &cAteş&r yayar. \\n\\nAyrıca &cAteş Kristalleri&r ve &bBuz Kristalleri&r fırlatır. Hasar verebilmek için &bBuz Kristallerine&r vurup onu donduracak şekilde üzerine fırlatmalısınız! Donduğunda nihayet ona vurabilirsiniz. \\n\\nDondurulduğunda kendisine yardım etmeleri için &cAteş Minyonlarını&r da çağıracaktır. \\n\\nSöndürüldüğünde düşüreceği şey..."
		"{image:atm:textures/questpics/aether/aether_gold2.png width:200 height:100 align:center}"
	]
	quest.08E4892F96828EC4.title: "&c&lGüneş Ruhu"
	quest.0903F0D8642449B7.quest_desc: ["&6Analog devreleri geride bırakarak&r artık 2 bitten daha fazla bilgi işleyebiliyoruz. Bu da yeni makineler için ufuklar açıyor."]
	quest.090B564935D7A8F5.quest_desc: ["&5Makinelerinizi&r Yükseltmek için onları kırmaktan hoşlanmıyor musunuz? Neden sadece bir &eeşya&r kullanmıyorsunuz! \n\n&7Aşama&r Yükleyicileri ile &5Makineyi&r Yükseltmek için Eşyayı &5Makinenin&r üzerinde kullanmanız yeterli! \n\nOnları &a&lBasit Aşamaya&r yükseltmek için Varsayılan bir &5Makinenin&r üzerine &a&lBasit Aşama Yükleyiciyi&r kullanın. \n\nHayır, yükseltmeleri atlayamazsınız. Bir &a&lBasit&r makineyi tek bir &dYükleyici&r ile &d&lNihai&r makineye dönüştüremezsiniz."]
	quest.090B564935D7A8F5.title: "&lAşama&r Yükleyicileri"
	quest.0910C28A609ECBC1.quest_desc: ["&6Bal Pusulası&r, &6&lThe Bumblezone&r tarafından eklenen çok kullanışlı bir alettir. \n\nBir tane üretebilir veya takas edebilirsiniz. \n\nBelirli bir kovanı (&lProductive Bees'in Gelişmiş Arı Kovanları&r dahil) takip etmek için kovana Shift + Sağ Tık yapabilir veya Hücre Labirenti'nin yerini bulmak için havaya Sağ Tıklayabilirsiniz."]
	quest.0910C28A609ECBC1.title: "&6Bal Pusulası"
	quest.091957223C32B094.quest_desc: ["Bu aşamada &aMaks Eterna&r sınırını tekrar artırman gerekecek. &e&lYükseliş&r &lDünya Kademesi&r ile bu sınır &a60&r seviyesine yükselir."]
	quest.091957223C32B094.quest_subtitle: "Maks Eterna: 60"
	quest.091957223C32B094.title: "60'a &e&lYükseliş&r"
	quest.09223F02621781BF.quest_subtitle: "Demir Arısı + Duvarcı Arı"
	quest.09223F02621781BF.title: "Gümüş Arısı"
	quest.0923C941A9696122.quest_desc: ["Yanında bir Maceraya 256 Milyon eşya getirmen gerekmesi ihtimaline karşı! \\n\\n&8MEGA Item Cell Housing&r, &5ME Sandığı&r ve bir &5Yoğun Enerji Hücresi&r gibi birkaç basit Eşyaya ihtiyacın olacak. \\n\\nVe sonrasında &d256M MEGA Storage Component&r'e ihtiyacımız olacak... bunu yapmak çok daha zor. \\n\\nEğer tekrarlayan Üretim seni &2&lMinecraft&r'dan nefret ettiriyorsa, o zaman &2Blastproof Casing&r Üretmek isteyebilirsin! \\n\\n&3&lImprobable Probability Device&r Üretmek için 2 adet 256M Portable Item Cells, 2 adet &2Blastproof Casings&r veya her ikisinin karışımına ihtiyacımız olacak."]
	quest.0923C941A9696122.title: "256M Portable Item Cell"
	quest.09282E3864752CEE.quest_subtitle: "Aşama: &63"
	quest.092A23FDA5D50812.quest_subtitle: "Aşama: &a2"
	quest.092BB595F75D5536.quest_desc: ["&6&lForbidden \\& Arcanus&r'a Hoş Geldiniz! \\n\\nBu moda başlamak için derin yeraltında madencilik yapmamız gerekecek. \\n\\nY=1 ve daha alt seviyeler gibi..."]
	quest.092BB595F75D5536.title: "&6&lForbidden \\& Arcanus"
	quest.0945EC53626F58E6.quest_desc: ["Eşyalar ve sıvıların yanı sıra &3Refined Storage&r, Refined Storage - Mekanism Integration modu sayesinde &aKimyasalları&r depolamak için de kullanılabilir.\n\nAyrıca Refined Types modu sayesinde &4Enerji&r, &5Kaynaklar&r ve &9Ruhlar&r da depolayabilirsiniz."]
	quest.0945EC53626F58E6.title: "&5Diğer Depolama Parçaları"
	quest.0947B4ED95B0267E.quest_desc: ["Eşyaları ve aletleri kaplar.\\n\\nNetherit, harika bir kaplama malzemesidir."]
	quest.0947B4ED95B0267E.quest_subtitle: "Kesinlikle sadece Netherit için değil"
	quest.09485B63483B7A15.quest_desc: [
		"&lYetenek Türü:&r Aktif"
		""
		"&lYetenek İşlevi:"
		""
		"Etkinleştirildiğinde etraftaki düşman yaratıkların oyuncuya olan husumetini geçici olarak sıfırlar. Bekleme süresi vardır."
	]
	quest.094D28B7A0170039.quest_desc: [
		"Yerdeki eşyaları toplayıp kovanına geri getirir."
		""
		"Bir İstifçi Arısı kadar iyi değildir."
	]
	quest.094D28B7A0170039.quest_subtitle: "Sıradan bir Arıya Huni yedirin"
	quest.094D28B7A0170039.title: "Toplayıcı Arı"
	quest.09733948CBCB3FB9.quest_desc: ["&dKademe 6&r, en yüksek kademedir. Vibranium ve Unobtainium da dahil olmak üzere kırılabilen her şey onunla çıkarılabilir."]
	quest.09733948CBCB3FB9.title: "&dKırma Kademesi 6"
	quest.097DE7038A746847.quest_subtitle: "Kamış Yuvasında doğar"
	quest.097FDC136BC843A7.quest_desc: ["&lDünya Kademesi: &6Doruk&r kademesine geçmek için &eZırh&r ve &eAlet/Silah&r donanımını &aSıra Dışı&r seviyesinden &9Nadir&r (veya daha üstü) seviyesine yükseltmelisin! Ayrıca &0&lWither&r'ı katletmen gerekecek. \n\n&0&lWither&r'ın bir &4İstilacı&r olması şart değil; hatta normal olması işini oldukça kolaylaştırır. \n\n&6&lDoruk&r kademesinde &5Destansı&r &eEşyalar&f ve &2Cevherler&r en yaygın düşenler haline gelir. Ayrıca &eEşyalarda&r &6Mistik&r, &aCevherlerde&r ise &zKusursuz&r kaliteleri bulmaya başlayabilirsin. Tabii ikisi de hâlâ oldukça nadirdir! \n\nBu kademede %75 Ekstra Tecrübe, %50 Şans bonusu ve &a75 Maks Eterna&r sınırı kazanırsın. \n\nBuna karşılık &4Yaratıklar&r da 12 zırh puanı, 10 zırh sertliği, 15 zırh delme ve 10 koruma delme bonusu kazanarak güçlenir. \n\nBana mı öyle geliyor yoksa onların güçlendirmeleri bizimkilerden daha mı iyi?"]
	quest.097FDC136BC843A7.title: "&lDünya Kademesi: &6Doruk"
	quest.0980661B2F7FBC10.quest_desc: [
		"En tepeye ulaşmak için mumların üzerinden zıplayın! \\n\\nOraya çıktığınızda birkaç Bal Kozası bulabilirsiniz. \\n\\nAyaklarınızı yakmamaya dikkat edin.\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_candle.png width:200 height:100 align:center}"
	]
	quest.0980661B2F7FBC10.title: "Mum Parkuru"
	quest.09830BB2A23E94B4.quest_desc: ["Bazı &5Makineler&r, özellikle &eEşyalara&r eklemek için &cKimyasallar&r kullanacaktır. Düşünün, &9&lMetalurjik İnfüzer&r, &c&lKimyasal Enjeksiyon Odası&r ve &b&lArındırma Odaları&r. \n\nBunlar temelde aynı Görevler için daha az &cKimyasal&r kullanacaktır! \n\nHer &eeşya&r ve &5Makine&r ile çalışacağına söz veremem. Ve hayır, her Makine ile test etmiyorum!"]
	quest.09830BB2A23E94B4.title: "&cKimyasal &8Yükseltmesi"
	quest.0990D6CEE042F44E.quest_desc: ["Bu harita &9Twilight Forest&r için olmazsa olmazdır.\\n\\n&eBoş Büyülü Harita&r kullandığınızda, yakındaki patronları ve yapıları simgelerle gösteren özel bir haritaya dönüşür."]
	quest.0990D6CEE042F44E.title: "&eBüyülü Harita"
	quest.09936F8FCEA72C5C.quest_desc: [
		"&aVagon Birleştirici&r rayların üzerine yerleştirilir. &aBirleştiriciye&r bir &4Redstone sinyali&r verildiğinde, üzerine inşa ettiğiniz yapı bir &7Maden Arabası&r tarafından tek parça olarak devralınır."
		""
		"Blokların birbirine &aYapıştırılmış&r olması gerekir; &dDönme Gücü&r gerektiren tüm düzenekler hareket halindeyken de otomatik olarak çalışır."
		""
		"Yapıyı &7Maden Arabasından&r ayırmak için &4Redstone sinyalini&r kesip arabanın birleştiriciden geçmesini sağlamanız yeterlidir."
	]
	quest.09936F8FCEA72C5C.title: "&aVagon Birleştirici"
	quest.09955CF85F579E0F.quest_desc: ["Bunu eninde sonunda elde edeceksin, kelimenin tam anlamıyla &2&lMinecraft&r'daki en bol blok."]
	quest.09955CF85F579E0F.title: "Taş Bloklar"
	quest.09981C89C585002E.title: "&bGlacite Miğfer"
	quest.099C2A9B9CA138F8.quest_desc: ["&6Mistik&r dereceli eşyalar elde edebileceğiniz en güçlü eşyalardandır! \n\n&6Mistikler&r yalnızca &lDünya Kademesi: &6Doruk&r'ta ve en sık görüldükleri &lDünya Kademesi: &4Zirvede&r düşer. \n\n&6Tanrı Dövmesi İnciler&r, &c&lKurtarma Masasında&r &6Mistik&r &eeşyaları&r sökerek elde edilir."]
	quest.099C2A9B9CA138F8.quest_subtitle: "&6Mistik"
	quest.099C2A9B9CA138F8.title: "&6Tanrı Dövmesi İnci"
	quest.09ABD5D978373A54.quest_desc: ["&aHydra Heart&r, &a&lHydra&r'lardan çok nadir düşen bir eşyadır ama inanın bana çabaya değer! \\n\\nAna Eliniz dahil olmak üzere Hotbar'ınızın içindeyken size Yenilenme verecektir. \\nAma bekleyin, bu Yenilenmenin seviyesi ne kadar az &4Kalbiniz&r varsa o kadar artacaktır!"]
	quest.09ABD5D978373A54.title: "&aHydra Heart"
	quest.09BA45CBBFB4AE26.quest_desc: ["Bu modun bir sonraki aşaması, &3Assembly Line&r (Montaj Hattı) kurmanızı gerektirir. Bir &3Assembly Line&r'ın ana bileşeni &3Assembly Controller&r'dır.\n\nBasınç buraya gidecektir."]
	quest.09BA45CBBFB4AE26.quest_subtitle: "Her Zaman Gerekli"
	quest.09BE81548CD81068.quest_desc: ["Sonunda &#FFEB6EAllthemods Star&r için gereken bileşenlere ulaştınız!"]
	quest.09C3C0F0278C842F.title: "&4Amaramber Göğüslük"
	quest.09C82CDDA800D8C9.quest_desc: ["Wither ikinci Minecraft Patron'udur, bu isteğe bağlı bir Patron'dur. \\n\\nOnu ortaya çıkarmak için Wither'ı inşa etmen gerekecek. T şeklinde 4 Ruh Kumu ve üstüne 3 Wither İskeleti Kafatası yerleştirmek onu ortaya çıkaracaktır! \\n\\n300 Kalbi vardır ve etrafta uçarak Oyunculara veya Yaratıklara Wither Kafaları fırlatır. \\n\\nYarı Sağlığa düştüğünde, Uzak Mesafe Saldırılarına karşı bir kalkan kazanacak ve Kılıç veya Balta ile öldürülmesi gerekecektir. \\n\\nOnu öldürdüğünde şunları düşürecek: Nether Yıldızı, Solduran Ruh için şans ve tonlarca Corail Eşyası."]
	quest.09C82CDDA800D8C9.title: "Wither'ı Öldür"
	quest.09D18512037386C1.quest_desc: ["İksir efektlerini içine koymak için bir İksir Filtresini doldurman gerekir. \\n\\nBunu yapmak için: üzerinde bir İksir efekti olsun, ardından İksir Filtresine sağ tıklayarak onu üzerinden kaldır ve Filtreye ekle ve dolup aktif olana kadar tekrarla. \\n\\nBu aynı zamanda modifiye edilmiş İksir efektleri, Acele veya Direnç gibi genellikle İksirlerle elde edemeyeceğin etkilerle de çalışır."]
	quest.09D2137B4F42006E.quest_desc: ["Eclipse Ember, Just Dire Things ile eklenen yeni bir malzemedir. Voidflame Coal blokları üzerinde 4. aşama goo maddesi kullanılarak Goo Spread gerçekleştirilerek elde edilir. Eclipse Ember cevheri Servet büyüsünden etkilenir."]
	quest.09D76E9B8CABC31E.quest_desc: ["&5&lYaratıcı Öz&r için 4 &5Insanium Essence Blocks&r'a ihtiyacın olacak. Her blok 9 &5Essence&r'a eşittir, şimdi biraz matematik yapayım... \\n\\nSadece bu Bloklardan birini elde etmek için 9,216 &aInferium Essence&r'a ihtiyacın olacak. Yani toplamda 36,864 &aInferium Essence&r gerekecek!"]
	quest.09D76E9B8CABC31E.title: "4 &5Insanium Blocks"
	quest.09D7D3CF61E156B1.quest_desc: ["&2Fisyon Yakıtı Kümeleri&r, &2Bölünebilir Yakıtın&r depolanmasını sağlayan yapılardır. Ayrıca Verimliliğin belirlenmesine de yardımcı olurlar. \n\n&2Fisyon Yakıtı Kümelerinin&r çalışabilmesi için &2&lFisyon Reaktörüne&r yerleştirilmesi gerekir. \n\nÜst üste ve yan yana istiflenebilirler, ancak her istifin üzerinde bir... \n\n&2Kontrol Çubuğu Kümesi&r olması gerekir! &2Kontrol Çubuğu Kümesi&r Verimlilik gibi şeyleri değiştirmez ancak &2&lFisyon Reaktörü&r içinde üzerlerinde bir &2Kontrol Çubuğu Kümesi&r yoksa &2Fisyon Yakıtı Kümesi&r çalışmayacaktır!"]
	quest.09D7D3CF61E156B1.title: "&2Bölünebilir Yakıt&r Depolama ve Kullanımı"
	quest.09DEA44456CD5010.quest_desc: [
		"&cBreaching the Edge of Demon Realm&r ritüelini gerçekleştirir ve tek hamlede perdenin içinde tek kullanımlık bir yarık açarız — öte tarafta bir &cAntechamber&r belirir."
		""
		"İçeri adım atarız. Yanımızda anahtarlar ya da en azından onları bulmanın bir yolu olmalı; çünkü daha derindeki diyar kapılarını bedavaya açmayacaktır."
	]
	quest.09DEA44456CD5010.title: "Perdeyi Yarmak"
	quest.09E25B1CD6CABD5A.quest_desc: ["Bu yükseltme, Router'ın görünümünü bir Çerçeveli Blok (Framed Block) gibi değiştirmenizi sağlar.\\n\\nRouter'ın görünmesini istediğiniz bloğa eğilerek sağ tıklayın.\\n\\nDikkat edin, Router'ı gözden kaybetmeyin!"]
	quest.09E34E1F9C751458.quest_desc: ["&dDikey Şanzıman&r, standart &dŞanzımanın&r dikey eksene çevrilmiş halidir. \\n\\n4 adet dahili &8Şaftı&r bulunur ancak bu kez ana yönler yerine Ön, Arka, Yukarı ve Aşağı yönlere bakar. \\n\\nTıpkı normal &dŞanzıman&r gibi, giriş &8Şaftından&r aldığı Hız ve Stres değerlerini aynen korur."]
	quest.09E34E1F9C751458.title: "&dDikey Şanzıman"
	quest.09F43EB79DDBD127.quest_desc: [
		"Kuantum Veri Dolaştırıcısı, eşyaları birden fazla boyutta depolayarak Kuantum Bilgisayarı yapısındaki üretim depolamasını tam 6 katına çıkarır. Örneğin, 256M kuantum üretim depolaması artık 1,5G Üretim Depolaması sağlar."
		""
		"&lBir Kuantum Bilgisayarı yapısında bunlardan yalnızca 1 tane bulundurabilirsiniz.&r"
	]
	quest.09F43EB79DDBD127.title: "Gereksiz Derecede Büyük Depolama: Kuantum Veri Dolaştırıcısı"
	quest.09F49ED309152E24.quest_desc: ["&l&cChisel Reborn&r, &lChiseled&r'ı esas alan bir başka moddur. \\n\\nModun temelinde bazı Blokların tasarımlarını değiştirmek için Chisel Aletini kullanmak vardır. \\n\\nGUI'sini açmak için Chisel ile Sağ Tıklayabilirsin, orada içine bir istif blok koyabilir, sonra istediğin bir tasarımı seçebilir ve çıkarabilirsin. Ya da Chisel'da tutabilirsin, ama bunu neden istediğini anlamıyorum.  \\n\\nAyrıca Chisel GUI'sini açmadan tasarımını değiştirmek için Chisel ile bir Bloğa Sol Tıklayabilirsin! \\n\\nEndişelenme, bunun Dayanıklılığı yok."]
	quest.09F49ED309152E24.title: "&l&cChisel Reborn"
	quest.09FD3D0B9BCAEB5A.quest_desc: [
		"Çakıl Yuvası, Nehir veya Plaj biyomlarında arıları çeker."
		""
		"Küllü Madenci Arıyı, Çikolata Kıran Arıyı ve Kazıcı Arıyı çeker."
	]
	quest.09FD3D0B9BCAEB5A.quest_subtitle: "Nehir ve plaj biyomlarında arıları çeker"
	quest.0A02DBE226C3F44E.quest_desc: [
		"Geçerli Yükseltmeler:"
		"- Mind Fog"
		"- Stupefy"
		"- Night Vision"
		"- Debuff Remover"
		"- Mental Obliteration"
	]
	quest.0A0A991BAC99092C.quest_desc: [
		"Indigo Mushroom Bog, Blood Mushroom Bog'a kıyasla çok daha canlı ve dolu bir bataklıktır. \\n\\nElbette Indigo mantarları bulunur ama bununla da kalmaz; mini Smogstem ağaçları ve Virulent Mix havuzları da yer alır. Acaba ne işe yarıyorlar..."
		"{image:atm:textures/questpics/undergarden/undergarden_indigo.png width:200 height:100 align:center}"
	]
	quest.0A0A991BAC99092C.title: "Indigo Mushroom Bog"
	quest.0A11725B41AB45F6.quest_desc: ["Bu Görev, AllTheMods Mod Paketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk Katkıda Bulunanı&r tarafından hazırlanmıştır. \n\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansı altında olduğundan, bu Görevin &6AllTheMods Ekibi&r tarafından yayınlanmayan halka açık hiçbir pakette açık izin olmadan kullanılmasına izin verilmez. \n\nBu görev kasıtlı olarak gizlenmiştir, bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.0A1ABE9CF7740AAA.quest_desc: ["İndirim Yüzükleri; azami mananıza ve mana yenilenmenize küçük bir bonus sağlar. Ayrıca büyü yapma maliyetini de düşürür."]
	quest.0A1ABE9CF7740AAA.title: "İndirim Yüzükleri"
	quest.0A1C2A7A8617D3E4.quest_subtitle: "Speedrunner'lar Bunu Seviyor"
	quest.0A1C2A7A8617D3E4.title: "Buğday"
	quest.0A1D4228271DECA3.quest_desc: ["Nereye gittin?\\n\\nÖnceki boyutunun sadece yarısı kadar olmuşsun. 1 blok boşluğa sığacak kadar küçük."]
	quest.0A1D4228271DECA3.quest_subtitle: "Kolye"
	quest.0A1D4228271DECA3.title: "&5Küçülme Nazarlığı&r"
	quest.0A1D6E233C0ECC8E.quest_desc: [
		"&dNargoyle'lar&r, yer altında beliren iğrenç ve düşmanca yaratıklardır. \\n\\n15 kalbi (7,5 kalp) bulunur ve acımasızca sizi avlamaya çalışırlar. \\n\\nHiçbir eşya düşürmezler; tek amaçları huzurla maden kazan oyunculara köstek olmaktır."
		"{image:atm:textures/questpics/undergarden/undergarden_nargoyle.png width:100 height:100 align:center}"
	]
	quest.0A1D6E233C0ECC8E.title: "&dNargoyle&r"
	quest.0A1FBDA0C1314DE1.quest_desc: ["Uyumlanmış &bElmas&r/&aZümrütler&r birer &4Mahou&r pilidir ve &4&lMorgan&r'ı elde etmek için bolca &4Mahou&r'ya ihtiyacın olacak. \\n\\nUyumlanmış &bElmaslar&r 2000 &4Mahou&r, Uyumlanmış &aZümrütler&r ise 1000 &4Mahou&r depolar. \\n\\nRitüel için 5000 &4Mahou&r gerekecek, bu yüzden birkaç tane yapman gerekebilir!"]
	quest.0A1FBDA0C1314DE1.title: "Yeterince &4Mahou&r'n var mı? Muhtemelen!"
	quest.0A207A437AF153AA.quest_desc: ["&2Hayalet Zırhı&r, &2Hayalet Şövalye&r sandıklarında nadiren çıkabilir."]
	quest.0A207A437AF153AA.title: "&2Hayalet Zırhı"
	quest.0A21773B773F34F8.quest_desc: ["Renk, bir Yapıyı daha canlı hale getirmenin en önemli parçalarından biridir! \\n\\nOna hayat, kişilik ve renk verir!  \\n\\nBoyalarla başla!"]
	quest.0A21773B773F34F8.title: "Renkli Bloklar"
	quest.0A25276925EB0CBA.quest_desc: [
		"Tüm renkli Chalk'ları (Tebeşirleri) ve Foundation Chalk'ları topladığınızda, ikinci &dDemon-less&r (İblissiz) türü ritüel olan &dRonaza's Contact&r'ı gerçekleştirebilirsiniz. Bu, şu ana kadar öğrendiğiniz her şeyi kullanan nihai ritüeldir!"
		""
		"Sınırlı kullanımı vardır ancak bu ritüelle yaratılan her şey süper güçlüdür!"
	]
	quest.0A25276925EB0CBA.quest_subtitle: "Bu kutsal hazineyle çağırıyorum..."
	quest.0A25276925EB0CBA.title: "&dRonaza's Contact"
	quest.0A354B4707894A62.quest_subtitle: "+3'e Kadar Zıplama Yüksekliği"
	quest.0A3C464EF7CDD5F6.quest_desc: [
		"&4Cehennem Kitaplıkları&r &cQuanta&r değerine ilk adımındır; raf başına &c%3 Quanta&r ve &a3 Eterna&r verirler. \\n\\nNormal kitaplıklardan çok daha iyi, değil mi? \\n\\nBir sonraki adım için toplam 16 adet gerekecek: 15 tanesini &5Büyü Masası&r etrafına dizeceksin, 1 tanesini ise envanterinde tutacaksın. \\n\\nİlk 11 tanesini ürettiğinde son 5 &4Cehennem Kitaplığı&r benden ödül!"
		"{image:atm:textures/questpics/apothic/enchant_hellshelf.png width:100 height:100 align:center}"
	]
	quest.0A3C464EF7CDD5F6.title: "&4Cehennem Kitaplıkları"
	quest.0A43D38D27CF4304.quest_desc: [
		"&3Abandoned Spire&r bir Kaleye benzer. &3Frosted Prison&r'a benzer, sadece daha küçüğü! \\n\\n&3Draugr&r'lar ve &3Aptrgangr&r'lar burada Doğacaktır. \\n\\nFarklı katlarda ve binalarda birçok Sandık bulabilirsiniz."
		"{image:atm:textures/questpics/cataclysm/cataclysm_abandoned_spire.png width:200 height:100 align:center}"
	]
	quest.0A43D38D27CF4304.title: "&3Terk Edilmiş Kule"
	quest.0A43FD0B5C76C1C5.quest_desc: [
		"&l&7Railcraft&r, Demiri Çeliğe dönüştürmemiz için çok bloklu bir Yüksek Fırın ekler! \n\nİnşa etmek için 34 Yüksek Fırın Brick'e ihtiyacınız olacak. 3 blok genişliğinde, 3 blok uzunluğunda ve 4 blok yüksekliğinde olacaktır. Tam ortadaki iki blok boş olmalıdır. Hepsi birleşip Arayüzüne erişmenize izin verdiğinde tamamlandığını anlayacaksınız. \n\nOraya herhangi bir formda Demir koyarak Çelik ve Granulated Sand elde edebilirsiniz."
		"{image:atm:textures/questpics/railcraft/rail_furnace.png width:100 height:100 align:center}"
	]
	quest.0A43FD0B5C76C1C5.title: "Yüksek (Çelik) Fırın"
	quest.0A467A0CFFCF1490.quest_subtitle: "Beech + Luck"
	quest.0A4962728C98DAD9.quest_desc: ["&eEşya Kasaları&r standart depolamadan farklı olarak otomasyon odaklı çalışır! \n\nSandık gibidirler ancak içlerine elle doğrudan eşya koyup çıkaramazsınız... \n\nEşya aktarımı için &eHuniler&r kullanmanız gerekir. Kasalardan eşya girişi veya çıkışı sağlamak için hunileri kasalara bağlayın. Daha fazla eşya filtrelemesi için tercihen &ePirinç Hunileri&r kullanın. \n\nHer &eKasa&r geniş bir depolama alanı sunar ve yan yana yerleştirildiklerinde tek bir büyük depo oluştururlar. \n\n1x1, 2x2 veya 3x3 taban ölçülerinde kurabilirsiniz; uzunlukları ise taban genişliğinin 3 katına kadar çıkabilir! Yani oluşturabileceğiniz en büyük kasa boyutu 3x3x9'dur."]
	quest.0A4962728C98DAD9.title: "&eEşya Kasaları"
	quest.0A64D0937A5F7513.title: "Altın Olta"
	quest.0A7B0D0B81E138DE.quest_desc: ["&e&lMühendis'in Alet Kutusu&r ayrılmış bölmeli bir Shulker Kutusu gibi çalışır. \n\nÇeşitli bölümleri vardır: Sadece yiyecek koyabileceğiniz Yemek bölümü; &8&lIE&r aletlerini veya &bKovalar&r hariç diğer aletleri tutabilen Aletler bölümü; &cKablolar&r, &cBağlayıcılar&r veya &cRöleler&r alabilen &cKablolama&r bölümü ve ayrım yapmayan Her Şey bölümü. Her Şey bölümü gibi olmaya çalışın! \n\nAncak, &bSıvı Dolu Kovalar&r veya Akümülatör Sırt Çantaları gibi bazı eşyalar içinde tutulamaz. \n\n&e&lAlet Kutusunu&r bir sandık gibi yerleştirmek için Shift + Sağ Tıklayabilir, ardından geri almak için yine aynı şeyi yapabilirsiniz."]
	quest.0A7B0D0B81E138DE.title: "&e&lMühendis'in Alet Kutusu"
	quest.0A8F44B9B3C8FC0F.quest_subtitle: "Aşama: &63"
	quest.0A912B2E2BE34920.quest_desc: [
		"Yüzeyde Ham Petrol bulabilseniz de, sondaj yapmak bir ton petrol elde etmenin harika bir yoludur. Önce altınızda petrol bulana kadar bir &3Seismic Sensor&r kullanın, ardından petrol çıkarmak için sondaj borularıyla dolu &3Gas Lift&r'inizi kullanın. (Bunun çalışması için basınca ihtiyaç vardır).\n"
		"{image:pneumaticcraft:textures/patchouli/oil_pumping.png width:200 height:200 align:right fit:true}"
	]
	quest.0A912B2E2BE34920.quest_subtitle: "Petrol Sondajı"
	quest.0A9ADDE68342B987.quest_desc: [
		"&#43DEC2Polietilen&r üretmek için şu kimyasal süreç izlenir:"
		""
		"&8Ham Petrol&r -> &#D2CD2DSülfürik Hafif Yakıt&r -> &#DBD658Hafif Yakıt&r -> &#E2DF78Buharla Parçalanmış Hafif Yakıt&r -> &#44D1DBEtilen&r -> &#43DEC2Polietilen&r."
	]
	quest.0A9D5C5D2F4CDCC3.title: "&5Unobtainium Topuz"
	quest.0AA9EF3981E9BA37.quest_desc: ["&aEnerji Tabletleri&r yeterli &aEnerji&r tutmuyor mu? O zaman birkaç &aEnerji Küpüne&r ihtiyacınız olacak! \n\n&aEnerji Küplerine&r Kablolarla &aEnerji&r giriş çıkışı sağlanabilir. Her birinin Aşamasına göre belirlenmiş, belirli miktarda bir &aEnerji&r deposu vardır. \n\nBir &aEnerji Küpünün&r tüm kenarları &aEnerji&r alabilir veya verebilir, bu Kabloların İtip İtmediğine veya Çekip Çekmediğine göre belirlenir. \n\n&a&lTemel&r: 1.6mFE tutar. \n\n&c&lGelişmiş&r: 6.4mFE tutar. \n\n&b&lElit&r: 25.6mFE tutar. \n\n&d&lNihai&r: 102.4mFE tutar."]
	quest.0AA9EF3981E9BA37.title: "&aEnerji Küpleri"
	quest.0ABB2264CBB82470.quest_desc: ["&d&lArs&r Zırhlarının Demir Zırh versiyonu."]
	quest.0ABB2264CBB82470.quest_subtitle: "15"
	quest.0ABB2264CBB82470.title: "&5Arcanist Outfit"
	quest.0AC8FE3B59D1B09D.quest_desc: ["Quantum Catcher, yaratıkları taşımak için çok kullanışlı bir alettir. \n\nYaratıkları yakalamak için üzerlerine sağ tıklamanız yeterlidir; serbest bırakmak için tekrar sağ tıklayın. \n\nAncak bunu kullanabilmek için envanterinizde belirli miktarda &bAureal&r bulunmalıdır. Gereken miktar yaratığın canına bağlıdır: canı ne kadar yüksekse o kadar çok &bAureal&r harcar! Yaratıkları serbest bırakmak ise tamamen ücretsizdir. \n\nAh bekle, sanırım bunu nasıl üreteceğinizi söylemeliyim! &7Rune&r'lar, &cMundabitur Dust&r ve &8Çakmaktaşı&r ile yapılan bir &7Quantum Core&r'a ihtiyacınız olacak! \n\nSpawner Scraps parçaları, İpeksi Dokunuş olmadan kırılan Spawner'lardan düşer."]
	quest.0ACC0092A8F722C6.quest_desc: ["&8&lIE&r'deki çoğu makinenin çalışması için &cEnerjiye&r ihtiyacı olacaktır ve &cKablolar&r onu taşıma yöntemimizdir! \\n\\n&cKablolar&r, &cTel Bobini&r ile bir parçaya sağ tıklayarak ve ardından aynı &cBobin&r ile ikinci parçaya sağ tıklayarak bağlanır. Yolları engellenemez, aksi takdirde bağlanmaz. \\n\\n&cKabloları&r almak için bağlı oldukları şeyi kırabilir veya güvenilir &6Tel Kesicilerimizi&r kullanabiliriz! \\n\\nFarklı &cKablo&r seviyeleri ne kadar güç taşıdıklarını etkiler, &5HV&r en çok taşıyanıdır."]
	quest.0ACC0092A8F722C6.title: "&cTel Bobinleri"
	quest.0ACE573560A19309.quest_desc: ["Hemen hemen her &5Makine&r &aEnerji&r kullanacaktır ve onlardan düzinelerce olduğunda... Ağlarımız için kesinlikle kolay değildir. \n\n&aEnerji &8Yükseltmeleri&r eklersek, &5Makineler&r aynı Görevi yapacak, sadece tamamlamak için artık daha az &aEnerjiye&r ihtiyaç duyacak! \nKeşke bunları &d&lS.P.S.&r'ye koyabilseydik!"]
	quest.0ACE573560A19309.title: "&aEnerji &8Yükseltmesi"
	quest.0AD2B11565B484E7.quest_desc: ["Bunun için &5Netherite&r aşamasına kadarki tüm fırınlara ihtiyacınız olacak. Evet hepsine; &6Bakır&r fırına bile, &7Gümüş&r fırına bile, &3Kristal&r fırına bile!"]
	quest.0AD2B11565B484E7.title: "&zRainbow Plating"
	quest.0ADBE90B33ACC9FB.quest_desc: ["&zRainbow Generator&r, &3Augment&r: Generator eklentisi takılı bir &zRainbow Furnace&r için güçlendirme sağlar. Diğer 9 fırının tamamı (AllTheModium fırınları ve üzerindekiler hariç) &zRainbow Furnace&r'ın etrafındaysa, &3Augment&r: Generator eklentisine sahipse ve aktif olarak enerji üretiyorsa (yakıtı var ve enerji deposu dolu değilse), çalışan &zRainbow Furnace&r'a güç verir. Bu sayede tick başına 2k FE daha fazla enerji üretir!"]
	quest.0ADBE90B33ACC9FB.title: "&zRainbow Generator"
	quest.0AE28C998A3BF136.quest_subtitle: "531,441 Netherrack"
	quest.0AE6AD813928DE4F.quest_desc: ["Harici Isıtıcı, &c&lİlkel Yüksek Fırın&r ile değil, &2&lVanilla&r olanlar gibi Ocaklarla kullanılabilir! \n\nAlttan &cEnerji&r alır ve bunu ısı için kullanır. \n\nIsı, diğer taraflarından bitişikteki Bloklara aktarılır. \n\nTeknik olarak Ön Isıtıcılar üretilerek &4&lGelişmiş Yüksek Fırın&r için kullanılır ama ben bunu saymıyorum!"]
	quest.0AE83A6CC21F96D4.quest_desc: ["Bir &#3127F5Tekillik&r elektroliz edildiğinde &#DA27F5UU Maddesi&r elde edersiniz. İşlem sırasında &#3127F5Tekillik&r &n&aTÜKETİLMEZ&r."]
	quest.0AE8B51D63327EC3.title: "Chaotic Kalkan İyileştirme Modülü"
	quest.0AE930BA037DC565.quest_desc: ["DE eşyalarını nasıl kullanacağınızı ve yükselteceğinizi öğrenmek için Modüller bölümüne göz atın! Normal bir Yay gibi ok atar. Her atış, yayın enerjisinden bir miktar tüketir; yani yayınızı kullanabilmek için en azından bir Enerji Modülü takmanız gerekir."]
	quest.0AE930BA037DC565.title: "Wyvern Yay"
	quest.0AEAEA976ED0C470.quest_desc: ["&3Şarj İstasyonu&r, &aPneumaticCraft&r modundaki çeşitli aletleri ve cihazları basınç kullanarak şarj etmek için kullanılır."]
	quest.0AEAEA976ED0C470.quest_subtitle: "Kablosu nerede?"
	quest.0AEC181F5E21A299.quest_desc: ["Daha önce \"Kavun Enerjisi\" lafını duyduysanız, işte bahsettikleri şey tam olarak bu! Mekanism'in &dGaz Jeneratörü&r, Karpuz Dilimlerinden elde edilen &9Etileni&r yakarak ciddi miktarda enerji üretebilir.\\n\\n&dEtilen&r üretmek için öncelikle organik maddeleri bir &eÖğütücüde&r öğüterek &6Biyoyakıt&r elde etmelisiniz (Karpuz Dilimleri bu iş için biçilmiş kaftandır!). Ardından bu biyoyakıtı bir &dBasınçlı Reaksiyon Odasına (PRC)&r pompalamanız gerekir.\\n\\nPRC'nin Etilen üretebilmesi için Su, Biyoyakıt ve biraz da Hidrojene ihtiyacı vardır. Hidrojeni, suyu bir &9Elektrolitik Ayırıcıda&r ayrıştırarak elde edebilirsiniz.\\n\\nEtilen üretimi başladıktan sonra, enerji elde etmek için gazı Gaz Jeneratörünüze pompalamanız yeterlidir!"]
	quest.0AEC181F5E21A299.quest_subtitle: "KAVUN ENERJİSİ!"
	quest.0AEC181F5E21A299.title: "&9Mekanism: &dGaz Jeneratörü"
	quest.0AF2460579C6BD8C.quest_subtitle: "Osmiyum Arısı + Obsidiyen Arısı"
	quest.0AF2460579C6BD8C.title: "İşlenmiş Obsidiyen Arısı"
	quest.0AF5FB1B5AA5AA11.quest_subtitle: "Aşama: &b4"
	quest.0B0BDC37185AF9EC.quest_desc: [
		"Antik Çemberler, Antik Balmumu'ndan yapılmış yüksek kulelerdir. \\n\\nTepesinde içinden Rüzgarlı Hava'nın aktığı çemberler bulunur. \\n\\nOrası aynı zamanda Bal Kozası bulabileceğiniz yerdir! \\n\\nElitra kullanmak için harika bir mekan!\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_hoops.png width:200 height:100 align:center}"
	]
	quest.0B0BDC37185AF9EC.title: "Antik Çemberler"
	quest.0B11EAB8D76529E0.quest_desc: [
		"&6Antik Şehir&r, &2&lVanilla Minecraft&r dünyasındaki en tehlikeli Yapıdır. Dolayısıyla bu sadece &3&lDeeper and Darker&r macerasının başlangıcıdır! \n\nBurada bolca &3Sculk&r, değerli Ganimetler ve &9&lMuhafız&r bulabiliriz. Ayrıca &8Güçlendirilmiş Kayrak Taşından&r yapılmış Portal Çerçevesini de bulacağız. \n\nAma o zamana kadar, toplayabildiğiniz kadar Ganimet toplayın! Ve şuna dikkat edin..."
		"{image:atm:textures/questpics/allthemodium/all_city.png width:200 height:100 align:center}"
	]
	quest.0B11EAB8D76529E0.title: "Bir &6Antik Şehir&r Ziyaret Edin"
	quest.0B1DF8A040826D87.quest_desc: ["Artık &cRossinit&r elde ettiğinize göre, onu &aBenitoit (BaTiSi3O9)&r ile karıştırarak &dInsanit Külçeleri&r oluşturabilirsiniz.\\n\\n&aBenitoit Cevheri&r Nether'de bulunabilir."]
	quest.0B1DF8A040826D87.title: "Insanit Külçesi"
	quest.0B218DD73FE8D985.quest_desc: ["Eğer son görevi doğru bir şekilde yaptıysan, o tekilliği bir çift &bKuantum Dolanık Tekilliği&f'ne dönüştürmüş olmalısın. Bu yeni tekillikler &eKuantum Ağ Köprüsü&f olarak bilinen halka şeklindeki bir cihazı birbirine bağlamak için kullanılır.\\n\\nBu bireysel halkalardan ikisi Kuantum Dolanık Tekillikleri kullanılarak birbirine bağlandığında ve bir miktar AE gücü (örneğin bir enerji hücresi) ile başlatıldığında, bir ME ağı köprünün diğer tarafında, uzun mesafeler ve hatta boyutlar arasında kablosuz olarak genişletilebilir."]
	quest.0B218DD73FE8D985.title: "Kuantum Ağ Köprüsü"
	quest.0B2210804594E7B8.quest_subtitle: "Sadece üretilir"
	quest.0B2210804594E7B8.title: "Arcane Essence Arısı"
	quest.0B35172E47705205.quest_desc: ["Evet, &bIndustrial Foregoing&r'de cevher işleme de var. Bu makine, bir cevheri Ham Cevher Eti'ne dönüştürmek için &6Sıvı Et&r kullanır. Cevher uzmanı değilim, bu yüzden bu Ham Cevher Eti ile tam olarak ne yapacağınızı kestiremiyorum. Belki Fermentasyon İstasyonu'a iletirsiniz?"]
	quest.0B35172E47705205.quest_subtitle: "Cevher İşleme: Adım 1"
	quest.0B37355262121DD5.quest_desc: ["&aİnfüzyon Sunağı&r, tüm tohumları üretme yönteminizdir. Önce Altar'ı yerleştirin; kürsülerin nereye yerleştirileceğini size gösterecektir.\\n\\nİnfüzyonun başlaması için Altar'ın bir &4Redstone sinyaline&r ihtiyacı vardır."]
	quest.0B37355262121DD5.quest_subtitle: "Tohum Üretimi"
	quest.0B37355262121DD5.title: "&4İnfüzyon Sunağı"
	quest.0B3AC4E923332AC6.quest_desc: ["&b&lIce Dragon&r'ların en zorluları &bIce Dragon Cave&r'lerde doğanlardır, bunlar &lAşama 4&r ve &l5&r olan en yüksek &lAşamalardır&r! \\n\\nOnların &bIce Dragon Cave&r'leri (Buz Ejderhası Mağaraları) çok sivri ve &bBuzlu Bloklarla&r doludur, bu yüzden etrafta dolaşırken dikkatli olun. \\n\\nOh evet, bir de &b&lIce Dragon&r var, en çok yeri o kaplıyor! Endişelenmeyin, burada Uçmayacak veya Yüzmeyecekler, sadece Savaşacaklar! \\n\\nBu &bElement Saldırıları&r daha da fazla hasar verir ve daha da fazla Bloğu ve Yaratığı &bDondurur&r. Ayrıca normal Saldırıları eskisinden çok daha fazla hasar verir. \\n\\nHasar yeterince kötü değilmiş gibi, yüzlerce &4kalpleri&r ve 20'ye kadar &7zırh puanı&r vardır! Bu kötü çocuklar şaka yapmıyor! \\n\\nEğer öldürdüğünüz &b&lDragon&r &lAşama 4&r veya &l5&r ise, Dişi ise ve Boş Şişeler kullanmadıysanız bir &bIce Dragon Egg&r elde edebilirsiniz. Bunlar şununla kullanılabilir..."]
	quest.0B3AC4E923332AC6.title: "&lStage 4-5 &bIce Dragon"
	quest.0B3EA604C5172D98.quest_desc: [
		"Hangi &c&mDemon&r &9Arkadaşı&r çağırmak istediğimizi seçebilmek için özel bir &bBook of Binding&r yapmamız gerekecek.\n\nBunu yapmak için, biraz Siyah Boyayı &dSpiritfire&r'da arındırarak Purified Ink (Arındırılmış Mürekkep) elde etmelisiniz. Bununla, bir &aFoliot&r Demon çağıracak olan ilk Book of Binding'imizi yapacağız."
		""
		"Alternatif olarak, ihtiyacınız olan ritüel aşamasına uyması için daha sonra boyanabilen bir Empty Book of Binding (Boş Bağlama Kitabı) yapabilirsiniz."
	]
	quest.0B3EA604C5172D98.title: "&bBooks of &dBinding"
	quest.0B485DB737A036E9.quest_desc: ["Machine Settings Copier, makineler arasındaki ayarları kopyalamanıza olanak tanır."]
	quest.0B4CE3969067FA31.quest_desc: [
		"Kuantum Zırhı, çeşitli yükseltmelerle geliştirilebilir."
		""
		"Kuantum Zırhı'unuzu yükseltmek için ilgili tuşa (varsayılan olarak N) basarak Kuantum Zırhı Yapılandırma Menüsünü açın."
	]
	quest.0B4CE3969067FA31.title: "Kuantum Zırhı İçin Yükseltmeler"
	quest.0B60DA8F65E5DF06.quest_desc: ["&#C452C4Tungsten Tozu&r elde etmek için &#A140A1Ham Tungsten&r'ı çeşitli yöntemlerle öğütebilirsiniz."]
	quest.0B6D35F5B3A11FD2.quest_desc: ["&9Aura Cache&r, bünyesinde &aAura&r depolamanızı sağlar!"]
	quest.0B6D35F5B3A11FD2.quest_subtitle: "Aura Depolama!"
	quest.0B6D35F5B3A11FD2.title: "&9Aura Cache"
	quest.0B70D40FA951E13B.quest_subtitle: "Oak + Birch"
	quest.0B718FC37699B822.quest_desc: ["&aYankı Odunları&r, &5Yankılanan Orman'da&r yetişen &aYankı Ağaçlarından&r yapılır... burada bir yankı mı var, neden bu kadar çok duyuyorum? \n\n&aYankı Ağaçları&r &5Mor Yapraklara&r ve içlerinde Sculk Işığına sahiptir. Odunları ise &7Açık Gri Kabuğa&r ve çok &aAçık Yeşil Odun Rengine&r sahiptir. \n\nOnlardan yapılan tüm Tahtalar ve Ahşap Eşyalar neredeyse nane benzeri o &aAçık Yeşil Renge&r sahiptir. \n\nTuzak Kapıları ve Kapıları bile harika özgün desenlere sahiptir!"]
	quest.0B718FC37699B822.title: "&aYankı Ağaçları"
	quest.0B7F2B63D867D221.quest_desc: ["Bunları bulmak için biraz arkeolojiye ihtiyacımız olacak! \\n\\n&e&lAntik Kalıntı&r'a ulaşmak için gideceğiniz devasa şaftın yanlarında 3 oda var. \\n\\nBu odalardan 2'sinde ganimet elde etmek için Fırça kullanabileceğiniz Şüpheli Kum var! Buna &eÇöl Kolyesi&r de dahil. \\nSonra, onu diriltmek için &eÇöl Kolyesi&r ile &e&lAntik Kalıntı&r'a sağ tıklayın!"]
	quest.0B7F2B63D867D221.quest_subtitle: "Bir Antik Kalıntı Diriltmek"
	quest.0B7F2B63D867D221.title: "&eÇöl Kolyesi"
	quest.0B9BBE2A764631BF.quest_desc: ["Simple Swapper; üzerindeki eşyaları, blokları, yaratıkları veya oyuncuları bağlı olduğu diğer bir Simple Swapper'a ışınlar. Swapper'ları birbiriyle eşleştirmek için Ferricore Wrench kullanabilirsiniz."]
	quest.0B9F2B443813F43C.quest_desc: ["Hiç bir kürekle bir şeylere saldırıp can acıtmak istediniz mi? Neden diye sormuyoruz, sonuçta burası EvilCraft!\\n\\nAradığınız şey tam da bu! Hem bir silah hem de yumuşak blokları kırmak için bir alet görevi görür."]
	quest.0BA0AA8A6F07D383.quest_desc: [
		"İlk simya tezgâhımız olan &cTabula Vitae&r içinde bir &cArcane Scribe Tool&r hazırlarız. İçine yerleştirilmiş bir Orb of Vitae sayesinde tezgâh, bu aracı, reaktifleri ve ilk anointment'larımızı hazırlamak için EV'yi doğrudan Anima'mızdan çeker."
		""
		"Bununla yere vururuz ve ayaklarımızın altında bir çember uyanır — ilk &6Alchemy Array&r'imiz."
	]
	quest.0BA0AA8A6F07D383.title: "Yazıcının Aracı"
	quest.0BB0DF36B079558F.quest_desc: ["&6Entangled Chalice&r dünyaya yerleştirildiğinde içine kan pompalanabilir. Envanterinizde etkinleştirildiğinde, kaynak olarak &cBlood&r kullanan eşyalarınızı doldurmaya çalışır.\\n\\nAynı ağı kullanarak daha fazla Kadeh yapmak istiyorsanız, Altın Külçe yerine var olan bir Kadehi içeren üretim tarifini kullanmanız yeterlidir."]
	quest.0BB0DF36B079558F.title: "&6Entangled Chalice"
	quest.0BB367839D28607D.quest_desc: ["&8Kömür Jeneratörleri&r, yapımı en kolay enerji kaynaklarındandır.\\n\\nKullanımları oldukça basittir; içine koyduğunuz yakıt türüne bağlı olarak makul miktarda enerji üretirler. Ayrıca ürettikleri enerjiyi komşu bloklara otomatik olarak iletirler."]
	quest.0BB367839D28607D.quest_subtitle: "Fosil Yakıtlar"
	quest.0BB367839D28607D.title: "&8Kömür Jeneratörleri"
	quest.0BB42C5861B22D32.quest_desc: ["&bMycelial Reactor&r, yakınındaki tüm Mycelial Jeneratörlerin aynı anda çalışmasıyla devreye girer ve toplamda &a25 MFE/t&r enerji üretir.\\n\\nKulağa harika gelse de çalışmasını sağlamak için ciddi bir otomasyon kurmanız gerekir. Her bir Mycelial Jeneratörün ne tükettiğini inceleyip girdilerini otomatikleştirmelisiniz. Çoğu jeneratörün işleyişi basit olsa da bazıları oldukça zordur... (&oDisenchanting Mycelial Generator gibi&r).\\n\\nSistemi bir kez otomatikleştirdikten sonra tek bir reaktörle sınırlı kalmak zorunda değilsiniz, daha fazlasını da inşa edebilirsiniz!"]
	quest.0BB42C5861B22D32.quest_subtitle: "Sıradan Bir Reaktör Değil"
	quest.0BB42C5861B22D32.title: "&9Industrial Foregoing: &bMycelial Reactor"
	quest.0BB562FB44B0AAA7.quest_desc: ["Sadece kartların sınırı yok, bu yüzden Overclocker kullanan tek şey de kartlar değil! \\n\\nBu yükseltmeleri sağ alttaki &cNode&r'un içerisine yerleştirerek işlem hızını artırabilirsiniz."]
	quest.0BB562FB44B0AAA7.quest_subtitle: "Maks: 8"
	quest.0BB8D556305EB307.quest_desc: [
		"Eter River gördüğünüz an tanıyabileceğiniz bir nehirdir. \\n\\nOldukça parlaktır; haritada kırmızı görünebilir ki bu görsel bir hatadır, aldırış etmeyin."
		"{image:atm:textures/questpics/eternal/starlight_ether.png width:200 height:100 align:center}"
	]
	quest.0BB8D556305EB307.title: "Eter River"
	quest.0BC106B34AD386E5.quest_desc: ["&l&cRegions Unexplored&r başka bir Biyom Modudur, bu &l&6AllTheMods!&r için yeni bir mod! \\n\\nTabii ki Biyomlarla birlikte daha fazla Ağaç geliyor!"]
	quest.0BC106B34AD386E5.title: "&l&cRegions Unexplored&r Kütükleri"
	quest.0BCB7E97BC566683.quest_subtitle: "1 Manganez Arısı Çağırma Yumurtası elde etmek için 6 Demir Arısı Çağırma Yumurtasını santrifüjleyin"
	quest.0BCB7E97BC566683.title: "Manganez Arısı"
	quest.0BCC79C1D002F532.quest_desc: ["&bArcane Crystal Dust&r'ı &bLiquid Aureal&r haline getirmek için bir sıvıya ihtiyacımız olacak. Aradığımız o sıvı &9Su&r'dur! \\n\\nBir &9Sink&r'ten &9Su&r pompalayabilirsiniz, tamamen sonsuzdur."]
	quest.0BCC79C1D002F532.title: "Sonsuz &9Su&r!!!"
	quest.0BCCDE24D378F260.quest_subtitle: "Kademe: &d3"
	quest.0BCCDE24D378F260.title: "&dGelişmiş Makine Kasası"
	quest.0BD6365534BF04D5.quest_desc: [
		"Lime Chalk ile, &5Possesion Rituals&r'a (Ele Geçirme Ritüellerine) dalma zamanı. Bu ritüeller diğerlerinden biraz farklıdır çünkü hepsi canlı bir kurban gerektirir, genellikle Tavuk, Arı, Yarasa vb. gibi küçük moblar. Ancak, ritüeller karmaşıklaştıkça daha da büyük kurbanlar gerektirecektir. "
		""
		"Gerekli tüm eşyaları ve Book of Binding'i Golden Sacrificial Bowl'a (Altın Kurban Kasesi) yerleştirmiş olsanız bile, rünlerin üzerindeki kurbanı öldürene kadar Ritüel başlamaz."
		""
		"Empty Soul Gem, Jar, Mob Imprisonment Tool veya Quantum Catcher gibi bir tür mob yakalama eşyası yapmanız önerilir!"
		""
		"&5Possession Rituals&r'ın ilk aşaması olan &eHeidryn's Lure&r, yalnızca İskelet Kafatasları ve End Taşı gibi sıradan eşyaları almak için kullanılır. Bu nedenle, doğrudan ritüelin ikinci aşaması olan &aIhagan's Enthrallment&r'a atlayabilirsiniz. "
	]
	quest.0BD6365534BF04D5.quest_subtitle: "Kimi arayacaksın?"
	quest.0BD6365534BF04D5.title: "&aIhagan's Enthrallment"
	quest.0BD908937BC6E97B.quest_subtitle: "Kapok + Rosewood"
	quest.0BE2E7C9454058C3.quest_desc: [
		"Güzel &d&lÇiçekli Çayırlar'ın&r bir parçası da diğerlerinden çok daha yaşlı ve büyük olan &dKiraz Ağacıdır&r. \\n\\n&6Arılar&r bu &dağaçları&r çok sevmiş gibi görünüyor ve yanlarına yavrularıyla dolu minik &ekovanlar&r kurmuşlar!"
		"{image:atm:textures/questpics/bumblezone/bumble_cherry.png width:200 height:100 align:center}"
	]
	quest.0BE2E7C9454058C3.title: "&dEmektar Kiraz Ağacı"
	quest.0BE6CE2C264140AD.quest_subtitle: "Aşama: &a2"
	quest.0BFAF1499415DD68.quest_subtitle: "Silver Lime + Cherry"
	quest.0C096EE635645E43.quest_desc: ["&dCrystal &bCrossbow&r, tıpkı &7Mechanical &3Crossbow&r gibi üretilir, yalnızca çubuk yerine &bKristaller&r kullanılır. \\n\\nNormal bir arbalet ile aynı temel hasarı verir fakat hedefe Kristal Enfeksiyonu bulaştırır. Bu enfeksiyon, hedefin üzerinde kristaller çıkararak saniye başına 1 hasar verir! Ve evet, eninde sonunda onları öldürür."]
	quest.0C096EE635645E43.title: "&dCrystal &bCrossbow"
	quest.0C176F04D32B75DD.quest_desc: ["&cFire Dragonsteel&r, bir &c&lFire DragonForge&r içinde &cFire Dragon Blood&r ve &7Demirin&r birleştirilmesiyle yapılır. \\n\\nBununla Silahlar yapabiliriz! Bunlar bir ton hasar verecek, ayrıca Yaratıkları Geri İtecek ve onları &cAteşe&r verecektir. \\n\\nSilahların yanında Zırh da gelir. Bu Zırh bir ton İstatistik verir ve harika görünür! Ayrıca bizi &cEjderhaların Element Saldırılarından&r ekstra korur! \\n\\nNeden sadece kendimize Zırh alalım ki? Peki ya &c&lEjderhalarımız&r! Bu çok daha pahalıya patlar, ancak &c&lEjderhanız&r için özellikle de diğer &c&lEjderhalara&r karşı bir ton Koruma sağlayacaktır."]
	quest.0C176F04D32B75DD.title: "&cFire Dragonsteel"
	quest.0C1D55AA9CC902BD.quest_desc: [
		"Geçerli Yükseltmeler:"
		"- Lawnmower"
		"- Sky Sweeper"
		"- Auto Smelter"
		"- Hammer"
		"- Drops Teleporter"
	]
	quest.0C229BE9B57269EF.quest_desc: ["&#EBA844Kanthal Tozu&r, &#816DF7Elektrikli Maden Eritme Ocağı&r içerisinde eritilmelidir."]
	quest.0C25F73C0E0FB22A.quest_desc: ["&c&lOtomatik Forge&r'umuz için gereken bir diğer Öz de &aTecrübe&r! Bu aslında &3&lJust Dire Things&r modundan gelen &aFluid XP&r'dir. \\n\\n&aFluid XP&r elde etmek için bir &aExperience Holder&r kullanabilirsiniz. Belirli bir alanda tecrübe puanı toplayacak şekilde ayarlanabilir. \\n\\n&7Spiked Plate&r ile öldürülen yaratıklar hâlâ tecrübe puanı düşürür, bu yüzden bunları çiftliklerinizin yanına yerleştirin! \\n\\nAyrıca diğer sıvı tecrübe formlarını veya kendi tecrübe seviyelerinizi de içine aktarabilirsiniz!"]
	quest.0C25F73C0E0FB22A.title: "Otomatik &aTecrübe"
	quest.0C2EC56133D3CC6C.quest_desc: [
		"&lYetenek Türü:&r Aktif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Etkinleştirildiğinde oyuncuyu kısa süreliğine her türlü hasara karşı dokunulmaz kılar. Bekleme süresi vardır."
	]
	quest.0C7491BA5857AA00.quest_subtitle: "Teak + Jungle"
	quest.0C7D96DB3573EF9C.quest_desc: [""]
	quest.0C7D96DB3573EF9C.quest_subtitle: "&oYaşam yaratma yeteneği."
	quest.0C7D96DB3573EF9C.title: "&5&lYaratıcı Öz"
	quest.0C8180524757B238.quest_desc: [
		"&7Yüzen Yapılar&r, Minecraft kod yapısı açısından teknik olarak yapı sayılmasalar da gayriresmi olarak öyle kabul edilirler. \\n\\nHerhangi bir biyomda görünebilirler, ancak &7&lUğuldayan Yapılar&r alanında her zaman bolca bulunurlar! \\n\\nAntik Balmumu'ndan yapılmış uçan disk şeklinde yapılardır. Henüz Arıların Özü'nü kullanmadıysanız, Antik Balmumu'na dokunduğunuzda Zayıflık, Yavaşlık ve Madencilik Yorgunluğu etkisi alırsınız. Ayrıca üzerlerinde &6Bal Kozaları&r veya &5Kristaller&r bulunur!"
		"{image:atm:textures/questpics/bumblezone/bumble_floaters.png width:200 height:100 align:center}"
	]
	quest.0C8180524757B238.title: "&7Yüzen Yapılar"
	quest.0C82CE3AFBD48C1E.quest_desc: ["&l&aSushi Go Crafting&r çok fazla blok eklemiyor ama eklediklerini Mutfağında kullanmanı kesinlikle tavsiye ederim! \\n\\nÖzellikle Rice Cooker; artık Pilav için Mikrodalga kullanmaya gerek yok."]
	quest.0C82CE3AFBD48C1E.title: "&l&aSushi Go Crafting&r"
	quest.0C856BBB1679A7DD.quest_desc: ["Bu sayfada, yolculuğunda size yardımcı olacak bazı yararlı eşyalar ve bilgiler bulacaksın!"]
	quest.0C856BBB1679A7DD.quest_subtitle: "Ve Diğer Faydalı Eşyalar!"
	quest.0C93D7A607AB8B83.quest_desc: ["Yığınları talep etmek için &6M&r tuşunu kullanarak haritanı aç, ardından sol üstteki &aTalep Edilen Yığınlar&r simgesine tıkla.\\n\\nBir yığını talep etmek için sol tıkla ve sürükle.\\n\\nBir yığını zorla yüklemek için, yığına shift-sol tuşla tıkla. Doğru şekilde yapılırsa, yığın boyunca çizgiler göreceksin."]
	quest.0C94D76B87E49FFD.title: "Demir İşleme"
	quest.0C98503A2F20484D.quest_desc: [
		"Frostfields civarında Frosty Smogstem ormanları ile karşılaşabilirsiniz. \\n\\nTıpkı Frostfields gibidirler, tek farkları Smogstem ağaçlarıyla kaplı olmalarıdır!"
		"{image:atm:textures/questpics/undergarden/undergarden_frostytrees.png width:200 height:100 align:center}"
	]
	quest.0C98503A2F20484D.title: "Frosty Smogstem Forest"
	quest.0C9C5639D76FDF65.quest_desc: ["İğnelerini yeniden takarak 12 &6arıyı&r kurtarın. \n\nBir &6arı&r bir yaratığa veya size saldırdığında iğnesini kaybeder ve bu durum ona ölümcül bir zehir verir. \n\nBir Arı İğnesi ile arıya sağ tıklarsanız iğnesini takıp hayatını kurtarabilirsiniz!"]
	quest.0C9DD8E53A1B92C0.quest_desc: [
		"Geçerli Yükseltmeler:"
		"- Ore Miner"
		"- Auto Smelter"
		"- Hammer"
		"- Drops Teleporter"
		"- X-Ray"
		"- Instant Break"
	]
	quest.0C9F9196CA49FF8D.quest_subtitle: "Yolculuğunuza başlamak için Nikel Cevheri bulun"
	quest.0C9F9196CA49FF8D.title: "Oritech'e Başlangıç"
	quest.0CBFE2CE53DCACD5.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Zıplama yüksekliğinizi artırır."
	]
	quest.0CC0632E8276C787.quest_desc: ["Işınlanma Pedi'ni &l&cNether&r'a yerleştirerek &b&lOther&r'a git."]
	quest.0CC0632E8276C787.title: "&c&lNether"
	quest.0CC48C2AA553A314.quest_desc: ["&3Matkap Bit&r'ler bir Pneumatic Jackhammer'da kullanılabilir."]
	quest.0CD04A00529FE1C9.quest_desc: ["Bakır Sandık yapılabilir ancak Demir Sandık yapmak için gerekli değildir. Yine de biraz Demir biriktirmek istiyorsan kullanılabilir."]
	quest.0CD04A00529FE1C9.title: "&6Bakır Sandık"
	quest.0CD36928116E868E.quest_desc: ["&#F36EF5PolyVinil Klorür&r elde etmek için &#F783F3Vinil Klorür&r; &#9683F7Kurşun Küçük Toz&r veya &#FEA8FFKrom Küçük Toz&r ile karıştırılabilir."]
	quest.0CD6F30BBEE20E15.quest_subtitle: "Parlayan Arı + Osmiyum Arısı"
	quest.0CD6F30BBEE20E15.title: "İşlenmiş Işık Taşı Arısı"
	quest.0CE1F6DE5FD6A6D9.title: "&aEvocation&r Upgrade Orb"
	quest.0CE236731DF15DFF.quest_desc: ["Minecraft'ta yere düşen eşyaların tekrar toplanabilmesi için normalde kısa bir süre geçmesi gerekir.\\n\\nPeki ama neden bekleyesiniz?\\n\\nBu yükseltme, Vacuum Modülünün bekleme süresini ortadan kaldırır ve eşyaları düştüğü anda toplar.\\n\\nAyrıca sunucu performansını korumak için de harikadır!"]
	quest.0CF69DBA9573A7B3.quest_desc: [
		"Tasarı Masası, yapılarınızı tasarımlara kaydetmenizi veya mevcut tasarımları okumanızı sağlar."
		""
		"Binalarınızı kopyalamak veya diğer oyuncularla paylaşmak için kullanabilirsiniz!"
	]
	quest.0CFAAF6F13EB6C2C.title: "&cStarfire Çekiç"
	quest.0D01524F249E25D7.quest_subtitle: "Kim kapattı ışıkları?"
	quest.0D01524F249E25D7.title: "&8Koyu Xychorium Taşları"
	quest.0D18BBB04693885A.quest_desc: ["Strigeor's Higher Binding, &6Infusion Rituals&r'ın (İnfüzyon Ritüelleri) ikinci aşamasıdır. Pek çok farklı şey için kullanılır, ancak ihtiyacımız olan ana şeyler Infused Pickaxe ve Gray Paste'tir."]
	quest.0D18BBB04693885A.quest_subtitle: "\"Her Şey\" Ritüeli"
	quest.0D18BBB04693885A.title: "&aStrigeor's Higher Binding"
	quest.0D19FB62C2C1D9F7.quest_desc: ["En az 200 &4Mahou&r elde ettiğinde bir Yaşam Emme Alanı yapmak isteyebilirsin. \\n\\nBu alan içinde ölen her Yaratık için 10 &4Mahou&r geri alırsın, ancak bu YAVAŞ bir süreçtir."]
	quest.0D19FB62C2C1D9F7.title: "Yaşam Emme Alanı"
	quest.0D1C143B2C788204.quest_desc: ["&5Seeker&r'lar &9&lStarlight&r boyutunda her yerde doğabilen düşmancıl yaratıklardır. \\n\\n12.5 &4Kalbi&r vardır ve süzülerek uçarlar. \\n\\nYaklaşarak dillerini fırlatıp saldırırlar. \\n\\n&5Seeker&r'lar ayrıca &5Seeking Eye&r toplamak için harika bir kaynaktır!"]
	quest.0D1C143B2C788204.title: "&5Seeker"
	quest.0D212038C0A45E0B.quest_desc: ["Casull Fişekleri varsayılan mermilerdir. 5 Kalp Hasar verirler ve hepsi bu! \n\nZırh Delici Fişeklerin Zırh Puanını yok sayma şansı daha yüksektir. Bu, Bulwark gibi Yaratıklara karşı mükemmeldir. \n\nSaçma Fişekleri 1 mermi atmak yerine birden fazla mermi atacaktır. En iyi etki için yakın mesafede kullanın! \n\nGümüş Fişekler, Zombiler ve İskeletler gibi Ölümsüz yaratıklara karşı daha yüksek Hasarla Casull Fişekleri gibi davranacaktır!"]
	quest.0D212038C0A45E0B.title: "Yaygın Mermiler"
	quest.0D26E5EF6CFCFDBF.quest_desc: ["Hançerden daha yüksek Dayanıklılık, ancak daha düşük hasar ve hız."]
	quest.0D26E5EF6CFCFDBF.quest_subtitle: "Sivri Uçlu"
	quest.0D2BF2C5D784FCBE.quest_desc: ["&eValkyrie Pelerini&r tıpkı Yavaş Düşüş İksiri gibi etki gösterir. \\n\\n&e&lAether&r ve &d&lEnd&r için oldukça faydalıdır!"]
	quest.0D2BF2C5D784FCBE.title: "&eValkyrie Pelerini"
	quest.0D2D1F99945BA209.quest_desc: ["S tuşuna iki kez dokunduğunuzda &8&lAğır Kaplamalı Kalkanınızı&r kuşanması bekleniyor... \"bekleniyor\" kelimesine vurgu. \\n\\n&8&lIE&r'nin hala Beta aşamasında olduğunu hatırlatalım! Mod geliştirme çok fazla zaman ve çaba gerektirir, buna saygı gösterin!"]
	quest.0D2DD9AA960843A3.quest_desc: ["Yaratık Dedektörü, etki alanındaki varlıkları algılar ve arkasından, etki alanındaki varlık sayısına eşit güçte Redstone sinyali yayar.\\n\\nBu makine Menzil Eklentilerini destekler."]
	quest.0D2F07FC0F804223.quest_desc: [
		"Ona 10 &eZafer Madalyası&r getirdiğinizde onunla savaşabilirsiniz! \\n\\n&e&lKraliçe&r'nin 500 &4Kalbi&r (250 kalp) vardır. Kılıcını savurarak odada hızla hareket eder. \\n\\nBazen üzerinize yıldırım çağıran Yıldırım Kristalleri fırlatır; ki bu 1. çatı altında imkansız olmalı, 2. ise kesinlikle hile sayılır! \\n\\nYenildiğinde size &eAltın Kılıcını&r ve şunları bırakacaktır..."
		"{image:atm:textures/questpics/aether/aether_silver2.png width:200 height:100 align:center}"
	]
	quest.0D2F07FC0F804223.title: "&e&lValkyrie Kraliçesi"
	quest.0D2F5CC96269F9E3.quest_desc: ["PCB yapımının bir sonraki adımı, Etching Acid ile &3Etching Tank&r kullanmayı içerir. Çalışması için ısı gerektirir."]
	quest.0D2F5CC96269F9E3.quest_subtitle: "Aşındırma Zamanı!"
	quest.0D31CD79BE6CC8D2.quest_desc: ["Neden normal Ekmek Maya gerektirmez?"]
	quest.0D31CD79BE6CC8D2.quest_subtitle: "Sorunlarının Mayası"
	quest.0D31CD79BE6CC8D2.title: "Ydoğu"
	quest.0D330FAD6C993DBC.quest_desc: ["Bu, Büyü Kitabınız için bir sonraki yükseltmedir! \\n\\nToplam mananızı ve mana yenilenmenizi artırmanın yanı sıra Seviye 2 Glifleri oluşturup kullanmanıza olanak tanır."]
	quest.0D427BD581ADC3A6.title: "&aFlowglaze Kazma"
	quest.0D4C64DD58567758.quest_desc: ["Sırt Çantasına tank ekler."]
	quest.0D4FE97640F2CA60.quest_desc: ["&bUltra Yok Edici&r 36 filtre yuvasına sahiptir, 5 kat daha hızlı çalışır ve entegre bir &eYığın Yükseltmesi&r içerir."]
	quest.0D4FE97640F2CA60.title: "&bUltra Yok Edici"
	quest.0D5015B8FF482D0A.quest_desc: [
		"Gelişime devam edebilmek için &3Amadron Tablet&r'i kullanarak &3Amadron&r'dan bir şeyler sipariş etmemiz gerekecek. Kullanmak için, bir Sandık ve bir Sıvı tankına shift ile sağ tıklayın, para biriminizi (Zümrüt vb.) bağlı bir kaba koyun ve bir şey sipariş edin. Paranızı almak için bir Amadrone'un aşağı indiğini ve sipariş ettiğiniz şeyi bırakmak için başka bir Amadrone'un geldiğini göreceksiniz."
		""
		"{image:atm:textures/questpics/pneumaticcraft/amadron_drone.png width:300 height:150 align:center}"
	]
	quest.0D5015B8FF482D0A.quest_subtitle: "Acaba 1 günde teslimatları var mı?"
	quest.0D5015B8FF482D0A.title: "Amadron"
	quest.0D50BDEFA0319EA1.quest_desc: ["Bu, bitmiş ürünü çıktı sandığınıza bırakacaktır."]
	quest.0D50BDEFA0319EA1.quest_subtitle: "Her Zaman Gerekli"
	quest.0D5691403AEC25A8.quest_desc: [
		"Router'lar otomatik çiftçilik için de mükemmeldir!\\n\\nÖncelikle basit bir tarlayla başlayın. Ekinlere doğru bakan bir Activator Modülü kurun. Ardından, olgunlaşan ekinleri toplamak için Router'a bir Vacuum Modülü ekleyin. Son olarak modülleri yerleştirip Redstone sinyali verin ve otomatik çiftliğinizin keyfini çıkarın!"
		"{image:atm:textures/questpics/router/router_farm.png width:60 height:150 align:center}"
	]
	quest.0D5691403AEC25A8.title: "Router ile Otomatik Çiftçilik"
	quest.0D5D76B3551CD5A7.quest_desc: ["Evet, buna Alüminyum Arısı deniyor."]
	quest.0D5D76B3551CD5A7.quest_subtitle: "Kristal Arısı + Küllü Madenci Arı"
	quest.0D5D76B3551CD5A7.title: "Alüminyum Arısı"
	quest.0D61473D7A09CD48.quest_desc: [
		"En önemli çoklu blok yapılarından biridir, çünkü diğer yapılar için buna ihtiyacımız var. \\n\\nBu yapıda &bFluid Input&r (her giriş yalnızca 1 tür sıvı tutabilir, bu yüzden birden fazlasına ihtiyacınız olacaktır), &cEnergy Input&r, &eItem Input&r ve Output Kapakları gereklidir. \\n\\nBu kapakları kullanarak tüm eşyaları, sıvıları ve enerjiyi aktarabiliriz ve o da tıpkı diğer çoklu blok kontrolcüleri gibi eşyalarımızı üretecektir! \\n\\nHatta &6Star Parts&r için gerekli eşyalarımızı da burada üretebiliriz! Onlar için bolca &4Kan&f, &bAureal&f, Ruh ve &cEnerji&r gerekecek!"
		"{@pagebreak}"
		"{image:atm:textures/questpics/chap3/creative_forge1.png width:150 height:100 align:center}"
		"İlk katman oldukça basittir: Biraz &9Polished Darkstone Block&f ve &9Stair&r'ın yanı sıra &7Rune Block&r'lar ve &6Arcane Polished Darkstone&r. Bir saniye, en önemli bloğu neredeyse unutuyordum: &5Forge Bloğu&r!"
		"{image:atm:textures/questpics/chap3/creative_forge2.png width:150 height:100 align:center}"
		"Sonraki katmanda blok, merdiven ve basamak şeklinde daha fazla &9Darkstone&r ile birlikte &6Gilded Chiseled Polished Darkstone&r ve &6Chiseled Polished Arcane Darkstone&r yer alacak. 4 &bArcane Crystal Obelisk&r'i de unutmayın!"
		"{image:atm:textures/questpics/chap3/creative_forge3.png width:150 height:100 align:center}"
		"Burası çok kolay! Merkezde tam bir &9&lTier 5 &6Forge&r karesi ve 2 blok uzağında 8 adet &6Darkstone Pedestal&r."
		"{image:atm:textures/questpics/chap3/creative_forge4.png width:150 height:100 align:center}"
		"Burada bir katmanı atlıyoruz çünkü araya hiçbir şey eklenmiyor! Bir blok boşluk bırakarak &7Quantum Injector&r'ı &9&lTier 5 &6Forge&r'un üzerine yerleştirin."
		"{image:atm:textures/questpics/chap3/creative_forge5.png width:200 height:100 align:center}"
		"{image:atm:textures/questpics/chap3/creative_forge6.png width:200 height:100 align:center}"
		"Son olarak birkaç kapak daha yerleştirmeniz gerekecek! Tüm bunları manuel olarak inşa etmek istemiyorsanız, yapıyı sizin için otomatik kurması için &b&lAutomatic Hephaestus Forge&r Kontrolcüsüne eğilerek sağ tıklayabilirsiniz."
	]
	quest.0D888A4C5EF0073E.quest_subtitle: "Mahogany + Kapok"
	quest.0D8B4DAB82ABEF9D.quest_desc: ["Kuantum Hızlandırıcılar, Kuantum Bilgisayarı yapısına her biri 12 eş işlemci iş parçacığı ekler. Kuantum Bilgisayarı üzerindeki tüm üretim işlerinin bu eş işlemcileri ortaklaşa kullanabildiğini unutmayın; bu yüzden bolca üretmeniz faydanıza olacaktır."]
	quest.0D8B4DAB82ABEF9D.title: "Eş İşlemci Çılgınlığı: Kuantum Bilgisayar Hızlandırıcısı"
	quest.0D91A6B36BD2F526.quest_desc: ["&7Cloggrum Savaş Baltanızı&r geliştirerek &2&lUndergarden'ın&r sunabileceği en güçlü silaha sahip olun!"]
	quest.0D91A6B36BD2F526.title: "Nihai Silah!"
	quest.0D9560C8E247F9E7.quest_desc: ["Bir yere sağ tıkladığınızda geri dönüş yolunuzu bulabileceksiniz. Yeterince yakınsanız ve doğrudan bir rotanız varsa, bir yol belirecektir."]
	quest.0D9560C8E247F9E7.quest_subtitle: "Maks: 1"
	quest.0D97CDE92F3B1A83.quest_subtitle: "Kurşun Arısı/Elmas Arısı/Platin Arısı Çağırma Yumurtası üzerine Eriyik Enderium"
	quest.0D97CDE92F3B1A83.title: "Enderium Arısı"
	quest.0DABAD0803DCEA1E.quest_desc: ["Artık &c&lEjderha&r bizim! Onu nasıl kullanacağız? \\n\\nİlk olarak bazı Aletlere ihtiyacımız olacak! Ona talimatlar vermek için &7Dragon Command Staff&r. &c&lEjderhaları&r tutmak ve taşımak için &7Dragon Horn&r. Ve &c&lUçan Ejderhaları&r aşağı çağırmak için &7Dragon Flute&r. \\n\\nEnvanterini ve Arayüzünü görüntülemek için &c&lEjderhaya&r Shift Sağ Tıklayabilirsiniz. Buradan Yaşını, &4Sağlığını&f, &lAşamasını&r görebilir ve Envanterini değiştirebiliriz. Hangi Zırhı giydiği ve Flama takıp takmadığı! \\n\\n&7Dragon Command Staff&r'ı (Ejderha Komut Asası), onlara Eşlik Etmelerini, Dolaşmalarını veya Kalmalarını söylemek için kullanabiliriz. Eşlik Etmek, sizi takip edecekleri ve sizinle Savaşacakları anlamına gelir. Dolaşmak, belirli bir alanda Uçacakları ve içindeki Canavarlara saldıracakları anlamına gelir. Kalmak sadece olduğu yerde Oturacağı ve hiçbir şey yapmayacağı anlamına gelir! \\n\\n&7Dragon Horn&r bir &c&lEjderhayı&r içine koymak için kullanılabilir. Burada, Yaşını, Cinsiyetini ve Adını görebileceğiniz bir Eşyanın içinde güvenli ve kompakt bir şekilde tutulacaklardır. \\n\\nSon eşya olan &7Dragon Flute&r (Ejderha Flütü), tüm Evcilleştirilmiş Uçan Yaratıklar için kullanılır. Siz &7Flütü&r kullandığınızda Uçuyorlarsa, yere inerler."]
	quest.0DABAD0803DCEA1E.title: "&c&lEjderhanızı&r Komuta Etmek"
	quest.0DAF5D42694EA8C9.quest_desc: [
		"&#6E6D6D&nDemirci Örsü&r, endüstriyel yolculuğunuzun ilk adımıdır. Cevherlerinizden &#B53A3Adaha fazla verim&r almaktan gelecekteki üretimler için &#DBD25Abileşenler&r hazırlamaya kadar pek çok alanda işinize yarar."
		""
		"Ürettiğiniz &7Çekiç&r doğrudan tarif şartı olmasa da hazırladığınız &#DBD25Abileşenlerden&r daha yüksek miktarda çıktı almanızı sağlar."
	]
	quest.0DAF5D42694EA8C9.title: "&#949494Demirci Örsü"
	quest.0DC0E236C8213050.quest_desc: ["500mB Unrefined Liquid Soul'u tek bir ruh ile birleştirerek 500mB Liquid Soul oluşturabiliriz! \\n\\nBunun için &bLiquid Aureal&r'ın gerektirdiği miktarın iki katı olan 2000 &dLiquefied Source&r gereklidir."]
	quest.0DC0E236C8213050.title: "Sıvı Ruhlar"
	quest.0DC8B68CDF945348.quest_desc: ["Router verir, Router alır!\\n\\nBu modül inşaat ve madencilik işlerinde hayat kurtarır. Router'ın kendi tampon belleğinden (buffer) envanterinize eşya aktarmasını veya envanterinizdeki eşyaları çekmesini sağlayabilirsiniz.\\n\\nÖzellikle madendeyken envanterinizde biriken kırıktaş ve derin taşları otomatik çekip bir çöp kutusuna aktarmak için mükemmeldir."]
	quest.0DF4B01CC5B49E4E.quest_desc: ["Bu Döküm Kalıbı ile klasik kılıcı yapabilirsin! Güvenilir hasar ve güvenilir hız."]
	quest.0DF4B01CC5B49E4E.quest_subtitle: "Eski Güvenilir Dost"
	quest.0E02CE4469FCA4C9.quest_desc: ["Redstone Kontrolü canavar çağırıcınıza açma/kapama anahtarı ekler. Redstone Gücü olmadan mob doğurmaz."]
	quest.0E02CE4469FCA4C9.title: "Redstone Kontrolü"
	quest.0E03F5EAE4963ECB.quest_subtitle: "8 Kuru Yeşil blok"
	quest.0E057B7F76401421.quest_subtitle: "İlk Yükseltme"
	quest.0E057B7F76401421.title: "&6Bakır Sırt Çantası"
	quest.0E06F323BF8C1D73.quest_desc: [
		"Tomurcuklanan Entro Fluix kaçınılmaz olarak bozulduğu için, kristallerinizi otomatik üretmenin başka yollarını arayabilirsiniz."
		""
		"Neyse ki bunun için bir arı türü mevcut. Ayrıca bir tohum seçeneği de var."
	]
	quest.0E06F323BF8C1D73.quest_subtitle: "Bozulmayla başa çıkamadığınız zamanlar için"
	quest.0E06F323BF8C1D73.title: "Entro Kristalleri Otomasyonu"
	quest.0E0CAA31480EC0A1.quest_desc: ["Sırt Çantasının eşyaları almasını sağlar."]
	quest.0E0CAA31480EC0A1.quest_subtitle: "Sırt çantasının eşyaları almasını sağlar."
	quest.0E175356D43E6A10.quest_desc: [
		"Güzel güzel, artık &eKlorumuz&r var. &3Hidrojen Klorür&r için başka neye ihtiyacımız var? Ah evet, Hidrojen! \n\nHidrojen ve &bOksijen&r elde etmek için Aşama 1'deki gibi bir &9&lElektrolitik Ayırıcıya&r biraz &9Su&r verin. Sadece bu sefer Hidrojeni tutmamız gerekiyor. \n\n&a&lKimyasal Karıştırıcımız&r ile Hidrojen ve &eKloru&r birleştirerek &3Hidrojen Klorür&r yapabiliriz. \n\nO &3Hidrojen Klorürü&r bir &c&lKimyasal Enjeksiyon Odasına&r pompalayarak &7Cevherleri&r &cEnjekte edip&r &7Parçalar&r elde edin. \n\n&7Cevher Blokları&r 4 &7Cevher Parçası&r alırken 3 &7Ham Cevher&f 8 &7Cevher Parçası&r alacaktır."
		"{image:atm:textures/questpics/mek/mek_tier3_2.png width:150 height:100 align:center}"
	]
	quest.0E175356D43E6A10.quest_subtitle: "Aşama 3 Cevher İşleme"
	quest.0E175356D43E6A10.title: "&3Hidrojen Klorür&f &cEnjekte Etmek"
	quest.0E1ABCAA87120367.quest_subtitle: "Aşama: &c5"
	quest.0E1BC2AE1BE0BDFA.quest_desc: [
		"Yemyeşil Bir Mağarada seyahat ediyorsanız ve bir Ametist Kümesine benzeyen bir şeyle karşılaşırsanız, dikkatli olun çünkü bu bir &2Ametist Yuvası&r olabilir! \\n\\nBu doğru! &2Ametist Yengeç&r'ler sonunda kendilerine tam olarak uyan bir yuva buldular."
		"{image:atm:textures/questpics/cataclysm/cataclysm_amethyst.png width:200 height:100 align:center}"
	]
	quest.0E1BC2AE1BE0BDFA.title: "&2Ametist Yuvası"
	quest.0E1C2DA415D5742D.title: "&bGlacite Kılıç"
	quest.0E20A9B79D1C6637.quest_desc: ["Muhafız 1.20'de eklenen bir patrondur. \\n\\nDoğal olarak ortaya çıkan 3 Sculk Çığırtkanı'nın arka arkaya patlamasıyla veya ilk Muhafız ortaya çıktıktan sonra herhangi bir Çığırtkan'ın patlamasıyla ortaya çıkar. \\n\\nMinecraft tarafından eklenen en güçlü Yaratık'dır, 500 Kalp ve 20 Kalpten fazla hasar veren saldırılarıyla. \\n\\nSaldırıları arasında sana vurmak ve daha uzaktakiler için Sonar Patlamaları yer alır. \\n\\nTek zayıflığı kör olması, ama tıpkı Daredevil gibi bu onun diğer duyularını çok daha güçlü hale getirdi! Eğer yakındaysan kokunu alabilir bu yüzden gürültü yapmamaya dikkat et! \\n\\nEğer onu bir şekilde öldürürsen, şunları düşürecektir: Sculk Katalizörleri, Muhafız Karapaksı ve Derinlerin Kalbi."]
	quest.0E20A9B79D1C6637.title: "Muhafız'ı Öldür"
	quest.0E2515424291BB59.quest_desc: ["&d&lArs&r Zırhlarının &bElmas&r versiyonu!"]
	quest.0E2515424291BB59.quest_subtitle: "20"
	quest.0E2515424291BB59.title: "&5Battlemages Outfit"
	quest.0E2AD156E5EF263A.quest_desc: ["Scribe's Table üzerinde büyü yazmak için kullanılır."]
	quest.0E32DB6B8E023764.quest_desc: ["&6&lProductive Bees&r? Burada ne işin var? \\n\\nBazen &6&lKovan Duvarları&r veya &6&lSütunlar&r boyunca Productive Bees modunun petek yataklarını bulabilirsiniz! \\n\\nTıpkı &2Overworld'de&r maden kazmak gibi."]
	quest.0E32DB6B8E023764.title: "Ortak Yapım?"
	quest.0E345B5B625E6235.quest_subtitle: "Enchanting Apparatus ile yapılır"
	quest.0E345B5B625E6235.title: "Earth Essence Bee"
