	quest.715B86DC82EA636B.title: "Sıvılardan Gelen Basınç"
	quest.715F9F7107374299.quest_desc: ["Wyvern seviye enerji kristali. Temel kristalle aynı işleve sahiptir ancak çok daha yüksek enerji aktarım hızına ve bağlantı sınırına sahiptir."]
	quest.715F9F7107374299.title: "Wyvern Enerji Röle Kristali"
	quest.71667FFC8011525C.quest_subtitle: "Magmatik Arı + Yaprak Kesen Arı"
	quest.71667FFC8011525C.title: "Kömür Arısı"
	quest.716FF64ACF896D50.quest_desc: ["&cKasvetli Levha&r, &cBulutlu Sütunlar&r içinde &3Sculk Taşının&r yerini alır. \n\nTıpkı &3Sculk Taşı&r gibi çalışır, sadece daha Kahverengidir."]
	quest.716FF64ACF896D50.title: "&cKasvetli Levha"
	quest.71766BD7321FCB13.quest_desc: ["Harika, başka bir &c&lKimyasal Karıştırıcı&r! \n\n&aUranyum Heksaflorür&r oluşturmak için &aUranyum Oksit&r ve &7Hidroflorik Asidi&r birleştirin. \n\nŞimdi nihayet güzel &2Bölünebilir Yakıtımızı&r elde etmek için &aUranyum Heksaflorürü&r bir &5&lİzotopik Santrifüjden&r geçirebiliriz."]
	quest.71766BD7321FCB13.title: "&2Bölünebilir Yakıt"
	quest.7177653B736AB10E.quest_desc: ["&5D-T Yakıtımızı&r yapmak için &cDöteryum&r ve &aTrityumu&r bir &c&lKimyasal Karıştırıcıda&r birleştirebiliriz. Ayrıca her iki &cKimyasalı&r da &c&lFüzyon Reaktörüne&r &cbağlantı noktası ile aktarıp&r &c&lReaktör&r içinde birleştirebiliriz. \n\nSadece &5D-T Yakıtını&r &cAktarırsak&r, &cAktarıldığı&r oranda Enjekte edilecektir. Ancak hem &cDöteryum&r hem de &aTrityum&r &cAktarıp&r &c&lReaktör&r içinde birleştirirsek istediğimiz Enjeksiyon Oranını seçebiliriz! \n\nİlk çalıştırma için bir &eHohlraum&r içinde az miktarda &5D-T Yakıtına&r da ihtiyacımız olacak ve bunu &c&lFüzyon Reaktörünün&r içine koyacağız. \n\nBir &eHohlraum&r nasıl yapılır diye mi soruyorsunuz? &eHohlraum&r üretmek için bir &9&lMetalurjik İnfüzerde&r 4 &eAltın Tozunu&r 10mb &0Karbon&r ile &9İnfüze etmeniz&f yeterlidir. \n\nBoş çıktığında, doldurmak için &5D-T Yakıtı&r olan bir &5Makineye&r atın. Ardından &c&lFüzyon Reaktörünün&r arayüzündeki Yuvaya koyun ve hazır!"]
	quest.7177653B736AB10E.title: "&5D-T Yakıtı&r"
	quest.7177E49BF9ECA5CF.quest_desc: [
		"&3Thermal Kompresör&r ısı kullanarak basınç yaratır! Basınç yaratmak için bir tarafa sıcak, diğer tarafa soğuk bir şey yerleştirin."
		""
		"{image:pneumaticcraft:textures/patchouli/thermal_compressor.png width:100 height:100 align:left fit:true}"
	]
	quest.7177E49BF9ECA5CF.title: "Isıdan Gelen Basınç"
	quest.71869B1D81D6A7EF.quest_desc: ["&2&lB.R.O.&r (&2&lBasınçlı Reaksiyon Odası&r), yeni &eEşyalar &fve &cKimyasallar&r yapmak için birden fazla &bSıvı &fve &cKimyasalı&r bir &eeşya&f ile birleştirir! \n\n&bSıvılar&r, büyük ihtimalle &9Su&r, en Soldaki Çubuğa gider. &cKimyasallar&r yanındaki Çubuğa gider ve ilk &eEşyalar&r &4Kırmızı Yuvaya&r. \n\nBiten &eeşya&r &9Mavi Yuvada&r belirecek ve biten &cKimyasal&r &9Mavi Çubukta&r olacaktır. \n\n&2&lB.R.O.&r HDPE Eşyaları, &7Barut&r ve &aSülfür&r ve hatta &2Nükleer Eşyalar&r gibi birkaç eşya yapabilir!"]
	quest.71869B1D81D6A7EF.title: "&2&lBasınçlı Reaksiyon Odası"
	quest.7188DC06A28AE30E.quest_desc: ["&eAltın Kanca&r takmak, düşmanlardan elde edeceğin deneyimi artırır!"]
	quest.7188DC06A28AE30E.quest_subtitle: "Eller"
	quest.7188DC06A28AE30E.title: "&eAltın Kanca&r"
	quest.718A2040D868E09F.title: "&21048m Depolama Parçası"
	quest.718DABA6C9E5982A.quest_desc: ["Giyildiğinde oyuncuya Gece Görüşü kazandırır."]
	quest.718DABA6C9E5982A.quest_subtitle: "Maks: 1"
	quest.7198ED7E97A256A4.quest_desc: ["Üretilen ilk özel Divination Rod, Abundant Material Rod'dur! \n\nAsayı bir Eşyanın &eAlchemical Sulfur&r'ü ile ürettiğinizde, Asa o Eşyaya uyum sağlar. \n\nAbundant Malzemelerinin listesini Etiketlerde görebilirsiniz, Görevlerde tek tek sayamayacağım kadar büyük bir listedir.  "]
	quest.719D5CEB4217B734.quest_desc: [
		"Bu &6Arı&r şeklinde bir ev! \\n\\nAdeta bir arı yuvası! \\n\\nİçinde mütevazı ganimetler, &6bal&r ve bazen de küçük bir &6arı&r sakini barındırıyor!\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_house.png width:200 height:100 align:center}"
	]
	quest.719D5CEB4217B734.title: "&6Arı&r Evi"
	quest.71A1FD0772453B51.quest_desc: ["Koyun kırpmaktan inek sağmaya kadar her şeye tek tek sağ tıklamaktan sıkıldınız mı?\\n\\nActivator modülü, tıpkı bir oyuncu sağ tıklıyormuş gibi blok veya yaratıklarla etkileşime girer.\\n\\nModül menüsünden sağ tıklama, sol tıklama (saldırı), eğilerek tıklama ve etkileşim mesafesi gibi seçenekleri kolayca ayarlayabilirsiniz."]
	quest.71AA40CB2948A8D7.quest_subtitle: "Blue Yonder + Soul Tree"
	quest.71B1B53A03A16296.quest_desc: ["&bSeyyar Akışkan Arabirimleri&r, &bAkışkan Tankı&r kullanan &aDüzenekler&r ile birlikte kullanılır. \\n\\n&bAkışkan Tanklarına&r erişmek için iki &bSeyyar Akışkan Arabirimine&r ihtiyacınız olacak; biri &aDüzeneğe&r, diğeri ise &bAkışkan Borularına&r bağlı olmalıdır. \\n\\n&bSeyyar Akışkan Arabirimlerinin&r çalışabilmesi için buluşma noktaları arasında 1 veya 2 blokluk bir boşluğa ihtiyacı vardır. \\n\\nTüm bunlara sahipsek, &aDüzeneğe&r bağlı &bSeyyar Akışkan Arabirimi&r, &aDüzenek&r bünyesindeki &bAkışkan Tanklarına&r sıvı eklemek için ikinci &bSeyyar Akışkan Arabiriminden&r &bSıvı&r almak veya vermek üzere &aDüzeneği&r durduracaktır."]
	quest.71B1B53A03A16296.title: "&bSeyyar Akışkan Arabirimleri"
	quest.71B6F013C8A60EB6.quest_desc: ["&2Canopy Diminisher&r ve &2Herbivorous Absorber&r, aura üretmeye başlamak için pratik ve etkili yöntemlerdir."]
	quest.71B6F013C8A60EB6.quest_subtitle: "Daha Fazla Aura!"
	quest.71B6F013C8A60EB6.title: "Aura Üretimi"
	quest.71B72958B9F80355.quest_desc: ["Endişelenme, bu aşamada artık yere eşya bırakmak yok! \\n\\nŞimdi yalnızca üretim yapmamız gerekiyor: Lens of &3Certain Death&r'i bir &bDiamond Sword&r ve &5Enchanted Book of Sharpness V&r ile birleştirerek Lens of the &4Killer&r üret. \\n\\n&5Enchanted Books&r'u &5&lRunic Enchanter&r'dan elde edebilirsin; ayrıntılarını başka bir görevde öğrenebilirsin!"]
	quest.71B72958B9F80355.title: "Lens of the &4Killer"
	quest.71C552678A0F649F.quest_desc: ["&7Osmium&r, Deepslate çevresinde oluşur ve kazmak için yalnızca Iron seviyesinde bir Pickaxe gerekir; buna karşın &cNetherite&r'dan daha iyi değerler sağlar!"]
	quest.71C552678A0F649F.quest_subtitle: "21"
	quest.71C552678A0F649F.title: "&7Osmiyum Zırh"
	quest.71C58666D4BC2508.quest_desc: ["Standart çakmak gibi ateş yakmak için kullanılır."]
	quest.71C58666D4BC2508.title: "&eSaltpeter Matchbox"
	quest.71CF9E59F8F0B4A6.quest_desc: ["Bu &5Makineler&r &c&lGelişmiş'ten&r bile daha iyi! \n\nBu &5Makineleri&r yapmak için &b&lElit Aşama&r'dan &eEşyalar&r kullanın!"]
	quest.71CF9E59F8F0B4A6.title: "Daha da iyi &5Makineler&r!"
	quest.71D133BA3EC6F4FD.quest_desc: ["Extractor, altındaki bloğu veya eşyayı \"çoğaltarak\" üstündeki envantere aktarır.\\n\\nBu mekanizma; çeşitli taş türleri için Kırık Taş üreteci, ametist çiftliği ve hatta Ejderha Yumurtası çoğaltıcı gibi birçok otomasyon için kullanılabilir!"]
	quest.71D133BA3EC6F4FD.quest_subtitle: "Kaya Toplama Çiftliği! (ve Dahası)"
	quest.71E0D06EA65172CF.quest_desc: [
		"Her şeyin yavaşça kanamasını izlemek zorunda değiliz. Sıradan bir &cThrowing Dagger&r ilk aşamalarda uzaktan bizi güvence altına alır ve daha büyük bir şeyi başlatır: bütün &6Spiritus&r ekonomimizi."
		""
		"Fırlatılan bir hançerle yaraladığımız her şey öldüğünde ardında &cRaw Spiritus&r bırakır. Onu al — Hellfire Forge onu isteyecek."
	]
	quest.71E0D06EA65172CF.title: "Fırlatma Hançerleri"
	quest.71E1454990DEC451.quest_desc: [
		"&bGwib'ler&r, &bGwibling'lerin&r daha iri ve kindar versiyonlarıdır. \\n\\nGanimet düşürmezler ve kovayla yakalanamazlar. Tek sundukları şey acı ve ızdıraptır!"
		"{image:atm:textures/questpics/undergarden/undergarden_gwib.png width:100 height:100 align:center}"
	]
	quest.71E1454990DEC451.title: "&bGwib&r"
	quest.71E4FD61787DE299.quest_desc: [
		"Sadece Antik Şehirlerde bulabileceğin bir diğer eşya ise &6Allthemodium Demirci Şablonu&r.\\n\\nOnu elde etmek için Şüpheli Kili Fırçalaman gerekecek.\\n\\nOnu Antik Şehir'in zemininde bulabilirsin.\\n"
		"{image:atm:textures/questpics/allthemodium/all_clay.png width:200 height:100 align:center}"
	]
	quest.71E4FD61787DE299.title: "&6Allthemodium Demirci Şablonu"
	quest.71F0E9C36AA02B46.quest_desc: ["Bu arena oldukça boş görünüyor... ah bekle bu da ne! \\n\\n&cCinderous Soul Rune&r. Neredeyse bir Anahtar Deliğine benziyor, sadece Decrepit Keys üzerlerinde çalışmıyor. \\n\\nBana güven, çalışmıyorlar. \\n\\nBunun yerine &cCinderous Soulcaller&r'a ihtiyacımız olacak! &cCinder Essence&r, &5Netherite Scraps&r ve bir &9Echo Shard&r'dan yapılmıştır. \\n\\n&5Netherite Scraps&r &5Antik Kalıntı&r'dan, &9Echo Shards&r &9Ancient City&r'den gelir ve &cCinder Essence&r &5Ancient Knights&r'dan Düşen ganimetlerdir!"]
	quest.71F0E9C36AA02B46.title: "&cCinderous Soulcaller"
	quest.71FDF8CD953E46FC.quest_desc: ["HAHAHA görevler arasındaki Kreatif eşyayı görünce korktunuz mu?\n\nEndişelenmeyin, bu bölümü tamamlamak için o eşyaya ihtiyacınız yok, sadece sizi korkutmak istedim.\n\nBen de bazen eğlenebilirim..."]
	quest.7208CB011F6E2ACF.quest_desc: ["&l&6The Bumblezone&r yapılarında bulunabilir veya &5Arı Kraliçesi&r ile takas edilebilir! \n\nBu Marangoz Arı Çizmeleri gerçekten inanılmazdır: Ahşap kalaslar, yapraklar ve &6Bal Blokları&r üzerinde duvarda yürüyebilir veya daha uzağa zıplayabilirsiniz. \n\nAyrıca Shift tuşuna basılı tuttuğunuzda bu çizmeler altınızdaki bloğu kazar."]
	quest.72133DD1B3237493.quest_desc: ["&4Vampir Kılıcı&r can çalma özelliğine sahiptir. \\n\\nDüşmanlara verdiğiniz hasarın bir kısmıyla kendi &4Kalbinizi&r yenilersiniz!"]
	quest.72133DD1B3237493.title: "&4Vampir Kılıcı"
	quest.722978AC0C1B2649.quest_desc: ["Sonsuz &9suyu&r otomatikleştirmek için kolay eşya. \\n\\nDaha fazla &9suya&r mı ihtiyacın var? Bir tane daha yap!"]
	quest.722978AC0C1B2649.quest_subtitle: "Reaktör Soğutucusu olarak kullanılabilir"
	quest.722978AC0C1B2649.title: "Sonsuz &9Su&r"
	quest.7231F6177EEF5BF0.quest_desc: [
		"&6Arıları&r veya sizi taşımak için mükemmel, rengârenk tüpler! \\n\\nRüzgarlı Hava sizi metrolarda her yere, hatta ganimet dolu gizli odalara ulaştırır!"
		"{image:atm:textures/questpics/bumblezone/bumble_subway.png width:200 height:100 align:center}"
	]
	quest.7231F6177EEF5BF0.title: "Metro"
	quest.723E0CD3C8DD36B1.quest_desc: ["Seçkin Disk Arayüzü 18 filtre yuvasına sahiptir ve 2 kat daha hızlı çalışır."]
	quest.723F67A9C6993018.quest_desc: ["&bUltra Disk Arayüzü&r 36 filtre yuvasına sahiptir, 5 kat daha hızlı çalışır ve entegre bir &eYığın Yükseltmesi&r içerir."]
	quest.723F67A9C6993018.title: "&bUltra Disk Arayüzü"
	quest.7242F591DA474B37.quest_desc: ["&bSıvı Lojistiği&r, su, lav ve özel Create sıvılarını borular, pompalar ve tanklarla taşıma sanatıdır. \\n\\nSıvı elemanlarının üretimi için Bakır malzemelere ihtiyacınız olacak."]
	quest.7242F591DA474B37.title: "&b&lSıvı Lojistiği"
	quest.72489FB9D9A5A24B.quest_desc: ["&l&6The Bumblezone&r yapılarında bulunabilir veya &5Arı Kraliçesi&r ile takas edilebilir! \n\nBu Marangoz Arı Çizmeleri gerçekten inanılmazdır: Ahşap kalaslar, yapraklar ve &6Bal Blokları&r üzerinde duvarda yürüyebilir veya daha uzağa zıplayabilirsiniz. \n\nAyrıca Shift tuşuna basılı tuttuğunuzda bu çizmeler altınızdaki bloğu kazar."]
	quest.72537968598AB884.quest_desc: ["&6Mühendis Gözlüğü&r (Goggles), kinetik hatların durumunu anlık görmenizi sağlar. \\n\\nGözlüğü taktığınızda &6Gerilimölçerlerde&r mevcut Gerilim tüketimini ve kapasitesini, &6Hızölçerlerde&r sistemin dönüş hızını görebilirsiniz. \\n\\n&dBuhar Kazanlarında&r kazanın boyutu, su miktarı ve ısı düzeyi; &6Konuşlandırıcı&r ve &6Mekanik Pres&r gibi makinelerde ise kullanılan Gerilim Birimi gösterilir."]
	quest.72537968598AB884.title: "&6Mühendis Gözlüğü"
	quest.72569275EDE9FA23.quest_desc: ["Şeker kullanarak 6 &6Bal Balçığı'nı&r çiftleştirin."]
	quest.726A627BD7654E0C.quest_desc: ["Bu Aletler için &cNetherit'ten&r &9Muhafız'a&r geçişte pek bir değişiklik yoktur. \n\nKazma aynı Seviyede ve aynı Hızdadır. Kürekler hâlâ Yol yapabilir ve yine aynı Hızdadır. Çapalar hâlâ Tarım Arazisi yapabilir ve ayrıca aynı Hızdadır. \n\nTek gerçek değişiklik hepsi için daha yüksek Saldırı Hasarıdır. \n\nKomik bir şekilde bu, &9Muhafız Çapalarının&r tüm &2&lVanilla&r Çapalardan daha yüksek Hasara sahip olduğu anlamına gelir!"]
	quest.726A627BD7654E0C.title: "&9Muhafız Aletleri"
	quest.7270A37E31A70C91.quest_desc: ["&6&lHoly&r tüm Sıhhiyeci/Destek oyuncuları içindir. Çoğunlukla iyileştirme ve yardım etme amaçlıdır. \\n\\n&6&lHoly's&r Focus Materyali üretilen &6Divine Pearls&r'dir. Bunlarla Runes (Rünler) yapabilir veya &6Holy Runes&r almak için &6&lPriest&r'ı öldürebilirsiniz. \\n\\n&6Holy Scrolls&r &6Gold&r (Altın) metinlerle &fWhite&r renktedir."]
	quest.7270A37E31A70C91.title: "&6&lHoly"
	quest.7270FA5C48AF7280.quest_desc: ["&3Cursium Zırh&r, Netherit Zırhı için bir yükseltmedir. Netherit Ekipmanını, bir &3Cursium Külçesi&r ve bir &3Cursium Yükseltme Şablonu&r ile birleştirin. Bunları Üretebilirsiniz, endişelenmeyin! \n\n&3Cursium Kaskı&r, yaratıkları Blokların içinden görmek için C Tuşu ile kullanılabilir! Spektral Göz gibi. \n\n&3Cursium Göğüslüğü&r, yerleşik bir Ölümsüzlük Totemi olarak çalışır. Öldükten sonra kurtarılacaksınız. Ancak 6 dakikalık bir Bekleme Süresi vardır... \n\n&3Cursium Pantolonu&r olasılıkla çalışıyor... gerçi &2&lMinecraft&r'da nasıl çalıştığından emin değilim! \n\n&3Cursium Botları&r, V Tuşuyla geriye doğru zıplamanızı sağlar. Ayrıca düşme hasarını çok azaltırlar (ama tamamen değil!)"]
	quest.7270FA5C48AF7280.title: "&3Lanetli Zırh"
	quest.72717D1135486D7F.quest_desc: ["Biraz tohum toplayalım."]
	quest.72717D1135486D7F.quest_subtitle: "Blok El 1, blok Çimen 0"
	quest.72717D1135486D7F.title: "Çimenleri Yumrukla"
	quest.7276892E129A739B.quest_desc: ["Bunun &5&lMekanism&r'in hepsi olduğunu mu düşünüyorsunuz? Hiçbir fikriniz yok! \n\nAncak oraya gelmeden önce, bazı &5Makineler &fve &aSülfür&r hazırlayalım! \n\nÖnümüzde uzun bir yol olacak."]
	quest.7276892E129A739B.title: "&5&lMekanism: Reaktörler"
	quest.7277D695C4CB7840.quest_subtitle: "Enerjilendiren Küre ile yapılır"
	quest.7277D695C4CB7840.title: "Niotik Kristal Arısı"
	quest.7279700A93E8630B.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_unobtainium.png width:100 height:150 align:center}"]
	quest.7279700A93E8630B.title: "&5Unobtainium&r"
	quest.728189EE56E5CAF7.quest_subtitle: "Alloy Smelter'da üretilir"
	quest.728189EE56E5CAF7.title: "Redstone Alaşımı Arısı"
	quest.7282DCB1547CEB63.quest_desc: ["&#ED9553Bronz&r, &7&nBuhar Çağı'nın&r temel malzemesidir. Bronz tozunu fırında pişirerek gelecekte pek çok tarifte kullanacağınız &#ED9553Bronz Külçelerini&r elde edebilirsiniz."]
	quest.7282DCB1547CEB63.title: "&#EDD653Bronz"
	quest.728BE1816DA23DC0.quest_desc: ["Ender Ejderhası, End'i koruyan Patron'dur. \\n\\nEnd Geçidine girdiğinde, Ejderha'nın ortaya çıktığı End Adasına varacaksın. \\n\\n200 Kalbi vardır ve Ateş Topları ile saldırabilir veya sana çarpabilir. \\n\\nOnu öldürebilmek için, onu iyileştiren sütunlardaki End Kristallerini kırman gerekecek! \\n\\nOnu öldürdüğünde şunları düşürecek: Arcane Öz, Destansı Gölgelendirici Çantaları, Ejderha Derisi, iki farklı moddan Ejderha Pulları ve tonlarca TP! \\n\\nSonra Geçit açılacak, böylece Ana Dünyaya dönebilir veya dış adaları keşfetmek için bir End Geçidi bulabilirsin. Ayrıca Geçitte bir Ejderha Yumurtası bulacaksın."]
	quest.728BE1816DA23DC0.title: "Ender Ejderhasını Öldür"
	quest.72917C96C322A922.title: "La Bee-da Loca"
	quest.7297391D026EE9A6.quest_desc: ["Enerji üretmenin farklı bir yolunu mu arıyorsunuz? &dİksirleri&r denemeye ne dersiniz! &dPotion Generator&r tam olarak bunu yapar; iksirlerinizi tüketerek iksirin gücüne ve etki süresine oranla enerji üretir."]
	quest.7297391D026EE9A6.title: "&dPotion Generator"
	quest.72989212DD45DC10.quest_desc: ["Bu yumurtayı bulmak için Sıcak Okyanus Harabelerinde &aŞüpheli Kumu&r fırçalaman gerekecek.\\n\\nYumurtayı dünyaya yerleştirebilirsin ve o yavaşça &dYavru Koklayıcıya&r dönüşecektir. Normalde yumurtadan çıkması yaklaşık 20 dakika sürer, ancak yumurtadan çıkma hızını iki katına çıkarmak için Yosun bloğunun üzerine yerleştirebilirsin ve yumurtadan çıkması böylece yalnızca 10 dakika sürer.\\n\\nYavru Koklayıcı sonunda yetişkin bir &dKoklayıcıya&r dönüşecek ve kazabilecekleri blokların üzerinde dolaşırken &2Meşale Çiçeği Tohumu&r veya &2Sürahi Bitkisi Tohum Zarfı&r gibi eşyaları koklayacak.\\n\\nMeşale çiçeklerini kullanarak 2 yetişkin Koklayıcı'yı çiftleştirebilirsin."]
	quest.72989212DD45DC10.quest_subtitle: "Scruff McGruff'ın Uzak Kuzeni"
	quest.72989212DD45DC10.title: "&5Koklayıcı"
	quest.729DCB919A92B735.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_bolt.png width:100 height:150 align:center}"]
	quest.729DCB919A92B735.quest_subtitle: "Trial Odaları"
	quest.729DCB919A92B735.title: "Bolt Zırh Süsü"
	quest.72A287DCAEEFE49F.quest_desc: [
		"Aynı 8x jeneratörden 8 tanesini bir Conduit ile birleştirmek, onları tek bir devasa jeneratöre dönüştürür! 64 tane normal jeneratörün gücünde çalışır ancak sadece tek bir blok yer kaplar."
		""
		"ATM Star üretimi için 64x Magmatic Generator gereklidir."
	]
	quest.72A71E1D6D8996FD.quest_desc: ["Bu kod mu? Ben yazılımcı değilim ki!? Sadece bu görevleri yapmak istemiştim!\n\nBurada Arama Çubuğuna bir Regex (Düzenli İfade) yazabilir ve Artı (+) Butonuna tıklayarak filtreye ekleyebilirsiniz. Bu Regex ne zaman eşleşirse filtrelenecektir."]
	quest.72AB70FD8D8FABBF.quest_subtitle: "&cNether&r!"
	quest.72AB70FD8D8FABBF.title: "Şuraya Giden Otoyolda..."
	quest.72AE56D34834D28E.quest_desc: ["PneumaticCraft'tan bir tane daha mı? Oh bu gerçek spawner'mış, anladım. Draconic Stabilized Spawner gibi önce Vanilla Spawner'a ihtiyacınız olacak. Bir tane bulduğunuzda, spawner'ın üstüne bir Spawner Extractor yerleştirin ve çalışması için -0.5 Bar'ın altında basınç verin. İşlem bittiğinde, size içinde hangi mob varsa onunla dolu bir Spawner Core verecek ve size boş bir spawner bırakacak. Ardından bu boş spawner'ı kullanarak bir Pressurized Spawner üretin ve Spawner Core'u içine koyun. (Core'u yükseltmek için Spawner Core'a girecek olan mobları emmek üzere bir Vacuum Trap kullanın). Bunu yaptığınızda, spawner artık çalışmak için basınca ihtiyaç duyacak, ışık seviyesini yok sayacak ve Redstone ile etkinleşecek."]
	quest.72AE56D34834D28E.quest_subtitle: "PneumaticCraft'ın Spawner'ı"
	quest.72C09FD89C28B1EC.quest_desc: [
		"Yapacağımız &3Oil Rafineri&r, 1 &3Rafineri Controller&r (altta) ve dört &3Rafineri Çıkış&r'dan (üstte) oluşan 1x1x5 boyutlarında bir multiblock yapıdır. Bunun çalışması için Petrol ve ısı girdisi yapmanız gerekecektir. Bu; Dizel, Kerosene, Gasoline ve LPG üretecektir. Yanlarına &3Thermal Lagging&r koymak onu sıcak tutmaya yardımcı olur."
		""
		"{image:atm:textures/questpics/pneumaticcraft/oil_refinery.png width:300 height:150 align:center}"
	]
	quest.72C09FD89C28B1EC.quest_subtitle: "Şimdi bir yere varıyoruz"
	quest.72C09FD89C28B1EC.title: "Oil Rafineri"
	quest.72C7698072BF0F1D.quest_desc: ["&dDöndürme Kolu&r, manuel dönme gücü üreten ilk yardım aracıdır. \\n\\nSağ tık ile saat yönünde, Shift + sağ tık ile saat yönünün tersine geçici dönme gücü sağlar."]
	quest.72C7698072BF0F1D.quest_subtitle: "Manuel Güç"
	quest.72C7698072BF0F1D.title: "&dDöndürme Kolu"
	quest.72CE46D28C9E7452.quest_desc: ["Hassas Dürbün hem &5&lElektromanyetik Top&r hem de &d&lRevolver&r üzerinde kullanılabilir. \\n\\nDürbünü kullanmak için orta tıkı basılı tutun, yakınlaştırma oranını ayarlamak için fare tekerleğini kaydırın."]
	quest.72D578686C47B154.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_red.png width:100 height:150 align:center}"]
	quest.72D578686C47B154.title: "&5Red Starlight Crystal&r"
	quest.72D6265E35814927.quest_desc: [
		"Sağlık ve hasar sistemi olan çoğu oyunda Yenilmezlik Çerçeveleri vardır. Hasar aldıktan sonra birkaç Yenilmezlik Çerçeven olur. Böylece;"
		"1. Basit bir saldırı ile anında ölmezsin ve"
		"2. Karşılık vermek için zamanın olur. Sana en iyi şekilde savaşmak için zaman verir. \\n\\n&eHaç Kolye&r ile birkaç Yenilmezlik Çerçevesi daha elde edersin. Bu da karşılık vermek için fazladan zaman demektir!"
	]
	quest.72D6265E35814927.quest_subtitle: "Kolye"
	quest.72D6265E35814927.title: "&eHaç Kolye&r"
	quest.72DB967E59EEA729.quest_desc: ["&3&lGlassential&r inşa için çok önemli bir moddur, hatta amacı olan yapılar için bile! \\nBu sadece normal Cam değil, bunların eşya üzerinde gezinirken okunabilen özellikleri var! \\n\\nİçinden geçebildiğin ancak Yaratıkların geçemediği Ethereal Glass gibi. (Bunu 9sky'daki Arı Kubbem için kullandım!)"]
	quest.72DB967E59EEA729.title: "&3&lGlassential&r"
	quest.72DCE154E1714890.quest_desc: [
		"&6Mekanik Testereleri&r kendi başlarına görmek için ikinci Sayfaya bakın! Bu sayfada onların &aDüzenekler&r içindeki kullanımlarından bahsedeceğiz. \\n\\nBir &aDüzenek&r içinde hareket ettirildiğinde, &6Mekanik Testere&r temas ettiği tüm Ağaçları kıracaktır! Ağacın alt kısmına çarpması ve en alt kısımdaki tüm Kütükleri kırması gerekir. \\n\\nBu kütükleri kırdığında, tüm Ağaç kesilerek Eşya formuna düşecektir. \\n\\nEğer &aDüzeneğin&r bir Envanteri varsa, ağaç parçaları bu envanterde toplanır. Aksi takdirde, Ağaç doğada... yerde kalır."
		"{@pagebreak}"
		"&6Mekanik Testere&r, bir &aDüzenek&r içinde kullanılmadığında da başka görevler yapabilir. Yere yerleştirilebilir ve &dDönme Gücü&r ile kullanılabilir. \\n\\n&6Testere&r aynı zamanda yakınındaki Ağaçları da kesebilir. Evet, yine de en alt kütükleri kesmeleri gerekecektir. \\n\\nAyrıca bir &7Taşkesici&r/Odunkesici olarak da kullanılabilir! Bu şekilde kullanmak için tıpkı normalde olduğu gibi yukarı bakacak şekilde yerleştirilmesi gerekir. \\n\\nDaha sonra ona Blokları (doğru koruma açıkken) Elimizden veya &eKayışlar&r aracılığıyla besleyebiliriz. Kütükler Soyulacak ve Taş Bloklar Kesilecektir. \\n\\nEğer bloğun Kesici aracılığıyla birden fazla Tarifi varsa, o bloğu &6Mekanik Testere'nin&r Filtresine yerleştirerek hangisini istediğinizi Filtreleyebilirsiniz."
	]
	quest.72DCE154E1714890.title: "&6Mekanik Testere"
	quest.72DDA413D73E3235.quest_desc: ["&6&lAllthemodium&r Zırhları için sırada olan &3Vibranium&r ile her şeyde çok daha yüksek istatistikler! \\n\\nBunu oluşturmak için &6Allthemodium Zırh&r'a ihtiyacın olacak."]
	quest.72DDA413D73E3235.quest_subtitle: "32"
	quest.72DDA413D73E3235.title: "&3Vibranium Zırh"
	quest.72E1C19156633391.quest_desc: ["Kovalar ve Tanklar lavları etrafta taşımak için oyunun başlarında kullanılabilecek harika bir yöntemdir."]
	quest.72E1C19156633391.title: "Lav Kovası"
	quest.72E7AE66F2A7C4C4.quest_subtitle: "Makinelerde sıvı kullanımını sağlar"
	quest.72EA25D05C46D39A.quest_desc: ["&9Integrated Dynamics&r basit ama kullanışlı bir enerji depolama sistemi sunar. Energy Battery birimleri, depolama kapasitelerini artırmak için üretim ızgarasında birleştirilebilir!"]
	quest.72EA25D05C46D39A.quest_subtitle: "Piller Dahil!"
	quest.72EA25D05C46D39A.title: "&9Integrated Dynamics: &bEnergy Battery"
	quest.72EC845C19645AFC.quest_desc: ["&3Sculk Sarmaşıkları&r, &4Ağlayan Sarmaşığın&r &3Sculk&r versiyonudur. \n\n&bBlooming Caverns&r ve &9Derin Yer Altı Toprakları&r içinde oluşabilirler."]
	quest.72EC845C19645AFC.title: "&3Sculk Sarmaşığı"
	quest.72F57D77C3FB366D.quest_desc: ["Block of Crystallized Menril kırılarak Crystallized Menril Chunk elde edilebilir. Bu parçalar Integrated Dynamics modunun temel üretim bileşenidir."]
	quest.72F57D77C3FB366D.quest_subtitle: "Temel Üretim Malzemesi"
	quest.72F57D77C3FB366D.title: "Crystallized Menril Chunks"
	quest.72FADEAEE2DA03AF.quest_desc: [
		"Üçüncü adım Sonuç Kaidesidir (Result Pedestal). Dönüştürülen yeni &eSulfur&r bu kaidede belirir."
		"{image:atm:textures/questpics/theurgy/theurgy_reform_3.png width:100 height:100 align:center}"
	]
	quest.72FADEAEE2DA03AF.title: "3. Adım: Result Pedestal"
	quest.72FB345F3A7E7288.quest_desc: ["&5Lightning Dragonsteel&r, &5&lLightning DragonForge&r içinde &5Lightning Dragon Blood&r ve &7Demirin&r birleştirilmesiyle yapılır. \n\nBununla Silahlar yapabiliriz! Bunlar bir ton hasar verecek, ayrıca her Vuruşta &5Yıldırım&r Çağıracaktır. \n\nSilahların yanında Zırh da gelir. Bu Zırh bir ton İstatistik verir ve harika görünür! Ayrıca bizi &5Ejderhaların Element Saldırılarından&r ekstra korur! \n\nNeden sadece kendimize Zırh alalım ki? Peki ya &5&lEjderhalarımız&r! Bu çok daha pahalıya patlar, ancak &5&lEjderhanız&r için özellikle de diğer &5&lEjderhalara&r karşı bir ton Koruma sağlayacaktır."]
	quest.72FB345F3A7E7288.title: "&5Lightning Dragonsteel"
	quest.72FFD9E471242D68.quest_desc: ["Paslanmaz Çelik eritmek için sıradan fırınlardan daha yüksek ısı gerekir. Bu yüzden daha önce yaptığımız Elektrikli Maden Eritme Ocağı'nı kullanmanız gerekecek."]
	quest.730130CCF1CF5119.quest_desc: ["Bu Relic'ler, &2Ana Dünyada&r bulunabilir!"]
	quest.730130CCF1CF5119.title: "&2Ana Dünya"
	quest.7305EE0F7D73C231.quest_desc: ["Blank Upgrade (Boş Yükseltme) şablonları tüm yeteneklerin temelini oluşturur. Yetenekler pasif ve aktif olarak ikiye ayrılır.\\n\\nPasif yetenekler kullanıcı müdahalesi olmadan kendiliğinden çalışır. Aktif yetenekler ise ayarlar menüsünde atadığınız tuşa basıldığında tetiklenir ve kullanımda dayanıklılık veya enerji tüketir. Üst kademe zırh ve aletlere takıldığında aktif yeteneklerin bekleme süreleri kısalır, pasif yeteneklerin etkisi ise güçlenir.\\n\\nSmithing Table (Demirci Masası), Just Dire Things ekipmanlarına yükseltme eklemek için kullanılır. Envanterde eşyanın üzerine gelip Shift tuşuna basarak uyumlu yükseltmeleri görebilirsiniz."]
	quest.730AF9210F00018E.quest_desc: ["&bElmas Minotor Baltası&r, &cMinoshroom&r mağlup edildiğinde düşer. Koşarak (depar atarak) saldırdığınızda ekstra hasar verir."]
	quest.730AF9210F00018E.title: "&bMinotor Baltası"
	quest.730F2D3329C4FF88.quest_desc: ["&nFermentation&r: \nGlikoz gibi moleküllerin havasız ortamda parçalandığı kimyasal süreç. \n\nYani &9Su&r ve zamanın bir şeyleri değiştirmesi! \n\nFermentation Vat'i kullanmak için Eşyaları ve Sıvıyı Vat'e koyun, ardından kapatmak için Shift + Sağ Tıklayın. \n\nBir süre sonra fermente olmalıdır! &eAlchemical Sulfur&r'ü daha fazla Eşyaya dönüştürülebilecek &3Alchemical Niter&r'a bu şekilde dönüştürürüz!"]
	quest.730F2D3329C4FF88.title: "Fermentation Vat"
	quest.7310BBC4A90EDA9D.quest_desc: ["&eTaşınabilir KEO Gösterge Paneli&r, &e&lQIO Sistemimizi&r her yerden görüntülememizi sağlar! \n\n&eEşyayı&r sahiplenmek için onunla Sağ Tıklayın! \n\nArtık ona Sağ Tıklayabilir ve &e&lQIO Sistemimize&r bir Ağ Frekansı ayarlayabilirsiniz. \n\nBum! &eKEO Gösterge Panelinin&r yaptığı her şeyi bu küçük arkadaşla yapabiliriz!"]
	quest.7310BBC4A90EDA9D.title: "&eTaşınabilir KEO Gösterge Paneli"
	quest.73110103EF23BFDF.quest_desc: ["&6Bakır&r ve &7Çinkonun&r bir karışımı. \n\n&8&lIE&r'de pek bir şey için kullanılmaz... Sanırım onunla Tabelalar yapabilirsiniz..."]
	quest.73110103EF23BFDF.title: "&6Pirinç Külçesi"
	quest.731A4846BC556AE1.quest_desc: ["&8&lReplika&r için ihtiyacın olan son şey, tabii ki başka bir &7Parşömen&r. \\n\\n&7Ölüm Toplayıcı Mistik Gözler Parşomeni&r. \\n\\nYaratıkların ölümünü izleyerek Ruh toplamanı sağlar. \\n\\nHer ölüm yalnızca çok az miktarda Ruh verir, bu yüzden bolca ölüm görmen gerekecek. \\n\\n5 tam Ruh elde ettiğinde &8&lReplika'yı&r almaya hazır olacaksın."]
	quest.731A4846BC556AE1.title: "Ruhlar"
	quest.731A70C25C2C7281.quest_desc: ["Bu modül takılıyken kazdığınız bloklar doğrudan kişisel Ender Sandığınıza ışınlanır (modlu olan değil, Minecraft'taki)."]
	quest.731A70C25C2C7281.title: "Ender Koleksiyon Modülü"
	quest.73201E591C2A40CC.quest_desc: ["Artık &6Yıldız Parçalarını&r elde ettiğine göre, &6&lYıldızlarımızı&r yeniden yapmak için farklı parçaları yapmaya başlayabilirsin! \\n\\n1 &6&lYıldızı&r yeniden yapmak için toplam 262 &6Yıldız Parçasına&r ihtiyacın olacak... umarım iyi bir Arı kurulumu yapmışsındır!"]
	quest.73201E591C2A40CC.title: "&6Yıldız Parçaları&r"
	quest.7322332BB6CF5CF7.title: "&7Deepsilver Fırça"
	quest.732DA855AFF62907.quest_desc: ["&8Kömürü&r santrifüjleyerek &7Karbon Tozu&r elde edebilirsiniz."]
	quest.73325912C84F64A5.quest_desc: ["Başka bir seçenek de Zaman Değişimi kullanmaktır; 12 saat boyunca &4Mahou&r kazanırsın, ardından 12 saat boyunca harcarsın. \\n\\nİkinci bir Zaman Değişimi çemberi yaparsan, ilki harcamaya başladığında bu sonsuz bir döngüye dönüşür."]
	quest.73325912C84F64A5.title: "Zaman Değişimi"
	quest.73350AD668200E99.quest_desc: ["4 Inferium Özü'nü İnfüzyon Kristali ile birleştirerek elde edilen 2. Kademe Öz."]
	quest.73350AD668200E99.quest_subtitle: "Aşama: &a2"
	quest.73350AD668200E99.title: "&2Prudentium"
	quest.7338CA23B27B2AF8.quest_subtitle: "&f12 &cSaldırı Hasarı"
	quest.73391A08D7615C77.quest_desc: [
		"Henüz boş olan altara bir &belmas&r koyarız. Yakındakilerden çekilen iki bin EV, onu ilk &cNovicius Orb of Vitae&r'imize dönüştürmeye yeter — bundan sonraki tüm üretimlerimize ruhumuzu taşıyacak gizli ağ olan &6Anima&r'mızın çapası."
		""
		"Tek bir sağ tıklama küreyi bize sonsuza kadar bağlar. Ardından dilediğimiz zaman kendi kanımızı sunabiliriz: bir altarın yakınında doğrudan havuza akar; uzaktayken ise hazır olana kadar kürenin içinde bekler."
		""
		"İlk mütevazı küre bile Anima'mızı &e5,000 EV&r'ye çıkarır. Altı basamağın en küçüğüdür, ama bundan sonraki her basamak ona bağlıdır."
	]
	quest.73391A08D7615C77.title: "Bir Novicius Orb Bağla"
	quest.734411D931A8CDBF.quest_desc: ["Yıkıcı, yalnızca daha zorlu Baskınlarda ortaya çıkan bir Mini Patron'dur. \\n\\nBaskınların ne olduğunu bilmiyorsan veya güncellenmiş şeklini anlamıyorsan, bu tamamen sorun değil, Görevler bunun için var! \\n\\nYağmacı Kaptanları (Sancak taşıyanlar) öldürerek Uğursuz İksirler elde edebilirsin, bunları içtiğinde Kötü Alamet Etkisi elde edersin. Sonra, bir Köyün yakınına gidebilir ve bir Baskın başlatabilirsin. \\n\\nBaskınlarda savaşmak için Yağmacılar, İntikamcılar, Uyandırıcılar, Cadılar ve Yıkıcılar ortaya çıkacaktır!"]
	quest.734411D931A8CDBF.title: "Bir Yıkıcı Öldür"
	quest.734A72A4C898BDFB.quest_subtitle: "Kalay Arısı/Demir Arısı Çağırma Yumurtası üzerine Eriyik Invar"
	quest.734A72A4C898BDFB.title: "Invar Arısı"
	quest.734F61A03FFA13ED.quest_subtitle: "CreeBee + Demir Arısı"
	quest.734F61A03FFA13ED.title: "Radyoaktif Arı"
	quest.73552A4BA0687962.quest_desc: ["Bu yükseltmeler hem aletlere hem de zırhlara takılabilir."]
	quest.7361BD20A6B95D14.quest_subtitle: "Aşama: &63"
	quest.736F4A43EEBDD7B3.quest_desc: [
		"&3Sculk Isırganları&r küçük ama öfkeli Yaratıklardır! \n\nOnların &9Derin Yer Altı Toprakları &fve &cBlooming Caverns&r içinde doğduklarını gördüm. \n\n6 &4Kalbe&r sahiptirler ve Öldüklerinde &3Ruh Tozu&r düşürürler."
		"{image:atm:textures/questpics/deepndark/dnd_snapper.png width:100 height:100 align:center}"
	]
	quest.736F4A43EEBDD7B3.title: "&3Sculk Isırganı"
	quest.7377C657CED885AC.quest_desc: ["&2&lMystical Agriculture&r tarımla ilgili bir moddur, ama ne için tarım yapıyorsun?\\n\\nBala, Çelik'e ve Wither İskeletlerine kadar hemen hemen her şey için.\\n\\n&6&lATM Star&r'ı yapmak için bu modla epeyce tarım yapman gerekecek!"]
	quest.7377C657CED885AC.title: "&2&lMystical Agriculture"
	quest.737DC37E4310090C.quest_desc: ["&8Zincirli Taşıyıcılar&r kendi başlarına pek bir şey yapmazlar. Başka bir &8Zincirli Taşıyıcıya&r, &8Zincirlere&r ve &dDönme Gücüne&r ihtiyaç duyarlar! \\n&8Zincirli Taşıyıcılar&r, &8Zincirler&r ile bağlanabilmek için yakınlarda başka bir &8Zincirli Taşıyıcıya&r ihtiyaç duyar. \\n\\n&8Zincirlerin&r bir &8Zincirli Taşıyıcı&r üzerine sağ tıklanması ve ardından bağlanmak istenen diğerine aynı şekilde uygulanması gerekir. \\n\\nBirine &dDönme Gücü&r verildiğinde &8Zincirler&r aynı hızda hareket edecektir. Yön konusunda endişelenmeyin, 2 &8Zincir&r olacaktır! \\n\\n&8Zincirler&r hareket ederken, onlarla birlikte hareket etmek için bir &6Ayarlı Anahtar&r ile bağlanabilirsiniz; &8Zincirden&r inmek için Shift'e basabilir veya eşyaları değiştirebilirsiniz. \\n\\nAyrıca üzerlerine &eKarton Paketler&r yerleştirebilirsiniz, ancak bir sonraki görevde açıklanan &eEşya&r olmadan sadece daire çizeceklerdir!"]
	quest.737DC37E4310090C.title: "&8Zincirli Taşıyıcı"
	quest.7386A8433698946C.quest_desc: [
		"Bir eşya seçin ve bu yükseltme onu yakındaki sandıklarda veya yerde arayacaktır. Sandıklarda bulmak için Block Tracker Upgrade'ine ve yerde bulmak için Entity Tracker Upgrade'ine ihtiyacı olacaktır.\\n"
		"{image:atm:textures/questpics/pneumaticcraft/item_search_upgrade.png width:200 height:200 align:center}"
	]
	quest.7386A8433698946C.quest_subtitle: "Maks: 1"
	quest.7388D8168AF78B9A.quest_subtitle: "Aşama: &63"
	quest.7395B41685F4BC1A.quest_desc: ["&3Flux Kompresör&r, güç (power) kullanarak bir ton basınç yaratabilir. Basitçe biraz FE pompalayın ve biraz üretmeye başlayacaktır. Eğer harcayacak yeterli FE'niz varsa, bu muhtemelen basınç üretmenin en kolay yoludur."]
	quest.7395B41685F4BC1A.quest_subtitle: "Güç = Basınç"
	quest.7395B41685F4BC1A.title: "Güçten Gelen Basınç"
	quest.739601B0C43B239B.quest_desc: ["Evet, siyah boya yapımında kullanılabilirler!"]
	quest.73A56DD4AC1B9590.quest_desc: ["Aşağı düşerken bir Yaratığa ne zaman Vurursanız Kritik Vuruş verirsiniz. \\n\\nBunlar bir ton daha fazla hasar verir. \\n\\nBu &3Yüzüğü&r takarken daha da fazla hasar vereceksiniz!"]
	quest.73A56DD4AC1B9590.title: "&3Kin Yüzüğü"
	quest.73B73870B29DFAD9.quest_desc: ["Bizden biri! Bizden biri! \\n\\n&eKöylü Şapkası&r, Köylüleri aynı Kasabadan olduğuna inandırır. Böylece Kasaba Dışı Vergisinden muaf olursun. Köylü Ticaretleri daha ucuzdur."]
	quest.73B73870B29DFAD9.quest_subtitle: "Kafa"
	quest.73B73870B29DFAD9.title: "&eKöylü Şapkası"
	quest.73B8A70240E6070E.quest_desc: ["İnek Bul ve Kovayla Sağ Tıkla.\\n\\nCidden, neden Boğa yok?"]
	quest.73B8A70240E6070E.quest_subtitle: "Oyunda neden Boğalar yok?"
	quest.73B8A70240E6070E.title: "İnek Sağ - Kâr"
	quest.73BE1EB3E69814E9.quest_desc: ["Bu tarifin ilk ve en kolay kısmı &5Evil Sticks&r'dir. Sadece Kazarak elde ettiğiniz &8Dark Gems&r'e ve &cUndead Trees&r'dan elde ettiğiniz &cUndead Planks&r'e ihtiyacınız var. \\n\\nSırada, &5Güç verilmiş Ters Potansiyel (Empowered Inverted Potentia)&r var. Yapması o kadar zor değil, sadece bir &7Inverted Potentia&r üretin, ardından onu bir &aEnviromental Accumulator&r içinde tutun ve Yıldırım çarpmasını sağlayın! \\n\\nSon kısım devasa bir &aBoş Promises&r serisine sahip; epeyce infüze yapacaksın. \\n\\nUmarım bolca &4Blood&r'ın vardır! Lafı açılmışken, ayrıca &5Mace&r'i de &4Blood&r ile doldurman gerekecek."]
	quest.73BE1EB3E69814E9.title: "&5Mace of Destruction"
	quest.73C70B15582958A5.quest_desc: [
		"&eToprak Yuvası&r, arıları çekmek için herhangi bir Overworld biyomuna yerleştirilebilir."
		""
		"Küllü Madenci Arıyı, Çikolata Kıran Arıyı ve Yaprak Kesen Arıyı çekebilir."
	]
	quest.73C70B15582958A5.quest_subtitle: "Herhangi bir Overworld biyomu"
	quest.73C7F57B90731010.quest_desc: [
		"Süzülen &6bal&r ve &bşekerli suyla&r süslenmiş harika bir çeşme yapısı."
		"{image:atm:textures/questpics/bumblezone/bumble_fountain.png width:200 height:100 align:center}"
	]
	quest.73C7F57B90731010.title: "&6Bal&r Çeşmesi"
	quest.73D60868024FF907.quest_desc: ["Fluid MK2 modülü ile yalnızca bitişikteki değil, çevredeki belirlenen tüm sıvı kaynaklarını toplayabilir veya sıvı dağıtabilirsiniz."]
	quest.73D6B980D35082A0.quest_desc: ["Bunu açıklamak biraz zaman alıyor o yüzden sabırlı olun. \\n\\nİlk olarak, bir &aEvoker Fort&r bulun. \\nSonra, içinde gizlenmiş bir Araştırma Kitabı bulun. Sonra, &aFort&r'da rehin olan bir Tüccara bunu tercüme ettirin. (Rehin Görev Çevirmenlerimiz gibi!) \\nTercüme edildikten sonra, &eSpell Book&r ile takas etmek için onu bir &6Village&r'daki (Köy) bir &6&lPriest&r'a götürün! \\n\\n&6Holy Spells&r'e bir güçlendirme sağlar ve endişelenmeyin rehin Tüccarlar çok ama çok nadirdir, aramaya devam edin!"]
	quest.73D6B980D35082A0.title: "&6Villager Bible"
	quest.73E09ED46A94B812.quest_desc: ["&4&lZirve&r son Dünya Kademesidir. Bu kademeye ulaştığında &aMaks Eterna&r tavan sınırın oyunun en üst noktası olan &a100&r seviyesine çıkar.\\n\\n&8Neyse ki bu sefer kilit/geçit görevi gerekmeyecek.&r"]
	quest.73E09ED46A94B812.quest_subtitle: "Maks Eterna: 100"
	quest.73E09ED46A94B812.title: "Nihayet &4&lZirve&r"
	quest.73E2A53A088AD29A.quest_subtitle: "11 Islak Pembe blok"
	quest.73E6878553BA6908.quest_desc: ["Çekmeceleri sever misiniz? &5&lMekanism&r bize biraz veriyor! Sadece bunlara &eKutular&r deniyor. \n\n&eKutular&r sadece bir tür eşya tutabilir ancak o &eEşyadan&r tonlarca Yığın tutacaktır! \n\nOtomatik olarak altındaki Envantere Çıkış yapması için &eKutu&r üzerinde bir &3Yapılandırıcı&r kullanabilirsiniz. \n\nEğer &eKutuda&r bir &eeşya &fvarsa, o &eEşyayı&r Kilitlemek için ona Shift Sağ Tıklayabilirsiniz. \n\n&a&lTemel&r: 64 Yığın tutar. \n\n&c&lGelişmiş&r: 128 Yığın tutar. \n\n&b&lElit&r: 512 Yığın tutar. \n\n&d&lNihai&r: 4.096 Yığın tutar."]
	quest.73E6878553BA6908.quest_subtitle: "Çekmeceler"
	quest.73E6878553BA6908.title: "&eKutular"
	quest.73EA326304C01C3B.quest_desc: [
		"Eşya çekmek istediğiniz envantere bir Importer yerleştirin. Ardından, Interface'i ikinci envantere takıp iki bloğu Logic Cables ile bağlayın. Son olarak Variable Card'ı Importer'a yerleştirip ayarlarını dilediğiniz gibi yapılandırın.\\n\\nTransfer limitleri ayarlanarak tek seferde tamsayı sınırına kadar (2 milyarın üzerinde) aktarım gerçekleştirilebilir."
		"{image:atm:textures/questpics/logistics/id_item.png width:200 height:50 align:center}"
		"{image:atm:textures/questpics/logistics/id_fluid.png width:200 height:50 align:center}"
		"{image:atm:textures/questpics/logistics/id_energy.png width:200 height:50 align:center}"
	]
	quest.73EA326304C01C3B.quest_subtitle: "İçeri Aktarım"
	quest.73FC51144FC2DA52.quest_desc: ["Bu &7Eldiven&r ile vurduğun tüm düşmanların canını alacaksın!\\n\\nOh evet üzgünüm unutmuşum... bleh bleh blehhh!"]
	quest.73FC51144FC2DA52.quest_subtitle: "Eller"
	quest.73FC51144FC2DA52.title: "&7Vampir Eldiveni&r"
	quest.73FF01D830A669AA.quest_desc: ["&4Augment&r: Blasting, Iron Furnace'ınızı bir Iron Blast Furnace'a dönüştürür! Yalnızca maden cevherlerini eritir ancak bunu iki kat hızla yapar. Ayrıca diğer eklentilerin ve üst seviye fırınların hız bonuslarıyla birleşerek üst üste binebilir."]
	quest.73FF01D830A669AA.title: "&4Augment&r: Blasting"
	quest.74015945716FD10A.quest_desc: ["Bu &3Omnidirectional Hopper&r herhangi bir taraftan eşya alabilir, ayrıca normal bir Huni'den çok daha hızlı olacak şekilde yükseltilebilir! Borulara gerek olmadığında çok hoş."]
	quest.74015945716FD10A.quest_subtitle: "Yapılandırılabilir bir huni"
	quest.7408CCF998D9CD37.quest_desc: ["Üretilebilir bir &eSpell Book&r... evet, üretmesi kolay değil. \\n\\nElde edilmesi en zor olanı, &9Ancient City&r Sandıklarında bulabileceğiniz Ruined Book olacaktır. &4Blood Vials&r, bir Yaratığı (hatta kendinizi) bir Kamp Ateşinin üzerindeki bir Kazana veya Alchemical Cauldron'a (Simya Kazanı) koyarak elde edilebilir. &5Bottle O' Lightning&r, Yüklü bir Creeper üzerinde bir Şişe kullanılmasından gelir. \\n\\nTüm bunları yaptıktan sonra Ancient Codex'i üretebilirsiniz. 12 &3Spell&r Yuvası çok faydalıdır!"]
	quest.7408CCF998D9CD37.title: "Ancient Codex"
	quest.74130EB1E4B8586D.quest_desc: ["&aIhagan's Enthrallment&r kullanarak, bir &6Possessed Bee&r (Ele Geçirilmiş Arı) çağırmak için bir Huzurveren, Yarasa, Arı veya Papağan kurban edebilirsiniz. Birini yendiğinizde, Orange Chalk yapmak için ana madde olan Cursed Honey düşürecektir!"]
	quest.74130EB1E4B8586D.title: "&6Orange Chalk"
	quest.7413BB136EF9D6C5.quest_desc: ["Mechanical Drying Basin, kurutma işlemini gerçekleştirmek için enerji kullanır."]
	quest.74200A48498DD7F8.quest_desc: ["&e&lGüneş Jeneratörü&r, &eGündüz&r sırasında &bGökyüzüne&r maruz kalmasına bağlı olarak &aEnerji&r Üretecektir. \n\nKullanımı çok basit otomatik bir &e&lJeneratördür&r, sadece Üretmek can sıkıcıdır! \n\n&b&lRüzgar Jeneratörleri&r kadar fazla &aEnerji&r (sadece Gündüz) üretmeyecekler ama Anlık olarak daha fazla üretecekler ve daha az Yer kaplayacaklar! \n\nGüçlendirildiler ve artık yaklaşık 40kFE tutabiliyorlar!"]
	quest.74200A48498DD7F8.quest_subtitle: "Yaklaşık 60FE/t Üretir"
	quest.74200A48498DD7F8.title: "&e&lGüneş Jeneratörü"
	quest.74297A72584F5D7B.quest_subtitle: "Alder + Wild Cherry"
	quest.744842B2AED28344.quest_desc: ["Entegre bir üretim arayüzü ile ağ depolamanıza kablosuz olarak erişmenizi sağlar."]
	quest.744AC6BD82FC2DEE.quest_subtitle: "&f36 &cSaldırı Hasarı"
	quest.744DBE831C120B2F.quest_desc: [
		"Şu kaya hareket mi ediyor? Yok yahu, kaya değilmiş, bu bir &aMog&r! \\n\\n&aMog'lar&r Depthrock Pebbles ile beslenip çoğaltılabilir; öldüklerinde ise çakıl taşı veya Mogmoss yosunu düşürürler! \\n\\nMogmoss pek çok farklı tarifte kullanılır."
		"{image:atm:textures/questpics/undergarden/undergarden_mog.png width:100 height:100 align:center}"
	]
	quest.744DBE831C120B2F.title: "&aMog&r"
	quest.744E620B7DEBB483.quest_desc: ["&#27CFF5Vakumlu Dondurucu&r; ürettiğiniz &#E6AD1ESıcak Külçe&r'leri veya belirli sıvıları soğutarak çok daha yüksek verimle üretim yapmanızı sağlar."]
	quest.744E620B7DEBB483.quest_subtitle: "Bing Chilling"
	quest.745E616E97838D2E.quest_desc: ["&lDur!&r Hayvanların kitlesel soykırımını durdur. PETA bir uzlaşmaya varmış gibi görünüyor. Hey, sen masum hayvanları öldürmeyi bırak. Onlar da sana &5Yaratıcı &4Blood Drop&r versin! \\n\\nBununla &4Blood&r'a ihtiyaç duyan herhangi bir kabı sonsuza kadar doldurabilirsin! \\n\\nBunu üretmek için 4 &bPromise of Tenacity&r, bir &6&lATM Yıldızı&r ve &4Blood&r ile dolu olması gereken 4 farklı Eşyaya ihtiyacın olacak."]
	quest.745E616E97838D2E.title: "&5&lYaratıcı &4Blood Drop"
	quest.7464CA1290B3474B.quest_desc: [
		"Geçerli Yükseltmeler:"
		"- Invulnerability"
	]
	quest.746DE905D45A396C.quest_desc: [
		"&5&lLeviathan&r, insanların Okyanustan korkmasının nedenidir. \n\n6.400 &4Kalbi&r, keskin dişleri ve güçlü dokunaçları vardır ve &9Suyun&r dışında yenilmezdir. \n\nSize karşı kullanacağı devasa bir güç dizisine sahiptir. Sualtı &5Mayınları&r çağırabilir, Godzilla benzeri bir &5Atom Işını&r atabilir ve hatta sadece sizi çiğneyebilir. \n\nAncak en kötüsü &5Girdaplardan&r gelir! Ve &6&lATM Dev&r'i kastetmiyorum! \n\nDokunaçlarını, kendisi için yem olarak yakındaki tüm varlıkları içine çekecek bir &5Su Girdabını&r kırarak açmak için kullanabilir. Ayrıca Okyanus tabanındaki &5Girdaplardan&r yukarı doğru ateş edecek &5Lazerler&r çağırabilir. \n\nOnu yarı &4Sağlığın&r altına getirdiğinizde öfkelenecektir! Öfkelendiğinde, &5Lazerlerini&r eskisinden çok daha fazla kullanacak ve Okyanuslarda sadece bir tane yüzen varlık kalana kadar acımasızca saldıracaktır."
		"{image:atm:textures/questpics/cataclysm/cataclysm_leviathan.png width:100 height:100 align:center}"
	]
	quest.746DE905D45A396C.title: "&5&lLeviathan&r"
	quest.747B62A955D0C629.quest_desc: [
		"&4Antik Fabrika&r, &2Overworld&r'de yerin derinliklerinde bulunur. \\n\\nŞalterler, Elektrikli Raylar ve EMP'ler gibi birçok Redstone Eşyası bulacaksınız... Bunların yakında işe yarayıp yaramayacağını merak ediyorum? \\n\\nAyrıca sizi öldürmeye çalışan bazı Redstone Makineleri de bulacaksınız! &4Gözetleyiciler &fve &4Gizli Avcılar&r gibi! \\n\\nTehlikeye rağmen buradan çalabileceğiniz tonlarca ganimet ve blok, özellikle de Redstone var."
		"{image:atm:textures/questpics/cataclysm/cataclysm_factory.png width:200 height:100 align:center}"
	]
	quest.747B62A955D0C629.title: "&4Antik Fabrika&r: &4&lMüjdeci&r'ın Evi"
	quest.747BA0DB44A49A4F.quest_subtitle: "Red Delicious Apple + Sand Pear"
	quest.7485BCBE366501DF.quest_desc: [
		"Eğer daha da fazla &7Cevher&r istiyorsak! &7Cevherlerimizi&r &lİşlemenin&r daha iyi bir yoluna ihtiyacımız olacak. Hidrojen işe yaramayacak, &3Hidrojen Klorür'ü&r deneyelim. \n\nBunun için elbette &eKlor'a&r ihtiyacımız olacak! \n\nÇoklu Bloğu nasıl Üreteceğinizi daha ayrıntılı öğrenmek için &6&lTermal Buharlaştırma Tesisi&r Görevine bakın, ancak temelde bir tanesine ihtiyacımız olacak. \n\n(Yavaşça) &eSalamura&r yapmak için bir &6&lTermal Buharlaştırma Tesisine&r &9Su&f besleyin. \n\nO &eSalamurayı&r &7Sodyum&r ve &eKlor&r elde etmek için bir &9&lElektrolitik Ayırıcıya&r atın! &7Sodyum&r, &2&lFisyon Reaktörü&r için faydalıdır... ama &lCevher İşleme&r için değil!"
		"{image:atm:textures/questpics/mek/mek_tier3_1.png width:200 height:100 align:center}"
	]
	quest.7485BCBE366501DF.quest_subtitle: "Aşama 3 Cevher İşleme"
	quest.7485BCBE366501DF.title: "&eKlor&f Yapımı"
	quest.748A01B5607C475B.quest_desc: ["&2Dağ biyomlarının&r kayalık zirvelerinde gizlenen &aYaylı Bot&r, sınırları aşmaya cesaret edenleri bekliyor. Mühendislik ürünü yayları her inişi bir &6fırlatmaya&r dönüştürerek hareketi hem &2kaçışa&r hem de &csaldırıya&r çevirir. \\n\\n- &l1 yeteneği vardır:&r \\n\\n &bYay Atılımı&r: \\n Çömelerek zıplamak, &6kalıntıyı giyen kişiyi&r baktığı yönün &ctersi tarafına&r güçlü bir şekilde fırlatır. Tamamen durmadan önce yapılan her &6iniş&r, giyen kişinin yatay yüzeylerden &asekmesini&r sağlar ve &cdüşme hasarını tamamen yok sayar&r. Etkiyi bilerek &5durdurmak&r için yere değmeden hemen önce &6zıplama&r veya &6çömelme&r tuşunu basılı tut. \\n\\n- &2hareketliliğin&r ve &fgücün&r bir &6kalıntısı&r... her &azıplamanın&r göklere yükselmek için bir fırsat olduğu yerde."]
	quest.748A01B5607C475B.quest_subtitle: "Doğru kullanmayı bilirsen her adım bir sıçrayışa dönüşebilir…"
	quest.748A01B5607C475B.title: "&aYaylı Bot"
	quest.7496B2380A23FDC6.title: "Chaotic Ormansızlaştırma Modülü"
	quest.74ACCEB6DC9EF6F7.quest_desc: ["&dBoşluk &4Omuz Saldırı Silahı &d(V.&4A.S.W.)&r tıpkı Wither versiyonu gibidir ama daha iyisidir! \\n\\nArtık sadece daha fazla hasar verecek olan ve &4Obüs&r'ün vurduğu alanda yerden &dBoşluk Rünleri&r çıkmasına neden olan &dBoşluk &4Obüsleri&r ateşlemektedir. \\n\\nSadece uzun bekleme süresi pahasına, ama bekleyecek vaktimiz var. \\n\\n&4W.A.S.W.&r ve bir &dBoşluk Çekirdeği&r'u &4Mekanik Füzyon Örsü&r içinde birleştirerek üretilebilir."]
	quest.74ACCEB6DC9EF6F7.title: "&dV.&4A.S.W. &d(Boşluk &4Omuz Saldırı Silahı)"
	quest.74AE214747A3DB1A.quest_desc: ["Eşyaların ne kadar basınç tutabileceğini artırır."]
	quest.74AE214747A3DB1A.quest_subtitle: "Sesi aç!"
	quest.74B0308336F5E017.quest_desc: ["&cBlood Chest&r, &ckan&r harcayarak eşyaları onarmak için kullanılır.\\n\\nAncak onarılan eşyalar &dlanetlenebilir&r..."]
	quest.74B0308336F5E017.title: "&cKan&r ile Aletleri Onarmak"
	quest.74B352457BF1541B.quest_desc: ["Eğer sende benim gibiysen ya da aklı başında biriysen Tozlaşmış Kar hoşuna gitmez. Neyse ki &l&3Artifacts&r bize bununla başa çıkmamız için bir alet veriyor! Kar Ayakkabıları! \\n\\nKar Ayakkabıları, Deri Çizmelerin yaptığı gibi Tozlaşmış Kar üzerinde güvenle yürümeni sağlayacaktır. Ayrıca herhangi bir Kar üzerinde yürürken Hız artışı elde edeceksin!"]
	quest.74B352457BF1541B.quest_subtitle: "Ayaklar"
	quest.74B3E4B62FA9565E.quest_subtitle: "Offering Table ile üretilir"
	quest.74B3E4B62FA9565E.title: "Gökyüzünün Arısı"
	quest.74C648FC8733310B.quest_desc: [
		"&9Sea Serpent&r'lar Denizcilerin anlattığı hikayelerdir. &9Okyanusun&r derinliklerinde, &9Sudan&r fırlayan ve tek bir ısırıkla düzinelerce adamı yiyip yutan Dev Canavarlar! \n\n&9Sea Serpent&r'ların uzunluğu birkaç Bloktan 30'un üzerine kadar değişir! Boyutları ayrıca &4Sağlıklarını&r 50'den 250 &4Kalbe&r kadar artırır. \n\nGörünümleri Renk ve Boyut dışında aynı kalır. Hiçbirinin uzuvları yoktur, sadece Baş, Gövde ve Kuyruk. \n\nSize olan Menzilinize bağlı olarak epeyce Saldırıları vardır. Onlara yakınsanız Sizi Isıracaklar ve bu epeyce hasar verecektir! Eğer uzaktaysanız size &9Su Akıntıları&r fırlatacaklardır ve bu zamanla hasar verecektir. &9Suyun&r dışında ancak Menzil içindeyseniz havaya sıçrayıp üzerinize dalabilirler! \n\nBu Saldırı, yakındaki her Yaratığa bir ton hasar ve Geri İtme verecektir."
		"{image:atm:textures/questpics/iceandfire/iaf_serpent.png width:150 height:100 align:center}"
	]
	quest.74C648FC8733310B.title: "&9Sea Serpents"
	quest.74C715F8F24B8BAE.quest_desc: ["Ender Koleksiyonu modülünün eşya filtreleme özelliğine sahip gelişmiş versiyonu."]
	quest.74C715F8F24B8BAE.title: "Filtrelenebilir Ender Toplama Modülü"
	quest.74CD3FC35F245DF2.quest_subtitle: "Blue Yonder + Flickering Sun"
	quest.74D4E51A6381DB24.title: "Gözler Sancak Deseni"
	quest.74FC0DDDB91DB172.quest_desc: ["Hayatı çok daha kolay hale getirmek için AE2, ME verilerinin manipülasyonu, yani depolanan eşyaların dünya çapında taşınması için bir grup cihaz sağlar.\\n\\n&bME Arayüzü&f bu cihazlardan biridir. Bir giriş cihazı olarak Arayüz, herhangi bir eşyanın/sıvının/vb. harici olarak içinden geçirilmesine izin verir. Bunlar daha sonra otomatik olarak arayüzün bağlı olduğu ME Ağında depolanır.\\n\\nBir çıkış cihazı olarak Arayüz, ME ağından kendi dahili envanterine kadar depolanan bir eşyanın belirli bir miktarını stokta tutacak şekilde yapılandırılabilir. Bu, eşyaların daha sonra başka bir oyuncu veya bir boru gibi harici bir kaynak tarafından alınmasını sağlar."]
	quest.74FC0DDDB91DB172.quest_subtitle: "OI, OI, OI! (GÇ, GÇ, GÇ!)"
	quest.74FC0DDDB91DB172.title: "GÇ (Giriş-Çıkış)"
	quest.7503823ACDDB0491.quest_desc: ["Bu ve &aHurafe Şapka&r sana ihtiyacın olabilecek tüm şans tılsımlarını verir!\\n&2Şanslı Atkı&r, Kazmaların için ekstra bir Servet seviyesi sağlar."]
	quest.7503823ACDDB0491.quest_subtitle: "Atkı"
	quest.7503823ACDDB0491.title: "&2Şanslı Atkı&r"
	quest.7509E4093010EA4C.quest_desc: ["&aArayıcı Yay&r, &3Kar Kraliçesi&r'nden düşer. Fırlattığı oklar kendiliğinden hedefe kilitlenir. Artık ok kaçırmak yok!"]
	quest.7509E4093010EA4C.quest_subtitle: "Nişanın Kötü mü?"
	quest.7509E4093010EA4C.title: "&aArayıcı Yay"
	quest.750B6316267CF574.quest_desc: ["Kovanlarınız boşken ve karanlıktayken küçük bir Arı ziyaretçisi olan bir İskelet Gibi Arı bulabilirsiniz. \\n\\nYeni ziyaretçinize bir &8Wither Gülü&r yedirerek onu &8Solmuş Arıya&r dönüştürebilirsiniz. "]
	quest.750B6316267CF574.title: "&8Solmuş Arı Peteği Bloğu&r"
	quest.752DD0BF36B70D88.quest_desc: ["Fırınlar normal &2&lMinecraft&r'ta yeterince hızlı değil, peki Modlu olanda nasıl idare edeceklerini düşünüyorsun!?\\n\\nNeyse ki &7&lIron Furnaces&r onları epeyce hızlandırmaya yardımcı oluyor! \\n\\nAyrıca kendine ait bir Görev sayfası da var, sadece &c&lGenerator Galore&r ile aynı odayı paylaşıyor."]
	quest.752DD0BF36B70D88.title: "&7&lIron Furnaces"
	quest.753B3EF7CC94A6DD.quest_desc: ["Bu, öldüğünüz anlar da dahil olmak üzere &aoyunculara&r özgü bir ganimettir!\\n\\nBunu defalarca ölerek veya PvP mücadelelerinde elde edebilirsiniz."]
	quest.754500BB7FD8C413.quest_subtitle: "Aşama: &b4"
	quest.754B8F1FBCD983C5.quest_desc: ["&eStok Gösterici&r'lar, elinizde &eStok Gösterici&r varken &eStok Bağlantısı&f'e Sağ Tıklanarak &eAğa&r ayarlanabilir. \\n\\nArdından &eStok Gösterici&r'ı yerleştirin ve yakınına bir &cBlaze Ocağı&r veya Koltuğa bir Mob yerleştirerek ona bir &eArdiyeci&r atayın. \\n\\nStereotipik &aYeşil (Green)&r siperliklerinden onların bir &eArdiyeci&r olduğunu anlayabilirsiniz. Artık &eAğımızdan&r &eEşyaları&r görüntülemek ve sipariş etmek için &eArdiyeci&r'a Sağ Tıklayabiliriz. \\n\\n&eEşya&r sipariş ettiğinizde, bunlar &eStok Bağlantısı&r'in altındaki bir &ePaketleyici&f'dan çıkan bir &eKarton Paket&f içine yerleştirilecektir."]
	quest.754B8F1FBCD983C5.title: "&eStok Gösterici"
	quest.75560045ED084900.quest_desc: [
		"Çoğu tohum kolayca üretilebilir; ancak &9Yaratık Tohumları (Mob Seeds)&r yapmak için Nether'a gidip &8Soulium&r toplamanız gerekir."
		""
		"Bulduğunuz taş ve cevherlerle &3Soulium Hançeri&r ve &3Ruh Kavanozu&r üretebilirsiniz. Hançerle yaratıkları öldürerek &bruhlarını&r toplayabilir ve bu ruhları İnfüzyon Sunağı'da ilgili yaratık tohumunu üretmek için kullanabilirsiniz."
		""
		"Alternatif olarak, &3Ruh Çıkarıcı&r makinesine ruh kavanozu koyup yaratık eşyalarını işleyerek de kavanozları doldurabilirsiniz. Örneğin Çürük Et eklemek bir miktar Zombi Ruhu kazandırır."
	]
	quest.75560045ED084900.title: "Yaratık Tohumları Üretimi"
	quest.75619C7174C6703C.quest_desc: ["&#83729EUranyum Tozu&r santrifüjlendiğinde, daha gelişmiş yakıt çubuklarının yapımında kullanılan uranyum izotopları elde edilir."]
	quest.75619C7174C6703C.title: "Uranyum Tozu Santrifüjleme"
	quest.756628F4B7F79446.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_aramber.png width:100 height:150 align:center}"]
	quest.756628F4B7F79446.title: "&cAmaramber&r"
	quest.7574A782DCFB87CE.quest_desc: ["Kivi, başta dekorasyon ve makine yapımı olmak üzere çeşitli alanlarda kullanılır.\\n\\nXyCraft'taki makine kasaları ve diğer cihazlar için Kivi gereklidir. Ayrıca Taş Yontma Makinesinde Xychorium taşlarıyla birleştirilerek dekoratif bloklar üretilebilir."]
	quest.7574A782DCFB87CE.title: "&l&7Kivi"
	quest.757B14D08A9A03C4.quest_desc: ["Çoğu modlu makine gibi Iron Furnaces fırınları da kapsamlı bir yapılandırma menüsüne sahiptir. Ayarlara sol üst köşedeki simgeden ulaşabilirsiniz. Burada giriş, çıkış ve Redstone tetiklemelerini ayarlayabilirsiniz. Redstone modu, fırının ne zaman çalışacağını belirler. Üstteki düğmeler komşu envanterlerle otomatik eşya alım-satımını kontrol eder. Yön kutucukları ise fırının her bir yüzünün giriş, çıkış veya yakıt beslemesi olarak işlev görüp görmeyeceğini belirler. Furnace Settings Linker eşyası, bu yapılandırma ayarlarını diğer fırınlara kopyalamanızı sağlar!"]
	quest.757B14D08A9A03C4.title: "Yapılandırmalar"
	quest.7580037DB8ADEB3C.quest_desc: ["Miyav miyav! Ben bir ineğim..."]
	quest.7580037DB8ADEB3C.quest_subtitle: "Aşama: &a2"
	quest.7597D3D06E761759.quest_desc: ["&eValkyrie Mızrağı&r muazzam bir erişim menziline sahip yakın dövüş silahıdır! \\n\\nTam 10 blok menzil!"]
	quest.7597D3D06E761759.title: "&eValkyrie Mızrağı"
	quest.759B0D6F8C0CC1EF.quest_desc: [
		"Halihazırda sekiz &cBlank Runes&r, merkez açık bırakılmış 3x3 biçiminde, havuzun bir seviye altındaki ilk halkamızı tamamlar. Dört ana yön yuvasına özel rünler gelir; çaprazları şimdilik boş bırakırız — yalnızca yüksek kademelerde önemlidirler."
		""
		"Bu kademedeki altarla, bağlı bir küreyi diğer elimizde de taşıyabilir ve öldürdüğümüz her şeyden doğrudan EV çekerek kendi kanımızı esirgeyebiliriz."
	]
	quest.759B0D6F8C0CC1EF.quest_subtitle: "Altar yükseltmesi."
	quest.759B0D6F8C0CC1EF.title: "Kademe I: Rün Halkası"
	quest.75A66B81C1181F59.quest_desc: ["Forgotten Vestiges, &2&lUndergarden'da&r rastlanan Depthrock tuğlalarından örülmüş küçük harabelerdir. \\n\\nİçleri ganimet dolu çömleklerle doludur! \\n\\nTek yapmanız gereken onları kırmak!"]
	quest.75A66B81C1181F59.title: "Forgotten Vestige"
	quest.75ACC8CF5873F92D.quest_desc: [
		"Beyaz Işıldayan Balmumu Kanalı, beyaz ve '&7Açık Gri&r' çiçekler bize buranın Beyaz Sonsuz Mabet olduğunu söylüyor. \n\nTüm mekan vanilya ve &6bal&r aromalı gibi kokuyor, insanı acıktırıyor. \n\nBeyaz Öz'ü bulmak için odaları takip edin. \n\n6 kozmik kristal varlığı ile savaşmanız gerekecek. Hepsinin 60 kalbi vardır ve hangi silahla vurursanız vurun darbe başına sadece 1 hasar alırlar."
		"{image:atm:textures/questpics/bumblezone/bumble_white1.png width:200 height:100 align:center}"
		"{image:atm:textures/questpics/bumblezone/bumble_white2.png width:200 height:100 align:center}"
	]
	quest.75ACC8CF5873F92D.title: "&fBeyaz Sonsuz Mabet&r"
	quest.75AD0CEBC1335915.quest_desc: ["&dReaktör Kontrolcüsü (Temel)&r reaktörün kalbidir. Reaktör yapısı tamamlandığında arayüzü açmak için kontrol paneline sağ tıklayabilirsiniz.\\n\\nArayüz, reaktörün &9Pasif Soğutmalı&r veya &eAktif Soğutmalı&r olmasına göre farklılık gösterir. Pasif soğutmalı reaktörler yakıt yakarak doğrudan enerji üretir. Aktif soğutmalı reaktörler ise ortaya çıkan ısıyı soğutucuyu buharlaştırmak için kullanır; elde edilen buhar türbine gönderilerek güç elde edilir.\\n\\nPasif bir reaktörün arayüzünde durumu inceleyebilir, atık boşaltma ayarlarını değiştirebilirsiniz. Ayrıca sıcaklık değerlerini, reaktörün ne kadar FE/t ürettiğini ve tik başına ne kadar yakıt yaktığını da görebilirsiniz."]
	quest.75AD0CEBC1335915.quest_subtitle: "Reaktörün Kalbi"
	quest.75B14A09FE39EDDA.quest_desc: ["&aDüzeneklerinizin&r yalnızca düz bir çizgide gitmesini mi istiyorsunuz? O halde &aVinç Taşıtı&r sizin için mükemmeldir! \\n\\n&aVinç Şaftlarını&r &aDüzeneğinizin&r gitmesini istediğiniz çizgi boyunca yerleştirin ve ona &dDönme Gücü&r verin. \\n\\nArdından &aVinç Taşıtınızı&r &aVinç Şaftının&r üzerine yerleştirin, onunla birlikte hareket edecektir. \\n\\n&aVinç Taşıtının&r üzerine Blokları ve &6Makineleri&r de onunla birlikte hareket etmesi için &aYapıştırabilirsiniz! \\n\\n&aVinç Şaftları&r bir &4Redstone Sinyali&r verilerek durdurulabilir. Ayrıca berber dükkânlarındaki o direklere ne kadar benzediklerini fark ettiniz mi?"]
	quest.75B14A09FE39EDDA.quest_subtitle: "Lineer Taşıyıcı"
	quest.75B14A09FE39EDDA.title: "&aVinç Taşıtı"
	quest.75C5BFAEADEB486E.quest_desc: ["&eValkyrie Zırhı&r, &cNetherite Zırhı&r ile aynı değerlere sahiptir. \\n\\nAsıl eğlenceli yanı tüm parçaları (Kask, Göğüslük, Pantolon, Çizme ve Eldiven) aynı anda giydiğinizde ortaya çıkar. \\n\\n5 parçayı da taktığınızda Boşluk (Space) tuşuna basılı tutarak uçabilirsiniz! Ancak bu uçuş kısa sürelidir."]
	quest.75C5BFAEADEB486E.title: "&eValkyrie Zırhı"
	quest.75CBB5BD8C1DFEA1.quest_desc: ["&8Hazne&r, karıştırma, presleme ve iksir üretimi gibi işlemlerde malzemelerin toplandığı bölmedir."]
	quest.75CBB5BD8C1DFEA1.title: "&8Hazne"
	quest.75CD4EE6A542D687.quest_subtitle: "Kristal Arısı + Küllü Madenci Arı"
	quest.75CD4EE6A542D687.title: "Bakır Arısı"
	quest.75CE67D3AA75C798.quest_subtitle: "Red Delicious Apple + Granny Smith Apple"
	quest.75CF9EAB75C3907E.quest_desc: ["&9Dark Gem&r gücünü kullanarak &aDark Tank&r üretebiliriz.\\n\\nBunlar istediğiniz herhangi bir sıvıdan 16 kova depolayabilir, ancak toplayacağınız tüm &ckan&r için fazlasıyla ihtiyacınız olacak.\\n\\nDaha fazla kapasiteye mi ihtiyacınız var? Başka bir Dark Tank ile çalışma masasında birleştirmeniz yeterlidir."]
	quest.75CF9EAB75C3907E.title: "&aSıvıları &cDepolamak"
	quest.75D09040185B0E40.quest_subtitle: "Aşama: &a2"
	quest.75D3F3C1D4A3EAA2.quest_desc: ["Vortex Tube tarafından yapılan ısıyı taşımak için biraz &3Heat Pipe&r (Isı Borusu) yapın."]
	quest.75D3F3C1D4A3EAA2.quest_subtitle: "Taşıyacak ısımız var:)"
	quest.75D3F3C1D4A3EAA2.title: "Isıyı Taşımak"
	quest.75DA0A46E41E6690.quest_desc: ["Her yerde bulunabilen, ancak en nadirlerinden biri olan bir &6Relic&r. \\n\\n&eTecrübe&r, &aDeneyim Dağıtıcı&r ile paylaşılmak içindir. \\n\\n&l- 1 Yeteneği vardır&r \\n\\n&aTecrübe Dispersion&r: \\nBir &6Relic&r ne zaman &eRelic Tecrübe&r kazansa, diğer tüm &6Relic&r'ler de &eTecrübe&r kazanacaktır. \\n\\n- Cömertlik gösteren bir &6Relic&r."]
	quest.75DA0A46E41E6690.quest_subtitle: "Paylaşmak önemsemektir"
	quest.75DA0A46E41E6690.title: "&aDeneyim Dağıtıcı"
	quest.75DD345164EE5CD9.quest_desc: [
		"&6Yüksek Hızlı Ray&r'ler &6Güçlendirilmiş Ray&r'ler gibidir ama elbette daha hızlıdır. Hız kazanmaya yardımcı olmak için &cRay Kiti&r'lerine ihtiyaç duyarlar! Ve virajlarda dikkatli olun."
		"{image:atm:textures/questpics/railcraft/rail_speed.png width:150 height:100 align:center}"
	]
	quest.75DD345164EE5CD9.title: "&6Yüksek Hızlı Ray&r'ler"
	quest.75E4751F7A802A44.quest_desc: [
		"Ne kadar eğlenceli! Bir &cKimyasal&r Alışveriş Listesi! Biz Walter White mıyız? \n\nİlk ve en önemlisi, &aSülfürik Asit&r için, &eSülfürdür&r! Biraz kazın ve &eSülfür Dioksit&r elde etmek için onu &bOksitleyin&r. \n\nAncak biraz daha &bOksijene&r ihtiyacımız olacak, o yüzden &9Su&r ile beslenen bir &9&lElektrolitik Ayırıcı&r ile biraz daha alalım. \nArdından, o yeni bulunan &bOksijeni&r &eSülfür Dioksit&r ile bir &c&lKimyasal Karıştırıcıda&r birleştirerek &cSülfür Trioksit&r elde edin. \n\nSu Buharı elde edene kadar o &eSülfür&r şeyini bir anlığına bırakın! Su Buharı elde etmek için &9Suyu&r bir &c&lDöner &bYoğunlaştırıcıdan&r geçirin. "
		"{image:atm:textures/questpics/mek/mek_tier4_1.png width:200 height:100 align:center}"
	]
	quest.75E4751F7A802A44.quest_subtitle: "Aşama 4 Cevher İşleme"
	quest.75E4751F7A802A44.title: "&aSülfürik Asit&r Yaratımı"
	quest.75EE965CBA598FEA.quest_desc: ["Tarif kafa karıştırıcı görünebilir ama inan bana oldukça kolay. Herhangi bir &dWireless Terminals&r üret, ardından bunları birlikte üreterek &dUniversal Wireless Terminal&r yap. \\n\\nAyrıca &dTerminal&r üzerinde sahip olduğun Genişletilmiş Şablonlar gibi şeyleri de saklayacaktır, bu &b&lAE2&r kullanımı için çok yardımcı olur ancak &6&lATM Star&r için önemli değildir!"]
	quest.75EE965CBA598FEA.title: "&dUniversal Wireless Terminal"
	quest.75F0405FFAB9C080.quest_desc: ["En üst seviye olan Chaotic Aşama tarifler için gereklidir. Kaos Parçası elde etme adımlarını tamamladığınızdan emin olun."]
	quest.75F0405FFAB9C080.title: "Chaotic Çekirdek"
	quest.75FE0B514448865B.quest_desc: ["Yükseltmeler doğrudan Router'a takılır ve bir Router en fazla 5 yükseltme kartı alabilir. Yükseltmeler Router'daki tüm uyumlu modülleri etkiler ve genellikle üst üste istiflenebilir."]
	quest.75FE0B514448865B.title: "&lYükseltmeler"
	quest.7604D8B3C9FCCFD9.quest_desc: ["Refined Storage sisteminin 'Sabit Sürücüleri'ni üretme vakti! Bunun için bir &9Depolama Diski&r oluşturmak üzere &6Depolama Parçası&r ile birleştireceğiniz bir &9Depolama Kasasına&r ihtiyacınız olacak. İstediğiniz boyutta bir parça üretip ardından kasasıyla birleştirerek diskinizi tamamlayın.\n\n&9Depolama Diski&r, bir &9Disk Sürücüsü&r içine takıldığında eşyalarınızı sanal ortamda depolamak için kullanılır. Depolama diski yere atıldığında kaybolmaz (despawn olmaz)."]
	quest.76062D375E4CC8DD.quest_desc: ["Hem filtreleme hem de sırayla dağıtım (Sırayla Seç) özelliklerini birleştiren modül! Örneğin Mystical Agriculture tohumlarını belirli bir sırayla ekmek ve düzenlemek için idealdir."]
	quest.76064465104B1C28.title: "Draconic Kalkan Kapasitesi Modülü"
	quest.76071C22A73A2026.title: "&cTertium Tarım Arazisi"
	quest.760864EE43FB33AC.quest_desc: [
		"&bHippocampus&r temelde Denizatlarının olmasını umduğumuz şeydir. \n\nAtlar gibi Kafaları ve ön Toynakları varken arkaları daha çok Balık gibidir. Ayrıca tüm Bedenleri &bPullarla&r ve Yüzgeçlerle kaplıdır. \n\nKırmızı, Turuncu, Sarı, Açık Yeşil, Yeşil, Açık Mavi ve Mavi renklerinde gelirler! \n\n&bHippocampus&r'ün 20 Kalbi vardır ve tamamen Pasiftirler. Karşılık vermeyeceklerdir! \n\nÖlüm anında &bShiny Scales&r ve çok nadiren de olsa &bHippocampus Fin&r (Hippocampus Yüzgeci) Düşüreceklerdir."
		"{image:atm:textures/questpics/iceandfire/iaf_hippocampus.png width:150 height:100 align:center}"
	]
	quest.760864EE43FB33AC.title: "&bHippocampus"
	quest.7617737FC179EA1A.quest_desc: ["&bFroststeel&r zırhı, Elmas zırhtan bir tık düşük olsa da hatırı sayılır bir Geri İtme Direnci (Knockback Resistance) sağlar. \\n\\nFakat kullanıcıyı yavaşlattığı için hareket kabiliyetinizden ödün vermeniz gerekir!"]
	quest.7617737FC179EA1A.title: "&bFroststeel&r Zırhı"
	quest.7618153D6613790E.title: "&6Thermal Springstone Scythe"
	quest.761D21C6FBD13EE1.quest_subtitle: "Elmas Arısına Peridot yedirin"
	quest.761D21C6FBD13EE1.title: "Peridot Arısı"
	quest.762581CAE5F5DDC1.quest_desc: [
		"Bir Sihirli Modu ne kadar hoş! &d&lArs Nouveau&r, &5Unobtainium&r ve &6Allthemodium&r'u birlikte üretmek için kullanacağımız Mod! \\n\\nBüyüleyici Aparat, şu anda burada birçok tarif için kullanılan çoklu bloktur. Esrarengiz Çekirdek ile başla, ardından Büyüleyici Aparat'ı onun üzerine koy. Ardından, Büyüleyici Aparatının etrafına aynı Y Seviyesinde Kaideler yerleştir. \\n\\nDaha sonra Eşyaları Kaidelere istediğin sırayla yerleştir, Kaynak'ı yakınında bulundur ardından Kaynak Cevherini Aparata yerleştir sonrasında üretmeye başlayacak! Ardından &5Unobtainium&r-&6Allthemodium&r Alaşım Külçeni üretmiş olacaksın!\\n"
		"{ \"text\": \"ARS NOUVEAU GÖREV SERİSİ\", \"color\": \"#55FF55\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6AEDA2F9BEB57759\" } }"
	]
	quest.762B8309E1A31B99.quest_desc: ["Her yükseltme +0.5 Zırh Savunması ve +1 Zırh Sertliği ekler."]
	quest.762B8309E1A31B99.quest_subtitle: "Maks: 4"
	quest.762C54C261ED5D29.quest_subtitle: "Teak + Mahogany"
	quest.763A19067AEEF6D5.quest_subtitle: "+2 Şans"
	quest.763AE58CF620695E.quest_desc: ["Bu &9Mühendis'in Taslağı&r, diğer pek çoğu gibi Üretilebilir. \\n\\n&8&lImmersive Engineering&r kendine özgü Sancak Desenleri ekler; bunları üretmek için &9Mühendis'in Taslağı&r gerekir."]
	quest.763AE58CF620695E.title: "&9Afiş Deseni Şemaları"
	quest.763EB5C911D7E78C.quest_desc: ["İnfüzyon teknolojisinin zirvesi: Chaotic Aşama. Bu aşamaya ulaştığınızda moddaki en güçlü aletleri, zırhları ve reaktör bileşenlerini üretebilirsiniz."]
	quest.763EB5C911D7E78C.title: "Chaotic Aşaması"
	quest.763FB27929E053BE.quest_desc: ["&9Filtre &8Yükseltmeleri&r sadece &b&lElektrikli Pompalarda&r kullanılır. \n\n&b&lPompalar&r aynı şekilde çalışacak, ancak &9Su&r almak yerine &9Ağır Su&r alacaklar. \n\n&9Ağır Su&r, &2&lFisyon Reaktörü&r Yakıtı için gerekli olacaktır!"]
	quest.763FB27929E053BE.title: "&9Filtre &8Yükseltmesi"
	quest.76406EFFF8CBA6B4.quest_desc: ["Elmaslar alet yapımı için kullanılabilecek en iyi malzemelerden biridir ve aynı zamanda Twilight Forest gibi yeni boyutları ziyaret etmeni sağlar!"]
	quest.76406EFFF8CBA6B4.title: "&bElmasları&r Bulduk!"
	quest.764609E41957DA69.quest_subtitle: "6,561 Zümrüt Bloğu"
	quest.7649D648A3688D4A.quest_desc: ["Çekici Yükseltmesi, Çekmecelerin eşyaları herhangi bir taraftan çekmesini sağlar."]
	quest.76516C997B63905A.quest_subtitle: "Aşama: &b4"
	quest.76558D23A70AFF78.title: "&bIce&r Upgrade Orb"
	quest.7655E1C6C5E5469F.quest_subtitle: "Menzil: &a18&r blok"
	quest.7655E1C6C5E5469F.title: "&2Prudentium Büyüme Hızlandırıcısı"
	quest.7658C1C663394E85.quest_desc: ["ATM içinde pek çok yardımcı komut vardır. İşte birkaç tanesi:\\n\\n&e/sethome&r (evin adı) | /home (ad) kullanarak geri ışınlanabileceğin bir ev ayarlamana izin verir. Örnek: /sethome farm - sonra /home farm ile ışınlan.\\n\\n&e/spawn&r | Bu seni ana dünyanın başlangıç noktasına ışınlayacaktır.\\n\\n&e/rtp&r | 'Rastgele Işınlanma' sizi dünyada rastgele bir yere ışınlar.\\n\\nNot: Bu komutların bekleme süreleri ve sınırları vardır. Bunları değiştirmek istersen, burada bulabileceğin config dosyasını düzenleyebilirsin:\\n\\n - Tek Oyuncu için | &osaves/(kaydın adı)/serverconfig/ftbessentials.snbt&r\\n\\n - Sunucular için | &oworld/serverconfig/ftbessentials.snbt&r"]
	quest.765CD913CC3896B2.quest_desc: ["&lAşama 4&r ve &l5 &cFire Dragon&r'lar, yüzeyin derinliklerinde kendi &cMağaralarında&r güvenli bir şekilde mühürlenmiş olarak bulunur. Yalnızca en aptallar oraya inmeye ve onlarla savaşmaya istekli olur! \n\n&cFire Dragon Cave&r'leri devasa Yapılardır ancak yine de kapalıdırlar. Bu, &c&lEjderhanın&r kolayca Uçup kaçamayacağı anlamına gelir... ama siz de kaçamazsınız. \nBu devasa &c&lEjderhalarla&r savaşmak istiyorsanız en iyi Ekipmanlara, Büyülere ve İksirlere ihtiyacınız olacak. Özellikle &cYanıktan&r Ölmenizi Engelleyecek olanlara! \nSaldırıları daha fazla hasar verirken, &cElement Saldırıları&r daha da yayılır ve eskisinden çok daha fazla &cYakar&r! Bir &3&lMuhafız&r ile aynı &4Sağlığa&r ve tam bir &cNetherite&r sete denk &7Zırh Puanına&r sahip olduklarını da unutmamak gerek! \n\nEğer bir &lAşama 4&r veya &l5 &cDişi Fire Dragon&r Öldürürseniz (ve üzerinde Şişe kullanmazsanız) bir &cEgg&r Düşürebilir. Bu &cDragon Egg&r'leri &2&lVanilla&r &dDragon Egg&r'lerinden çok daha iyidir çünkü..."]
	quest.765CD913CC3896B2.title: "&lStage 4-5 &cFire Dragon"
	quest.765F6A5A9779CF6D.quest_desc: ["Havabulutları &l&eAether'in&r dört bir yanında bulunur. Gökyüzü boyutunda olduğumuz düşünülürse bu gayet doğal! \\n\\nSoğuk Havabulutları ve &eAltın Havabulutları&r benzer şekilde çalışır. İçlerine hafifçe batarsınız; tıpkı &6bal&r gibi ama daha az yapışkandır. Ayrıca düşme hasarını tamamen sönümlerler. \\n\\n&bMavi Havabulutları&r ise farklıdır: Üzerlerinde zıpladığınızda gökyüzüne fırlatılırsınız. Shift tuşuna basarak içlerinden aşağı süzülebilirsiniz. \\n\\nHavabulutlarını her yerde bulup toplayabilirsiniz. Ayrıca Soğuk Havabulutlarını &5büyüleyerek&r &eAltın Havabulutları&r, &bDondurucu kullanarak&r ise &bMavi Havabulutları&r elde edebilirsiniz."]
	quest.765F6A5A9779CF6D.title: "Havabulutları"
	quest.76660075F254597E.quest_desc: ["&#F5B758Gelişmiş Yükseltme&r, takılan her yükseltme için maksimum enerji kullanım sınırını &#EDE02F+16 EU/t&r artırır."]
	quest.766C80E5D7B7A916.quest_subtitle: "Birini seç!"
	quest.766EEB89C6DF3575.quest_desc: ["Eternal Stella, Smithing Table'da bir Item ile birleştirilerek o Item'ı Unbreakable yapmak için kullanılabilir. Onu Alloy Tools üretmek için de kullanabilirsin! \\n\\nÖnce, içinde bol miktarda Materials bulunan bir Tier 3 Forge gerekir. \\n\\nArdından üç Xpetrified Orbs gerekir; bunları elde etmek için bir Black Hole'u Items ile beslemelisin. \\n\\nAyrıca madencilikle bulacağın bir Stellarite Piece ve bir &6Allthemodium Ingot&r gerekir."]
	quest.7671AFAA1EFD287F.quest_desc: ["&6&lForge&r için &bAureal&r üretimini otomatikleştirmek mi istiyorsunuz? 2 &bArcane Crystal Block&r, &6Arcane Polished Darkstone&r ve &cMundabitur Dust&r'a ihtiyacınız var! \\n\\n&6Arcane Polished Darkstone&r'ı yerleştirip üzerine iki &bArcane Crystal Block&r koyun. \\n\\nBu 1x3x1 yapıyı kurduktan sonra &cMundabitur Dust&r ile sağ tıklayarak &bObelisk&r oluşturun! \\n\\nBunları &6&lForge&r yapısında kürsülerin yerine koyarak &bAureal&r üretimini otomatikleştirebilirsiniz."]
	quest.7671AFAA1EFD287F.title: "&bArcane Crystal Obelisk"
	quest.7678B5DD1339833E.quest_desc: ["Güneş Paneli, güneşe doğrudan erişim sağlandığında FE üretir. Ancak, önündeki engelleri görmezden gelmek için &7Ender'in Lensi&r kullanabilirsin."]
	quest.767E4FC03B6F6534.quest_desc: ["İnvar Külçeler &7Demir&r ve &7Nikel&r ile yapılır. \\n\\nBu Alaşımların (Alloys) birçoğu gibi bunlar da &8&lIE&r içinde pek kullanışlı değildir."]
	quest.767E4FC03B6F6534.title: "&7İnvar Külçesi"
	quest.768C07D1B5EB1FEB.quest_desc: ["Bunlar Soğuk Okyanus Harabeleri'ndeki şüpheli kum ve çakıllardan elde edilebilir."]
	quest.768C07D1B5EB1FEB.quest_subtitle: "Soğuk Okyanus Harabeleri Şüpheli Blokları"
	quest.769B23E692CBA16B.quest_desc: ["Bildiğimiz kova ve tekneler gibi çalışırlar; tek farkı &l&eAether&r tahtasından yapılmış olmalarıdır!"]
	quest.769B23E692CBA16B.title: "&2Gökkökü&r Tekne ve Kova"
	quest.769D5DE66D13B256.quest_desc: ["Bu görev, AllTheMods Modpack'lerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk katılımcısı&r tarafından oluşturulmuştur.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu görevin &6AllTheMods Ekibi&r tarafından yayınlanmayan veya açık bir izin verilmeyen hiçbir halka açık pakette kullanılmasına izin verilmez.\\n\\nBu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.76A0592F4C294545.quest_desc: ["Sawmill (Hızar), kütükleri işleyerek talaş çıkarır ve normal üretimle elde edeceğinizden daha fazla kalas sağlar. Talaş, kağıt yapımında kullanılabilir.\\n\\n - Fustic Kütükleri ek olarak Fustic verir.\\n - Brazilwood ve Logwood Kütükleri ise ek olarak Hematoksilin (Haematoxylin) verir."]
	quest.76A0592F4C294545.quest_subtitle: "Ben de İsterdim"
	quest.76A0592F4C294545.title: "Kesim İşlemi"
	quest.76A3A2A97AB66C43.quest_desc: ["Bir &9Box of Eternal Closure&r içine hapsettiğiniz bir Vengeance Spirit'ten bir Spawn Egg mi yaratmak istiyorsunuz?\\n\\n&9Spirit Reanimator&r tam olarak bunu yapar. Ona bolca &cBlood&r, bir yumurta ve elbette Spawn Egg oluşturmak istediğiniz ruha sahip &9Box of Eternal Closure&r verin; Spawn Egg yaratmaya çalışacaktır!\\n\\nNot: Bazı moblar Spawn Egg oluşturmak için kullanılamaz."]
	quest.76B1C5AFC5D6B7CF.quest_desc: ["Time Wand, tıpkı Time in a Bottle gibi blokların çalışma hızını 128 katına kadar katlayabilir. Time in a Bottle'dan farklı olarak biriken zaman yerine FE enerjisi ve Time Fluid tüketir, bu da dolumunu son derece kolaylaştırır.\\n\\nAncak sahte oyuncu (fake player) otomasyonları için kara listeye alınmıştır. Bunu otomatikleştirmenize izin verilmemektedir!"]
	quest.76B1C5AFC5D6B7CF.quest_subtitle: "Time in a Bottle'ın Kuzeni"
	quest.76BFC5815FC6565C.quest_desc: ["&9&lStarlight&r boyutunda zaman zaman gökyüzünden &5Meteor Yağmuru&r yağar. \\n\\nMeteorların düştüğü noktalarda değerli &5Aethersent&r cevherleri ve uzaydan gelen tehlikeli yaratıklar oluşur!"]
	quest.76BFC5815FC6565C.title: "&5Meteor Shower"
	quest.76C63670624C3C56.quest_desc: ["&c&lGenerator Galore&r bize tonlarca yardımcı ve basit Güç Jeneratörleri verir! \\n\\nBazıları daha güçlü olmak için birbiriyle bile birleştirilebilir. \\n\\nOnlar için bir Görev sayfası var, sadece &7&lIron Furnaces&r ile ev arkadaşı."]
	quest.76C63670624C3C56.title: "&c&lGenerator Galore"
	quest.76CBFA38D021AC95.quest_desc: ["&dYel Değirmenleri&r &9Su Çarklarına&r göre biraz daha karmaşıktır, ancak aynı zamanda daha fazla özelleştirme ve tabii ki Hız ile Stres Birimi sağlarlar! \\n\\nİlk olarak, &dYel Değirmeninin&r kalbi olan &dYel Değirmeni Rulmanı&r'e ihtiyacınız olacak. Bu Blok &dDönme Gücü&r'ı dışarı aktaracaktır. Ayrıca &dYel Değirmenini&r çalıştırmak için kullanacağımız şey de budur! \\n\\nArdından, asıl &dYel Değirmeni&r kısmını yapmak için Bloklara ihtiyacınız olacak. Bloklar otomatik olarak &dRulman&r'e yapışır, ancak &dYel Değirmeninin&r geri kalanı için &aTutkal&r kullanmanız gerekir. &dYel Değirmeni Yelkenleri&r hariç, onlar otomatik olarak takılır! \\n\\nAyrıca &dYel Değirmeni Yelkeni&r benzeri en az 8 Bloğa ihtiyacımız olacak, bunlar &dYel Değirmeni Yelkenleri&r veya Yün. Ne kadar çok olursa &dYel Değirmeni&r o kadar hızlı döner! \\n\\nHer şey hazır olduğunda, çalıştırmak için Boş El ile &dRulman&r'e Sağ Tıklamanız yeterlidir."]
	quest.76CBFA38D021AC95.title: "&dYel Değirmenleri"
	quest.76CDC18D7A208512.quest_desc: ["&2&lUndergarden'da&r yer alan &cRot yaratıkları&r (&cRotling&f, &cRotwalker&f, &cRotbelcher&f ve &cRotbeast&r) size &cUtherium&r bulaştırabilir. \\n\\nBulaşma gerçekleştiğinde açlık barınızın üstünde kırmızı göstergeler belirir. 4 bar dolduğunda ekranınızda kırmızı damarlar görünür. 8 barda durumun ciddiyetini belirtmek için barlar titremeye başlar. 10 bara ulaştığında hepsi parlar ve canınız yanmaya başlar. \\n\\n&cRot&r (Çürüme), bar tamamen dolmadığı sürece zamanla kendiliğinden geçer. Ayrıca kurtulmak için Mysterious Totem'lerden Saflık (&bPurity&r) etkisi alabilir veya &3Rogdorium&r yiyebilirsiniz. \\n\\nBunların her ikisi de Y=0 altındaki Depths biyomunda bulunur. Oraya ulaşmak için &aForgotten Kazma&r veya &6Allthemodium Kazma&r gibi üst düzey bir kazmaya ihtiyacınız var. \\n\\n&cRot&r etkisinden korunmanın tek yolu zırhınızı Infuser bloğunda &3Rogdorium&r ile işlemektir."]
	quest.76CDC18D7A208512.title: "Uyarı"
	quest.76CDF08465700AA2.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_silent.png width:100 height:150 align:center}"]
	quest.76CDF08465700AA2.quest_subtitle: "Antik Şehirler"
	quest.76CDF08465700AA2.title: "Silence Zırh Süsü"
	quest.76CECFB244F39F18.quest_desc: [
		"Güç kaynağının üzerine bir &3Energy Importer&r yerleştirip Logic Cable ile bir &3Energy Interface'e&r bağlayın! Variable Card'ları takıp ayarladıktan sonra profesyonelce enerji aktarımı yapabilirsiniz! \\n\\nNot: Akı Prizi ve Akı Noktası bloklarıyla doğrudan enerji aktarımı yaparken nadiren sorun yaşanabileceğinden dikkatli olmanız önerilir."
		"{image:atm:textures/questpics/logistics/id_energy.png width:200 height:50 align:center}"
	]
	quest.76CECFB244F39F18.title: "&3Enerji İçe Aktarımı"
	quest.76E94639E90FEB4E.quest_desc: ["Karanlık bir alana birkaç boş &eGelişmiş Arı Kovanı&r yerleştirin. Gece olduğunda arılar zamanla içeri taşınacaktır."]
	quest.76E94639E90FEB4E.quest_subtitle: "Karanlıktaki boş kovanlarda ortaya çıkar"
	quest.76E94639E90FEB4E.title: "İskelet Gibi Arı"
	quest.76EA017B12E8F01B.quest_desc: ["Bu bölüm, enerjinizi depolayabileceğiniz farklı yöntemleri gösterir."]
	quest.76EA017B12E8F01B.title: "&f&lEnerji Depolama"
	quest.76F14C2B866B4EAD.quest_desc: ["&3&lOtherside&r, &9&lMuhafız&r da dahil olmak üzere &3Sculk &fve &3Sculk yaratıklarının&r doğum yeridir. \n\nBurada onun pek çok uzak kuzenini bulacaksınız, ama endişelenmeyin &3&lOtherside'ın&r birkaç artı yönü de var! \n\nBulabileceğimiz pek çok yeni Yapı Bloğu ve Eşya var ve tonlarca &aXP&r için her yerde &3Sculk&r var! \n\nBu yüzden Çapanızı hazırlayın ve &3&lOtherside'a&r doğru maceraya atılın!"]
	quest.76F14C2B866B4EAD.quest_subtitle: "Merhaba..."
	quest.76F14C2B866B4EAD.title: "&3&lOtherside"
	quest.76F675A898EAB4E8.quest_desc: ["&dSal Ammoniac&r, eşya üretimi ve çoğaltılmasında kullanılan &eAlchemical Sulfur&r sentezinin en kritik bileşenidir. \\n\\n&dSal Ammoniac&r üretmek için bol miktarda &9Su&r gerekecektir."]
	quest.76F675A898EAB4E8.title: "&dSal Ammoniac"
	quest.770C0975CA61CE46.quest_desc: ["&bGlacite&r cevheri, Permafrost Forest biyomlarının altındaki derin mağaralarda bulunur. \\n\\nDondurucu soğuklara ve dondurma etkisine karşı koruma sağlayan zırh ve alet yapımında kullanılır!"]
	quest.770C0975CA61CE46.title: "&bGlacite"
	quest.77145113CD5B26FB.quest_desc: ["Agronomic Sourcelink bitki olarak Source Berry kullanıldığında diğer ürünlere kıyasla daha fazla Source üretir. \\n\\nAyrıca 3x3'lük alandaki toprak ve çimleri Mycelium'a dönüştürür ve boş alanlarda mantar üretir."]
	quest.77145113CD5B26FB.quest_subtitle: "Yiyecek ve Meyvelerden Source Üretimi"
	quest.7725CB7D0AE55180.quest_desc: [
		"Advanced AE; Applied Energistics 2 için, ME sisteminizi yönetirken kullanıcı deneyimini iyileştirmeye ve oyun sonu sistemlerinin sınırlarını genişletmeye odaklanan bir eklentidir."
		""
		"Bir makinenin belirli yüzeylerine ürün iletebilen bir Kalıp Sağlayıcı'dan, sınırsız üretim işi çalıştırabilen ve eş işlemcileri bu üretimler arasında ortaklaşa kullandırabilen çoklu blok bir bilgisayara kadar pek çok yenilik sunar."
	]
	quest.7725CB7D0AE55180.title: "Advanced AE"
	quest.772C65FC32AECD6B.title: "Barış Sancak Deseni"
	quest.7731623EA92027D9.quest_desc: [
		"Toplam 100 rüne ulaşırız; önceki halkaların üstüne, daha derinde bir halka daha eklenir. Bir &cHellforged Block&r dört ana yönün her birini tamamlar ve altar &cKademe IV&r'e yükselir — Vitaemancy'deki en yıkıcı ritüellerin yuvası."
		""
		"Burada &cDominus Orb of Vitae&r'i üretiriz — ilk küremizin verdiğinin bin katı olan &e5,000,000 EV&r Anima."
	]
	quest.7731623EA92027D9.title: "Kademe IV: Başbüyücünün Küresi"
	quest.77382D4114E901CB.quest_desc: ["&bHortum Makarası&r, dolu Sıvı Kaynak Bloklarını almak ve yerleştirmek için kullanılır, evet sadece &9Su&r değil. \\n\\nİlk olarak, bir taraftaki &8Şaft&r ile &bHortumun&r ne kadar aşağı veya yukarı gideceğini ayarlayın. İster bir &6Dişli&f, &8Şaft&r, ister en kolayı olan &dDöndürme Kolu&r ile. \\n\\nArdından, &bHortum Makarası&r'in diğer tarafına birkaç &bAkışkan Borusu&r koyabiliriz. &bMekanik Pompalar&r ile &bHortum Makarasının&r &bSıvı&r Kaynaklarını toplayacağını mı yoksa yerleştireceğini mi seçebiliriz. \\n\\n&bHortum Makarası&r yalnızca 1.5 Kova veya 1500mB'lık bir Envantere sahiptir, ancak &bSıvılar&r diğer Envanterlere veya &bAkışkan Tanklarına&r &bAktarılabilir! \\n\\nEğer &9Su&r Kaynağı sonsuzsa, &bHortum Makarası&r Kaynak Bloklarını almayacak ancak &bSıvı&r çekmeye devam edecektir. \\n\\nBu aynı zamanda &cLav&r Kaynak Blokları ile de çalışacaktır, ancak bunlar sonsuz değildir. Bu yüzden orada neredeyse sonsuz olduğu için &c&lNether&r'a göz atmak isteyebilirsiniz!"]
	quest.77382D4114E901CB.title: "&bHortum Makarası"
	quest.7741905EA8380B25.quest_desc: ["&aZırh Süslemeleri&r zırhına süs eklemek için kullanılan eşyalardır! Bu işlem Demirci Masası'nda yapılabilir.\\n\\nBir tarifi olsa da, süslemelerin çoğu ganimet sandıklarından veya arkeoloji kazılarından nadiren bulunur. Bir tane bulduğunda, daha fazlasını oluşturmak için tarifi kullanarak Şablonu çoğaltabilirsin!"]
	quest.7741905EA8380B25.title: "&dZırh Süslemeleri&r"
	quest.7744BEC5CD328262.quest_desc: ["Su altında Blokları kazabilmek için bu Yükseltmeye ihtiyacınız olacak. \n\nAyrıca size Suya Uyum (Aqua Affinity) kazandırır! (Bu, &bSuyun&r içinde olmanın Kazma hızınızı yavaşlatmadığı anlamına gelir.)"]
	quest.774D61FEFABEFD9A.quest_desc: [
		"Çığlık Solucanları, &9Derin Yer Altı Topraklarında&r &3Enfekte Sculk'a&r basıldığında oluşurlar. \n\n100 &4Kalbe&r sahip Mini patronlardır. \n\nÇok yaklaşırsanız sizi ısırırlar ve tonla Hasara neden olurlar! Ama çok uzağa giderseniz tekrar toprağın altına çekilirler. \n\nBiraz &aXP&r dışında hiçbir şey düşürmezler, bu zahmete değeceğini sanmıyorum."
		"{image:atm:textures/questpics/deepndark/dnd_worm.png width:100 height:200 align:center}"
	]
	quest.774D61FEFABEFD9A.title: "Çığlık Solucanı"
	quest.775AB10F8196F27B.quest_desc: ["&4Mekanik Göz&r, &4&lMüjdeci&r ile savaşmanız için sizi &4Antik Fabrika&r'ye götürecektir."]
	quest.775AB10F8196F27B.title: "&4Mekanik Göz&r"
	quest.775D176081DD75F5.quest_desc: [
		"Yapı tamamlandığında Türbin Kontrolcüsü (Temel) bloğuna sağ tıklayarak türbin arayüzünü açabilirsiniz.\\n\\nBurada türbinin tüm istatistiklerini görebilirsiniz. Üzerlerine geldiğinizde detaylı bilgiler görüntülenecektir.\\n\\nSol alt kısımda &9Akış Hızı&r seviyesini kontrol etmek için iki ok bulunur. Bu, türbine ne kadar buhar pompalanacağını belirler. Uygun değeri bulmak için reaktörünüzdeki &dBuhar Çıkışı&r değerini referans alabilirsiniz. "
		"{image:atm:textures/questpics/extremereactors/turbineui.png width:200 height:150 align:1}"
	]
	quest.7766E66A14643F4D.quest_desc: ["&6Uyanış&r, &2&lMystical Agriculture&r'a nispeten yeni bir eklentidir. &6Awakening Ritual&r ile &6Awakened Essence&r yapabilirsiniz. \\n\\nSonra bunları Külçelerle birleştirerek bu Bloku elde edebilirsiniz!"]
	quest.7766E66A14643F4D.title: "&6Uyandırılmış Supremium Külçesi Bloğu"
	quest.7770F0D62457096D.quest_desc: ["Bu görevler Drone'lar hakkında olmasa da, onlar harikadır! İsterseniz onları kullanmayı bir araştırın."]
	quest.7770F0D62457096D.title: "Drone'ları Programlamak"
	quest.7778937DF377C1B4.quest_desc: [
		"Bu, otomatik olarak &aEnerji&r üretmek için harika bir seçenektir."
		""
		"&b&lRüzgar Jeneratörünün&r ürettiği &aEnerji&r miktarı Y Seviyesine bağlıdır."
		""
		"Bu deniz seviyesinde yaklaşık 90FE/t üretir ve üretebileceği maksimum miktar 360FE/t'dir!"
		""
		"&b&lRüzgar Jeneratörünün&r ayrıca çalışması için üzerinde &bGökyüzü&r olması gerekir, tıpkı bir Fener gibi!"
	]
	quest.7778937DF377C1B4.quest_subtitle: "Rüzgardan Güç Üretir"
	quest.7778937DF377C1B4.title: "&b&lRüzgar Jeneratörü"
	quest.77793642678CB886.quest_desc: ["Bir &c&lFire Dragon&r Çıkarmak oldukça kolaydır. \n\n&cYUMURTAYI&r &cATEŞE&r VERİN! \n\nEn kolay yolu &cEgg&r'yi &cNetherrack&r üzerine Yerleştirmek ve ardından Çakmaktaşı ve Çelik ile &cAteşe&r vermektir. \n\n6 Dakika sonra &cEgg&r Çatlayacak ve size Evcilleştirilmiş &c&lBaby Fire Dragon&r Doğacaktır! \n\nVe hayır, &c&lBaby&r &cAteşten&r hasar almayacaktır, o bir &c&lFire Dragon&r!"]
	quest.77793642678CB886.title: "&cYumurtanızı&r Pişirmek"
	quest.777BB82B56038ED3.quest_desc: ["&4&lMorgan&r'ın Hasarını artırmanın tek yolu Köylüleri öldürmektir. Bebek Köylüler, &4&lMorgan&r'ın Hasarını daha da fazla artırır! \\n\\nUmarım bir çiftlik kurmuşsundur. Çok, çok, çok sayıda Köylü ölümünün ardından fullemiş bir &4&lMorgan&r'a sahip olacaksın. \\n\\nAyrıca &4&lMorgan&r ile Sağ Tık'ı basılı tutarak özel bir saldırı yapabilirsin."]
	quest.777BB82B56038ED3.title: "&4&lMorgan&r'ı En Yüksek Seviyeye Çıkar"
	quest.7798BC7C5112D6FB.title: "&bGlacite Tozluk"
	quest.779CA0C49F93C4F9.quest_subtitle: "59,049 Obsidyen"
	quest.77A8E8122870BBCE.quest_desc: ["Bu teknik olarak bir Spawn Egg değil, ancak mobları Spawner'lara bağlama yeteneği nedeniyle bunu buraya dahil ediyorum. Bu Lead'i nasıl elde edeceğini öğrenmek için &5&lApothic Enchanting&r bölümüne göz at."]
	quest.77A8E8122870BBCE.quest_subtitle: "Bu bir Spawn Egg değil!"
	quest.77AD61FCA9BC9AFB.quest_desc: ["14 Büyü Yuvası!"]
	quest.77AD61FCA9BC9AFB.title: "&3Vibranium Büyü Kitabı"
	quest.77B185799366ACD2.quest_desc: ["Blok Filtresini ayarlamak için sadece yanlışlıkla kırılmasını engellemek istediğiniz bloğa Blok Filtresi ile tıklamanız yeterlidir. \\n\\nHer Filtre sadece 1 blok tutabilir, bu nedenle Arı Kovanları, Kablolar, Sandıklar, Fırınlar ve İksir Stantlarının artık yanlışlıkla yok edilmemesini istiyorsanız 5 adet Blok Filtresine ihtiyacınız olacaktır. \\n\\nİçindeki Bloğu, sadece elinizdeyken farklı bir bloğa tıklayarak değiştirebilirsiniz."]
	quest.77B5B23A2C01ED7E.quest_desc: ["&9Kineticator&r, etraftaki eşyaları ve tecrübe puanlarını çeken bir mıknatıs görevi görür.\\n\\n&eReverse Kineticator&r ise tam aksine eşyaları ve tecrübe puanlarını kendinden uzağa iter."]
	quest.77B5B23A2C01ED7E.quest_subtitle: "Mıknatıslar"
	quest.77B5B23A2C01ED7E.title: "Kineticators"
	quest.77B6A7151B3E5980.quest_desc: ["&aDamar Madenciliği&r, sınırlı bir FTB Ultimine özelliğidir. \n\nCevherleri veya Odunları Kazdığımızda, ona bağlı olan aynı Bloklar onunla birlikte kırılacaktır. \n\nÇok fazla zaman kazandırır... ama aynı zamanda FTB Ultimine de var... bu yüzden."]
	quest.77B6A7151B3E5980.quest_subtitle: "Meka-Aleti"
	quest.77B6A7151B3E5980.title: "&aDamar Madenciliği &7Modülü"
	quest.77BE3D9D274F72F1.quest_desc: ["&5Tren İstasyonları&r &5Trenler&r için en önemli Bloklardır! Onlara &5Trenler&r yapmak, &5Trenleri&r parçalamak ve Zamanlamak için ihtiyacımız var! \\n\\nOnları kullanmak için bir &7Tren Rayı&r seçmeniz gerekecek. Elinizde &5Tren İstasyonu&r tutun ve bir &7Tren Rayı&r'e Sağ Tıklayın. \\n\\nBir &5Tren İstasyonu&r'ın yerleştirilebileceği maksimum mesafeyi bilmiyorum, en az 10 Blok! (Test etmek için o kadar alanım yok). \\n\\nYerleştirildikten sonra en üstteki Metin Çubuğu ile yeniden adlandırabilirsiniz. \\n\\nİlk &5Traininizi&r yapmaya başlamak için \"Create New Train\"e de Tıklayabilirsiniz. Tıkladıktan sonra &7Raylardan&r biri &9Mavi&r görünecektir, bu &5Boji&r yerleştirebileceğiniz &7Raydır&r. \\n\\nBir &5Boji&r, yani &5Tren Tekerlekleri&r yapmak için o &7Raya&r bir &5Tren Kasası&r ile Sağ Tıklayın. Tasarımını değiştirmek için tekerleklerin kendisine Sağ Tıklayın. Sonra yapabilirsiniz..."]
	quest.77BE3D9D274F72F1.title: "&5Tren İstasyonları"
	quest.77C6667B4C37589C.quest_desc: ["Makine yükseltmeleri, &aMystical Agriculture&r makinelerinin çalışma hızını artırmak için kullanılır."]
	quest.77C9EE701F72586D.quest_desc: [
		"&bTaşınabilir Hücreler&f, bir sandığa veya sürücüye yerleştirilebilmeleri ve buna göre doldurulabilmeleri açısından normal hücrelerle aynı işlevi görür. "
		""
		"Bununla birlikte, normal hücrelerden farklı olarak, içeriklerine hücre eşyasının kendisi aracılığıyla bağımsız olarak da erişilebilir. Biraz dijital ME-aromalı sırt çantası gibi."
	]
	quest.77D3546953550E39.quest_subtitle: "Bull Pine + Spruce"
	quest.77F2271C45DB49BA.quest_desc: ["Bu Modül, &aMekaSuit&r Göğüslüğüne konulduğunda size Yaratıcı Uçuş verecektir. \\nBunu üretmek için sadece oyundaki en pahalı Eşyalardan bazılarına ihtiyacınız var!"]
	quest.77F241BEE9902751.quest_desc: ["Sophisticated Storage'daki sandıkların en büyüğü"]
	quest.77F241BEE9902751.quest_subtitle: "Aktiviteler için çok fazla alan!"
	quest.77F241BEE9902751.title: "&dNetherit Sandık"
	quest.77FB313845779AED.quest_desc: [
		"Şimdi Su Buharımızı ve &cSülfür Trioksitimizi&r &a&lİnfüze etmek&r için başka bir &a&lKimyasal Karıştırıcı&r kullanın. Artık &aSülfürik Asidimiz&r var! \n\n&7Cevherlerimizi&f &aAsitle&r &3Eritmek&r için &aSülfürik Asidi&r bir &3&lK.Ç.O.'ya&r pompalayın. Bu bize &7Cevherlerin&r &cKimyasal&r bir formu olan &7Kirli Cevher Çamuru&r verecektir. \n\n3 &7Ham Cevher&r 2 Kova &7Cevher Çamuru&r verecek ve 1 &7Cevher Bloğu&r 1 Kova &7Cevher Çamuru&r verecektir. \n\nEtrafta &7Kirli Cevher Çamuru&r ile dolaşamayız, bu utanç verici! Onu temizlememiz gerekecek! Bir &a&lKimyasal Yıkayıcı&r başlatın ve içine biraz &9Su&r (ve çamaşır deterjanı) koyun. \n\nHer 5mb &7Kirli Çamur&r 3mb &7Cevher Çamuruna&r dönüştürülecektir. \n\nArtık &7Çamurumuz&r tertemiz olduğuna göre, onu bir &5&lKimyasal Kristalleştiriciye&r koyabiliriz. Bu bize &7Cevher Kristalleri&r verecektir! Evet, &7Parçalar &fve &7Yığınlardan&r farklı. Her 200mb &7Cevher Çamuru&r 1 &7Kristale&r eşittir."
		"{image:atm:textures/questpics/mek/mek_tier4_2.png width:300 height:50 align:center}"
	]
	quest.77FB313845779AED.quest_subtitle: "Aşama 4 Cevher İşleme"
	quest.77FB313845779AED.title: "&7Cevherleri&f &aAsit &file Eritmek &fve Onları &5Kristalleştirmek&r"
	quest.77FC692AC94D2EEF.title: "&l&9Ana Dünya Ödülü:&r&e Creeper'lar"
	quest.780E0163033CCD9B.quest_subtitle: "Aşama: &b4"
	quest.78202A1CF5D86B94.quest_desc: ["Powah'ın &9Güç Bankası&r.\\n\\nBunlar aynı zamanda kablosuz &7Ender Ağının&r toplam güç depolama kapasitesini artırmak için de kullanılabilir."]
	quest.78215D704E6095B0.quest_desc: ["Oyun sonu zırh setlerinde tüm eğlencenin &5&lMekanism&r ve &l&7Modern Industrialization&r'a ait olduğunu mu sanıyordunuz? \\n\\nBu &5Kuantum Zırhı&r, &cNetherit Zırhı&r mevkisinde temel istatistiklere sahiptir ancak tıpkı &aMekaSuit&r gibi enerjiyi kalkan olarak kullanabilir. \\nAyrıca sizi daha da güçlendirmek için takılabilecek yükseltmeleri de var! Uçuş, Gece Görüşü ve hatta şarj olma yeteneği gibi. \\n\\nEn iyi yanı ise Depolama Sistemine bağlanabilmesidir! Böylece nerede olursanız olun sistemden otomatik olarak enerji çekebilir ve sistemdeki istediğiniz eşyayı alabilirsiniz. \\n\\nDahası, tam seti giymek &aRadyasyondan&r korunmanızı sağlar."]
	quest.78215D704E6095B0.quest_subtitle: "Sizi tamamen yenilmez yapmaz"
	quest.78215D704E6095B0.title: "Zırh Olarak ME Sistemi: Kuantum Zırhı"
	quest.78311531069807DE.quest_desc: ["Applied Energistics 2'de her ME ağında belirli sayıda &ekanal&f mevcuttur. Bu da basitçe tüm ağa, kaç tane ağa bağlı cihazın sığabileceği anlamına gelir.\\n\\nGenel bir kural olarak, ME verilerini doğrudan işleyen (ağ içinde depolanan eşyalar) ve bir çeşit G/Ç gerçekleştiren herhangi bir cihaz bir kanal kaplayacaktır. Genellikle &eEnerji Hücreleri&f ve &eYazıcılar&f gibi sadece ağın dahili güç depolamasıyla ilgilenen bileşenler kanal kullanmazlar.\\n\\n&bME Kontrolcüsü&f olmayan ağlar 'ad-hoc' ağlar olarak bilinir ve yalnızca maksimum 8 kanalı destekler."]
	quest.7834734E79E41A3A.quest_desc: ["Şu fobilerden herhangi birinden muzdaripseniz lütfen &l&6The Bumblezone&r modunu oynamadan önce bir kez daha düşünün: \\n\\nMelissofobi, Apifobi, Entomofobi, Araknofobi, Tripofobi, Akrofobi, Klostrofobi ve Kristallofobi. \\n\\nEğer Tripofobiniz varsa, rahatlatıcı etki sağlamak için &l&6The Bumblezone&r tarafından sunulan kaynak paketini kullanabilirsiniz! Başka bir fobi ise maalesef işiniz zor."]
	quest.7834734E79E41A3A.quest_subtitle: "Dikkatli Olun!"
	quest.784466C3813AA506.quest_desc: ["Hiç canlı yaratıkları taşıyıp yakalamak istedin mi? Bunun için Ruh Cevherleri veya Yaratık Yakalayıcılar var tabii...\\n\\nAma şimdilik onları bir kenara bırakıp &5&lApotheosis&r modunun sunduğu seçeneğe odaklanalım: &5Zayıf Ender Kayışı&r, kayış serisinin en ucuz ancak en dayanıksız versiyonudur. Sadece dost pasif hayvanları bağlayabilir ve 8 kullanımdan sonra kırılır."]
	quest.784466C3813AA506.title: "&5Zayıf Ender Kayışı"
	quest.7846B7FFC3DD85C5.quest_desc: ["&d&lSüperkritik Faz Kaydırıcı&r (&d&lS.P.S.&r) &aPolonyumumuzu&r &dAntimaddeye&r dönüştürecektir. \n\nBunu yapmak için &aPolonyuma&r, &aEnerjiye&r, her ikisini karıştıracak bir yere ve &dAntimaddeyi&r dışarı alacak bir yere ihtiyacımız olacak! \n\nBu yüzden bunların her biri için bir &dBağlantı Noktasına&r ihtiyacımız olacak! \nYanlarda &aEnerji&r için 2 &dBağlantı Noktası&r, &d&lSPS'ye&r &aPolonyum&r vermek için 1 &dBağlantı Noktası&r ve &dAntimaddemizi&r dışarı almak için sonuncu."]
	quest.7846B7FFC3DD85C5.title: "&dSPS Bağlantı Noktaları"
	quest.784D6D11C4F41215.quest_subtitle: "&f6.5 &cSaldırı Hasarı"
	quest.785951190FFDAA21.quest_desc: ["Sırt Çantasındaki istif boyutunu 4 artırır."]
	quest.785951190FFDAA21.title: "&eİstif Yükseltmesi Kademe 2"
	quest.786073B57C901DB7.title: "Artılar Sancak Deseni"
	quest.7864C8F2CBC910CB.quest_desc: ["&a&lMekaSuit Miğfer&r, elbette kafanıza geçen kısımdır! Bir &dAntimadde Peleti&r, &aPolonyum Peletleri&r, bir &dNihai İndüksiyon Hücresi&r ve daha fazlasına ihtiyacınız olacak! \n\n&5Unobtainium Kasklara&r yapılan bir Yükseltme görevi görür. Çok daha az Zırh Puanına sahip olmasına rağmen, &5Unobtainium Kasklardan&r farklı çalışır. \n\n&a&lMekaSuit Miğfer&r Şarj Edilmemişse, bir &cNetherit Kask&r ile benzer istatistiklerle çalışacaktır, ancak eğlenceli kısım burada! &a&lMekaSuit Miğferler&r tüm Hasarları (Büyü Hasarı hariç) engelleyecek ve &aEnerji&r harcayacaktır. \n\nAyrıca giyildiğinde HUD ekranımızda gösterecektir: Koordinatlarımızı, &a&lMekaSuit'imizdeki&r &aEnerjiyi&r ve Zırh Puanlarının yerini bir &aEnerji Çubuğu&r alacaktır. \n\n&a&lMekaSuit Miğfere&r daha da az Hasar almak için daha fazla &aEnerji&r, Suda Nefes Alma, &aRadyasyondan&r korunma ve hatta &eGüneş Şarj Etme Birimi&r gibi Yükseltmeler vermek için &7&lGeliştirme İstasyonunu&r kullanabiliriz!"]
	quest.7864C8F2CBC910CB.title: "&a&lMekaSuit Miğfer"
	quest.78656C89EEE80DB5.quest_desc: ["&ePirinç Tünel&r'lar &eAndezit Tünel&r'lar gibi çalışır, sadece çok daha fazla konfigürasyona sahiptir! \\n\\nİlk olarak, artık Filtrelere sahibiz! Bunlar taraf başınadır: Girdi tarafını Filtrelerseniz, yalnızca o Filtrelenen &eEşyanın&r &eTünel&r içinden geçmesine izin verilir. Çıktı taraflarını Filtrelerseniz, yalnızca o &eEşyalar&r kendi tarafından çıkar. \\n\\nArtık &ePirinç Tünel&r'ları yan yana da dizebiliriz. Bu, hepsinin aynı Girdileri almasını ancak bunları belirli &eKayışlara&r Filtrelemesini sağlayacaktır! \\n\\n&eTünelin&r üst kısmında Dağıtım Modlarını değiştirme seçeneğini bulacağız. Bunları çok fazla ayrıntılı açıklamayacağım, Görevlerimizin sınırlı alanı var, bunun yerine özetleyeceğim! \\n\\nPaylaştır: &eEşya&r yığınlarını kaç &eKayışa&r gideceğine göre eşit olarak böler. Paylaştırmaya Zorla: normal Paylaştır bazen atlayabilirken her &eKayışın&r eşit miktarda almasını sağlar. Sırayla Seç: her bir &eKayış&r arasında sırayla dönüşümlü hareket eder. Sırayla Seçmeye Zorla: bazı &eEşyaları&r atlamaz ve bunun yerine bekler, herkese sıra gelir! En Yakına Öncelik Ver: &eEşyaları&r en yakın Çıktıya gönderir. Rastgele: &eEşyaları&r rastgele farklı Çıktılara gönderir. Girişleri Eşitle: yalnızca her &ePirinç Tünel&r'da Girdi için bekleyen bir &eEşya&r olduğunda Çıktı verir."]
	quest.78656C89EEE80DB5.title: "&ePirinç Tünel"
	quest.787415570026FFAA.quest_desc: ["Bu yükseltmeler &4Yok Edici'nize&r büyü özellikleri kazandırır.\n\nBunu nerede kullanacağınızı mı düşünüyorsunuz? Örneğin bir Builder veya Quarry cevherleri İpeksi Dokunuş ile kırıp sisteminize taşıyor olsun. Bu cevherleri bir &bYapıcı&r ile yere dizdirebilir, ardından &eServet&r büyülü bir &4Yok Edici&r ile kırarak kat kat daha fazla ham cevher elde edebilirsiniz."]
	quest.787415570026FFAA.title: "Yok Edici Yükseltmeleri"
	quest.7878F190BC8ADC82.quest_desc: ["En üst seviye kehanet asası! Elmaslardan Nether Yıldızı ve Allthemodium'a kadar yalnızca en değerli cevher ve malzemeleri bulur."]
	quest.787E714014EC2C02.quest_subtitle: "Aşama: &63"
	quest.78840993C7832E89.quest_desc: [
		"Geçerli Yükseltmeler:"
		"- Tree Feller"
		"- Leaf Breaker"
		"- Auto Smelter"
		"- Drops Teleporter"
		"- Instant Break"
	]
	quest.788A7A2F1F438B64.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_cloggrum.png width:100 height:150 align:center}"]
	quest.788A7A2F1F438B64.title: "&7Cloggrum&r"
	quest.789AF6D0A6321945.quest_desc: [
		"&l&3Eser&r'lerden tek ve en önemlisi! En güçlüsü! En tehlikeli olanı!"
		"{@pagebreak}"
		"Ne işe yaradığını açıklamam gerektiğinden bile emin değilim, çok tehlikeli!"
		"{@pagebreak}"
		"Gücüyle başa çıkabileceğinden eminsen, belki de okumaya devam etmelisin..."
		"{@pagebreak}"
		"Geri dönmek için geç değil!"
		"{@pagebreak}"
		"Tamam, seni uyarmıştım..."
		"{@pagebreak}"
		"Osurma ihtimali için &dWhoopee Minderi&r takılıyken Shift tuşuna bas."
	]
	quest.789AF6D0A6321945.quest_subtitle: "Benzersiz"
	quest.789AF6D0A6321945.title: "&dWhoopee Minderi&r"
	quest.78AA7BFABBFB9973.quest_desc: ["&2&lNature's&r &eSpell Book&r. \\n\\n10 &3Spells&r'e sahiptir ve &2Nature Spells&r'e bir güçlendirme sağlar! \\n\\nBunu üretmek için bir Rotten Spell Book'a ihtiyacınız var gerçi..."]
	quest.78AA7BFABBFB9973.title: "&2Druidic Tome"
	quest.78AAFE5AF04A13AC.quest_desc: ["&bAerbunny'ler&r havada zıplarlar. Siz de yapabilseniz siz de yapardınız! \\n\\nYalnızca 6 &4Kalbi&r (3 kalp) olan zararsız yaratıklardır. \\n\\nOnları öldürecek kadar acımasızsanız geriye İp bırakırlar."]
	quest.78AAFE5AF04A13AC.title: "&bAerbunny"
	quest.78B7FC6A868F5C4D.quest_desc: ["Bunları ya &6&lThe Bumblezone&r yapılarında bulmalı ya da &5Arı Kraliçesi&r ile takas etmelisiniz! \n\nTakılıyken süzülmek için Boşluk (Space) tuşuna basılı tutabilirsiniz. \n\nAncak tıpkı bir &6arı&r gibi, kanatlarınız küçük tombik bedeninizi yerden kaldırmak için fazla küçüktür."]
	quest.78BCED8699ADEDF4.quest_desc: ["&3Soundproof Glass&r, &3Ruh Tozu&r ve Cam birleştirilerek yapılır. \n\nBunlar tıpkı Yün gibi Sesi hafifletmeye yarar! Bir &3Sculk Sensörünün &fveya &3Sculk Çığırtkanının&r üzeri bunlardan biriyle kapatılırsa Sesleri duymazlar. \n\nSadece bunların arkasını görebilirsiniz!"]
	quest.78BCED8699ADEDF4.title: "&3Soundproof Glass"
	quest.78BD3D4FBA42D3DC.quest_desc: ["Sheepuff'lar Aether'de yaşayan şapşal küçük canlılardır. \\n\\nNormal koyunlara benzerler ama bazen sebepsizce havaya fırlayıp yavaşça süzülürler. Nedenini bilmiyorum, belki de eğlencelidir! \\n\\nBazen fazla yünden dolayı şişerler; bu durumda arka arkaya iki kez kırkılabilirler! \\n\\n8 &4Kalpleri&r (4 kalp) vardır ve Çiğ Koyun Eti ile Yün düşürürler."]
	quest.78BD3D4FBA42D3DC.title: "Sheepuff"
	quest.78BFDD3A9B996655.quest_desc: ["&5Zayıf Ender Kayışına&r kıyasla önemli bir geliştirme! Artık düşman yaratıkları da bağlayabilir ve 64 kullanım dayanıklılığa sahiptir. Bunu infüze etmek için en az &a45 Eterna&r, &c%25 Quanta&r ve &5%40 Arkana&r gerekir.\\n\\nBu oranları 9 &bKristal Deniz Kitaplığı&r ile ya da Cehennem yolunu seçtiysen 9 &4Parlayan Cehennem Kitaplığı&r ve 8 Mum (İpucu: Bir bloğa 4 taneye kadar mum yerleştirebilirsin) ile sağlayabilirsin."]
	quest.78BFDD3A9B996655.title: "&5Ender Kayışı"
	quest.78CCD8075249E2B7.quest_subtitle: "Magmatik Arı + Su Arısı"
	quest.78CCD8075249E2B7.title: "BreezBee"
	quest.78CE2ECEF0B651DA.quest_desc: ["&bAurora Sarayı&r sandıklarında bulunan &3Buz Kılıcı&r, vurduğu düşmanları 10 saniye boyunca &bDonma&r etkisi altında bırakır."]
	quest.78CE2ECEF0B651DA.title: "&3Buz Kılıcı"
	quest.78D1C97A542133D8.quest_desc: [
		"Augment'ler, Iron Furnaces fırınları için özel eklenti ve geliştirmelerdir!"
		""
		"Fırın arayüzünün sağ üst köşesinde eklenti menüsünü açan bir düğme bulunur. Burada kırmızı, yeşil ve mavi yuvalar yer alır; her yuva kendi rengine uygun 1 adet Augment alabilir."
	]
	quest.78D1C97A542133D8.title: "&lAugment'ler"
	quest.78D26411B482CD5A.title: "&dStarlit Elmas Kürek"
	quest.78D8F40AA9568511.quest_desc: ["Güçlendirilmiş Hadde Makinesi, Manuel Hadde Makinesi'nin çok daha iyi bir versiyonudur. \n\nBir şeyler üretmek için makinenin içine bakmaya devam etmeniz gerekmez ve hepsini otomatik olarak üretecektir. \n\nTek sorun, güce ihtiyaç duymasıdır!"]
	quest.78DA970F97002975.quest_desc: ["Fıçılar, &bSıvıları&r tutmanın basit yollarıdır. \n\nAhşap Fıçılar ve Metal Fıçılar vardır. Ahşap olanlar yalnızca soğuk ve oda sıcaklığındaki &bSıvıları&r tutabilir, sıcak &bSıvıları&r veya Gazları tutamaz. Metal Fıçılar ise her türlü &bSıvıyı&r ve Gazı tutabilir. \n\nHer iki Fıçı da 12 Kova &bSıvı&r tutabilir. Üst taraftan otomatik olarak &9Giriş&r yapar ve Alt tarafa &6Çıkış&r verir, ancak bu değiştirilebilir."]
	quest.78DA970F97002975.title: "&bSıvıları&r Depolamak"
	quest.78DD2A3DFF6D1613.quest_desc: ["2 &2Biyoyakıt&r ile &2&lB.R.O.&r aracılığıyla 1 &aSubstrat&r yapabiliriz. \n\nŞey... &2&lB.R.O.'da&r ayrıca &9Suya&r ve Hidrojene de ihtiyacımız olacak ama o zaman &aSubstratımızı&r ve ayrıca &dKimyasal Eteni&r elde edeceğiz. \n\nYYPE Peletleri yapmak için &aSubstratımıza&r ihtiyacımız olacak ve ayrıca &dKimyasal Etenimizi&r &dSıvı Etene&r dönüştürmemiz gerekecek. Onu &bSıvıya&r dönüştürmek için bir &c&lDöner &bYoğunlaştırıcı&r kullanabiliriz! \n\nŞimdi hem &dSıvı Eten &fhem de &aSubstratlarımızı&r YYPE Peletleri yapmak için &2&lB.R.O.'ya&r atın! \n\nArdından bir YYPE Çubuk yapmak için 4 Peleti birlikte Üretebilir veya bir YYPE Levha yapmak için 3 tanesini &dZenginleştirebiliriz&r."]
	quest.78DD2A3DFF6D1613.title: "&2Biyoyakıtı&r YYPE'ye dönüştürmek için her şeyi kullanmak"
	quest.78E40BDB0E54B638.quest_desc: ["&6&lThe Bumblezone&r yapılarında bulunabilir veya &5Arı Kraliçesi&r ile takas edilebilir! \n\n&6Bal Bloklarına&r yapışıp kalmaktan ya da &ePolen&r yüzünden yavaşlamaktan bıktınız mı? Bal Arısı Tozluğu tam size göre! Bu blokların üzerinde takılmadan hareket etmenize yardımcı olur. Ne kadar çok Arı Zırhı giyerseniz, yolculuk etmek o kadar rahat olur! \n\nAyrıca &epolenleri&r toplamak için içlerinden Shift ile geçebilirsiniz!"]
	quest.78E51D22C16C4686.quest_desc: ["Depo Denetleyicisi ayrıca diğer depolara kablosuz olarak bağlanabilir. Bu, Depo Aleti kullanılarak mümkündür. Bağlamak için Depo Denetleyicisine sağ tıkla ve bağlamak için depolara sağ tıkla.\\n\\nKablosuz bağlantı için menzil normal ile aynıdır, 14 blok alan."]
	quest.78E66F1DE42C747A.quest_desc: ["&9Yankı Parçası&r toplamak oldukça zorlu ve uğraştırıcıdır; üstelik bu raflar için bunlardan bolca gerekecek! Peki daha kolay bir çoğaltma yolu olmasın mı?\\n\\n&d&lİnfüzyon&r ile 1 adet &9Yankı Parçasını&r 4 adede çoğaltabilirsin!\\n\\nGerekli değerler: &a70 Eterna&r, &c%50 Quanta&r ve &5%50 Arkana&r.\\n\\nBu oranlar için şu dizilimlerden birini tercih edebilirsin:\\n\\n- 14 &9Derin Kitaplık&r (Uyuyan olmayanlar!)\\n- 12 &4Parlayan Cehennem Kitaplığı&r ve 2 &9Derin Kitaplık&r\\n- 12 &bKristal Deniz Kitaplığı&r ve 2 &9Derin Kitaplık&r"]
	quest.78E66F1DE42C747A.title: "Sonsuz &9Yankı Parçası&r?"
	quest.78E94C386B1E7359.quest_desc: ["Normalde Spawn Egg elde edemezsiniz, ama bu durum spawner'lar için de geçerli ve işte buradayız! Spawn Egg elde etmenin birkaç yolu vardır ancak bir tane bulduğunuzda, spawner'ın doğurduğu mobları değiştirmek için bir spawner'a sağ tıklayın."]
	quest.78EC7D19BE24FE06.quest_subtitle: "Patlamaz"
	quest.78ECC28DD4BA9696.quest_desc: [
		"&dOtherworld&r materyallerinin çoğunu Spiritfire kullanarak elde edebilseniz de, bu materyallerin yerini belirlemek için &9Divination Rods&r da kullanabilirsiniz."
		""
		"İlk olarak, Rod'u (Asayı) aradığınız malzemeye uyumlamanız (attune) gerekecek. Örneğin, &8Otherstone&r arayışındaysanız, dünyadaki Otherstone'un yerini bulmaya yardımcı olması için &aAndezit&r üzerinde Rod'u kullanabilirsiniz."
		""
		"Bir materyale uyumlandığında, elinizdeki Rod ile sağ tıklamaya basılı tutabilirsiniz, ve en yakın uyumlu olduğu malzemenin yönüne doğru bir parçacık fırlayacaktır."
		""
		"Otherworld bloğunu hasat edebilmek için hala &3Third Eye&r (Üçüncü Göz) etkisi altında olmanız gerekecek."
	]
	quest.78ECC28DD4BA9696.quest_subtitle: "&dOtherworld&r Materyalleri Avı"
	quest.78ECC28DD4BA9696.title: "Mesleğin Araçları: Divination Rod"
	quest.78FBB0C88182040E.quest_desc: ["Minecraft'ı 1.13'ten beri oynamadıysanız bu kafanızı karıştırabilir, ama tatar yaylarını ve Delme (Piercing) büyüsünü bilirsiniz. Oklarının birden fazla hedefin içinden geçmesini ve sürekli hasar vermesini sağlayan bir büyüye sahiptirler. Bu Modül tam olarak bunu yapar!"]
	quest.78FBB0C88182040E.title: "Wyvern Mermi Delme Modülü"
	quest.78FEDE6FA4845585.quest_desc: ["Bazı özel &d&lİnfüzyonlar&r son derece hassas ve nokta atışı &aEterna&r, &cQuanta&r veya &5Arkana&r oranları gerektirir. \\n\\nİstediğin tam oranı yakalamak için eksiltme yapan özel filtre raflarından faydalanabilirsin. \\n\\nBu rafların her biri ilgili efsun statını belirli bir oranda düşürerek hassas ayar yapmanı sağlar."]
	quest.78FEDE6FA4845585.title: "&4Azaltıcı Raflar&r"
	quest.7900A4836CC55428.quest_desc: [
		"Birleştirici Matrisi, birden fazla Moleküler Birleştirici ve Kalıp Sağlayıcıyı tek bir kanalda barındırabilen çoklu blok bir yapıdır."
		""
		"Birleştirici Matrisi en az 3x3x3, en fazla 7x7x7 boyutlarında bir küp olmalıdır. Şunları gerektirir:"
		"- Birleştirici Matris Çerçevelerinden oluşan kenarlar"
		"- Birleştirici Matris Duvarı/Camı ile oluşturulmuş yüzler"
		"- Birleştirici Matrisi Kalıp/Üretim/Hız Çekirdeklerinden oluşan iç yapı"
		""
		"Geçerli bir Birleştirici Matrisinin içinde en az 1 adet Kalıp Çekirdeği ve Üretim Çekirdeği bulunmalıdır. İçi tamamen doldurulmalı ve boşluk kalmamalıdır. Yapı doğru kurulup güç verildiğinde çerçeve üzerindeki çizgiler maviye dönecektir."
		""
		"{@pagebreak}"
		""
		"Bu örnekte, esas olarak Craft ve Kalıp Çekirdekleri arasındaki dengeye odaklanan 7x7x7'lik bir Birleştirici Matrisi kuracağız."
		""
		"İlk 43 Birleştirici Matris Çerçevesini ve ilk 125 Birleştirici Matris Duvarını üretin. (Toplam 68 çerçeveye ve 150 duvara ulaşmak için) bu görevin ödülleri arasında her birinden 25'er adet hediye edilecektir."
	]
	quest.7900A4836CC55428.quest_subtitle: "Tek Bir Kanalda Birçok Moleküler Birleştirici ve Kalıp Sağlayıcı"
	quest.7900A4836CC55428.title: "Hepsini Barındıran Birleştirici: Birleştirici Matrisi"
	quest.790EC3EDC2DB1FB0.quest_desc: ["Daha önce de belirtildiği gibi. Bu mod, belirli yapılar gerektiren, güç üretmek için bir ton eğlenceli yöntem ekler."]
	quest.790EC3EDC2DB1FB0.title: "Generators Galore"
	quest.79110ACAAC8412EA.quest_subtitle: "İnfüzyon Üretimi"
	quest.79110ACAAC8412EA.title: "Tertium Arısı"
	quest.791A981914CE345F.quest_subtitle: "&f10 &cSaldırı Hasarı"
	quest.791AE62ACACBD5BA.quest_subtitle: "Açarsın, kapatırsın, sonra tekrar açarsın, çünkü sıkılmışsındır"
	quest.792990DC06DB98F9.quest_desc: ["&2&lOverworld&r etrafında &5&lEternal Starlight&r Portal Harabeleri bulabilirsiniz. Orada Geçit Bekçisini bir dövüşe davet edebilirsiniz! \\n\\nEğer kazanırsanız size bazı Eşyalar verecektir ve onlarla keşfedilecek yepyeni bir dünyaya açılan Portaldan girebilirsiniz!"]
	quest.792990DC06DB98F9.title: "&5&lEternal Starlight"
	quest.7934873E784C4B3C.quest_desc: [
		"Bu tanıdık geliyor mu? \n\nArtık yine &7Parçalarımız&r var. Onlarla herhangi bir şey yapmadan önce &bOksijene&r ihtiyacımız olacak. \n\n&bOksijen&r elde etmek için bir &9&lElektrolitik Ayırıcıya&r &9Su &fatın. Ardından, o &bOksijeni &f&9&lAyırıcıdan&r &b&lArındırıcıya&r &cTüpleyin&r. \n\nO &bOksijenle&f, &b&lArındırıcı&r &7Parçalarınızı &f&7Cevher Yığınlarına&r dönüştürebilir. \n\nŞimdi, o &7Yığınları&f &cKırarak&r &7Kirli Toz&r elde edin. Ardından, o &7Kirli Tozu&f &dZenginleştirerek &f&7Cevher Tozu&r elde edin. \n\nVe son olarak o &7Tozu&r &6Eritin&r, böylece güzelce &lİşlenmiş Cevherimizi&r elde ederiz!"
		"{image:atm:textures/questpics/mek/mek_tier3_3.png width:250 height:100 align:center}"
	]
	quest.7934873E784C4B3C.quest_subtitle: "Aşama 4 Cevher İşleme"
	quest.7934873E784C4B3C.title: "&7Kristal&f, &7Parça&f, &7Yığın&f, VB"
	quest.7937DE650CABC1FF.quest_subtitle: "Fırın yakıtıyla çalışır"
	quest.7941938014E97A30.quest_desc: ["Bir arının sırtında uçmayı hiç istediniz mi?\n\nBombus Arıları dünyada doğal olarak oluşurlar ve binek olarak kullanılabilirler!\n\nKendinize bir &6İkramlı Çubuk&r yapın, bir Bombus Arısına eyer takın ve gökyüzüne süzülün!"]
	quest.7941938014E97A30.quest_subtitle: "Overworld'deki Bombus Arısı Yuvalarında doğar"
	quest.7941938014E97A30.title: "Bombus Arısı"
	quest.794D6F9B8DB31E7D.quest_desc: ["&bIce Staff&r bir süreliğine kafamı karıştırdı ama çok şükür artık biliyorum! \\n\\nBir &bPermafrost Shard&r ve bir &bFrosted Helve&r'a ihtiyacınız olacak. &bPermafrost Shard&r, Ice Breaker Yapısının içindeki bir ganimettir. Bunlar Buzlu Biyomlardaki Gemi Enkazlarıdır. \\n\\n&bFrosted Helve&r Üretilmiş bir Eşyadır. &5Arcane Ingots &fve &bFrozen Bones&r kullanır. İkincisi &bStrays&r'den (Sokak İskeletlerinden) düşer. \\n\\n&bIce Staff&r 5 &4Damage&r verir ve %25 Mana Yenilenmesi sağlar. Tüm &3Spell&r'e %5, ve sadece &bIce Spells&r'e %15 &3Spell Power&r (Büyü Gücü) verir."]
	quest.794D6F9B8DB31E7D.title: "&bIce Staff"
	quest.795143471F31A64A.quest_subtitle: "Lazer tarifleri için Gerekli"
	quest.7952DA35B4F5C598.quest_desc: ["Ne, bir &7Kova&r yeterli değil mi? Bir Yığın &7Kova&r da mı yeterli değil? O zaman dostum, birkaç &bSıvı Tankına&r ihtiyacın olacak! \n\n&bSıvı Tankları&r içlerinde tek bir &bSıvının&r birden fazla &7Kovasını&r tutabilir ve daha sonra bir &7Kova&r gibi etrafta taşınabilir. Ne yazık ki bunlar Kaynak Blokları yerleştiremez. \n\n&bSıvı&r eklemek veya çıkarmak için, ikisinden birini yapacak şekilde yapılandırılmış &bMekanik Borulara&r ihtiyacınız olacak. \n\n&a&lTemel&r: 32 Kova Sıvı tutar. \n\n&c&lGelişmiş&r: 64 Kova Sıvı tutar. \n\n&b&lElit&r: 128 Kova Sıvı tutar. \n\n&d&lNihai&r: 256 Kova tutar."]
	quest.7952DA35B4F5C598.title: "&bSıvı Tankları"
	quest.7953C87C488A2AF7.quest_desc: ["Iron Man gibi uçmanızı sağlar.\n\nÇizme içinde tek seferde bu Yükseltmelerin yalnızca bir seviyesine sahip olabilirsiniz. Her seviye bir öncekinden daha fazla basınç kullanacaktır.\n\nBu yükseltmeleri kullanın, sadece üretip bırakmayın."]
	quest.7953C87C488A2AF7.quest_subtitle: "Maks: 1"
	quest.795A860668072830.quest_desc: ["{image:atm:textures/questpics/allthemodium/all_armor_vibarcane.png width:100 height:175 align:center}"]
	quest.795A860668072830.title: "&3Vibranium Arcanist Zırhı"
	quest.795B80BF12D23897.quest_desc: ["Adı üzerinde, ancak bir Hazine Büyüsü olduğu için herkes bunu bilmeyecektir. \n\nBuz Yürüyücü büyülü Botlarla veya &bBuz Yürüyücü &7Modüllü&r &a&lMekaSuit Çizmeyle&r &9Suyun&r üzerinde yürürken &9Su&r &bBuza&r dönüşecektir! \n\n&bBuz&r sonsuza kadar sürmeyecek, kısa süre sonra eriyecektir! \n\nNe kadar çok Buz Yürüyücü olursa, o kadar çok &bBuz&r olur!"]
	quest.795B80BF12D23897.quest_subtitle: "Bot"
	quest.795B80BF12D23897.title: "&bBuz Yürüyücü &7Modülü"
	quest.795FA102F6577368.quest_desc: ["&4&lMorgan&r'ı elde etmek için &e&lCaliburn&r ile evcilleştirilmiş bir Köpek öldürmen gerekir. \\n\\nAyrıca &e&lCaliburn&r'ün Doğuştan Gelen Sınırı, &4&lMorgan&r'ın da Doğuştan Gelen Sınırı olacaktır. \\n\\nİyi şanslar!"]
	quest.795FA102F6577368.title: "&4&lMorgan&r'ı Elde Et"
	quest.796E922CA69BAE82.quest_desc: ["&4Mega Disk Arayüzü&r 54 filtre yuvasına sahiptir, 8 kat daha hızlı çalışır ve entegre bir &eYığın Yükseltmesi&r içerir."]
	quest.796E922CA69BAE82.title: "&4Mega Disk Arayüzü"
	quest.7975C7145572C438.quest_desc: ["İster deneyimli bir modlu oyuncu olun, ister MC'ye tamamen yabancı olun, herkesin &2Tahta Kazma&r yapması gerekir.\\n\\nKazmalar çoğu taş ve metal bloğu kırmanı sağlar. Bu tahta olan uzun süre dayanmaz, bu yüzden onunla biraz &3Kırık Taş&r topladığından emin ol!"]
	quest.7975C7145572C438.title: "İlk Kazmamız"
	quest.79886D63280DBBF3.quest_desc: ["Filtrelemek yetmiyor mu?!?! Eşyaların yok edilmesini mi istiyorsunuz?!?! Sizi canavar!"]
	quest.79886D63280DBBF3.title: "Seçici Yakma Modülü"
	quest.798B592E956AD28C.quest_desc: [
		"&b&lRunic Crucible&r, öz üretimini otomatikleştirmemizi sağlayan çoklu blok yapıdır: Liquid Soul ve &bLiquid Aureal&r! \\n\\nİnşa adımları için sonraki sayfaya bakın! \\n\\nÇalışması için bağlantı noktalarına eşyaları ve sıvıları (Liquefied Source dahil) borularla aktarmanız gerekir. \\n\\n&b&lRunic Crucible&r ayrıca &9Corrupt Soul&r, &dEnchanted Soul&r ve &5Obsidiansteel&r üretmek için de kullanılabilir."
		"{@pagebreak}"
		"{image:atm:textures/questpics/chap3/creative_crucible1.png width:100 height:100 align:center}"
		"&l&bRunic Crucible&r yapısının ilk katmanının ortasında &6Gilded Chiseled Polished Darkstone&r, etrafında ise &9Polished Darkstone&r yer alır. Kenarlarda baş aşağı &9Polished Darkstone Stairs&r ve köşelerde Rune Block'lar bulunur."
		"{image:atm:textures/questpics/chap3/creative_crucible2.png width:100 height:100 align:center}"
		"Tam ortaya etrafı &9Polished Darkstone Stairs&r ile çevrili bir &bArcane Crystal&r yerleştirin. Yanlarda &6Arcane Polished Darkstone Sütunları&r ile kapakların konacağı bloklar yer alır."
		"{image:atm:textures/questpics/chap3/creative_crucible3.png width:100 height:100 align:center}"
		"Her köşeye &bArcane Crystal Block&r yerleştirin."
		"{image:atm:textures/questpics/chap3/creative_crucible4.png width:100 height:100 align:center}"
		"Son olarak, bir blok boşluk bırakarak &7Quantum Injector&r'ı ortadaki &bArcane Crystal Block&r üzerine yerleştirin."
		"{image:atm:textures/questpics/chap3/creative_crucible5.png width:150 height:100 align:center}"
		"Orta katmandaki &9Polished Darkstone&r blokları kapakların konacağı yerdir! Yapıyı otomatik kurmak isterseniz kontrolcüye eğilerek sağ tıklayabilirsiniz."
	]
	quest.798B592E956AD28C.title: "&b&lRunic Crucible&r"
	quest.7992C63F063BE908.quest_desc: ["Bu kadar güçlü bir şey için oldukça basit bir &7Parşömen&r tarifi! Sadece 2 &eTozlaşmış Altın&r ve 1 &bTozlaşmış Elmas&r. \\n\\nBunu, üzerinde &cMahoujin&r bulunan bir &7Parşomen&r üzerinde kullan; kurulduktan sonra &7Parşömeni&r elde etmek için üzerine Sağ Tıkla! \\n\\nArdından &c&lEfsanevi Patlayıcı Yoğunlaşmış Mana Asasını&r almak için &7Parşömeni&r kullan!"]
	quest.7992C63F063BE908.title: "&7Patalyıcı Yoğunlaşmış Mana Parşomeni"
	quest.799CC9FEEDE471B1.quest_subtitle: "Mango + Star Anise"
	quest.79A1A63BCE7A541B.quest_desc: ["&bGörünmezlik Pelerini&r adından ve popüler kültürden de anlaşılacağı üzere sizi görünmez kılar! \\n\\nÇok yaklaşmadığınız veya saldırmadığınız sürece yaratıklar sizi fark etmez."]
	quest.79A1A63BCE7A541B.title: "&bGörünmezlik Pelerini"
	quest.79AD74A863EA43CB.quest_desc: ["Flux Networks, ağınızda ürettiğiniz enerjiyi depolamak için özel çözümler sunar!\\n\\nBu depolama birimleri devasa miktarda enerji tutabilir ve kapasiteleri daha da yükseltilebilir!"]
	quest.79AD74A863EA43CB.quest_subtitle: "Enerji Depolamak"
	quest.79AD74A863EA43CB.title: "Basit Akı Deposu"
	quest.79AF63E77AD70A93.quest_desc: ["Sıradan &7Kitaplıklar&r bu yolculuğun sonraki adımları için sadece başlangıçtır; kesinlikle son noktası değil! \n\nSadece vanilya &7Kitaplıklar&r kullanarak &aEterna&r değerini en fazla 30 seviyesine çıkarabilirsin. \n\n(Efsun Seviyelerini kısa süre içinde açıklayacağım ama şimdilik sadece bu seviyeleri yükseltmen gerektiğini bil yeter.)\n\n(Temel Kitaplıklar ile vanilya Kitaplıklar tariflerde birbirinin yerine kullanılabilir.)"]
	quest.79AF63E77AD70A93.title: "&2&lVanilya&r Limiti Sadece Başlangıçtır"
	quest.79B03F769746784A.title: "&9Malarite Kazma"
	quest.79B33E4691E6CB45.title: "&aFlowglaze Kılıç"
	quest.79BBCC1BEE90DBBB.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Ölümcül darbe aldığınızda hayatta kalmanızı sağlar (uzun bir bekleme süresine sahiptir). Bir nevi harcanmayan, bekleme süreli Ölümsüzlük Totemi işlevi görür."
	]
	quest.79BEECD4E545793F.quest_desc: ["Jiletli Tel, Örümcek Ağı gibi çalışır... sadece daha keskindir! \n\nJiletli Tel, biz de dahil olmak üzere içinden geçmeye çalışan herkese Hasar verecek ve Yavaşlatacaktır! \n\n&6Mühendis Tel Kesicilerimizle&r onu güvenle sökebiliriz. \n\nYa da daha fazla Hasar vermesini ve Sersemletme Efekti uygulamasını sağlamak için &6LV &cKabloları&r kullanabiliriz!"]
	quest.79C1105A84B8BF8F.quest_desc: ["Variable Card'lar, içeri aktarım gibi ağ etkileşimlerini başlatmak için gereklidir. Kartı Importer veya Exporter'ın yuvalarından birine yerleştirmeniz yeterlidir.\\n\\nArayüzdeki \"+\" düğmesine basarak tüm aktarım detaylarını düzenleyebilirsiniz. Aktarım miktarından eşya yuvalarına ve kanallara kadar tüm parametreleri bu kart üzerinden kontrol edebilirsiniz.\\n\\nYalnızca basit bir eşya taşıma işlemi yapacaksanız, karmaşık ayarlarla uğraşmadan kartı takabilir ve dilerseniz transfer limitini belirleyebilirsiniz."]
	quest.79C1105A84B8BF8F.title: "Variable Cards"
	quest.79C4CF8D7312FC28.quest_desc: ["Klasik Minecraft'ın zirve noktası: &5Netherite&r! Korkmayın, bu işlem için Demirci Şablonu gerekmez, sadece bolca &5Netherite&r yeterlidir.\n\nHer 5 tick'te 1 eşya eritir, bu da saniyede 4 eşya demektir! Evet, artık eritme başına saniye değil, saniye başına eritme devri!\n\n&dObsidian Furnace&r ile yapılır... ama bir dakika, en son aşama bu değil miydi?"]
	quest.79C4CF8D7312FC28.title: "&5Netherite Furnace&r"
	quest.79C652E3FCB88550.quest_desc: [
		"&5Gloomper'lar&r teknik olarak uysaldır fakat kendilerini savunma huyları olduğu için tarafsız sayılırlar! \\n\\nSaldırıya uğradıklarında Kalıcı İksir (Lingering Potion) benzeri bir etki bulutu bırakırlar. \\n\\nÖldüklerinde son derece lezzetli bacaklarını ve bazen de deri düşürürler. \\n\\nAyrıca Gloomgourd ile beslenerek çoğaltılabilirler!"
		"{image:atm:textures/questpics/undergarden/undergarden_gloomper.png width:100 height:100 align:center}"
	]
	quest.79C652E3FCB88550.title: "&5Gloomper&r"
	quest.79C9875A1A494762.quest_desc: ["Edelwood yetiştirmek için &9Corrupt Soul&r kullanmak istemiyorsanız şansınızı deneyebilirsiniz! \\n\\nGezgin Tüccar bazen ekilebilir Growing Edelwood fidanı satabilir. \\n\\nTüccarın gelişi rastgele olduğundan, Nerede doğacağını belirlemek için Tüccar Halıları (Trader Carpet) kullanabilirsiniz."]
	quest.79C9875A1A494762.quest_subtitle: "Wandy T'den"
	quest.79C9875A1A494762.title: "Edelwood Satın Almak"
	quest.79CA2F401982C04F.quest_subtitle: "Arcanus Arısına bir Rune Block yedirin"
	quest.79CA2F401982C04F.title: "Rune Arısı"
	quest.79D2617E01481281.quest_desc: ["AE2'ye başlamak için &bSertus Kuvars&f olarak bilinen, mod için önemli bir kaynak çıkarman gerekecek. Sertus Kuvars &eToz&f ve &eKristaller&f için kırabileceğin Sertus Kuvars Kristallerini Meteorlarda bulacaksın."]
	quest.79D2617E01481281.title: "Sertus Kuvars"
	quest.79D3055DE0EEA6B0.quest_desc: ["&d&lArs Elemental&r &cFire Armor&r!"]
	quest.79D3055DE0EEA6B0.quest_subtitle: "15"
	quest.79D3055DE0EEA6B0.title: "&cPyromancer Outfit"
	quest.79D48F8F31B152C3.quest_desc: [
		"&bIndustrial Foregoing &#27AEB9Ruhlar&r mekaniği, diğer makineleri ivmelendiren sistemler sunar.\\n\\n&#27AEB9Ruh Lazer Merkezi&r, Wither'dan Eter Gazı çıkaran bir Sıvı Lazer Merkezi'ne benzer mantıkla çalışır ve sistemin kalbidir. Bir &#27AEB9Muhafız&r'dan ruh çekmek için &9Mavi Lazer Merceği&r kullanır. Çekilen &#27AEB9Ruhlar&r; &#27AEB9Ruh Borusu&r'lar veya dijital depolama sistemleri (AE2 ve RS) ile taşınabilir. Bu ruhlar &#27AEB9Ruh Dalgası&r makineleri ile diğer blokları hızlandırmakta kullanılır.\\n\\n&#27AEB9Muhafız&r'dan ruh çekmek canlı için &4&lcan yakıcı&r bir işlemdir; hasar alır ve ölebilir. Muhafız'ı Durağanlık Odası ile dondurup iyileşme yükseltmeleriyle desteklemek son derece önemlidir."
		"{@pagebreak}"
		"Aşağıdaki gibi zemin ile &#27AEB9Ruh Lazer Merkezi&r arasında 3 blokluk bir boşluk olduğundan emin olun:"
		"{image:atm:textures/questpics/industrialforegoing/soul_laser_gap.png width:100 height:100 align:center}"
		"Ayrıca dondurmadan önce &#27AEB9Muhafız&r'ın tamamen ortaya çıktığından emin olun."
	]
	quest.79D48F8F31B152C3.quest_subtitle: "Hızlı gitmeliyim!"
	quest.79D48F8F31B152C3.title: "&bIndustrial Foregoing &#27AEB9Ruhlar"
	quest.79D6A251FE3761B3.quest_desc: ["Bataklık biyomuna yerleştirilen Balçık Gibi Yuva, Balçık Gibi Arıları çeker."]
	quest.79D6A251FE3761B3.quest_subtitle: "Bataklık Biyomunda Balçık Gibi Arı çeker"
	quest.79E30114ED8870EE.quest_subtitle: "&f7 &cSaldırı Hasarı"
	quest.79EC8A49368421BF.quest_desc: ["&6Pyrium&r, &cCitadels&r Mahzenlerinden onaylanmış bir ganimettir... \\n\\nAncak bu Mahzenler normal Trials Keys'i kabul etmiyor. Vay canına, sanki bir Anahtar her Kilidi açamıyormuş gibi! \\n\\n&cCitadel&r'daki &5Ancient Knights&r'dan Düşen bir ganimet olan Decrepit Key'e ihtiyacımız olacak. Kulelerde ve Kütüphanenin alt seviyesinde doğarlar."]
	quest.79EC8A49368421BF.title: "&6Pyrium"
	quest.79EF24E396779B9F.quest_subtitle: "Kademe: &f2"
	quest.79FC674836B6340E.title: "Draconic Zıplama Modülü"
	quest.79FF12D7A4C8E821.quest_desc: [
		"7 &b&lŞeker Denizi'nde&r süzülen, korkusuz kaptanın komutasındaki tehlikeli &bKorsan Gemisi&r. \\nAlt güvertede seyrüseferciler bulunur. \\nKargo ambarındaki silahların yanında levazım subayı yer alır. \\n\\n&bGeminin&r her yerinde korsanların maceralarından kalan ganimetleri bulabilirsiniz!"
		"{image:atm:textures/questpics/bumblezone/bumble_pirates.png width:200 height:100 align:center}"
	]
	quest.79FF12D7A4C8E821.title: "&bKorsan Gemisi"
	quest.7A066DD274F970C2.quest_subtitle: "2/5"
	quest.7A066DD274F970C2.title: "&6&lATM Yıldızı&r'nın Sağ parçası"
	quest.7A103577EAE7B3F1.quest_desc: ["Uyanış Sunağı üzerinde 4 Bilişsel Toz, her element özünden 10'ar adet ve 1 Supremium Bloğu birleştirilerek elde edilen 5. Kademe Uyandırılmış Öz."]
	quest.7A103577EAE7B3F1.quest_subtitle: "Aşama: &c5 - Uyandırılmış"
	quest.7A103577EAE7B3F1.title: "&6Uyandırılmış Supremium"
	quest.7A16D2EB63359294.quest_desc: [
		"&3Aurora Deer&r soğuk biyomlarda yaşayan zararsız geyiklerdir. \\n\\nÖldürüldüklerinde deri, geyik bifteği ve silah/çapa olarak kullanılabilen &3Aurora Deer Antlers&r düşürürler."
		"{image:atm:textures/questpics/eternal/starlight_deer.png width:200 height:100 align:center}"
	]
	quest.7A16D2EB63359294.title: "&3Aurora Deer"
	quest.7A1C117CA8FB7C31.quest_desc: ["Bu asa oldukça özeldir! Cevher aramak yerine doğrudan Tomurcuklanan Ametist bloklarının yerini tespit eder. \\n\\nArtık ametist jeotları aramak için dünyayı dolanmanıza gerek kalmadı efendim!"]
	quest.7A1E3E7E2DF17AD2.quest_desc: ["İlki &8Testere Bıçağıdır&r. Bu, &2Ağaçları&r kesmek için kullanılır. Kesilen Kütüğün üzerindeki &2Ağaçtaki&r tüm Kütükleri ve Yaprakları kesecektir. \n\nİkincisi &8Kaya Kesici Bıçaktır&r. Bu &2Ağaçları&r kesemez, bunun yerine İpeksi Dokunuşa sahip bir Kazma olarak kullanılır. Taşı kırar ve Kırık Taş yerine Taş verir. \n\nÜçüncüsü &8Taşlama Diskidir&r. &2Ağaçları&r veya Taşı kırmaz, bunun yerine &7Metal Blokları&r kırar! &8Çelik İskele&r ve &6Bakırın&r oksitlenmesini kazımak için iyidir!"]
	quest.7A1E3E7E2DF17AD2.title: "&2&lDaire Testere&r Cephanesi"
	quest.7A271F425C3934CE.quest_desc: ["Şu anki tariflerde 2 adet &bPlant Salt&r fırınlanarak 1 adet &bCreature Salt&r (Hayvansal Tuz) elde edilebilir. \\n\\nUmarız gelecek güncellemelerde yaratıkları avlayarak da bu tuzu elde etme şansımız olur!"]
	quest.7A271F425C3934CE.title: "&bCreature Salt"
	quest.7A2B26CF0EDAA724.quest_subtitle: "Alloy Smelter'da üretilir"
	quest.7A2B26CF0EDAA724.title: "End Çelik Arısı"
	quest.7A3DD8CAD6A5692D.quest_subtitle: "Red Delicious Apple + Sugar Maple"
	quest.7A41038180C06B00.quest_desc: ["&cBağlayıcılar&r... şey, bağlayan şeylerdir! &cKabloları&r Makinelerden &cAkümülatörlere&r, Jeneratörlere, neredeyse her şeyden bağlarlar! \n\nBir &cBağlayıcının&r &9Giriş&f mi yoksa &6Çıkış&r mı yapacağı, bağlı olduğu şeyin konfigürasyonuna göre belirlenir! \n\nAyrıca kendi dahili &cEnerji&r depoları vardır, Voltaj Kademesi ne kadar olduğunu belirler."]
	quest.7A41038180C06B00.title: "&cBağlayıcılar"
	quest.7A4ABFCD12202A91.quest_desc: ["Operasyonel Potansiyel (OP), Draconic Evolution modunun ana enerji birimidir (1 OP = 1 RF). Enerjiyi kablosuz olarak aktarmak için IO Röle Kristallerini, eşyalarınızı şarj etmek içinse Enerji İnfüzörü / Enerji Transfüzörü cihazlarını kullanabilirsiniz."]
	quest.7A4ABFCD12202A91.title: "OP (Operasyonel Potansiyel) Nedir?"
	quest.7A4B51313FB134EA.quest_desc: ["&6Anka Zırhı&r &cNetherite&r ile aynı şekilde toplam 20 zırh puanı ve 8 sertlik sağlar. \\n\\nAyrıca doğuştan gelen ateş koruması sayesinde &cateş&r veya &clavdan&r hasar almazsınız! \\n\\nAncak giyerken &9suya&r girmemeye dikkat edin, aksi halde..."]
	quest.7A4B51313FB134EA.title: "&6Anka Zırhı"
	quest.7A514E27E1A7FE32.quest_desc: ["Elmaslar, &l&cBuilding Gadgets&r modunu kullanarak inşa etmemize yardımcı olacak harika cihazlar üretmemizi de sağlar.\\n\\nBunlar daha büyük üsler inşa etmek veya &cDestruction Gadget&r kullanarak alan temizlemek için harika araçlardır.\\n\\nHatta bunları bir Wireless Access Point'e yerleştirerek bir AE2 ağına bağlayabilirsin!"]
	quest.7A514E27E1A7FE32.title: "&l&cBuilding Gadgets&r"
	quest.7A579E233C69871F.quest_desc: ["&b&lHostile Neural Networks&r tamamen Yaratıkları Ganimetleri için kasmak amacıyla simüle etmekle ilgilidir! \\n\\nBaşkaca bir şey yok."]
	quest.7A579E233C69871F.title: "&b&lHostile Neural Networks"
	quest.7A615E2A152917AD.quest_desc: ["Bunun için 2 adet &5Netherite Furnace&r ve her biri gökkuşağının renklerinde olan 7 parça cama ihtiyacınız var: &cKırmızı&r, &6Turuncu&r, &eSarı&r, &2Yeşil&r, &3Mavi&r, &9Lacivert&r, &5Mor&r ve &dMacenta&r! Evet, tüm tayf burada!"]
	quest.7A615E2A152917AD.title: "&zRainbow Core"
	quest.7A873E48E38B5C0E.quest_desc: ["Çelik makineler, Bronz makinelere göre iki kat daha fazla buhar tüketir; ancak bu durumu iki kat çalışma hızıyla telafi ederler."]
	quest.7A89560F303A8BE6.quest_subtitle: "Aşama: &63"
	quest.7A93F07BE2E6EC97.quest_desc: ["Yağmur yağarken Environmental Accumulator içine &aWeather Container&r atmak yağmuru hapseder.\\n\\nBunu kullanarak &9Sonsuz Su Kovası&r veya &9Sonsuz Su Kaynağı Bloğu&r üretebilirsiniz. İkisi de son derece kullanışlı eşyalardır!\\n\\nAyrıca bunu sırf yağmuru dindirmek için bile kullanabilirsiniz!"]
	quest.7A93F07BE2E6EC97.title: "&9Yağmuru&r &aDurdur!"
	quest.7A979BEB20C9591E.quest_desc: ["Akı Tozu üretimi &6Productive Bees&r modu ile otomatikleştirilebilir!\\n\\nBir Obsidiyen Arısı, bir Redstone Arısı Çağırma Yumurtasını tozlaştırdığında onu Flux Dust Arısı Çağırma Yumurtasına dönüştürür."]
	quest.7A979BEB20C9591E.title: "Otomatik Akı Tozu Üretimi"
	quest.7AC6A958936636D9.quest_desc: ["&aMountaineer's Spawner Upgrade Rune&r, Spawner Upgrade Runes serisinin 3. aşamasıdır. Evet, bunun için bir Muhafız ile savaşmanız gerekecek.\\n\\nMinimum Spawn Gecikme değerini 50'ye, Maksimum Spawn Gecikme değerini 200'e, Spawn Count değerini 13'e, Max Entities değerini 24'e ve Activation Menzil değerini 40'a ayarlar."]
	quest.7AD4ED72AC31D912.quest_desc: ["&3Aerwhale'ler&r &l&eAether'de&r süzülen devasa, hızlı, uçan barışçıl yaratıklardır. \\n\\nÖldüklerinde bir şey düşürmezler; sadece manzarayı güzelleştirirler."]
	quest.7AD4ED72AC31D912.title: "&3Aerwhale"
	quest.7AD9DF3FFCB03495.quest_subtitle: "Aşama: &a2"
	quest.7ADE214373DE135F.quest_subtitle: "Aşama: &63"
	quest.7ADE27F9398D97F1.quest_desc: ["Bu pek farklı değil, neden kontrol ediyorsun ki?"]
	quest.7ADE27F9398D97F1.quest_subtitle: "10"
	quest.7ADE27F9398D97F1.title: "Bee Armor 2"
	quest.7AE1459B0B862737.quest_subtitle: "Doğrudan üretilir"
	quest.7AE1459B0B862737.title: "Time Bee"
	quest.7AE3C8134F5ED726.quest_desc: ["Sırt Çantasındaki istif boyutunu 16 artırır."]
	quest.7AE3C8134F5ED726.title: "&dİstif Yükseltmesi Kademe 4"
	quest.7AE502EDB73BD57A.quest_desc: ["&4&lÖğütücü&r, adından da anlaşılacağı gibi öğütür! Tıpkı diğer Modların öğütme makineleri gibi... \n\nKülçelerden Toz, &7Taştan&r &7Kırık Taş&r ve &2Bitkilerden&r &2Biyoyakıt&r elde edebiliriz! \n\nToz birçok Tarif için gerekli olacak, bu yüzden buna kesinlikle ihtiyacınız olacak. Özellikle &8Yükseltmeler&r yapmak için!"]
	quest.7AE502EDB73BD57A.quest_subtitle: "Bir Şeyleri Öğütür."
	quest.7AE502EDB73BD57A.title: "&4&lÖğütücü"
	quest.7AE85F4FF4DDF4F2.quest_desc: ["Yel Değirmeni, Kinetik Dinamo ile kullanabileceğimiz başka bir seçenektir! \n\nBunlar otomatik olarak dönmeye başlayacak ve hızıyla Enerji elde edeceğiz, yani ne kadar çok hız o kadar çok Enerji. \n\nHızı nasıl elde ederiz? Öncelikle, çalışması için önünde alana ihtiyacı vardır. Önünde ne kadar az blok olursa o kadar hızlı döner! \n\nHızdaki bir diğer faktör ise Yel Değirmeni Yelkenleridir. Elinizde Yelkenler varken ortadaki Yel Değirmeni Bloğuna Sağ Tıklayarak toplamda 8 Yel Değirmeni Yelkeni ekleyebilirsiniz."]
	quest.7AED8FD7FB023AD8.quest_desc: ["&4&lMüjdeci&r'ı güçlendirmek için Wither'ı öldürerek elde edebileceğiniz bir Nether Star'a ihtiyacınız olacak. \\n\\nBu açıklamak zorunda olmamam gereken bir &2&lVanilla&r mekaniğidir. \\n\\nArtı, Bölüm 1'de (Chapter 1) bulunuyor."]
	quest.7AED8FD7FB023AD8.quest_subtitle: "Müjdeci'ı Güçlendirmek"
	quest.7AED8FD7FB023AD8.title: "Nether Star"
	quest.7AEE4BE3AB41ED3E.quest_desc: ["Sadece bir &bIgnitium Göğüslük&r ile bir Elitra'yı birleştirin... bu kadar basit!"]
	quest.7AEE4BE3AB41ED3E.title: "&bIgnitium Elytra Göğüslüğü"
	quest.7AEFF81E7C8CF300.quest_desc: ["Elinizde bir Just Dire Things aleti veya asası varken eğilerek sağ tıklamak, yetenekleri ayarlayıp aktif/pasif kılabileceğiniz yapılandırma menüsünü açar."]
	quest.7AF6C95816E82861.quest_desc: ["&#8F49C4Döteryum&r ve &#AABBFAOksijen&r &#5B75D4kimyasal reaksiyona sokulduğunda&r &#9C51DBAğır Su&r elde edilir. Elde edilen ağır su tekrar &#45BF56Reaktör&r içerisine aktarılabilir."]
	quest.7AF8567CF8C543F7.title: "&6Thermal Springstone Axe"
	quest.7AFEB7A91DC8F413.quest_desc: [
		"Novicius Orb artık bize yetmez. Altar Kademe I'e ulaştığında onun yerine &cDiscipulus Orb of Vitae&r'i üretebiliriz — çok daha fazlasını depolar ve daha hızlı boşalır."
		""
		"Bununla Anima'mızın tavanı &e25,000 EV&r'ye çıkar — öncekinden beş kat fazla."
	]
	quest.7AFEB7A91DC8F413.title: "Çırağın Küresi"
	quest.7B0764DDE94E73D0.quest_desc: ["Daha büyük &2&lReaktörlerde&r daha gelişmiş bir arıza korumasına ihtiyacımız olacak. \nBu tasarım için &2&lReaktörümüzün&r en az 5 Blok genişliğinde olması gerekir. Bu, 2 &2FRLA'mız&r için 3 Blok genişlik verir. \n\n&2FRLA'larımızdan&r 1 tanesini &2&lReaktöre&r yerleştirin ve Yüksek Sıcaklık veya Kritik Hasar olarak ayarlayın. Ardından ikincisini aynı Y Seviyesindeyken en az 1 Blok uzağa yerleştirin. İkincisinin Etkinleştirmeye ayarlanması gerekecektir. \n\nŞimdi biraz &4Redstone&r yapalım! \n\nİlk &2FRLA'dan&r dışarı bakacak şekilde bir &4Redstone Yenileyici&r yerleştirin. Ardından, &4Yenileyicinin&r baktığı yere &4Redstone&r ileten bir Blok koyun. \n\nO Bloğun üzerine, ikinci &2FRLA'nın&r bulunduğu yöne doğru bir &4Redstone Meşalesi&r yerleştirin. \n\nBundan sonra, ikinci &2FRLA'nın&r aynı X/Z Seviyesindeyken &4Meşalenin&r yanına &4Redstone Tozu&r koyun. Ve son olarak, &4Redstone Tozundan&r ikinci &2FRLA'ya&r giden ikinci bir &4Redstone Yenileyici&r yerleştirin."]
	quest.7B0764DDE94E73D0.title: "Gelişmiş Arıza Koruması"
	quest.7B0CE182D3FE3035.quest_subtitle: "2 blok boyundaki çiçekler MA Özü ile üretilebilir"
	quest.7B0CE182D3FE3035.title: "Üretilebilir Çiçekler"
	quest.7B0DFA55B4D8B16D.quest_desc: [
		"&a&lIşınlayıcılar&r, &5Makine&r yapıldığı ve &aGüçlendirildiği&r sürece herhangi bir Boyutta herhangi bir yere Işınlanmamızı sağlayacaktır! \n\nŞimdi onu nasıl yapacağız ve Güçlendireceğiz? \n\nİlk olarak, &a&lIşınlayıcıyı&r yapmak için 1 &aIşınlayıcı Bloğuna&f ve 9 &aIşınlayıcı Çerçevesine&r ihtiyacımız olacak. \n\n&aIşınlayıcı Bloğu&r, &a&lIşınlayıcının&r ana &aKontrolcüsüdür&r. &aEnerjiye&r ihtiyaç duyacak Bloktur ve &aGüçlendirildiğinde&r onu açabiliriz. Burada tıpkı &5Kuantum Dolaşıklık Işınlayıcı&r gibi bir Ağ ayarlayabiliriz, bir isim yazın ve Ağı oluşturmak için Onay İşareti Düğmesine tıklayın! \n\nŞimdi diğer &a&lIşınlayıcı Yapıları&r veya &aIşınlayıcı Blokları&r o Ağa ayarlandığında (Arayüzlerindeki adlandırılmış Ağa tıklayarak) &a&lIşınlayıcıyı&r belli ki aynı Ağdaki diğer &a&lIşınlayıcılara&r Işınlanmak için kullanabilirsiniz. \n\nŞimdi &a&lIşınlayıcı Yapısını&r yapma hakkında. &aIşınlayıcı Bloğunun&r her iki tarafına bir &aIşınlayıcı Çerçevesi&r yerleştirin. Bunların üzerine 4 blok yüksekliğinde olması için 3 tane daha yerleştirin. &aIşınlayıcı Bloğunun&r üzerinde 2 blok boşluk olacak şekilde, son &aIşınlayıcı Çerçevelerimizi&r yerleştirebiliriz. \n\nŞimdi Güç verildiğinde ve ayarlandığında, &a&lIşınlayıcı&r hazır olacak ve ortaya çıkan hangi renkteki Portaldan yürüyebileceksiniz! \n\n(Her biri için Rengi &a&lIşınlayıcı&r Arayüzünden değiştirebilirsiniz!)"
		"{@pagebreak}"
		"{image:atm:textures/questpics/mek/meka_portal1.png width:200 height:75 align:center}"
		"&aIşınlayıcı Bloğunu&r yanına 2 &aIşınlayıcı Çerçevesi&r ile yerleştirin."
		"{image:atm:textures/questpics/mek/meka_portal2.png width:150 height:125 align:center}"
		"Şimdi önceki &aIşınlayıcı Çerçevelerinin&r üzerine &aIşınlayıcı Çerçeveleri&r yerleştirin."
		"{image:atm:textures/questpics/mek/meka_portal3.png width:100 height:125 align:center}"
		"Tekrarlayın."
		"{image:atm:textures/questpics/mek/meka_portal4.png width:100 height:140 align:center}"
		"Şimdi, üst taraf için tam bir sıra &aIşınlayıcı Çerçevesine&r ihtiyacımız olacak."
		"{image:atm:textures/questpics/mek/meka_portal5.png width:110 height:150 align:center}"
		"Her şey ayarlandığında, seçtiğiniz Portal bu şekilde görünmelidir!"
	]
	quest.7B0DFA55B4D8B16D.quest_subtitle: "Işınlanmanın En İyisi"
	quest.7B0DFA55B4D8B16D.title: "Özel Portallar!"
	quest.7B140A034DF1291C.quest_desc: ["&7&lNexium Emitter&r'ı etrafta hareket ettirmek için bir şeye ihtiyaç vardır; bu, &6Mekanik Kol&f veya &6Large Advanced Motor&r olabilir! \\n\\nİkisi de hareket eder, bu yüzden ikisi de işe yarar!"]
	quest.7B140A034DF1291C.title: "&6Mekanik Kol&f veya &6Large Advanced Motor"
	quest.7B1693793419B769.quest_subtitle: "Silver Lime + Cherry"
	quest.7B1818D2C5C2BB18.quest_desc: ["Soulstrider's Pickaxe, cevher parçalarını “vein-mine” (damar madenciliği) yapmak için kullanılabilir."]
	quest.7B1818D2C5C2BB18.quest_subtitle: "Kademe: &e5"
	quest.7B2008977702D0C8.quest_desc: ["Bir Air Kompresör'da basınç oluştururken, basıncın gideceği bir yer yoksa, sadece ortadan kaybolacaktır. Biraz yapmadan önce basıncın gideceği bir yer olduğundan emin olun."]
	quest.7B2008977702D0C8.quest_subtitle: "RF veya FE'ye ne oldu?"
	quest.7B21D2FAD5F3246A.quest_desc: ["&b&lIce &fand &cFire&r'a hoş geldiniz! Artık &b&lThe Other&r'da \n\nBu Mod, hepsi mitolojinin bir türüyle ilişkili olan veya tamamen Moda özgü sayısız Canavar ve Yaratık ekler! \n\nBu Canavarları &b&lThe Other&r'ın her yerinde bulacaksınız, ancak dikkatli olun, hepsi dost değildir! "]
	quest.7B21D2FAD5F3246A.title: "&b&lIce &fand &cFire&r"
	quest.7B293C32824033F9.quest_desc: [
		"&cCrystallum Fractura&r ritüeli hasadı bizim için otomatikleştirir: menzildeki her kristal türünün büyüme hızını iki katına çıkarır ve olgunlaştıkları an her birini toplar."
		""
		"Topladığı her tam büyümüş kristal için, chunk'ın Raw Spiritus'una göre ölçeklenen ek Fortune uygular. Etkinleştirir, kendi kendine çalışmasına izin veririz."
	]
	quest.7B293C32824033F9.title: "Crystallum Fractura'yı Etkinleştir"
	quest.7B3613C01F0B1373.quest_desc: [
		"&3Vibranium&r ve &6Allthemodium&r'u birleştirmek için &l&cPowah&r'a girmemiz gerekecek! \\n\\nEnerjilendiren Küre'yi yere yerleştir ve ardından Enerjilendiren Çubukları ona bakacak şekilde yerleştir. Enerjilendiren Çubukların bir Güç Kaynağına yerleştirilmesi gerekir sonrasında Küreye Enerji gönderirler. Her birinin tuttuğu ve gönderdiği miktar Kademesi tarafından belirlenir. \\n\\nKülçeleri, 2 Piglich Kalbi ve Sıkıştırılmış Nitro Kristal Bloğu X1'i Küreye yerleştir (sıra önemli değil). Ardından 1 Milyar FE Çubuklar aracılığıyla Küreye aktarıldığında hazır olacaktır!\\n"
		"{ \"text\": \"POWAH GÖREV SERİSİ\", \"color\": \"#55FF55\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"2A6EBEEBAB882679\" } }"
	]
	quest.7B385FD1CBE02C85.quest_desc: ["&bSoğutucu&r olarak &9Su&r kullanıyorsak, yan ürün olarak Buhar elde edeceğiz! \n\nŞimdi onunla ne yapacağız?"]
	quest.7B385FD1CBE02C85.title: "Buhar"
	quest.7B3920DE6306A94A.quest_subtitle: "Mandarin + Kumquat"
	quest.7B40A9DAA119DE59.quest_subtitle: "Kristal Arısı + Neon Guguk Arısı"
	quest.7B40A9DAA119DE59.title: "Menril Arısı"
	quest.7B447E986493AD6B.quest_desc: ["&7Kreozot Yağı&r, &lKok Fırınının&r bir yan ürünüdür. \n\nTemel kullanımı, &8&lIE&r'nin temel Yapı Bloğu olan İşlenmiş Odun yapmak olacaktır. \n\nAyrıca daha sonra farklı bir Sıvı için de ona ihtiyacınız olacak, oraya vardığımızda bunun için endişeleniriz."]
	quest.7B447E986493AD6B.title: "&7Kreozot Yağı"
	quest.7B4A687EB505C2FF.quest_desc: ["&cKarminit İnşacıları&r, Redstone sinyali aldığında sinyalin yönünde geçici bloklar oluşturur.\\n\\n&cKarminit Reaktörü&r ise çevresindeki Obsidyen ve Netherrack bloklarını &eSahte Altın&r ile &3Sahte Elmas&r'a dönüştürür. Ardından bu blokları içine çekip patlayarak etrafa &cKarminit Ghastling&r'ler saçar."]
	quest.7B4A687EB505C2FF.title: "&cKarminit İnşacıları \\& Reaktörleri"
	quest.7B4AAC741F0A6073.quest_desc: ["Her reaktörde &9Reaktör Kontrol Çubuğu (Temel)&r ve &9Reaktör Yakıt Çubuğu (Temel)&r blokları bulunmalıdır. Bu bloklar yakıtın reaktöre nasıl yerleştirildiğini denetler.\n\nReaktör Kontrol Çubuğu (Temel) blokları reaktörün üst tavanına yerleştirilir. En az 1 tane olmalıdır ancak isteğe göre sayısı artırılabilir. Genellikle çubuk sayısı arttıkça reaktör daha fazla yakıt kullanıp yakabilir. Bu da reaktör tasarımınıza bağlı olarak daha yüksek yanma oranı pahasına genel gücü artırabilir.\n\nHer Reaktör Kontrol Çubuğu (Temel) bloğunun altına, reaktör tabanına kadar uzanacak şekilde Reaktör Yakıt Çubuğu (Temel) blokları dizilmelidir. Örneğin 5 blok yüksekliğinde bir reaktörünüz varsa, her Reaktör Kontrol Çubuğu (Temel) bloğunun altına 3 adet Reaktör Yakıt Çubuğu (Temel) yerleştirmeniz gerekir.\n\nReaktör Kontrol Çubuğu (Temel) bloğuna sağ tıkladığınızda yakıt çubuklarını içeri iterek veya dışarı çekerek ne kadar yakıt yakılacağını kontrol edebilirsiniz. Çubukları ne kadar içeri uzatırsanız, o kadar az yakıt yakılır."]
	quest.7B4AAC741F0A6073.title: "Reaktör Kontrol Çubuğu (Temel)"
	quest.7B4AF35313D7D779.quest_subtitle: "Kademe: &64"
	quest.7B4AF35313D7D779.title: "&6Supreme Makine Kasası"
	quest.7B500E0577BDFF8F.quest_desc: ["&6Bronz&r, &6Bakır&r ve Tin karışımıdır. \\n\\nAlaşımı yapmanın bir düzine farklı yolu var, sana doğru yolu söylemeyeceğim."]
	quest.7B500E0577BDFF8F.quest_subtitle: "18"
	quest.7B500E0577BDFF8F.title: "&6Bronz Zırh"
	quest.7B524DAD8A33BF85.quest_desc: ["Düşmanlarınızdan daha fazla kana mı ihtiyacınız var? Tabii ki var!\\n\\n&dVein Sword&r, üzerindeki Ganimet (Looting) büyüsü sayesinde ekstra ganimetin yanı sıra çok daha fazla kan toplamanızı sağlar!"]
	quest.7B5A0BFD47D96BDE.quest_desc: ["Etrafında uçuşan arıları yakalamak için kullanılır.\n\nHangi arıları yakalamak istediğinizi filtrelemek için Filtre Yükseltmesi, yalnızca yavru arıları yakalamak için ise Yavru Arı Yükseltmesi kullanabilirsiniz."]
	quest.7B5A0BFD47D96BDE.quest_subtitle: "Arıları yakalar"
	quest.7B5D34650BBD97D9.quest_desc: ["&5Aethersent&r materyali &5Meteor Yağmuru&r alanlarında ve &5Creteor&r yaratıklardan elde edilir. \\n\\nYüksek seviye ekipman ve araçların yapımında kullanılır."]
	quest.7B5D34650BBD97D9.title: "&5Aethersent"
	quest.7B72CF322A3C985D.quest_desc: ["Bir &8Obsidiyen Arısı&r, bir &4Redstone Arısı Çağırma Yumurtasını&r tozlaştırdığında onu &2Flux Dust Arısı Çağırma Yumurtasına&r dönüştürür."]
	quest.7B72CF322A3C985D.title: "Flux Dust Arısı"
	quest.7B76EC62E3F7E12C.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_aethersent.png width:100 height:150 align:center}"]
	quest.7B76EC62E3F7E12C.title: "&5Aethersent&r"
	quest.7B7D1F0CB326B28F.quest_desc: ["&bME GÇ Bağlantı Noktası&f, bir ME ağının depolama içeriğinin ME hücreleri ve depolama veriyollarına bağlı harici konteynerler gibi farklı depolama ortamları arasında hızlı bir şekilde yeniden düzenlenmesini sağlar.\\n\\nSoldaki giriş yuvasına bir hücre yerleştirildiğinde, GÇ Bağlantı Noktası, hücreyi diğer ME depolarına boşaltmak veya (ideal olarak bölümlenmiş) hücreyi diğer depolara yayılmış belirli eşyalarla doldurmak için değiştirilebilir."]
	quest.7B7D1F0CB326B28F.quest_subtitle: "Disk Birleştirme"
	quest.7B7F7626FB6813FA.quest_subtitle: "Aşama: &63"
	quest.7B937E68FEFBBA98.title: "&dStarlit Elmas Göğüslük"
	quest.7B9486981786AC47.quest_desc: [
		"&lYetenek Türü:&r Aktif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Etraftaki yaratıkların yapay zekasını kalıcı olarak devre dışı bırakır. Enerji maliyetinden ötürü tek kullanımda en fazla 5 yaratığı etkiler ve uzun bir bekleme süresi bulunur."
	]
	quest.7B9672C4FCFFB887.quest_desc: ["Bu &9Şemalar&r Üretilebilir ve oldukça ucuzdurlar! \n\nUyarı İşaretleri &7Metal Plakalar&r, Boyalar ve bu &9Şema&r ile yapabileceğimiz çok basit dekorasyonlardır."]
	quest.7B9672C4FCFFB887.title: "&9Uyarı İşaretleri Şemaları"
	quest.7B99AA20DC55263C.quest_subtitle: "Kurşun Arısı + Gümüş Arısı"
	quest.7B99AA20DC55263C.title: "Antimon Arısı"
	quest.7B9F5EEC76FDD0D4.title: "Draconic Hasar Modülü"
	quest.7BB3BF6162F05265.quest_desc: ["Belirli bir dönüş hızını tam istediğin devir/dk (RPM) değerine ayarlamak bazen zor olabilir... Öyleyse neden bir Dönüş Hızı Denetleyici bloğu kullanmayasın! \\n\\nDönüş Hızı Denetleyici bloğu, üzerindeki &dBüyük Dişli&r bloğundan &dDönme Gücü&r alır ve içindeki &8Şaft&r üzerinden ters yönde, ayarladığın hızda iletir. \\n\\nYan yüzlerinden birine sağ tıklayıp basılı tutarak hedeflenen devir/dk değerini değiştirebilirsin. &dBüyük Dişli&r bloğuna verilen hız ne olursa olsun, &8Şaft&r her zaman ayarladığın devir/dk değerinde döner. \\n\\nGiriş hızından daha yüksek bir değer ayarlasan bile... Bunun kasıtlı olduğunu sanmıyorum..."]
	quest.7BC289DEF023FEAA.quest_subtitle: "Aşama: &63"
	quest.7BC616DDB5933479.quest_desc: ["Bu, bir &5Blood Vial&r ve Tomarlar için gereken normal malzemelerle oluşturulabilir. \\nYükseltebileceğiniz Seviye 10 ve &6Efsanevi&r olduğundan emin olmanız gerekecek."]
	quest.7BC616DDB5933479.title: "&4Wither Skull Scroll"
	quest.7BC8F50A89A3BE1A.quest_desc: ["Bunlar &cLaser Node&r'larını birbirine ve konektörlere bağlamak için kullanılır. Pek karmaşık bir işlevi yok, sırf anahtar temasını tamamlasın diye var. \\n\\nAyrıca diğer modların yapılandırmalarında da İngiliz anahtarı işlevi görür!"]
	quest.7BCD4A425CF6199B.quest_desc: ["&9Xeovrenth Adjure&r'dan çağrılan Goat of Mercy'i (Merhamet Keçisini) öldürdükten sonra, kendinizi bir Cruelty Essence (Zulüm Özü) daha zengin bulacaksınız. Bunu Brown Chalk (Kahverengi Tebeşir) oluşturmak için biraz Cocao Beans (Kakao Çekirdekleri) ile birleştirin."]
	quest.7BCD4A425CF6199B.title: "&#4E2C00Brown Chalk"
	quest.7BCE96070C36D547.quest_subtitle: "&f7.5 &cSaldırı Hasarı"
	quest.7BFB4DA68A7912E5.quest_desc: ["Ambrosium, &e&lAether'in&r kömürüdür. \\n\\nMeşale yapımında ve fırınlarda yakıt olarak kullanılır. \\n\\nAyrıca Aether çimleri üzerinde kullanıldığında toprağı kutsar."]
	quest.7BFB4DA68A7912E5.title: "&eAmbrosium"
	quest.7BFC24607189B6D0.quest_desc: ["Daha hızlı yüzmenizi sağlar."]
	quest.7BFC24607189B6D0.quest_subtitle: "Maks: 1"
	quest.7BFE7DAF18981843.quest_subtitle: "Matkap tarifleri için gerekli"
	quest.7C07D6A33F7ADB02.quest_desc: [
		"Bu, Sırt Çantanı Sırt Çantana koyabilmen için Sırt Çantası yükseltmesidir."
		""
		"Böylece Sırt Çantana ihtiyaç duyduğunda Sırt Çantanı Sırt Çantanda taşıyabilirsin."
	]
	quest.7C07D6A33F7ADB02.quest_subtitle: "Sırt Çantası içinde Sırt Çantası?"
	quest.7C0F7A1B3AB9A1A1.quest_subtitle: "Daha Fazla Filtreleme Seçeneği"
	quest.7C0F7A1B3AB9A1A1.title: "&eGelişmiş Yeniden Doldurma Yükseltmesi"
	quest.7C169A4A39F37FAC.quest_desc: ["Vanilla Arı Kovanı ile bir &eGelişmiş Arı Kovanı&r üreteceğiz. Meşe veya her türlü ahşaptan yapılabilir.\n\nArılar bunlara girip çıkacak ve kovanın envanterine Bal Peteği bırakacaklar. Ayrıca Bal Şişesi elde etmek için cam şişe de yerleştirebilirsiniz.\n\nÖdül mamaları için bolca Bal Peteğine ihtiyacımız olacak!"]
	quest.7C169A4A39F37FAC.quest_subtitle: "Artık petek kesmeye son."
	quest.7C169A4A39F37FAC.title: "Gelişmiş Meşe Arı Kovanı"
	quest.7C1D407CF67786F6.quest_desc: ["&d&lArs Elemental&r Air Armor!"]
	quest.7C1D407CF67786F6.quest_subtitle: "15"
	quest.7C1D407CF67786F6.title: "&fAethermancer Outfit"
	quest.7C2ED69E07988DF4.quest_desc: ["Orijinal &2&lMinecraft&r Sandalyesi, merdivenler. \\n\\nModlu &2&lMinecraft&r'a hoş geldin, dekorasyon için merdivenlerden çok daha fazlasına sahibiz. \\n\\nDekorasyon ekleyen onlarca mod var ve dekorasyon için kullanılabilecek eşyalar ekleyen daha da fazlası var!"]
	quest.7C2ED69E07988DF4.title: "Dekorasyon!"
	quest.7C3D763CF22D167A.quest_desc: ["Starlight Şarj Cihazı, \"Star Charged\" büyüsü ile malzemeleri \"büyüleyebilir\".\\n\\nOrtasında Starlight Şarj Cihazı bulunan bir yapı gece gökyüzüne bakacak şekilde inşa edilmelidir. Sadece gece boyunca Starlight Gücü kazanır.\\n\\nŞarj Cihazı, her köşesinde bir Sütun olacak şekilde 7x7'lik bir yapının ortasına yerleştirilmelidir. Her sütunda \"Starlight Şarj Cihazı Başlığı\" bulunmalıdır.\\n\\nAyrıca malzeme başına bir şarj cihazı katalizörü gerektirir."]
	quest.7C3D763CF22D167A.quest_subtitle: "Malzemelerin \"Büyülenmesi\""
	quest.7C3D763CF22D167A.title: "&dStarlight Şarj Cihazı"
	quest.7C3F65B5DAC7E57B.quest_desc: ["&eEnd&r'in derinliklerinde, kadim harabeler arasında saklı, &9gecenin kendisinden&r dokunmuş bir &6kalıntı&r bulunur... &5Gece Yarısı Örtüsü&r. \\n\\nBu pelerin yukarıdaki &bgökyüzüyle&r birlikte değişir; &9Ay&r doruğuna ulaştıkça güçlenir, karanlık çöktüğünde gölgeye karışır. \\n\\n- &l4 yeteneği vardır:&r \\n\\n1. &dAy Evresi&r: \\n &chasarın&r ve &2saldırı hızın&r büyük ölçüde artar; ancak &cgücü&r &9Ay&r'ın dolunay evresine ne kadar yakın olduğuna bağlıdır. \\n\\n2. &8Gölge&r: \\n &odüşük ışıkta&r pelerin seni &8karanlığa&r bürür ve &lgörünmezlik&r sağlar. &8Gölgelerden ayrılmak&r bu etkiyi &2&okısa bir süre&r&r zayıflatır; yeniden kullanılabilmesi için &cdüşmanların&r seni görmeyi bırakması gerekir. \\n\\n3. &7Takımyıldız&r: \\n &chasar&r almak etrafında dolaşan &zyıldızlar&r oluşturabilir. Bu &eyıldızlar&r takımyıldızlarına bağlanarak içlerinden geçen &cdüşmanların&r yönünü bozabilir veya dokunulduğunda &cpatlayarak&r yakındaki her şeye &chasar&r verebilir. \\n\\n4. &eYıldız Yağmuru&r: \\n &cdüşmanlarına&r vurduğunda düşen bir yıldız çağırma ihtimalin vardır; çarpma anında &ehasar veren&r ve hedefleri kısa süreliğine sersemleten bir &eşok dalgası&r oluşturur. \\n\\n- Göklerle... ve gökler arasındaki &8karanlıkla&r bağlı bir &6kalıntı&r."]
	quest.7C3F65B5DAC7E57B.quest_subtitle: "Her güç ışıktan gelmez..."
	quest.7C3F65B5DAC7E57B.title: "&5Gece Yarısı Örtüsü"
	quest.7C40F1963FC5BF65.quest_desc: [
		"İşte resmi AE2 rehberi ve oyun içi rehberin ötesinde bazı ek AE2 rehberleri."
		"{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://allthemods.github.io/alltheguides/mods/ae2/\"},\"color\":\"blue\",\"text\":\"AllTheGuides AE2 Rehberi\",\"underlined\":true}"
		"{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://www.youtube.com/watch?v=3htUhkDYbJ8\"},\"color\":\"blue\",\"text\":\"BucketSt'ten AE2 Rehber Videosu\",\"underlined\":true}"
		"{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://www.youtube.com/playlist?list=PLz9AkOmMlH1lI4H3GeBQ3VzEKlcDDNO8_\"},\"color\":\"blue\",\"text\":\"The MindCrafters'dan AE2 Rehber Oynatma Listesi\",\"underlined\":true}"
		"{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://www.youtube.com/watch?v=2_s1srWvq20\"},\"color\":\"blue\",\"text\":\"The MindCrafters'dan Gelişmiş AE Rehberi\",\"underlined\":true}"
	]
	quest.7C4D8AA107780795.quest_desc: ["&aSıvılaştırıcı&r yardımıyla &dBlutonyum Külçesi&r ile &eYelloryum Külçesini&r karıştırarak &2Verderyum&r üretebiliriz.\\n\\n&2Verderyum&r reaktörde yakıt olarak yakıldığında yan ürün olarak &cRossinit&r verir. İhtiyacımız olan malzeme tam olarak bu!\\n\\n&2Verderyumu&r yakıt olarak beslemek için reaktörünüze &cReaktör Yakıt Enjeksiyon Bağlantı Noktası (Güçlendirilmiş)&r eklemeniz gerekir.\\n\\nNot: Mevcut reaktördeki yakıtı tamamen boşaltmanız veya bu işlem için ayrı bir reaktör kurmanız gerekebilir."]
	quest.7C4D8AA107780795.title: "Rossinit"
	quest.7C4E4793DA887DE4.quest_desc: ["Efsanevi &eBig Reactors&r modunu temel alan &aExtreme Reactors&r, tamamen özelleştirilebilir çoklu blok reaktörler kurmanıza olanak tanır!\\n\\nTemel yakıtımız elbette uranyumdur. Kuruluma başlamak için uranyumun yanı sıra bolca kömür ve demire ihtiyacınız olacak.\\n\\nRehbere ihtiyacınız olursa detaylar için &aThe Extreme Book&r kitabına göz atabilirsiniz!"]
	quest.7C4E4793DA887DE4.quest_subtitle: "Tadı lezzetli gelebilir ama sakın yemeyin..."
	quest.7C4E4793DA887DE4.title: "&9Extreme Reactors&r'a Hoş Geldiniz!"
	quest.7C53F52992EA2064.title: "&4Amaramber Kürek"
	quest.7C54581562D2EA75.quest_desc: ["Hız Modülleri eğlencelidir, hemen hemen her şeyde çalışırlar ve onları daha hızlı yaparlar! Kılıçlar daha hızlı savrulur, Kazmalar daha hızlı kazar, Baltalar daha hızlı keser, Yaylar daha hızlı ateş eder ve Göğüslük sizi daha hızlı yapar. Hız Modülü ne kadar iyi olursa o kadar hızlı olurlar! (Bu arada çoğu istatistiğin üst üste biriktiğini belirtmek için iyi bir zaman. 2 Temel Hız Modülü o zaman Hızı %20 artırır!)"]
	quest.7C54581562D2EA75.title: "Temel Hız Modülü"
	quest.7C5FC2015F1E6DB1.quest_desc: ["Tüm &8Troll&r'ler Silah tutacaktır. Bu &8Silahları&r sizi Öldürmeye çalışmak için kullanırlar. \n\nÇok nadiren Ölüm üzerine &8Silahlarını&r Düşürürler. \n\nTüm bu &8Silahlar&r devasadır! Ancak Oyuncu yine de onları Tutabilir ve Kullanabilir! Tonla hasar verirler ancak Savrulmaları çok yavaştır."]
	quest.7C5FC2015F1E6DB1.title: "&8Troll Silahları"
	quest.7C651B90A738323E.quest_desc: ["Uyandırılmış Supremium Arısı ile karıştırılmamalıdır."]
	quest.7C651B90A738323E.quest_subtitle: "Draconic Füzyon Üretimi"
	quest.7C651B90A738323E.title: "Uyandırılmış Arısı"
	quest.7C687DCF71D77761.quest_desc: ["&c&lGelişmiş&r, &a&lTemel&r'in Yükseltmesidir. \n\n&c&lGelişmiş&r Makineler, &a&lTemel Aşamaya&r göre daha fazla &eeşya&f tutacak, daha fazla &eeşya&r taşıyacak ve daha fazla Yuvaya sahip olacaktır. \n\n&c&lGelişmişler&r &cİnfüze Alaşımlar&f, &cGelişmiş Kontrol Devresi&f ve genellikle &7Osmiyumdan&r yapılır! \n\n&cGelişmiş Kontrol Devreleri&r 2 &cİnfüze Alaşım&r ve bir &aTemel Kontrol Devresinden&r yapılır."]
	quest.7C687DCF71D77761.title: "&c&lGelişmiş Aşama"
	quest.7C73740F1B515F2C.quest_desc: ["&#C452C4Tungsten Tozu&r işlenebilmek için daha küçük toz parçacıklarına ayrıştırılmalıdır."]
	quest.7C758209D06ED0E3.quest_desc: ["&4Aşılama Yapılmış Cehennem Kitaplığını&r &eIşık Taşı&r ile birleştirerek &4Parlayan Cehennem Kitaplığı&r elde edebilirsin. \\n\\nBu raflar aynı &aEterna&r ve &cQuanta&r değerini korurken ek olarak raf başına &5%3 Arkana&r sağlar. \\n\\nBir &9Uyuyan Derin Kitaplığı&f işleyip &9Derin Kitaplığa&r &d&lİnfüze etmek&r için 12 adet raf gerektiğinde bu Arkana bonusu çok işine yarayacaktır!"]
	quest.7C758209D06ED0E3.title: "&4Parlayan Cehennem Kitaplığı"
	quest.7C79BCE482A06199.quest_desc: ["&b&lIce&r tamamen Kış zamanı Büyüleriyle ilgilidir. Düşmanları üşütmek ve incitmek için &bIce&r ve &bSnow&r kullanmak. \\n\\n&b&lIce's&r Focus Materyali, &bStrays&r'den düşen &bFrozen Bone&r'dur (Donmuş Kemik). Bunları &bIce Rune&r'u üretmek veya onu almak için &b&lCryomancer&r'ı öldürmek için kullanabilirsiniz. \\n\\n&bScrolls&r'u (Parşömenleri) &9Darker Blue&r metinle &bLight Blue&r (Açık Mavi) renktedir."]
	quest.7C79BCE482A06199.title: "&b&lIce"
	quest.7C7BD54624ED9AC2.quest_desc: ["Kelimenin tam anlamıyla Yaratıcı Uçuşu. \n\nBunu &cJetpack &7Modülü&r ile birlikte kullanamazsınız ve evet Uçmak için &aEnerji&r harcayacaktır! \n\nYapılandırmaları içinden ne kadar hızlı Uçacağınızı da artırabilirsiniz."]
	quest.7C7BD54624ED9AC2.quest_subtitle: "Göğüslük"
	quest.7C7BD54624ED9AC2.title: "&dYerçekimi Modülasyonu &7Modülü"
	quest.7C7C061FC04B89FB.quest_desc: ["Arıtılmış Demonite, &cHellforged Ingots&r'a dönüşür — oyun sonu aşamasında inşa edeceğimiz neredeyse her şeyin omurgası."]
	quest.7C7C061FC04B89FB.title: "Hellforged Steel"
	quest.7C7C0D3D7FCB0297.quest_desc: ["&6&lThe Bumblezone&r yapılarında bulunabilir veya &5Arı Kraliçesi&r ile takas edilebilir! \n\n&6Arıların&r birbirlerini bulmak ve iletişim kurmak için oldukça ilginç bir yöntemi vardır. Bunu nasıl yaptıklarını bilim açıklayamıyor ama antenlerinin radyo dalgası yayıp aldığını varsayabiliriz. \n\nİğnesiz Arı Miğferi takarken etrafınızdaki tüm &6arıları&r vurgulamak için Shift tuşuna basılı tutabilirsiniz. \n\nAyrıca miğfer takılıyken zehir ve bulantı etkileri çok daha hızlı geçer."]
	quest.7C848C7011726470.quest_desc: ["&cCanavar Gözü&r, &c&lNetherit Canavarı&r ile savaşmanız için sizi &cRuh Demirhanesi&r'e götürecektir."]
	quest.7C848C7011726470.title: "&cCanavar Gözü&r"
	quest.7C8CDD259495A31A.quest_desc: ["&eTüneller&r en temel düzeyde &eKayışlarınızı&r örtecektir. Bu, &eEşyaların&r toplanamamasını sağlar ve umulur ki Mob'lar ayrılmaz. \\n\\n&eTünelin&r üzerinde bulunduğu &eKayışa&r dik olarak hareket eden başka bir &eKayış&r yerleştirirseniz, &eTünel&r &eEşya&r Yığınından 1 &eEşyayı&r dik &eKayışa&r filtrelerken, &eEşyaların&r geri kalanını ilk &eKayış&r üzerinde bırakacaktır. \\n\\nYalnızca 1 &eEşya&r varsa, &eTünel&r içinden normal şekilde geçecektir."]
	quest.7C8CDD259495A31A.title: "&eAndezit Tünel"
	quest.7C90008081DEBECA.quest_desc: ["&eAletleriniz&r ve &aCevherleriniz&r var... peki bunları nasıl birleştireceğiz? \n\nÖncelikle &eAletinizde&r açık bir &9Yuva&r olduğundan emin olun. (&9Yuvalar&r hakkında daha fazlası için Mühürler bölümüne bakın). \n\nBiri açıksa, &eAletinizi&r ve &aCevherinizi&r bir &8&lDemirci Masası&r'nda birleştirabilirsiniz. \n\nMevcut &aCevherlerinizden&r memnun değilseniz farklı bir Masaya ihtiyacınız olabilir!"]
	quest.7C90008081DEBECA.title: "&aCevherleri&r (ve Diğerlerini) Takma"
	quest.7C9154EF6068BE27.quest_desc: ["Teknik olarak Ezici'yi &6&lATM Yıldızı&r'nı 5 &6Yıldız Parçası&r'na dönüştürmek içinde kullanabilirsin... \\n\\nAma yeni &6&lYıldız&r yapmak için 262 tanesine ihtiyacın olacak... \\n\\nÖyleyse neden yapasın ki?"]
	quest.7C9154EF6068BE27.title: "Ama neden?"
	quest.7C94F6AE2A793858.title: "&e1024k Depolama Parçası"
	quest.7C9D9D1C054874A7.quest_desc: ["Mümkün olan en mükemmel efsun dizilimini mi istiyorsun? Tüm istatistikleri tavan yapmış, en üst seviye ve nadir efsunlarla dolu bir eşya? O halde bu kuruluma ihtiyacın var! \\n\\n1. 5 &9Ruh Dokunuşlu Sculk Kitaplığı&r ve 5 &9Yankılanan Sculk Kitaplığı&r: İhtiyacın olan tüm &cQuanta&r ve &5Arkana&r değerini fazlasıyla karşılar. \\n\\n2. 1 &dEjderhamsı End Kitaplığı&r: &aEterna&r sınırını doğrudan &a100&r tavan noktasına taşır. \\n\\n3. &6Denge'nin Jeotla Kaplı Kitaplığı&r: Yüksek Quanta'nın kötü/zayıf efsun getirme riskini tamamen engeller. \\n\\n4. (İsteğe Bağlı) &6Büyülü Hazine'nin Derin Kitaplığı&r: Normalde masada çıkmayan &5Tamir&r gibi özel hazine efsunlarının da çıkmasını sağlar!"]
	quest.7C9D9D1C054874A7.quest_subtitle: "Kuzgunun Masası Olmadan"
	quest.7C9D9D1C054874A7.title: "&6&lEn İyi Efsunlama Düzeni"
	quest.7CA60DC31447E57A.quest_subtitle: "&f7 &cSaldırı Hasarı"
	quest.7CB03F92F9ECEFFB.quest_desc: ["Neyse ki &6&lApotheosis&r, &eAletlerden&r &9Yuvaları&r (cevherleri) çıkarmayı çok daha kolay hale getirdi! \n\nArtık &eAleti&r mi yoksa &aCevheri&r mi kurtaracağınızı seçmek zorunda kalmak yerine ikisini de tutabilirsiniz. \n\nBir &8&lDemirci Masası&r'nda &eEkli Alet&r ile &aGeri Çekme Mührünü&r kullanın ve &aCevheri&r ondan ayırın."]
	quest.7CB03F92F9ECEFFB.title: "&aGeri Çekme Mührü"
	quest.7CB4D47ABC295B92.quest_desc: ["İksir üretir. Standart bir İksir Tezgahına benzer şekilde yakıt olarak Blaze Powder gerektirir ve şişeleri kullanır. Ancak bir İksir Tezgahından farklı olarak bu şişeleri otomatik olarak suyla doldurabilir.\n\nMakineye kısa bir genel bakış sunduğum diğer görevlerin aksine, bazı konularda bir hayli hantal ve kafa karıştırıcı olduğundan, bu makineyi otomatikleştirmek için başka bir görevde kurulum rehberi sağlayacağım."]
	quest.7CBAA67204CC258C.quest_desc: ["Hayır, &9&lMuhafız&r Kılıç ve Balta kullanmaz. Ama biz kullanabiliriz! \n\nHem &9Muhafız Kılıcı &fhem de &9Muhafız Baltası&r, bir &9Güçlendirilmiş Yankı Parçası &fve &9Muhafız Yükseltmesi&r ile &cNetherit versiyonlarının&r yükseltmeleridir. \n\nHer biri 1 &4Kalp&r daha fazla Hasara ve daha da fazla Dayanıklılığa sahiptir! \n\nEvet, Balta hâlâ Ağaçları verimli bir şekilde kesebilir."]
	quest.7CBAA67204CC258C.title: "&9Muhafız Silahları"
	quest.7CBAD1047B087803.quest_desc: [
		"Artık &etortulara&r sahipsiniz. Santrifüje bir Sıvı Eklentisi takmak, içine &aSülfürik Asit&r koymanıza olanak tanır. &eTortular&r bu asitle işlendiğinde değerli taşlar elde edersiniz."
		""
		"Alternatif olarak, daha düşük bir verim için &9Su&r da kullanabilirsiniz."
		""
		"&l&o&nNot&r"
		""
		"Şu anda, toz veya parçacık üreten bazı tarifler bozuktur."
	]
	quest.7CBAD1047B087803.quest_subtitle: "Bir tortuyu santrifüjlemek bana değerli taş mı veriyor...?"
	quest.7CBAD1047B087803.title: "\"Döndürerek Değerli Taş Elde Etme\""
	quest.7CBEBBCB9D95D11A.quest_desc: ["&5Derinlerin Yumurtası&r aynı zamanda &5&lLeviathan&r'dan düşen bir eşyadır, çünkü görünüşe göre hamile bir tanesini öldürmüşsünüz. \\n\\n&5Yumurtayı&r yere yerleştirin, sonra bir süre bekleyin ve kendi bebek &5Leviathan&r'ınıza sahip olacaksınız. \\n\\nÇatladığında onu evcilleştirmek için ona tonlarca Tropikal Balık yedirebilirsiniz. \\n\\n&5Bebeğin&r 1200 &4Kalbi&r vardır ve Tropikal Balık yiyerek iyileşebilir. \\n\\nEvcilleştirildikten sonra, tıpkı &eModern Kalıntı&r gibi Shift sağ tık ile takip etmeye, kalmaya veya dolaşmaya ayarlanabilir."]
	quest.7CBEBBCB9D95D11A.title: "Derinlerin Yumurtası"
	quest.7CBF22CCCF599F26.quest_desc: ["&cSiren Flute&r'ü yapmak için daha önce bahsedilen &bShiny Scales&r'a ve bir &cSiren Tear&r'a (Siren Gözyaşı) ihtiyacınız olacak. \\n\\n&cSiren Tear&r'lar &cSiren&r'lerden düşen nadir Ganimetlerdir ve &cFlüt&r veya Flama yapımında kullanılabilir. \\n\\n&cSiren Flute&r temel olarak baktığınız Yaratığa Zayıflık 1 Milyon verecektir. Aşık olacaklardır ve Aşık olduklarında size Saldırmazlar. \\n\\nAncak &cFlütün&r bir Bekleme Süresi vardır."]
	quest.7CBF22CCCF599F26.title: "&cSiren Flute"
	quest.7CC49360D07086B8.quest_desc: ["&o\"Son derece detaylı Atomik Makineler kullanarak tüm Maddeyi moleküler seviyeye kadar ayırabilir ve o molekülleri belirli dalga boyları üzerinden taşıyabiliriz...\"&r Hadi ama bu sadece Büyü! \n2 &5Kuantum Dolaşıklık Işınlayıcı&r ile Kablosuz olarak &eEşyaları&f, &bSıvıları&f, &cKimyasalları&f, &6Isıyı&f ve &aEnerjiyi&r taşıyabiliriz! \n\nİlk olarak, &5Kuantum Dolaşıklık Işınlayıcıları&r bağlamamız gerekiyor. Bunu birinin Metin Çubuğuna gidip bir Ağ adı yazarak yapıyoruz. \n\nRakamlar, Harfler, Semboller olabilir, ne olursa olsun sadece Yazın ve Onay İşareti Düğmesine basın! Ardından, ikinci &5Kuantum Dolaşıklık Işınlayıcıya&r gidin ve Ayarlanan Ağ Adına Tıklayın. Artık bağlandılar. \n\nOndan sonra, &bBorularınızı&f, &cTüplerinizi&f, &aKablolarınızı&r veya her neyse bir &5Kuantum Dolaşıklık Işınlayıcıya&r Bağlayın ve diğerine daha fazlasını veya hatta bir &5Makine&r yerleştirin. \n\nHer şey hazır olduğunda, eşyalarımızı gerçekten hareket ettirmek için Kenar Yapılandırmalarını değiştirin. Otomatik Çıkarmayı (Auto-Eject) ayarlamayı unutmayın!"]
	quest.7CC49360D07086B8.quest_subtitle: "Kablosuz Güç, Gazlar, Sıvılar, Her Şey."
	quest.7CC49360D07086B8.title: "&5Kuantum Dolaşıklık Işınlayıcılar"
	quest.7CC96CE9901F25BB.quest_desc: ["&l&5Forbidden and Arcanus&r, Hephaestus Forge adlı Multiblock yapısı etrafında şekillenen başka bir büyü modudur.\\n\\nKurmak için Forge'un tooltip'indeki talimatları izle. Kurulduktan sonra Rituals'ı güçlendiren dört material ile besleyebilirsin: Aureal, Souls, Blood ve Experience.\\n\\nForge'u Rituals aracılığıyla yükseltmen de gerekecek; bunların tümünü JEI'de bulabilirsin."]
	quest.7CE86300AF8E9BCA.quest_desc: ["Aynı jeneratörden 8 tanesini bir Echo Shard ile birleştirmek, onları tek bir devasa jeneratöre dönüştürür! 8 normal jeneratör gücünde çalışır ama sadece 1 blok yer kaplar."]
	quest.7CE86300AF8E9BCA.title: "8x Ne fırsat!"
	quest.7CF13A4941F608E5.quest_desc: ["Normal Camdan, İnce Camlara ve hatta Mozaiklere kadar!"]
	quest.7CF13A4941F608E5.title: "&l&bChipped&r Camı"
	quest.7CF9A68167ADAD1A.quest_desc: [
		"Ağın her aktarımda taşıdığı miktarı artırmak için bir &cMaster Routing Node Core&r, aktarımları daha sık göndermek içinse bir &cSpeed Core&r üretiriz."
		""
		"İstediğimiz kadarını yerleştiririz. Böyle beslenen bir ağ, okyanusları anlar içinde taşıyabilir."
	]
	quest.7CF9A68167ADAD1A.title: "Ağır İşleyen Kalp Kimseye Yaramaz"
	quest.7CFA92CC48D1E7E3.quest_subtitle: "Aşama: &c5"
	quest.7CFEE836C68B3903.quest_subtitle: "&f7.5 &cSaldırı Hasarı"
	quest.7D086BC5AC152E27.quest_desc: ["&cSiren&r'ler Öldüklerinde &3Prismarine Shards&f, &3Crystals&f ve... &bShiny Scales&r Düşüreceklerdir!!! \n\n&bShiny Scales&r şu Eşyalar dahil olmak üzere birkaç eşya Üretmek için kullanılabilir: &9Tide Guardian Armor&f, &cSiren Flutes&f ve &9Water Breathing Potions&r. \n\nO kadar bol olmalarına sevindim!"]
	quest.7D086BC5AC152E27.title: "&bShiny Scales"
	quest.7D0AE6FCB0996218.quest_subtitle: "Teak + Ipe"
	quest.7D159D333B2AC57E.quest_desc: [
		"500 Milyon OP ön şarj tamam mı? Yakıt dolduruldu mu? Sıcaklık 2000°C'ye ulaştı mı? Etkinleştir butonuna basın ve patlama olmaması için dua edin!"
		"{image:atm:textures/questpics/draconic/draconic_reactor_on_down.png width:200 height:100 align:1}"
		"{image:atm:textures/questpics/draconic/draconic_reactor_on_up.png width:150 height:150 align:1}"
	]
	quest.7D159D333B2AC57E.quest_subtitle: "Şimdi Dua Zamanı..."
	quest.7D159D333B2AC57E.title: "Reaktörü Etkinleştirme"
	quest.7D1A27CBF1508712.quest_desc: ["&3Snow Queen&r, Buzul Biyomu'ndaki &bAurora Palace&r'da yaşar. \\n\\nBuzul Biyomu'na girmek için Alpha Yeti'yi öldürmen gerekecek. \\n\\nTahtından indirildiğinde, Ganimet Kupası da dahil olmak üzere tonlarca ganimet düşürecektir!"]
	quest.7D1A27CBF1508712.title: "&3Snow Queen &eTrophy"
	quest.7D1D2A4E07E98709.quest_desc: ["Önündeki blokları kırmak için haznesinde bir alet gerektiren basit bir blok kırıcı."]
	quest.7D220876E8FF7AED.quest_desc: [
		"&#65C2A6Paket Açıcı&r; &#53E67BBlokları Külçelere dönüştürmekten&r makinelerin &#53E67Bparçalarını geri dönüştürmeye&r kadar pek çok işte kullanılır."
		""
		"&oHatta bu makine sayesinde çok daha kolay Silikon Külçesi elde edebilirsiniz.&r"
	]
	quest.7D279FC39DA5C630.quest_desc: ["&cKükürt Trioksitimizle&r işimiz henüz bitmedi! Onu daha fazla işlemek için biraz Su Buharına ihtiyacımız olacak. \n\nSu Buharı elde etmek için &9Suyu&r Su Buharına dönüştürmek amacıyla &c&lDöner Yoğunlaştırıcıyı&r (Rotary Condensator) kullanabiliriz! \nDaha fazla &cİnfüzyon&r! &aSülfürik Asit&r yapmak için Su Buharımızı &cSülfürik Trioksitimizle&r birleştirin. \n\nArtık bir Asit oldu... ama doğru olanı değil... \n\nAh evet, Cevher Kazarak elde edebileceğimiz &dFlorite&r ihtiyacımız olacak. Ardından nihayet &7Hidroflorik Asitimizi&r elde etmek için &aSülfürik Asidi&r &dFlorit&r ile seyreltmek amacıyla &3&lKimyasal Çözünme Odasını&r kullanın!"]
	quest.7D279FC39DA5C630.title: "&cKükürt Trioksit&r'i &7Hidroflorik Asite&r Dönüştürme"
	quest.7D2F41DD9774DDA7.title: "Eşya Taşımacılığı"
	quest.7D359283625C1869.quest_desc: ["&4&lCataclysm&r, tamamen yeni Boss'lar eklemekle ilgili bir macera modudur! Ve onlardan ve etraflarından her şey! \\n\\nYapıları &2&lOverworld&r, &4&lNether&r ve &5&lEnd&r'in her yerinde bulabilirsiniz. \\n\\nİçinde yeni Yaratıklar, Miniboss'lar ve çok zor Boss'lar olacak. Yeni Silahlar, Zırhlar ve Eşyalar elde etmek için hepsini öldürebilirsiniz!"]
	quest.7D359283625C1869.title: "&4&lCataclysm"
	quest.7D38BC3DB3406F51.quest_desc: ["Tahta Kazmamız ile taş kırmak sorun olmamalı!\\n\\n&3Kırık Taş&r, cevherlerimizi eritebileceğimiz Ocak üretmek için kullanarak ilerlemenin bir sonraki bölümünü açar.\\n\\nAyrıca &bDemir&r gibi daha iyi cevherleri çıkarmak için kazmanı taşa yükseltmek isteyeceksin!"]
	quest.7D38BC3DB3406F51.title: "Taş Çağı"
	quest.7D40B80DBBC4E160.quest_desc: ["Manuel Hadde Makinesi, Railcraft için birçok malzemenin üretileceği küçük üretim makineniz olacaktır! \n\nTarifi koyduğunuzda ve 1'den fazla üretebildiğinde, siz hala ona bakarken otomatik üretim yapacaktır. Üretim yaparken Hadde Makinesi'nden ayrıldığınızda üretimi iptal eder ve eşyaları envanterinize koyar. \n\nSon tarifi manuel olarak yapmalısınız!"]
	quest.7D43016926E77150.title: "&9Imperium Zırh&r"
	quest.7D52DD751DDADA1B.quest_desc: ["Güç aktarımı için temel kablolar."]
	quest.7D57A14810BC0CBE.quest_desc: [
		"&bYanan Küller&r'ı &bAlter of Flame&r üzerinde kullandığınızda &b&lIgnis&r'i elde edeceksiniz. \nOnun 7.200 &4Kalbi&r ve devasa bir &bKılıcı &fve &bKalkanı&r vardır. \n\n&bKalkanı&r verdiğiniz hasarı engelleyecek ve &bKılıcı&r sizi dilimlemek ve saplamak için kullanılabilecektir. Saplandığınızda, hareket edemezsiniz, sadece saldırabilirsiniz. \n\nAyrıca üzerinize sıçrayabilir, bunu yaptığında &bKalkanını&r yere vurarak Blokları ve sizi Havaya fırlatacak bir Şok Dalgası yaratır. Aynısını &bKılıcıyla&r da sıçramaya gerek kalmadan yapabilir. \n\nSahip olduğu bir diğer saldırı ise &bAteş Toplarıdır&r. Havaya 3 &bAteş Topu&r fırlatacak, ardından bunlar size doğru uçarak gönderilecek! Onları sanki bir Ghast Ateş Topu'muş gibi ona geri vurun. \n\nOnun &4Sağlığını&r yaklaşık 4.800 &4Kalbe&r indirdiğinizde, renkleri &bAçık Mavi bir renge&r dönüşecektir. Artık daha hızlı Saldıracak, daha fazla hasar verecek ve Can Çalma kazanacaktır. \n\nOnun &bAteş Topları&r da yansıtılamayacak ve artık farklı Şok Dalgası türleri yapabilecek!"
		"{image:atm:textures/questpics/cataclysm/cataclysm_ignis.png width:100 height:100 align:center}"
	]
	quest.7D57A14810BC0CBE.title: "&b&lIgnis&r"
	quest.7D67058592EE5958.quest_desc: ["Tasarı Topu, yakındaki sandıklardan malzeme alarak ve barut kullanarak yapıları tasarımlardan otomatik olarak inşa eder."]
	quest.7D68FD0637351E02.title: "&6Thermal Springstone Miğfer"
	quest.7D690A7D0FF6E328.title: "Kademe 3 Sınıflandırma Katalizörü"
	quest.7D6B4AEF806AF62E.quest_desc: ["%100 çok fazla hızlı! Ölmemeye çalışın!"]
	quest.7D6B4AEF806AF62E.quest_subtitle: "Maks: 1"
	quest.7D7983F39E6E818D.title: "Kademe: &9Niotik"
	quest.7D7BB45D84A4E94A.quest_desc: ["&3Swet Pelerini&r taktığınızda &9Swet'ler&r dost canlısı hale gelir! \\n\\nSizi yakalamak yerine binek gibi güvenle sürmenize izin verirler. \\n\\nSizi öldürmeye çalışmadıklarında çok daha az düşme hasarı alırlar."]
	quest.7D7BB45D84A4E94A.title: "&3Swet Pelerini"
	quest.7D7BD1458CF12021.quest_desc: ["&5Lunaris Cactus&r kaktüsleri büyüdüklerinde tepelerinde yenilebilir meyveler (&5Lunaris Cactus Fruit&r) üretirler."]
	quest.7D7BD1458CF12021.title: "&5Lunaris Cactus"
	quest.7D7DC3C695CD7236.quest_subtitle: "Silver Lime + Spruce"
	quest.7D7E4C31DFE59E29.quest_desc: ["Öncekilerin aksine bu Modüller sadece DE Yayları içindir. Mermi Hasar Modülü, Yay tarafından atılan Okların hasarını artırır. Bazı Modüller bununla birlikte olumsuz etkilere sahip olabilir, örneğin bunlar Yaylara biraz daha İsabetsizlik verir. Bunların hepsi üst üste birikebilir!"]
	quest.7D7E4C31DFE59E29.title: "Wyvern Mermi Hasar Modülü"
	quest.7D81F2381516204D.quest_subtitle: "Finished PCB'ler için Gerekli"
	quest.7D81F2381516204D.title: "Transistör'lar"
	quest.7D972A3C4211EB26.quest_desc: ["&zRainbow Coal&r, bir &zRainbow Fırını&r havaya uçurularak elde edilir."]
	quest.7D972A3C4211EB26.title: "&zRainbow Coal"
	quest.7DA48EDCF28DBE03.quest_subtitle: "Ginkgo + Hazel"
	quest.7DA8ACE06DE8097F.quest_desc: ["&6Bakır&r, &2&lMinecraft&r'da en bol bulunan cevherdir ve ana kullanımı dekorasyondur. \\n\\nZaten &2&lMinecraft&r tarafından eklenen birçok farklı varyant var ama &l&bChipped&r bunun yeterince iyi olmadığını düşündü! Bu yüzden daha fazlasını aldık! \\n\\nHatta oksitlenmiş versiyonlar için bile varyantlar var. \\n\\nSahte &aZümrüt Bloklar&r yapabilirsin."]
	quest.7DA8ACE06DE8097F.title: "&l&bChipped &6Bakır"
	quest.7DABD82393713B5A.quest_desc: ["&c&lLuminax&r çok basit bir moddur. Renkli ışıkları seviyor musun? Renkli ışıkların olabilir. \\n\\nHepsi dokusuz, tek renklidir ve Merdivenler, Basamaklar hatta Basınç Plakaları gibi farklı şekillerde bulunabilir! \\n\\nÜstelik &l&cDy&6en&ea&ami&bcs&r ile de çalışırlar!"]
	quest.7DABD82393713B5A.title: "&l&cLuminax"
	quest.7DAED14CEC4CDA51.quest_desc: ["&aNature's Aura&r, &aAura&r enerjisini kullanma ve yenileme üzerine kurulu bir büyü modudur. Bu görevler temel mekanikleri anlatmaktadır.\n\nBaşlamak için &eAltın Parçaları&r, &aYapraklar&r ve &aÇimen&r ile &eBrilliant Fiber&r üretin. Elinizdeki &eBrilliant Fiber&r ile herhangi bir yaprağa sağ tıkladığınızda onları &eGolden Leaves&r'e dönüştürür.\n\n&aBook of Natural Aura&r rehber kitabını okuduğunuzdan emin olun; bu kitabı &aNature's Aura&r modundaki çoklu blokların nasıl yapılacağını görmek için de kullanabilirsiniz."]
	quest.7DAED14CEC4CDA51.title: "&aNature's Aura&r'ya &eHoş Geldiniz"
	quest.7DD638E4111D66E7.quest_desc: ["Üst düzey &9Depolama Diskleri&r üretmek için bir &8Gelişmiş Depolama Kasası&r gereklidir."]
	quest.7DD638E4111D66E7.title: "&8Gelişmiş Depolama Kasası"
	quest.7DE2154159D273C3.quest_desc: [
		"&3Vibranium Zırh&r, &6Allthemodium Zırh&r'ın yükseltilmiş hâlidir. \\n\\nHer özellik için yükseltme alırız! Artık 32 zırh puanı, 36 Zırh Sertliği ve %80 Savurma Direnci sağlar. \\n\\nNe yazık ki yeni etkiler ve yetenekler kazanmıyoruz... ancak daha fazla &dBüyü Hasarına Direnç&r elde ediyoruz! Şimdi %75!"
		"{image:atm:textures/questpics/allthemodium/all_armor_vib.png width:100 height:175 align:center}"
	]
	quest.7DE2154159D273C3.title: "&3Vibranium Zırhı"
	quest.7DFF18CFEB0B8DBE.quest_desc: ["Mümkün olan en kısa sürede &aInferium&r yetiştirmeye başlamalısınız!\n\nBu tohumları yetiştirmek için zorunlu olmasa da, tohumların (özellikle Inferium Tohumu'nun) büyüme hızını artırmak için &eÖz Tarım Arazisi&r oluşturabilirsiniz. Ancak bazı tohumların ekilebilmesi için belirli tarım arazileri gereklidir."]
	quest.7DFF18CFEB0B8DBE.title: "&aInferium Tarım Arazisi"
	quest.7E07C5A6FA6B6B1F.quest_desc: [
		"&aYeniden İşleyici&r yapısını tamamladıktan sonra enerji, su ve &9Cyanit Külçesi&r aktararak &dBlutonyum Külçesi&r üretebilirsiniz."
		""
		"Bu madde reaktörde alternatif yakıt olarak kullanılabilir ve yakıldığında &9Magentit&r atığı üretir."
	]
	quest.7E07C5A6FA6B6B1F.title: "Blutonyum Külçesi"
	quest.7E13007340A818C5.quest_desc: ["Bu, Starlight Şarj Cihazı için Kademe 1 Sütun Başlığıdır."]
	quest.7E13007340A818C5.title: "Kademe 1 Starlight Şarj Cihazı Sütun Başlığı"
	quest.7E35ED5B30697722.quest_desc: ["Efsanevi bir Kuantum Bilgisayarı kurulumu mu istiyorsunuz? İşte eş işlemci iş parçacıklarını en üst düzeye çıkarmaya odaklanmış bir tasarım.\\n\\n218 Kuantum Bilgisayar Yapısal Camı, 123 Kuantum Bilgisayar Hızlandırıcısı, 1 Kuantum Bilgisayar Çekirdeği ve 1 Kuantum Bilgisayar Çoklu İşleyicisi ihtiyacımız olan parçalar. Bu yapı bize toplamda 8928 eş işlemci iş parçacığı sağlıyor. 256M'lik çekirdek üretim depolaması tek başına fazlasıyla yeterli olduğu için çekirdeğin haricinde ekstra depolama bloğu eklemediğimi belirteyim. Data Entangler görevi bu yüzden isteğe bağlı tutulmuştur.\\n\\n200 Q.C. Structural Glass ve 100 Q.C. Accelerator hazırlayın; gerisini ben vereceğim çünkü en az Apothic Enchanting bölümü kadar cömertim."]
	quest.7E35ED5B30697722.title: "Nihai Kuantum Bilgisayarı"
	quest.7E373212AE6B27D0.quest_subtitle: "İnfüzyon Üretimi"
	quest.7E373212AE6B27D0.title: "Insanium Arısı"
	quest.7E39FB9F3E973009.quest_subtitle: "Hayır, Mekanism Kimyasalı değil, Wither Sütü"
	quest.7E39FB9F3E973009.title: "Eter Gazı"
	quest.7E3B19796870C2B1.quest_desc: ["&#9955EDKimyasal Reaktör&r, en çok başvuracağınız makinelerden biri olacak. Çeşitli kimyasal tepkimeleri ve bileşikleri gerçekleştirmek için kullanılır."]
	quest.7E3C84D7FCEC9D52.quest_desc: [
		"Yapabileceğimiz en küçük (çalışan) &2&lFisyon Reaktörü&r 3x4x3 boyutlarındadır. \n\nTaban ve çerçevenin &2Fisyon Reaktörü Kasasından&r yapılması gerekirken, iç kısmın Boş olması veya &2Fisyon Yakıtı Kümesi&r ya da &2Kontrol Çubuğu Kümesine&r sahip olması gerekir! \n\nDuvarların iç kısmı (kenarlar değil) &2Fisyon Reaktörü Bağlantı Noktalarımıza&r veya &2FRLA'ya&r sahip olabilir ve geri kalanı &2Reaktör Camı&r ile doldurulabilir. \n\n&2&lFisyon Reaktörümüz&r inşa edildikten sonra, arayüzünü açmak için &2Reaktördeki&r herhangi bir yere (&2FRLA&r hariç) Sağ Tıklayabiliriz."
		"{@pagebreak}"
		"Bu, yeni Oyuncular için oldukça korkutucu görünebilir, bu yüzden daha iyi anlamak için yavaşça inceleyeceğiz! \n\nEn üstte 4 farklı Çubuk görebiliriz. Bunlar ne kadar &2Bölünebilir Yakıt&f, &bSoğutucu&f, &6Isınmış Soğutucu&f ve &8Nükleer Atık&r olduğunu görebileceğimiz yerlerdir. \n\nÇubukların arasında &2&lReaktörün&r ana menüsünü bulacağız. Bize açık mı kapalı mı olduğunu, her Tick ne kadar &2Bölünebilir Yakıtın&r harcandığını, her Tick Sıcaklığın ne kadar yükseldiğini ve &2&lReaktörün&r ne kadar Hasar gördüğünü söyleyecektir! \n\nTüm bunların altında 2 Düğme göreceğiz! Biri &2&lReaktörü&r açmak için Etkinleştir der, diğeri ise kapatmak için SCRAM der. SCRAM Düğmesinin yanında Oyuncuların açık mı kapalı mı olduğunu bilmelerine yardımcı olacak küçük bir resim vardır. Açıkken Yeşil, kapalıyken Kırmızı. \n\nBu Düğmelerin altında &2&lReaktörümüzün&r ne kadar Sıcak olduğunu göreceğiz ve altında Sıcaklık değişiminin bir görseli gösterilecektir."
		"{@pagebreak}"
		"Bu menünün dışında, İstatistikleri açmak için Üst Sekmeye Tıklayabiliriz. \n\nÜstteki Grafik, Hasar oluşana kadar ne kadar Isının tutulabileceğini, &2Yakıtın&r &2&lReaktör&r içinde ne kadar alanı olduğunu ve &2Yakıtı&r tüketmek için Isıyı kullanmada ne kadar Verimli olduğunu gösterir. \n\nGeri kalanı, her Tick ne kadar &2Yakıtın&r kullanılabileceğine bağlıdır. Tür Kutusunda maksimum bir değer ayarlayabiliriz. Ayrıca Tick başına mB olarak ayarlanmıştır! \n\nAna menünün yanında bulabileceğimiz diğer Sekme Sıcaklığımız içindir! \n\nDağılma oranını ve gösterilen Sıcaklık Birimini gösterecektir. Sekmeye Tıklayarak Sıcaklık Birimini değiştirebiliriz. Büyük olasılıkla F (Fahrenheit) veya C (Celsius) kullanacaksınız ancak K (Kelvin), R (Rankine) veya STP (Standart Sıcaklık ve Basınç) da kullanabiliriz!"
		"{@pagebreak}"
		"ERİMELER! \n\n&2&lFisyon Reaktörü&r %250 Hasara ulaşırsa patlayacaktır. Patladığında Blokları kıracak, Yangınlar çıkaracak ve en kötüsü... &aRadyasyon&r yayacaktır! \n\nBundan kaçınalım! \n\nSıcaklık 1.200K'nin üzerine çıktığında Hasar artacaktır. Bu Sıcaklığı düşük tutmak için &bSoğutucular&r kullanmamız gerekecektir. \n\nSürekli bir &bSoğutucu&r beslemesine sahip olduğundan ve &bSoğutucu Çıktısının&r tıkanmadığından emin olun. Bu meydana gelirse daha fazla &bSoğutucu&r kullanılamaz ve Sıcaklık artar. \n\nSIZINTILAR! \n\n&8Nükleer Atık&r Çubuğu doluysa da &aRadyasyon&r sızıntıları meydana gelebilir. Bu, &2&lReaktörün&r etrafına &aRadyasyon&r yayacaktır. &8Nükleer Atığı&r sürekli çıkararak ve hatta &8Atığın&r ne zaman dolu olduğunu bilmek için &2FRLA&r kullanarak bundan kaçının!"
		"{@pagebreak}"
		"Bu Çoklu Blok sadece Görsellerde gösterilen boyutlarda değil, mevcut olan her boyutta yapılabilir. Görseller sadece yapabileceğimiz en küçük boyutu göstermektedir."
		"{image:atm:textures/questpics/mek/mek_fission1.png width:100 height:75 align:center}"
		"{image:atm:textures/questpics/mek/mek_fission2.png width:100 height:100 align:center}"
		"{image:atm:textures/questpics/mek/mek_fission3.png width:100 height:100 align:center}"
		"{image:atm:textures/questpics/mek/mek_fission4.png width:100 height:110 align:center}"
	]
	quest.7E3C84D7FCEC9D52.quest_subtitle: "1 Unsuru 2 Unsurda Bölmek"
	quest.7E3C84D7FCEC9D52.title: "&2&lFisyon Reaktörü"
	quest.7E3DA4168D352B42.quest_desc: [
		"Söz veriyorum bu son Mantar Bataklığı (Mushroom Bog)! \\n\\nBu mantarlar ilk bakışta sıradan görünse de asıl marifetleri sarkıttıkları parçalarda: \\n\\nVeil'lar (Tüller)! Harika bir dekorasyon bloğu."
		"{image:atm:textures/questpics/undergarden/undergarden_veil.png width:200 height:100 align:center}"
	]
	quest.7E3DA4168D352B42.title: "Veil Mushroom Bog"
	quest.7E4367252A39BE6C.quest_desc: ["&c&lPowah&r güçle ilgilidir! &5&lMekanism&r veya &lIndustrial Foregoing&r gibi diğer Modlardaki Makineleri kullanmak için FE gibi Güç üretmek! \\n\\nÜretmen gerekecek farklı Aşamalar var ve elbette &6&lStar&r için sonuncusuna ihtiyacımız olacak!"]
	quest.7E4367252A39BE6C.title: "&c&lPowah"
	quest.7E49C985A0433B20.quest_desc: ["&d&lArs Nouveau&r çok eğlenceli bir büyü Modu ve beraberinde kendi Ahşap grubunu getiriyor! \\n\\nArchwood, çoğu Biyomda var ama çoğunlukla Archwood Biyomunda ortaya çıkan 5 farklı renkte ağaçla gelir!"]
	quest.7E49C985A0433B20.title: "&d&lArs Nouveau&r Kütükleri"
	quest.7E57964F6AD5B060.quest_subtitle: "Yaprak Kesen Arı susamış olabilir"
	quest.7E57964F6AD5B060.title: "Tea Arısı"
	quest.7E7637DAD2C242CB.quest_subtitle: "European Larch + Spruce"
	quest.7E79F52147B606F9.quest_desc: ["Kan toplamaya başlamak için &cBlood Extractor&r üretmemiz gerekiyor.\\n\\nBu eşya envanterinizde olduğu sürece yaratıkları öldürmek kanı extractor içine dolduracaktır. &cKan&r, EvilCraft'taki en önemli kaynaktır.\\n\\nKapasiteyi artırmanız mı gerekiyor? Bir tane daha üretip çalışma masasında birleştirin! Kapasiteyi artırmak için Dark Tank da kullanabilirsiniz.\\n\\nAyrıca yerdeki &ckan lekelerinden&r kan çekmek için de kullanılabilir.\\n\\nSon olarak, yeterli kan biriktiğinde eğilerek sağ tıkladığınızda bulunduğunuz bloğa bir kova kan dökebilirsiniz."]
	quest.7E79F52147B606F9.title: "&cKan&r &aToplamak"
	quest.7E90138B0A2C3210.quest_desc: ["Northland Trees, Permafrost Forest biyomlarındaki büyük ve dayanıklı ağaçlardır. \n\nLadine benzerler ama renkleri çok daha açıktır! Belki de albino ladindirler. \n\nFidanlarının çimen üzerine değil toprağa yerleştirilmesi ve 2x2 düzeninde olması gerekir."]
	quest.7E92ED270C67FDE5.quest_desc: ["Modda yapabileceğin neredeyse her makine bir &9Dielektrik Gövde&r gerektirecektir.\\n\\nİlerlemek için önce &bMacun&r ve biraz da &aÇubuk&r yapman gerekecek!"]
	quest.7E92ED270C67FDE5.title: "Dielektrik Malzemelerle Başlamak"
	quest.7E9E03274A88347D.quest_desc: ["Sırt Çantasındaki istif boyutunu 2 artırır."]
	quest.7E9E03274A88347D.title: "&fİstif Yükseltmesi Kademe 1"
	quest.7EA218A489641684.quest_desc: ["&bIndustrial Foregoing&r geliştiricisi Buuz135 ruhların depolanabilir olmasını istememişti. Ancak mod geliştiricisi Ultramega bunu depolanabilir hale getirdi.\\n\\nİpucu: Dışa aktarıcının tüm ruhları Ruh Borusu'na dökmesini engellemek için Düzenleyici Yükseltmesi kullanın."]
	quest.7EA218A489641684.quest_subtitle: "Buuz bunu istememişti"
	quest.7EA218A489641684.title: "Ruh Depolaması mı?"
	quest.7EAFF64FFE8B5378.quest_subtitle: "Demir Arısı + Tatlı Arısı"
	quest.7EAFF64FFE8B5378.title: "Çinko Arısı"
	quest.7EB1C1AE52A0027F.title: "Chaotic Mermi Yerçekimi Telafisi Modülü"
	quest.7EB97C0DDE60DED4.quest_desc: ["Çok sayıda modül yuvasına ve muazzam güce sahip kaotik seviye yay!"]
	quest.7EB97C0DDE60DED4.title: "Chaotic Yay"
	quest.7EC01E7DB045DB05.quest_desc: ["&aAugment&r'ler, bir Fırının işlevini değiştirebilen veya yükseltebilen Fırın yükseltmeleridir.\\n\\n - Blasting: Fırını yalnızca Blasting tariflerine izin verecek şekilde dönüştürür.\\n\\n - Smoking: Fırını yalnızca Smoking tariflerine izin verecek şekilde dönüştürür.\\n\\n - Factory: Fırını yakıt yerine güç kullanacak şekilde dönüştürür ve bir fabrikaya yükselterek aynı anda birden fazla eşya eritmesini sağlar. Bu özellik Fırının kademesine bağlı olarak artar.\\n\\n - Speed: İki kat yakıt karşılığında Fırının hızını iki katına çıkarır.\\n\\n - Fuel Efficiency: Yakıt başına eritilen eşya miktarını iki katına çıkarır, ancak hızı %25 azaltır"]
	quest.7EC01E7DB045DB05.title: "Fırın &aEklentileri"
	quest.7EC7E12C0880F8F5.quest_subtitle: "Kademe: &e5"
	quest.7EC8814940C4C3D7.quest_desc: ["Küçülmek için bu eşyayı kullan. Otomasyon üzerinde çalışmak için yararlı ve aynı zamanda genel olarak eğlenceli."]
	quest.7EC8814940C4C3D7.quest_subtitle: "Tatlım, Kendimi Küçülttüm"
	quest.7EC8814940C4C3D7.title: "Personal Shrinking Device"
	quest.7EC89242980768B3.quest_subtitle: "Pecan + Wild Cherry"
	quest.7ECA0633AF1AEC19.quest_desc: ["&e&lHassas Bıçkı Makinesi&r, &6Ahşap Eşyaları&r \"geri dönüştürmek\" için çalışacaktır. \n\nOna biraz &aEnerji&r verin ve içine bir &6Ahşap eşya&r atıp bekleyin! \n\nYatakları 3 &6Ahşap Kalas&r ve 3 Yüne dönüştürecektir. &6Kapıları&r &6Ahşap Kalaslara&r. Ve &2Kütükleri&f 4 yerine 6 &6Kalasa&r! \n\nAyrıca &7Çubukları&r, &6Karton Kutu&r için gerekli olan &6Talaşa&r dönüştürecektir!"]
	quest.7ECA0633AF1AEC19.title: "&e&lHassas Bıçkı Makinesi"
	quest.7ECE00D12CFC50A4.quest_desc: ["&bİpek Dokunuş &7Modülü&r, &dMeka-Aleti&r için bir İpek Dokunuş Büyüsü görevi görecektir. \n\nAma sadece Kazma kısmı değil, aynı zamanda &dMeka-Aletinin&r içindeki Kürek ve diğer Aletler için de! \n\nBöylece Taş ve Cevherlerin yanı sıra Çimen ve Miselyum da toplayabilirsiniz. \n\nBu &7Modülü&r &dMeka-Aleti&r üzerinde &dCevher Arıtma &7Modülü&r ile birlikte kullanamayız."]
	quest.7ECE00D12CFC50A4.quest_subtitle: "Meka-Aleti"
	quest.7ECE00D12CFC50A4.title: "&bİpek Dokunuş &7Modülü"
	quest.7EDBE88A2CFAB353.quest_desc: [
		"&#562FD6Birleştirici&r makineleri, birçok bileşen ve makinenin üretiminde kullanılır. Üretim işlerini otomatik bir şekilde yapabilirler."
		"Ayrıca daha önce kullandığınız bazı tariflerin &açok daha ucuz&r alternatiflerini sunarlar."
	]
	quest.7EDBE88A2CFAB353.quest_subtitle: "Çok Sayıda İhtiyacınız Olacak"
	quest.7EDF2CC08FC774F9.quest_subtitle: "&f10 &cSaldırı Hasarı"
	quest.7EE27C3908008E20.quest_desc: ["&cLaser Node&r düğümlerini uzak mesafelere bağlamanız gerekiyorsa connector (konektör) kullanabilirsiniz! İngiliz anahtarını normal şekilde kullanarak bağlantıyı kurabilirsiniz."]
	quest.7EEEEDD5FF31ACD3.quest_desc: ["&eAkıllı Oluk&r, filtreleme desteği sunan gelişmiş dikey eşya aktarım oluğudur."]
	quest.7EEEEDD5FF31ACD3.title: "&eAkıllı Oluk"
	quest.7EF57BBEAA4B6B08.quest_desc: ["&9Applied Energistics 2&r gibi bir mod kullanarak sanal depolama alanı mı oluşturmak istiyorsun?\\n\\nBunlar depolama alanını geliştirmenin harika yollarıdır. Ancak &eNBT Eşyaları&r ve bunları depolamanın en iyi yolu hakkında konuşmak önemlidir.\\n\\nNBT eşyaları, üzerlerine ekstra etiketler eklenmiş eşyalardır. Büyülü eşyalar, dayanıklılığı olan eşyalar ve daha fazlası. Bunlar, üzerlerine NBT etiketleri iliştirilmiş eşyalardır. Bu nedenle genellikle istiflenmezler.\\n\\nBunlardan birçoğunu AE2 gibi bir depolama sisteminde depoladığında, kaydın veya sunucun için sorun oluşturma ihtimalin vardır.\\n\\nBu nedenle, bunları Sandıklarda veya Çantalarda saklamak en iyisidir!"]
	quest.7EF873DCEB3B9D48.quest_desc: ["Nihai kademe olan &lDünya Kademesi: &4Zirve&r! Bu seviyeye ulaşmak için &d&lEnder Ejderhasını&r katletmiş olmalı ve tamamen &5Destansı&r veya &6Mistik&r nadirlikte &eZırh&f ve &eAlet/Silah&r kuşanmalısın. \\n\\nBu kademede &5Destansı&r ve &6Mistik&r kalitedeki eşyalar ile &aCevherler&r en yaygın düşenler olur; &zKusursuz&r cevher bulma ihtimalin tavan yapar. &8Yaygın&r ve &aSıra Dışı&r kaliteler artık düşmez (zaten kimse onları özlemez!) \\n\\nBonus olarak %125 Ekstra Tecrübe, %100 Şans bonusu ve &a100 Maks Eterna&r sınırı kazanırsın. \\n\\nDüşman &4Yaratıklar&r da son güçlendirmelerini alır: 16 zırh puanı, 20 zırh sertliği, 25 zırh delme ve 20 koruma delme."]
	quest.7EF873DCEB3B9D48.title: "&lDünya Kademesi: &4Zirve"
	quest.7EFBAF3E281D2EBE.quest_desc: [
		"Harici bir depolama konteyneri ile karşılaştığında &bME Depolama Veriyolu&f, konteynerin ME ağının bir parçasıymış gibi kullanılmasına izin vererek eşyaların tamamen ME aracılığıyla konteynerden çıkarılmasına veya içine yerleştirilmesine olanak tanır. "
		""
		"Depolama veriyolları filtrelenebilir ve belirli eşyaların önce bağlı depolama alanına gitmeye çalışacağı şekilde belirli öncelikler verilebilir, ancak filtrelenmiş herhangi bir eşyayı ağdaki başka bir yerden bağlı depolama alanına geriye dönük olarak aktarmayacaktır."
	]
	quest.7EFBAF3E281D2EBE.quest_subtitle: "Yedek sandık"
	quest.7EFBFF5D0DA018E7.quest_desc: ["Sırt Çantasından otomatik olarak silinmesini istediğin eşyalar için filtre ekler."]
	quest.7EFBFF5D0DA018E7.quest_subtitle: "Sırt çantasından otomatik olarak silinmesini istediğin eşyalar için filtre ekler."
	quest.7EFEE009212A4FD4.quest_subtitle: "Aşama: &63"
	quest.7F007C888C23EC42.quest_desc: ["&5Cevher Kutusu&r, topladığın tüm &aApotheosis Cevherlerini&r depolamak için en pratik bloktur! \\n\\nÜretimi için 1 &3Ender Sandığı&r, 1 &5Cevher Kesme Masası&r, 4 Bazalt ve 3 Cam bloğu gerekir. \\n\\nKullanımı: Envanterindeki &aCevherlere&r Shift + sol tıklayarak veya cevherleri &9Mavi Yuvaya&r koyarak kutuya aktarabilirsin. \\n\\nKutu, her bir cevher türü ve saflık derecesi için 32.768 adede kadar depolayabilir (örneğin 32 bin Kusursuz Savaş Lordu Cevheri ve 32 bin Çentikli Savaş Lordu Cevheri aynı anda saklanabilir). İstenen cevhere ve saflığa tıklayarak geri çıkarabilirsin. \\n\\nAyrıca kutu doğrudan bir Cevher Kesme Masası gibi çalışır. Soldaki yuvalara nadirlik malzemeleri ile &9Cevher Tozu&r koyup depolanan cevher türüne tıkladıktan sonra çekiç butonuna tıklayarak 2 alt saflıktaki cevheri bir üst saflığa yükseltebilirsin."]
	quest.7F007C888C23EC42.title: "&5Cevher Kutusu"
	quest.7F076FC4F2187692.quest_subtitle: "&f8 &cSaldırı Hasarı"
	quest.7F09F8F98C13F11B.quest_desc: [
		"&cKurban&r olmayan Demonic Ritüel mi olur!:D\\n\\nÇoğu zaman Demon'lar eşyaları sever, bu yüzden henüz çok korkmayın. Ancak, eğer favori bir İneğiniz varsa, endişelenmeniz gerekebilir. Üzgünüm Sarıkız.\\n\\n&aSacrifical Bowls&r, Ritüeller için gereken eşyaları yerleştirmek için kullanılır. Bunlar, gereken Tebeşirleri kapatmadığı sürece Ritüel içindeki herhangi bir yere yerleştirilebilir. "
		""
		"Şimdilik sadece dört tanesine ihtiyacınız olacak, ancak ilerleyen zamanlarda her ritüel için ondan fazla kaseye ihtiyacınız olacak!\\n\\n&6Golden Ritual Bowl&r, Ritüeli etkinleştirmek için Ritüelin ortasında kullanılır ve ayrıca genellikle içinde Ritüel için bir Book of Binding'e ihtiyaç duyar."
	]
	quest.7F09F8F98C13F11B.title: "Ritüele Hazırlık: &6Bowls"
	quest.7F0B2D58361FB00E.quest_desc: ["Just Dire Things, oldukça çok yönlü bir teknoloji modudur. Goo Spread (Goo Yayılımı) adında yeni bir dönüşüm mekaniği ve otomasyonu kolaylaştıran çeşitli kullanışlı makineler sunar."]
	quest.7F0B2D58361FB00E.title: "Just Dire Things"
	quest.7F0F7111552F95A9.quest_desc: ["Tamam, tam Montajı Yapılmış &5Trenimizi&r aldık, peki şimdi nasıl kullanacağız? \\n\\nKontrol ediyorsanız, &5Tren Kontrolleri&r'a Sağ Tıklamanız gerekecek. \\n\\nİleri gitmek için W tuşuna basılı tutabilir veya Geri gitmek için S tuşuna basılı tutabilirsiniz. Hayır, &5Trenler&r Arabalar gibi dönmez, sadece &7Tren Raylarını&r takip ederler. \\n\\nİleri giderken epey Hız kazanırsınız, bunu &aTecrübe Çubuğu&r'nuzun yerini alan Çubukta görebilirsiniz. Geri gitmek o kadar Hız vermez. \\n\\nBir &5Tren İstasyonuna&r yaklaşıyorsanız ve ışık hızında hareket etmiyorsanız, &5Treni&f &5İstasyonda&r durdurmak için Boşluk tuşuna basılı tutabilirsiniz. Bu, onları sökmek veya daha fazla &5Boji&r bağlamak için yararlıdır."]
	quest.7F0F7111552F95A9.title: "&5Treninizi&r Kontrol Etmek"
	quest.7F11ABFB2E21B7E4.quest_desc: ["Armor, &l&2Minecraft&r'ın çok önemli bir parçasıdır; seni hasardan korur. \\n\\nFarklı Armor parçaları farklı Armor Points sağlar. Zırhın ne kadar etkili olduğunu bu puanlar belirler; ne kadar çoksa o kadar iyi!\\n\\nÇoğu Armor, Armor Trims ile süslenebilir. Görünümü değiştirmek için bir Armor parçasını, bir Armor Trim ve renklendirme malzemesiyle birlikte kullan!"]
	quest.7F11ABFB2E21B7E4.title: "&l&bTemel Zırhlar&r"
	quest.7F187E291C3D5BA7.quest_desc: ["Sıvı Boşaltıcısı, Sıvı Yükleyicisi'nin tam tersidir. &6Rayın&r üstünde olmak yerine altındadır. &3Buharlı Lokomotif&r'lere su vermek yerine sularını alır. Bunu neden yapmak isteyeceğinizi bilmiyorum ama yapabilirsiniz!"]
	quest.7F187E291C3D5BA7.title: "Sıvı Boşaltıcısı"
	quest.7F2D696AC9F4C4E4.quest_desc: [" &5Kristal katmanlarından&r dövülmüş vizyoner bir zanaatkâr tarafından üretilen &5Kesme Cam Çizme&r, dokunduğu her &csıvı damlasının&r anısını taşır. Gücü, giyen kişinin &csu, lav&r veya &5zehir&r üzerinde yüzey katı cammış gibi yürümesini sağlar. \\n\\n Bot takılıyken iç tamponunda &csıvı depolayabilir&r; böylece giyen kişi üzerinde yürüyeceği sıvıyı seçebilir. Aynı türden ne kadar çok sıvı depolanırsa adımlar o kadar hızlanır; &cyavaş yüzeyler&r &5hızlı bir yola&r dönüşür. \\n\\n- &l1 yeteneği vardır:&r \\n\\n &f&lCam&r: \\n Bu &6kalıntı&r, &9sıvılar&r için çok amaçlı bir &5kap&r görevi görür. &6Elde tutulduğunda&r, iç tamponunda birden fazla &9sıvı türü&r depolayabilir ve giyen kişinin hangisini kullanacağını seçmesine olanak tanır. \\n\\n Takılıyken giyen kişi, içinde depolanan herhangi bir &9sıvı&r üzerinde hareket edebilir. Hareket, &5katı zeminde&r yürümekten doğal olarak &cdaha yavaştır&r; ancak aynı türden ne kadar çok &9sıvı&r depolanırsa üzerinde yürümek o kadar kolaylaşır ve normalde &4tehlikeli yüzeyler&r &akararlı, yürünebilir bir yola&r dönüşür. \\n\\n- Batmayı reddeden ve her sıvı üzerinde &9süzülebilen&r kişiler için bir &6kalıntı&r."]
	quest.7F2D696AC9F4C4E4.quest_subtitle: "Başkalarının battığı yerde yürü ve sıvıların akışına hükmet!"
	quest.7F2D696AC9F4C4E4.title: "&bKesme Cam Çizme"
	quest.7F4963FCAE5337EC.quest_desc: ["Sadece &b&lIgnis&r ile savaşmak yeterince zor olmadığı için, &bYanan Küller&r'ı almak için önce &bYanan Hortlak&r ile savaşmanız gerekecek. \\n\\nOnlara sahip olduğunuzda, &b&lIgnis&r'i çağırmak için onları Ateşin Sunağı üzerinde kullanın."]
	quest.7F4963FCAE5337EC.quest_subtitle: "Ignis'i Yeniden Canlandırmak"
	quest.7F4963FCAE5337EC.title: "&bYanan Küller"
	quest.7F4B734CFB0F0306.quest_desc: ["Bu yeni &7Vagonlar&r, özel &2Vanilla&r &7Vagonlara&r benzer. &7Tanklı Vagon&r içindeki tüm Sıvıları tutar ve taşır. &7Enerji Hücreli Vagon&r ise bunun yerine Enerji tutar ve taşır!"]
	quest.7F4B734CFB0F0306.title: "Yeni Vagonlar"
	quest.7F59941D62E672B0.quest_desc: [
		"Occultism, cevherlerinizi parçalayacak (crush) Demon'lardan daha fazlasını sunar!"
		""
		"Sizin için eşyaları taşıyabilecek, odun kesebilecek ve daha fazlasını yapabilecek Demon'lar var!!"
		""
		"Ayrıca, size özel güçlendirmeler veren ve hatta sizin için savaşan, &dFamiliars&r olarak bilinen harika arkadaşları çağırmanın yolları da var! Rehber kitabınızdaki &dFamiliar Rituals&r'ı (Yoldaş Ritüellerini) kontrol ettiğinizden emin olun!"
	]
	quest.7F59941D62E672B0.title: "&dFamiliars"
	quest.7F67849DE9F700D8.quest_desc: ["&2Augment&r: Speed, fırınınızın işlem hızını katlar! Örneğin &bDiamond Furnace&r, 80 tick yerine her 40 tick'te bir eritme yapar; tabii iki kat yakıt tüketimi pahasına."]
	quest.7F67849DE9F700D8.title: "&2Augment&r: Hız"
	quest.7F6B66566C211735.quest_desc: ["Canavar Çağırıcıya uygulanan Zayıflatma Rünü (Runes of Debilitation), ortaya çıkan yaratığın maksimum sağlığını azaltacaktır. Bu, canlarını %20'ye kadar düşürebilir"]
	quest.7F6B66566C211735.title: "Can"
	quest.7F757CD6F8C57733.quest_desc: ["Enerji Çekirdeği, tüm Minecraft'taki en büyük olmasa da en büyük Enerji bankalarından biridir. Ve her şey Çekirdek ile başlar. Bu, Enerji Çekirdeği Çoklu Bloğunun ortası ve kalbidir (yerden biraz yukarıda olduğundan emin olun). Yere koyduğunuzda şunları içeren Arayüzünü görebilirsiniz: İnşa Rehberi, Alt Seviye, Üst Seviye ve Çekirdeği Birleştirin. Aşamalar, Çekirdeğin ne kadar büyük ve güçlü olduğunu belirler. İnşa Rehberi size bu Çekirdek Aşamasını nasıl birleştireceğinizi gösterir. Gerekli tüm bloklara sahipseniz Çekirdeği Birleştirin'a basabilirsiniz ve otomatik olarak inşa edecektir!"]
	quest.7F757CD6F8C57733.quest_subtitle: "Draconic Enerji Depolama"
	quest.7F757CD6F8C57733.title: "Enerji Çekirdeği Çoklu Bloğu"
	quest.7F7ED94590B5B857.quest_desc: ["Bazı &eBüyüler&r ihtiyaç duyulan her yerde kullanılmak üzere &7Parşömenlere&r aktarılabilir. \\n\\nİlk olarak bir &7Parşomene&r ihtiyacın olacak, onu yere yerleştir. Sonra aynı ritüeli &7Parşomen&r üzerinde gerçekleştir. \\n\\nTüm &4Kan&r ve &bToz&r işlemleri bittiğinde &7Parşomene&r Sağ Tıkla ve BUUM, işte &7Parşömen&r! \\n\\nBazı &eBüyüler&r &7Parşömene&r dönüştürülemez, bu yüzden ziyan olan malzemelerden sorumlu değilim."]
	quest.7F7ED94590B5B857.title: "Taşınabilir &eBüyüler&r!"
	quest.7F85669FEA41CD97.quest_desc: [
		"&6Village&r'ın (Köy) Tarafsız koruyucusu. Yakındaki tüm Düşman yaratıklara saldıracaktır. Bir Demir Golem gibi ama nedense tanıdık mı geliyor? Kostümlü tanıdığımız biri olabilir mi? \\n\\nOnunla İyileştirme İksirleri ve yakında &aEvoker Forts&r'a karşı yardım için yapılacak olan Furled Map için Zümrüt takası yapabilirsiniz. \\n\\nOnu öldürmek isterseniz size defalarca &6Holy Spells&r ile saldıracaktır. Ayrıca canı azaldığında kendini İyileştirecektir. \\n\\nÖldürüldükten sonra Arcane Essence, Mürekkepler, &6Holy Runes&r ve &6Holy Scrolls&r düşürecektir."
		"{image:atm:textures/questpics/iron_spells/spells_priest.png width:100 height:200 align:center}"
	]
	quest.7F85669FEA41CD97.title: "&6&lPriest"
	quest.7F8B6D5F360D985A.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_fiery.png width:100 height:150 align:center}"]
	quest.7F8B6D5F360D985A.title: "&eFiery"
	quest.7F8DEDD0A54D1E11.quest_desc: ["Acaba Dropper'lar ne iş yapar?\nSanırım bir şeyleri yere bırakıyorlar...\n\nTampon bellekteki (Arabellek) herhangi bir eşya yere bırakılacaktır.\n\nBotania gibi modlarda çok işe yarayabilir!"]
	quest.7F8E50FA436DB4E6.quest_desc: ["&dMuhafazalı Dişli Takımları&r, &8Şaftları&r bir sıra halinde birbirine bağlayarak &eKayışlara&r benzer şekilde işlev görür. \\n\\nYine de epey fark vardır; örneğin &dMuhafazalı Dişli Takımları&r döndürülmek için bir &6Ayarlı Anahtar&r ile kullanılabilir. Ayrıca &dDönmeye&r devam edebilmeleri için doğrudan diğer &dMuhafazalı Dişli Takımlarının&r yanına yerleştirilmeleri gerekir. \\n\\n&eKayışlar&r gibi orijinal &8Şaft&r ile aynı Hız ve Stres Birimi değerlerini korurlar. Ayrıca aynı yönü korurlar!"]
	quest.7F8E50FA436DB4E6.title: "&dMuhafazalı Dişli Takımları"
	quest.7F990FBC1A691020.quest_desc: ["Tuzaklı Sandıklar normal Sandıklarla aynıdır. Sadece açıldıklarında Redstone sinyali yayarlar ve bir tane olacak şekilde birleştirilemezler."]
	quest.7F990FBC1A691020.quest_subtitle: "\"Acaba bunun içinde ne var?\""
	quest.7FA85713C86166DA.quest_desc: ["Ağ üretim sıranıza kablosuz olarak erişmenizi sağlar."]
	quest.7FA9EA93602A98EC.quest_desc: [
		"&cFire Dragon Roost&r'ları, yerin üstünde bulunan, &cCharred Blocks&r (Kavrulmuş Bloklar) ve Külden yapılmış Yuvalardır. \n\nBunlar &lAşama 1&r ila &lAşama 3 &cFire Dragon&r'ları ile birlikte doğacaklardır. Ve &c&lEjderha&r ne kadar büyük olursa &cYuva&r da o kadar büyük olur! \n\nBu &cYuvalarda&r Sandıklarla birlikte &eAltın&r Yığınları olacaktır. Sandıklarda yalnızca &bElmaslara&r kadar Eşyalar olacaktır ancak yine de çok yardımcı olurlar!"
		"{image:atm:textures/questpics/iceandfire/iaf_struct_fireroost.png width:200 height:100 align:center}"
	]
	quest.7FA9EA93602A98EC.title: "&cFire Dragon Roost"
	quest.7FABB77A60E7962C.quest_desc: ["Obsidian'ı &bDiamonds&r ile infuse ederek İşlenmiş Obsidiyen Tozu elde edebiliriz! \\n\\nArdından &7Osmium&r'u bu malzemeye compress ederek Ingot biçimini elde edebiliriz. \\n\\nSon olarak bu Ingots'u, &6Allthemodium Armor&r'dan bile daha iyi değerlere sahip Armor'a dönüştürebiliriz!"]
	quest.7FABB77A60E7962C.quest_subtitle: "31"
	quest.7FABB77A60E7962C.title: "&5Refined Obsidian Armor"
	quest.7FB12EC3A5888123.quest_desc: ["&3Tube Junction&r, Pressure Tube'larınızı daha fazla yöne hareket ettirmenizi sağlayarak basıncınızın taşınması üzerinde daha fazla kontrol sahibi olmanızı sağlar."]
	quest.7FB12EC3A5888123.quest_subtitle: "Hayır, bu yoldan git!"
	quest.7FBB431AC055FE93.quest_desc: ["&7Soulit Spectator&r, &9Soul Dew&r ve &9Nightfall Spider Eye&r ile üretilir. \n\nTom Clancy's Splinter Cell'deki Yapışkan Kamera gibi çalışır. &7Spectator&r'ı fırlatmak için Sağ Tıklayabilirsiniz ve bir süre sonra onun gözünden görebilirsiniz. Hatta onunla kendinizi bile görebilirsiniz! \n\nErken sonlandırılamaz, bu yüzden kullanırken dikkatli olun. Ayrıca dayanıklılığı ve bekleme süresi vardır."]
	quest.7FBB431AC055FE93.title: "&7Soulit Spectator"
	quest.7FBC64E6408D8D7F.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_knightmetal.png width:100 height:150 align:center}"]
	quest.7FBC64E6408D8D7F.title: "&7Knightmetal"
	quest.7FBD51663C1A711A.title: "&4Amaramber Kılıç"
	quest.7FC54AF87CBDD222.quest_desc: [
		"&5Ancient Battlegrounds&r sadece geçmişin bir parçasıdır. \\n\\nNe olduğunu kim bilir. \\n\\nKimin kiminle savaştığını kim bilir. Şimdi tek sahip olduğumuz duvarların parçaları ve bu &5Piles of Armor&r (Zırh Yığınları). Kazmanızla onları Kazarak alsanız iyi olur."
		"{image:atm:textures/questpics/iron_spells/spells_battleground.png width:200 height:100 align:center}"
	]
	quest.7FC54AF87CBDD222.title: "&5Ancient Battleground"
	quest.7FD3C1784F32F2AF.quest_subtitle: "Kaotik Füzyon Üretimi"
	quest.7FD3C1784F32F2AF.title: "Chaos Arısı"
	quest.7FE273141D3DFFFD.quest_desc: ["Silahşör, yeni Yağmacıların orta sınıf birimidir! \n\n12 Kalpleri vardır ve Zırhları yoktur. \n\nTercih ettikleri silah, giydikleri Akümülatör Sırt Çantası tarafından şarj edilen bir &5&lElektromanyetik Top'tur&r! \n\nÖldüklerinde &aZümrütler&r ve &7Demir Çubuklar&r düşürürler."]
	quest.7FE273141D3DFFFD.title: "Silahşör"
	quest.7FE5864E59D7B827.quest_desc: ["&#6784EBHull&r gövdeleri, bir makineye aktarılabilecek maksimum güç miktarını belirler. Makineye yükseltme ekledikçe daha yüksek gücü çekebilmesi için üst seviye bir &#6784EBHull&r takmanız gerekir. Gövde seviyesi aynı zamanda makineye hangi kabloların bağlanabileceğini de etkiler."]
	quest.7FE5864E59D7B827.quest_subtitle: "Temel Yapı Taşı"
	quest.7FE969CB4B419FC6.quest_desc: ["Mekanism ile kuracağınız biraz gelişmiş bir düzenek sayesinde bu makine her şeyi kablosuz olarak aktarmanıza olanak tanır.\\n\\nÖzel kanallar oluşturarak eşyaları, enerjiyi hatta Mekanism gazlarını kablosuz iletebilirsiniz. Oldukça kullanışlı bir sistemdir."]
	quest.7FE969CB4B419FC6.quest_subtitle: "Sadece Enerji İçin Değil"
	quest.7FE969CB4B419FC6.title: "&9Mekanism: &6Kuantum Dolaşıklık Işınlayıcı"
	quest.7FF3EA602FE7A546.quest_desc: ["&3Sculk Vericisi&r, &6Antik Tapınak&r Sandıklarında bulabileceğimiz çok nadir bir Eşyadır. \n\nBir tane bulduğunuzda en iyi arkadaşınız olacak! \n\nKullanmak için arayüzü olan bir Bloğa Shift Sağ Tıklayın; Sandıklar, Çalışma Masaları ve Ocaklar gibi düşünün. Ardından &3Verici&r o Eşyaya bağlanacaktır. \n\nBundan sonra, o Bloğa nereden olursanız olun uzaktan erişmek için &3Vericiyi&r kullanabiliriz! \n\nBloğun bağlantısını kaldırmak için &3Verici&r ile Havaya Shift Sağ Tıklayın."]
	quest.7FF3EA602FE7A546.title: "&3Sculk Vericisi"
	quest.7FF77463F2A0E210.quest_desc: ["Nightfall Mud çamuru yalnızca &9Dark Swamp&r biyomlarında bulunur; çeşitli yapı bloklarının yapımında kullanılır."]
